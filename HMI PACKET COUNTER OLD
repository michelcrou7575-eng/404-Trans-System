FUNCTION "HMI PACKET COUNTER OLD" : VOID
TITLE =HMI Conveyors Display Packet Counter
VERSION : 0.2


VAR_TEMP
  UPDATE : BOOL ;	
  PIVOT_HIGH : BOOL ;	//Pivot Conveyor 10 -> High Position
  PIVOT_LOW : BOOL ;	//Pivot Conveyor 10 -> Low Position
  INT_TO_HMIWORD : INT ;	//INT to WORD Converter
  BIT0_5_COUNT_UP : BOOL ;	//Count Up Logic Buffer
  BIT1_5_COUNT_DOWN : BOOL ;	//Count Down Logic Buffer
  BIT0_6_COUNT_UP : BOOL ;	
  BIT1_6_COUNT_DOWN : BOOL ;	
  BIT0_11_COUNT_UP : BOOL ;	
  BIT1_11_COUNT_DOWN : BOOL ;	
  BIT0_12_COUNT_UP : BOOL ;	
  BIT1_12_COUNT_DOWN : BOOL ;	
  BIT0_13_COUNT_UP : BOOL ;	
  BIT1_13_COUNT_DOWN : BOOL ;	
  BIT0_21_COUNT_UP : BOOL ;	
  BIT1_21_COUNT_DOWN : BOOL ;	
  BIT0_22_COUNT_UP : BOOL ;	
  BIT1_22_COUNT_DOWN : BOOL ;	
  BIT0_23_COUNT_UP : BOOL ;	
  BIT1_23_COUNT_DOWN : BOOL ;	
END_VAR
BEGIN
NETWORK
TITLE =UpDate

      A     "M 6.5"; 
      FP    "FP 149.6"; 
      =     #UPDATE; 

NETWORK
TITLE =Packet Measurements Converter - Length (Pulse to mS)

      L     "COLLATORS DB".PacketLength_C4; 
      ITD   ; 
      DTR   ; 
      L     "DB UTILITY".LENGTH_CONST; 
      *R    ; 
      RND   ; 
      T     "MW 176"; 

NETWORK
TITLE =Packet Measurements - Width  (Pulse to mS)

      L     "COLLATORS DB".Packet_Width_C10; 
      ITD   ; 
      DTR   ; 
      L     "DB UTILITY".WIDTH_CONST; // 0.52
      *R    ; 
      RND   ; 
      T     "MW 178"; 

NETWORK
TITLE =Packet Measurements - mm Conversion

      A     #UPDATE; 
      JNB   NCON; 
      L     "COLLATORS DB".PacketLength_C4; 
      ITD   ; 
      DTR   ; 
      L     6.673000e+000; 
      *R    ; 
      RND   ; 
      T     "MW 202"; 

NCON: CLR   ; 

NETWORK
TITLE =Packet Counter - Slat Conveyor 3 

      A     "A 44.0"; 
      JNB   M440; 

      L     "HMI_DB".CONVEYOR_MAXCOUNT_L; 
      T     "DEBOUNCER OLD".B6_2_Slat_3_InFeed.Word_Count_Limit; 
//;
      L     "HMI_DB".CONV_3_COUNT; 
      T     #INT_TO_HMIWORD; 

      CALL "DE-BOUNCER OLD" (
           Bit_0                    := "B 6.2",
           Bit_1                    := "B 6.4",
           Transfer_Start           := FALSE,
           Preset_mS                := 500,
           Debounce_mS              := 1500,
           Plc_Scan_mS              := "DB UTILITY".Scan_Cycle_Previous,
           Rising_Pulse_1           := "DEBOUNCER OLD".B6_2_Slat_3_InFeed.Rising_Pulse_1,
           Rising_Pulse_2           := "DEBOUNCER OLD".B6_2_Slat_3_InFeed.Rising_Pulse_2,
           Rising_Pulse_3           := "DEBOUNCER OLD".B6_2_Slat_3_InFeed.Rising_Pulse_3,
           Rising_Pulse_4           := "DEBOUNCER OLD".B6_2_Slat_3_InFeed.Rising_Pulse_4,
           Rising_Pulse_5           := "DEBOUNCER OLD".B6_2_Slat_3_InFeed.Rising_Pulse_5,
           Rising_Pulse_6           := "DEBOUNCER OLD".B6_2_Slat_3_InFeed.Rising_Pulse_6,
           Rising_Pulse_7           := "DEBOUNCER OLD".B6_2_Slat_3_InFeed.Rising_Pulse_7,
           Rising_Pulse_8           := "DEBOUNCER OLD".B6_2_Slat_3_InFeed.Rising_Pulse_8,
           Memory_Bit_1             := "DEBOUNCER OLD".B6_2_Slat_3_InFeed.Bit_0_FrontEnd,
           Memory_Bit_2             := "DEBOUNCER OLD".B6_2_Slat_3_InFeed.Bit_1_FrontEnd,
           Memory_Bit_3             := "DEBOUNCER OLD".B6_2_Slat_3_InFeed.Bit_0_RearEnd,
           Memory_Bit_4             := "DEBOUNCER OLD".B6_2_Slat_3_InFeed.Bit_1_RearEnd,
           Memory_Bit_5             := "DEBOUNCER OLD".B6_2_Slat_3_InFeed.Packet_Exiting,
           Memory_Bit_6             := "DEBOUNCER OLD".B6_2_Slat_3_InFeed.Count_Error,
           Spare_1                  := "DEBOUNCER OLD".B6_2_Slat_3_InFeed.Sens_Error,
           Spare_2                  := "DEBOUNCER OLD".B6_2_Slat_3_InFeed.FirstScan_Init_Done,
           Word_Buffer_1            := "DEBOUNCER OLD".B6_2_Slat_3_InFeed.Bit_0_ON_Time,
           Word_Buffer_2            := "DEBOUNCER OLD".B6_2_Slat_3_InFeed.Bit_1_ON_Time,
           Word_Result              := "DEBOUNCER OLD".B6_2_Slat_3_InFeed.Word_Count_Result,
           Word_Count_Limit         := "DEBOUNCER OLD".B6_2_Slat_3_InFeed.Word_Count_Limit,
           Word_Count               := #INT_TO_HMIWORD);

      L     #INT_TO_HMIWORD; 
      T     "HMI_DB".CONV_3_COUNT; 

M440: NOP   0; 

      AN    "A 44.0"; 
      FP    "DEBOUNCER OLD".B6_2_Slat_3_InFeed.Rising_Pulse_8; 
      R     "DEBOUNCER OLD".B6_2_Slat_3_InFeed.Count_Error; 

NETWORK
TITLE =Packet Counter - Collator Conveyor 4

      A     "A 44.3"; 
      JNB   M443; 

      L     "HMI_DB".CONVEYOR_MAXCOUNT_L; 
      T     "DEBOUNCER OLD".B6_7_Conv_4_InFeed.Word_Count_Limit; 
//;
      L     "HMI_DB".CONV_4_COUNT; 
      T     #INT_TO_HMIWORD; 

      CALL "DE-BOUNCER OLD" (
           Bit_0                    := "B 6.7",
           Bit_1                    := "B 7.0",
           Transfer_Start           := "M 31.6",
           Preset_mS                := 500,
           Debounce_mS              := "MW 176",
           Plc_Scan_mS              := "DB UTILITY".Scan_Cycle_Previous,
           Rising_Pulse_1           := "DEBOUNCER OLD".B6_7_Conv_4_InFeed.Rising_Pulse_1,
           Rising_Pulse_2           := "DEBOUNCER OLD".B6_7_Conv_4_InFeed.Rising_Pulse_2,
           Rising_Pulse_3           := "DEBOUNCER OLD".B6_7_Conv_4_InFeed.Rising_Pulse_3,
           Rising_Pulse_4           := "DEBOUNCER OLD".B6_7_Conv_4_InFeed.Rising_Pulse_4,
           Rising_Pulse_5           := "DEBOUNCER OLD".B6_7_Conv_4_InFeed.Rising_Pulse_5,
           Rising_Pulse_6           := "DEBOUNCER OLD".B6_7_Conv_4_InFeed.Rising_Pulse_6,
           Rising_Pulse_7           := "DEBOUNCER OLD".B6_7_Conv_4_InFeed.Rising_Pulse_7,
           Rising_Pulse_8           := "DEBOUNCER OLD".B6_7_Conv_4_InFeed.Rising_Pulse_8,
           Memory_Bit_1             := "DEBOUNCER OLD".B6_7_Conv_4_InFeed.Bit_0_FrontEnd,
           Memory_Bit_2             := "DEBOUNCER OLD".B6_7_Conv_4_InFeed.Bit_1_FrontEnd,
           Memory_Bit_3             := "DEBOUNCER OLD".B6_7_Conv_4_InFeed.Bit_0_RearEnd,
           Memory_Bit_4             := "DEBOUNCER OLD".B6_7_Conv_4_InFeed.Bit_1_RearEnd,
           Memory_Bit_5             := "DEBOUNCER OLD".B6_7_Conv_4_InFeed.Packet_Exiting,
           Memory_Bit_6             := "DEBOUNCER OLD".B6_7_Conv_4_InFeed.Count_Error,
           Spare_1                  := "DEBOUNCER OLD".B6_7_Conv_4_InFeed.Sens_Error,
           Spare_2                  := "DEBOUNCER OLD".B6_7_Conv_4_InFeed.FirstScan_Init_Done,
           Word_Buffer_1            := "DEBOUNCER OLD".B6_7_Conv_4_InFeed.Bit_0_ON_Time,
           Word_Buffer_2            := "DEBOUNCER OLD".B6_7_Conv_4_InFeed.Bit_1_ON_Time,
           Word_Result              := "DEBOUNCER OLD".B6_7_Conv_4_InFeed.Word_Count_Result,
           Word_Count_Limit         := "DEBOUNCER OLD".B6_7_Conv_4_InFeed.Word_Count_Limit,
           Word_Count               := #INT_TO_HMIWORD);

      L     #INT_TO_HMIWORD; 
      T     "HMI_DB".CONV_4_COUNT; 

M443: NOP   0; 
//;  Count Down Re-Arm - Exit Sens Clear >= 300mS During Transfer
      AN    "B 7.0"; 
      A     "M 31.6"; 
      L     S5T#300MS; 
      SD    T    105; 
      A     T    105; 
      R     "DEBOUNCER OLD".B6_7_Conv_4_InFeed.Count_Error; // Count Done Latch - Re-Arm

      AN    "A 44.3"; 
      FP    "DEBOUNCER OLD".B6_7_Conv_4_InFeed.Rising_Pulse_8; 
      R     "DEBOUNCER OLD".B6_7_Conv_4_InFeed.Count_Error; 
      JNB   TEST; 

//   L     DB4.DBD   34
//   L     "MW 350"
//    <>R   
//    TAK   
//    T     "MW 350"

      L     MW   280; 
      T     MW   282; 

TEST: NOP   0; 

NETWORK
TITLE =Packet Counter Call Hold - Conveyor 5

      A     "A 45.0"; 
      L     S5T#1S; 
      SF    "Timer 90"; 
//;
      A     "Timer 90"; 
      =     "M 143.0"; 

NETWORK
TITLE =Packet Counter - Conv 5 Counting Conditions

      A     "B 7.0"; 
      A     "M 35.1"; // Feeding
      AN    "M 35.2"; // Feeding End
      =     #BIT0_5_COUNT_UP; // Count Up
//;
      A     "B 7.1"; 
      A     "M 35.3"; // Delivering
      AN    "M 35.4"; // Delivering End
      =     #BIT1_5_COUNT_DOWN; // Count Down
NETWORK
TITLE =Packet Counter - Link Conveyor  5 (End Sensor On When Full)

      A     "M 143.0"; 
      JNB   M450; 

      L     "HMI_DB".CONVEYOR_MAXCOUNT_L; 
      T     "DEBOUNCER OLD".B7_0_Conv_5_InFeed.Word_Count_Limit; 
//;
      L     "HMI_DB".CONV_5_COUNT; 
      T     #INT_TO_HMIWORD; 

      CALL "DE-BOUNCER OLD" (
           Bit_0                    := #BIT0_5_COUNT_UP,// Count Up
           Bit_1                    := #BIT1_5_COUNT_DOWN,// Count Down
           Transfer_Start           := "M 35.3",
           Preset_mS                := 500,
           Debounce_mS              := "MW 176",
           Plc_Scan_mS              := "DB UTILITY".Scan_Cycle_Previous,
           Rising_Pulse_1           := "DEBOUNCER OLD".B7_0_Conv_5_InFeed.Rising_Pulse_1,
           Rising_Pulse_2           := "DEBOUNCER OLD".B7_0_Conv_5_InFeed.Rising_Pulse_2,
           Rising_Pulse_3           := "DEBOUNCER OLD".B7_0_Conv_5_InFeed.Rising_Pulse_3,
           Rising_Pulse_4           := "DEBOUNCER OLD".B7_0_Conv_5_InFeed.Rising_Pulse_4,
           Rising_Pulse_5           := "DEBOUNCER OLD".B7_0_Conv_5_InFeed.Rising_Pulse_5,
           Rising_Pulse_6           := "DEBOUNCER OLD".B7_0_Conv_5_InFeed.Rising_Pulse_6,
           Rising_Pulse_7           := "DEBOUNCER OLD".B7_0_Conv_5_InFeed.Rising_Pulse_7,
           Rising_Pulse_8           := "DEBOUNCER OLD".B7_0_Conv_5_InFeed.Rising_Pulse_8,
           Memory_Bit_1             := "DEBOUNCER OLD".B7_0_Conv_5_InFeed.Bit_0_FrontEnd,
           Memory_Bit_2             := "DEBOUNCER OLD".B7_0_Conv_5_InFeed.Bit_1_FrontEnd,
           Memory_Bit_3             := "DEBOUNCER OLD".B7_0_Conv_5_InFeed.Bit_0_RearEnd,
           Memory_Bit_4             := "DEBOUNCER OLD".B7_0_Conv_5_InFeed.Bit_1_RearEnd,
           Memory_Bit_5             := "DEBOUNCER OLD".B7_0_Conv_5_InFeed.Packet_Exiting,
           Memory_Bit_6             := "DEBOUNCER OLD".B7_0_Conv_5_InFeed.Count_Error,
           Spare_1                  := "DEBOUNCER OLD".B7_0_Conv_5_InFeed.Sens_Error,
           Spare_2                  := "DEBOUNCER OLD".B7_0_Conv_5_InFeed.FirstScan_Init_Done,
           Word_Buffer_1            := "DEBOUNCER OLD".B7_0_Conv_5_InFeed.Bit_0_ON_Time,
           Word_Buffer_2            := "DEBOUNCER OLD".B7_0_Conv_5_InFeed.Bit_1_ON_Time,
           Word_Result              := "DEBOUNCER OLD".B7_0_Conv_5_InFeed.Word_Count_Result,
           Word_Count_Limit         := "DEBOUNCER OLD".B7_0_Conv_5_InFeed.Word_Count_Limit,
           Word_Count               := #INT_TO_HMIWORD);

      L     #INT_TO_HMIWORD; 
      T     "HMI_DB".CONV_5_COUNT; 

M450: NOP   0; 
//;  Count Down Re-Arm - Exit Sens Clear >= 300mS During Transfer
      AN    #BIT1_5_COUNT_DOWN; 
      A     "M 35.3"; 
      L     S5T#300MS; 
      SD    T    106; 
      A     T    106; 
      R     "DEBOUNCER OLD".B7_0_Conv_5_InFeed.Count_Error; // Count Done Latch - Re-Arm

      AN    "M 143.0"; 
      FP    "DEBOUNCER OLD".B7_0_Conv_5_InFeed.Rising_Pulse_8; 
      R     "DEBOUNCER OLD".B7_0_Conv_5_InFeed.Count_Error; 

NETWORK
TITLE =Packet Counter Call Hold - Conveyor 6

      A     "A 45.3"; 
      L     S5T#1S; 
      SF    "Timer 91"; 
//;
      A     "Timer 91"; 
      =     "M 143.1"; 

NETWORK
TITLE =Packet Counter - Conv 6 Counting Conditions

      A     "B 7.1"; 
      A     "M 39.1"; // Feeding
      AN    "M 39.2"; // Feeding End
      =     #BIT0_6_COUNT_UP; // Count Up
//;
      A     "B 7.3"; 
      A     "M 39.4"; // Delivering
      AN    "M 39.5"; // Delivering End
      =     #BIT1_6_COUNT_DOWN; // Count Down
NETWORK
TITLE =Packet Counter - Delivery Conveyor 6 (End Sensor On When Full)

      A     "M 143.1"; 
      JNB   M453; 

      L     "HMI_DB".CONVEYOR_MAXCOUNT_L; 
      T     "DEBOUNCER OLD".B7_1_Conv_6_InFeed.Word_Count_Limit; 
//;
      L     "HMI_DB".CONV_6_COUNT; 
      T     #INT_TO_HMIWORD; 

      CALL "DE-BOUNCER OLD" (
           Bit_0                    := #BIT0_6_COUNT_UP,// Count Up
           Bit_1                    := #BIT1_6_COUNT_DOWN,// Count Down
           Transfer_Start           := "M 38.5",
           Preset_mS                := 500,
           Debounce_mS              := "MW 176",
           Plc_Scan_mS              := "DB UTILITY".Scan_Cycle_Previous,
           Rising_Pulse_1           := "DEBOUNCER OLD".B7_1_Conv_6_InFeed.Rising_Pulse_1,
           Rising_Pulse_2           := "DEBOUNCER OLD".B7_1_Conv_6_InFeed.Rising_Pulse_2,
           Rising_Pulse_3           := "DEBOUNCER OLD".B7_1_Conv_6_InFeed.Rising_Pulse_3,
           Rising_Pulse_4           := "DEBOUNCER OLD".B7_1_Conv_6_InFeed.Rising_Pulse_4,
           Rising_Pulse_5           := "DEBOUNCER OLD".B7_1_Conv_6_InFeed.Rising_Pulse_5,
           Rising_Pulse_6           := "DEBOUNCER OLD".B7_1_Conv_6_InFeed.Rising_Pulse_6,
           Rising_Pulse_7           := "DEBOUNCER OLD".B7_1_Conv_6_InFeed.Rising_Pulse_7,
           Rising_Pulse_8           := "DEBOUNCER OLD".B7_1_Conv_6_InFeed.Rising_Pulse_8,
           Memory_Bit_1             := "DEBOUNCER OLD".B7_1_Conv_6_InFeed.Bit_0_FrontEnd,
           Memory_Bit_2             := "DEBOUNCER OLD".B7_1_Conv_6_InFeed.Bit_1_FrontEnd,
           Memory_Bit_3             := "DEBOUNCER OLD".B7_1_Conv_6_InFeed.Bit_0_RearEnd,
           Memory_Bit_4             := "DEBOUNCER OLD".B7_1_Conv_6_InFeed.Bit_1_RearEnd,
           Memory_Bit_5             := "DEBOUNCER OLD".B7_1_Conv_6_InFeed.Packet_Exiting,
           Memory_Bit_6             := "DEBOUNCER OLD".B7_1_Conv_6_InFeed.Count_Error,
           Spare_1                  := "DEBOUNCER OLD".B7_1_Conv_6_InFeed.Sens_Error,
           Spare_2                  := "DEBOUNCER OLD".B7_1_Conv_6_InFeed.FirstScan_Init_Done,
           Word_Buffer_1            := "DEBOUNCER OLD".B7_1_Conv_6_InFeed.Bit_0_ON_Time,
           Word_Buffer_2            := "DEBOUNCER OLD".B7_1_Conv_6_InFeed.Bit_1_ON_Time,
           Word_Result              := "DEBOUNCER OLD".B7_1_Conv_6_InFeed.Word_Count_Result,
           Word_Count_Limit         := "DEBOUNCER OLD".B7_1_Conv_6_InFeed.Word_Count_Limit,
           Word_Count               := #INT_TO_HMIWORD);

      L     #INT_TO_HMIWORD; 
      T     "HMI_DB".CONV_6_COUNT; 

M453: NOP   0; 
//;  Count Down Re-Arm - Exit Sens Clear >= 300mS During Transfer
      AN    #BIT1_6_COUNT_DOWN; 
      A     "M 38.5"; 
      L     S5T#300MS; 
      SD    T    107; 
      A     T    107; 
      R     "DEBOUNCER OLD".B7_1_Conv_6_InFeed.Count_Error; // Count Done Latch - Re-Arm
NETWORK
TITLE =Packet Counter - Flipper

      L     0; 
      A     "M 43.4"; 
      JCN   M434; 
      L     1; 

M434: T     "HMI_DB".FLIPPER_PACK_PRESENCE; 

NETWORK
TITLE =Packet Counter - TurnTable

      L     0; 
      A     "M 47.4"; 
      JCN   M474; 
      L     1; 

M474: T     "HMI_DB".TURNTABLE_PACK_PRESENCE; 

NETWORK
TITLE =Packet Counter - Conveyor 9 (Pusher 2)

      L     0; 
      A     "M 51.4"; 
      JCN   M514; 
      L     1; 

M514: T     "HMI_DB".ROLLER_PACK_PRESENCE; 

NETWORK
TITLE =Packet Counter - Pusher 2

      L     0; 
      A     "M 51.5"; 
      JCN   M515; 
      L     1; 

M515: T     "HMI_DB".PUSHER_PACK_PRESENCE; 

NETWORK
TITLE =Packet Counter - Pivot Conveyor 10 

      A     "A 48.0"; 
      JNB   M480; 

      L     "HMI_DB".CONVEYOR_MAXCOUNT_W; 
      T     "DEBOUNCER OLD".B10_4_Conv_10_InFeed.Word_Count_Limit; 
//;
      L     "HMI_DB".CONV_10_COUNT; 
      T     #INT_TO_HMIWORD; 

      CALL "DE-BOUNCER OLD" (
           Bit_0                    := "B 10.4",// InFeed Sens - Count UP
           Bit_1                    := "B 10.6",// Exit Sens - Count DN
           Transfer_Start           := "M 55.5",
           Preset_mS                := 500,
           Debounce_mS              := "MW 178",
           Plc_Scan_mS              := "DB UTILITY".Scan_Cycle_Previous,
           Rising_Pulse_1           := "DEBOUNCER OLD".B10_4_Conv_10_InFeed.Rising_Pulse_1,
           Rising_Pulse_2           := "DEBOUNCER OLD".B10_4_Conv_10_InFeed.Rising_Pulse_2,
           Rising_Pulse_3           := "DEBOUNCER OLD".B10_4_Conv_10_InFeed.Rising_Pulse_3,
           Rising_Pulse_4           := "DEBOUNCER OLD".B10_4_Conv_10_InFeed.Rising_Pulse_4,
           Rising_Pulse_5           := "DEBOUNCER OLD".B10_4_Conv_10_InFeed.Rising_Pulse_5,
           Rising_Pulse_6           := "DEBOUNCER OLD".B10_4_Conv_10_InFeed.Rising_Pulse_6,
           Rising_Pulse_7           := "DEBOUNCER OLD".B10_4_Conv_10_InFeed.Rising_Pulse_7,
           Rising_Pulse_8           := "DEBOUNCER OLD".B10_4_Conv_10_InFeed.Rising_Pulse_8,
           Memory_Bit_1             := "DEBOUNCER OLD".B10_4_Conv_10_InFeed.Bit_0_FrontEnd,
           Memory_Bit_2             := "DEBOUNCER OLD".B10_4_Conv_10_InFeed.Bit_1_FrontEnd,
           Memory_Bit_3             := "DEBOUNCER OLD".B10_4_Conv_10_InFeed.Bit_0_RearEnd,
           Memory_Bit_4             := "DEBOUNCER OLD".B10_4_Conv_10_InFeed.Bit_1_RearEnd,
           Memory_Bit_5             := "DEBOUNCER OLD".B10_4_Conv_10_InFeed.Packet_Exiting,
           Memory_Bit_6             := "DEBOUNCER OLD".B10_4_Conv_10_InFeed.Count_Error,
           Spare_1                  := "DEBOUNCER OLD".B10_4_Conv_10_InFeed.Sens_Error,
           Spare_2                  := "DEBOUNCER OLD".B10_4_Conv_10_InFeed.FirstScan_Init_Done,
           Word_Buffer_1            := "DEBOUNCER OLD".B10_4_Conv_10_InFeed.Bit_0_ON_Time,
           Word_Buffer_2            := "DEBOUNCER OLD".B10_4_Conv_10_InFeed.Bit_1_ON_Time,
           Word_Result              := "DEBOUNCER OLD".B10_4_Conv_10_InFeed.Word_Count_Result,
           Word_Count_Limit         := "DEBOUNCER OLD".B10_4_Conv_10_InFeed.Word_Count_Limit,
           Word_Count               := #INT_TO_HMIWORD);

      L     #INT_TO_HMIWORD; 
      T     "HMI_DB".CONV_10_COUNT; 

M480: NOP   0; 
//;  Count Down Re-Arm - Exit Sens Clear >= 300mS During Transfer
      AN    "B 10.6"; 
      A     "M 55.5"; 
      L     S5T#300MS; 
      SD    T    108; 
      A     T    108; 
      R     "DEBOUNCER OLD".B10_4_Conv_10_InFeed.Count_Error; // Count Done Latch - Re-Arm

      AN    "A 48.0"; 
      FP    "DEBOUNCER OLD".B10_4_Conv_10_InFeed.Rising_Pulse_8; 
      R     "DEBOUNCER OLD".B10_4_Conv_10_InFeed.Count_Error; 

NETWORK
TITLE =Packet Counter Call Hold - Conveyor 11

      A     "A 48.3"; 
      L     S5T#1S; 
      SF    "Timer 92"; 
//;
      A     "Timer 92"; 
      =     "M 143.2"; 

NETWORK
TITLE =Packet Counter - Conv 11 Counting Conditions

      A     "B 10.6"; 
      A     "M 59.1"; // Feeding
      AN    "M 59.2"; // Feeding End
      A     "P 15.1"; // Pivot Low Position
      =     #BIT0_11_COUNT_UP; // Count Up
//;
      A     "B 10.7"; 
      A     "M 59.3"; // Delivering
      AN    "M 59.4"; // Delivering End
      =     #BIT1_11_COUNT_DOWN; // Count Down
NETWORK
TITLE =Packet Counter - Cumul Conveyor 11 (End Sensor On When Full)

      A     "M 143.2"; 
      JNB   M483; 

      L     "HMI_DB".CONVEYOR_MAXCOUNT_W; 
      T     "DEBOUNCER OLD".B10_6_Conv_11_InFeed.Word_Count_Limit; 
//;
