      AN    "B 11.1"; 
      L     S5T#30S; 
      SD    "Timer 80"; 
      A     "Timer 80"; 
      FP    "HMI DB NEW".FP131; 
      JNB   F676; 
      L     0; 
      T     "HMI_DB".CONV_13_COUNT; // FC8 Takes Over 0 on Next Call
F676: NOP   0; 
      A     "M 79.4"; 
      JNB   F794; 
      L     0; 
      T     "HMI_DB".CONV_21_COUNT; // FC8 Takes Over 0 on Next Call
F794: NOP   0; 
      A     "M 83.4"; 
      JNB   F834; 
      L     0; 
      T     "HMI_DB".CONV_22_COUNT; // FC8 Takes Over 0 on Next Call
F834: NOP   0; 
