//       Bit_1               :="B 7.3"    // C6 Exit Sens
//       Transfer_Start      :="M 38.5"   // C6 Delivery Step
//       Space_DX_mS         :=600
//       ReSample_DX         :=85         // % of Packet
//       Conveyor_Type       :=2          // Delivery Type
//       Preset_MIN_mS       :=500
