           Bit_0                    := #BIT0,
           Bit_1                    := "B 15.7",
           Transfer_Start           := #XFER,
           Error_Reset              := "M 9.1",
           Space_DX_mS              := 600,
           ReSample_DX              := 85,
           Conveyor_Type            := 2,
           Preset_MIN_mS            := 300,
           LowSpd_Dimension_mS      := 0,
           HighSpd_Dimension_mS     := #DIM_237,
           Plc_Scan_mS              := "DB UTILITY".Scan_Cycle_Previous,
           Q_Error                  := #ERROR,
           Word_Count               := "HMI_DB".CONV_23_COUNT,
           IO_DB                    := "DEBOUNCER COUNTER DB".Conveyor_C23_Delivery);
M540: NOP   0; 
NETWORK
TITLE =HMI Packet Counters Reset (Same Conditions as FC1206)

      A     "M 10.2"; 
      JNB   F102; 
      L     0; 
      T     "HMI_DB".CONV_3_COUNT; // FC8 Takes Over 0 on Next Call
F102: NOP   0; 
      A     "M 31.7"; 
      JNB   F317; 
      L     0; 
      T     "HMI_DB".CONV_4_COUNT; // FC8 Takes Over 0 on Next Call
F317: NOP   0; 
      A     "M 35.4"; 
      JNB   F354; 
      L     0; 
      T     "HMI_DB".CONV_5_COUNT; // FC8 Takes Over 0 on Next Call
F354: NOP   0; 
      A     "M 35.3"; 
      FP    "FP 154.4"; 
      JNB   F396; 
      L     0; 
      T     "HMI_DB".CONV_6_COUNT; // FC8 Takes Over 0 on Next Call
F396: NOP   0; 
      A     "M 55.6"; 
      JNB   F556; 
      L     0; 
      T     "HMI_DB".CONV_10_COUNT; // FC8 Takes Over 0 on Next Call
F556: NOP   0; 
