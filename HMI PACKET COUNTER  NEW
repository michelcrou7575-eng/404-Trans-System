M450: NOP   0; 
NETWORK
TITLE =Packet Counter - Delivery Conveyor 6

      A     "A 45.3"; 
      L     S5T#1S; 
      SF    "Timer 121"; // Call Hold 1s
      A     "Timer 121"; 
      =     "M 143.1"; 
      JNB   M453; 
      L     "HMI_DB".CONVEYOR_MAXCOUNT_L; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C6_Delivery.Maximum_Count; 
      A     "B 7.1"; 
      A     "M 39.1"; 
      AN    "M 39.2"; 
      =     #BIT0; 
      A     "M 39.4"; 
      AN    "M 39.5"; 
      =     #XFER; 
      CALL "DE-BOUNCER / COUNTER" (
           Bit_0                    := #BIT0,
           Bit_1                    := "B 7.3",
           Transfer_Start           := #XFER,
           Error_Reset              := "M 9.1",
           Space_DX_mS              := 600,
           ReSample_DX              := 85,
           Conveyor_Type            := 2,
           Preset_MIN_mS            := 500,
           LowSpd_Dimension_mS      := 0,
           HighSpd_Dimension_mS     := "HOUSE_KEEPING DB".C4_Packet_Length_mS,
           Plc_Scan_mS              := "DB UTILITY".Scan_Cycle_Previous,
           Q_Error                  := #ERROR,
           Word_Count               := "HMI_DB".CONV_6_COUNT,
           IO_DB                    := "DEBOUNCER COUNTER DB".Conveyor_C6_Delivery);
M453: NOP   0; 
NETWORK
TITLE =Packet Presence - Flipper / TurnTable / Conveyor 9 / Pusher 2

      L     0; 
      A     "M 43.4"; 
      JCN   M434; 
      L     1; 
M434: T     "HMI_DB".FLIPPER_PACK_PRESENCE; 
      T     "HMI DB NEW".FLIPPER_PACK_PRESENCE; 
      L     0; 
      A     "M 47.4"; 
      JCN   M474; 
      L     1; 
M474: T     "HMI_DB".TURNTABLE_PACK_PRESENCE; 
      T     "HMI DB NEW".TURNTABLE_PACK_PRESENCE; 
      L     0; 
      A     "M 51.4"; 
      JCN   M514; 
      L     1; 
M514: T     "HMI_DB".ROLLER_PACK_PRESENCE; 
      T     "HMI DB NEW".ROLLER_PACK_PRESENCE; 
      L     0; 
      A     "M 51.5"; 
      JCN   M515; 
      L     1; 
M515: T     "HMI_DB".PUSHER_PACK_PRESENCE; 
      T     "HMI DB NEW".PUSHER_PACK_PRESENCE; 
NETWORK
TITLE =Packet Counter - Pivot Conveyor 10

      A     "A 48.0"; 
      L     S5T#1S; 
      SF    T    134; // Call Hold 1s
      A     T    134; 
      JNB   M480; 
      L     "HMI_DB".CONVEYOR_MAXCOUNT_W; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C10_Collator.Maximum_Count; 
      A     "B 10.4"; 
      =     #BIT0; 
      A     "M 55.5"; 
      AN    "M 55.6"; 
      =     #XFER; 
      CALL "DE-BOUNCER / COUNTER" (
           Bit_0                    := #BIT0,
           Bit_1                    := "B 10.6",
           Transfer_Start           := #XFER,
           Error_Reset              := "M 9.1",
           Space_DX_mS              := 600,
           ReSample_DX              := 85,
           Conveyor_Type            := 1,
           Preset_MIN_mS            := 500,
           LowSpd_Dimension_mS      := 0,
           HighSpd_Dimension_mS     := #DIM_31,
           Plc_Scan_mS              := "DB UTILITY".Scan_Cycle_Previous,
           Q_Error                  := #ERROR,
           Word_Count               := "HMI_DB".CONV_10_COUNT,
           IO_DB                    := "DEBOUNCER COUNTER DB".Conveyor_C10_Collator);
M480: NOP   0; 
NETWORK
TITLE =Packet Counter - Link Conveyor 11 (Low)

      A     "A 48.3"; 
      L     S5T#1S; 
      SF    "Timer 122"; // Call Hold 1s
      A     "Timer 122"; 
      =     "M 143.2"; 
      JNB   M483; 
      L     "HMI_DB".CONVEYOR_MAXCOUNT_W; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C11_Link.Maximum_Count; 
      A     "B 10.6"; 
      A     "M 59.1"; 
      AN    "M 59.2"; 
      A     "P 15.1"; 
      =     #BIT0; 
      A     "M 59.3"; 
      AN    "M 59.4"; 
      =     #XFER; 
      CALL "DE-BOUNCER / COUNTER" (
           Bit_0                    := #BIT0,
           Bit_1                    := "B 10.7",
           Transfer_Start           := #XFER,
           Error_Reset              := "M 9.1",
           Space_DX_mS              := 600,
           ReSample_DX              := 85,
           Conveyor_Type            := 3,
           Preset_MIN_mS            := 300,
           LowSpd_Dimension_mS      := 0,
           HighSpd_Dimension_mS     := #DIM_31,
           Plc_Scan_mS              := "DB UTILITY".Scan_Cycle_Previous,
           Q_Error                  := #ERROR,
           Word_Count               := "HMI_DB".CONV_11_COUNT,
           IO_DB                    := "DEBOUNCER COUNTER DB".Conveyor_C11_Link);
M483: NOP   0; 
NETWORK
TITLE =Packet Counter - Link Conveyor 12 (Low)

      A     "A 48.6"; 
      L     S5T#1S; 
      SF    "Timer 123"; // Call Hold 1s
      A     "Timer 123"; 
      =     "M 143.3"; 
      JNB   M486; 
      L     "HMI_DB".CONVEYOR_MAXCOUNT_W; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C12_Link.Maximum_Count; 
      A     "B 10.7"; 
      A     "M 63.1"; 
      AN    "M 63.2"; 
      =     #BIT0; 
      A     "M 63.3"; 
      AN    "M 63.4"; 
      =     #XFER; 
      CALL "DE-BOUNCER / COUNTER" (
           Bit_0                    := #BIT0,
           Bit_1                    := "B 11.0",
           Transfer_Start           := #XFER,
           Error_Reset              := "M 9.1",
           Space_DX_mS              := 600,
           ReSample_DX              := 85,
           Conveyor_Type            := 3,
           Preset_MIN_mS            := 300,
           LowSpd_Dimension_mS      := 0,
           HighSpd_Dimension_mS     := #DIM_31,
           Plc_Scan_mS              := "DB UTILITY".Scan_Cycle_Previous,
           Q_Error                  := #ERROR,
           Word_Count               := "HMI_DB".CONV_12_COUNT,
           IO_DB                    := "DEBOUNCER COUNTER DB".Conveyor_C12_Link);
M486: NOP   0; 
NETWORK
TITLE =Packet Counter - Delivery Conveyor 13 (Low)

      A     "A 49.0"; 
      L     S5T#1S; 
      SF    "Timer 124"; // Call Hold 1s
      A     "Timer 124"; 
      =     "M 143.4"; 
      JNB   M490; 
      L     "HMI_DB".CONVEYOR_MAXCOUNT_W; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C13_Delivery.Maximum_Count; 
      A     "B 11.0"; 
      A     "M 67.1"; 
      AN    "M 67.2"; 
      =     #BIT0; 
      A     "M 67.4"; 
      AN    "M 67.5"; 
      =     #XFER; 
      CALL "DE-BOUNCER / COUNTER" (
           Bit_0                    := #BIT0,
           Bit_1                    := "B 11.2",
           Transfer_Start           := #XFER,
           Error_Reset              := "M 9.1",
           Space_DX_mS              := 600,
           ReSample_DX              := 85,
           Conveyor_Type            := 2,
           Preset_MIN_mS            := 300,
           LowSpd_Dimension_mS      := 0,
           HighSpd_Dimension_mS     := #DIM_237,
           Plc_Scan_mS              := "DB UTILITY".Scan_Cycle_Previous,
           Q_Error                  := #ERROR,
           Word_Count               := "HMI_DB".CONV_13_COUNT,
           IO_DB                    := "DEBOUNCER COUNTER DB".Conveyor_C13_Delivery);
M490: NOP   0; 
NETWORK
TITLE =Packet Counter - Link Conveyor 21 (High)

      A     "A 53.4"; 
      L     S5T#1S; 
      SF    "Timer 125"; // Call Hold 1s
      A     "Timer 125"; 
      =     "M 143.5"; 
      JNB   M534; 
      L     "HMI_DB".CONVEYOR_MAXCOUNT_W; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C21_Link.Maximum_Count; 
      A     "B 10.6"; 
      A     "M 79.1"; 
      AN    "M 79.2"; 
      A     "P 15.0"; 
      =     #BIT0; 
      A     "M 79.3"; 
      AN    "M 79.4"; 
      =     #XFER; 
      CALL "DE-BOUNCER / COUNTER" (
           Bit_0                    := #BIT0,
           Bit_1                    := "B 15.4",
           Transfer_Start           := #XFER,
           Error_Reset              := "M 9.1",
           Space_DX_mS              := 600,
           ReSample_DX              := 85,
           Conveyor_Type            := 3,
           Preset_MIN_mS            := 300,
           LowSpd_Dimension_mS      := 0,
           HighSpd_Dimension_mS     := #DIM_31,
           Plc_Scan_mS              := "DB UTILITY".Scan_Cycle_Previous,
           Q_Error                  := #ERROR,
           Word_Count               := "HMI_DB".CONV_21_COUNT,
           IO_DB                    := "DEBOUNCER COUNTER DB".Conveyor_C21_Link);
M534: NOP   0; 
NETWORK
TITLE =Packet Counter - Link Conveyor 22 (High)

      A     "A 53.6"; 
      L     S5T#1S; 
      SF    "Timer 126"; // Call Hold 1s
      A     "Timer 126"; 
      =     "M 143.6"; 
      JNB   M536; 
      L     "HMI_DB".CONVEYOR_MAXCOUNT_W; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C22_Link.Maximum_Count; 
      A     "B 15.4"; 
      A     "M 83.1"; 
      AN    "M 83.2"; 
      =     #BIT0; 
      A     "M 83.3"; 
      AN    "M 83.4"; 
      =     #XFER; 
      CALL "DE-BOUNCER / COUNTER" (
           Bit_0                    := #BIT0,
           Bit_1                    := "B 15.5",
           Transfer_Start           := #XFER,
           Error_Reset              := "M 9.1",
           Space_DX_mS              := 600,
           ReSample_DX              := 85,
           Conveyor_Type            := 3,
           Preset_MIN_mS            := 300,
           LowSpd_Dimension_mS      := 0,
           HighSpd_Dimension_mS     := #DIM_31,
           Plc_Scan_mS              := "DB UTILITY".Scan_Cycle_Previous,
           Q_Error                  := #ERROR,
           Word_Count               := "HMI_DB".CONV_22_COUNT,
           IO_DB                    := "DEBOUNCER COUNTER DB".Conveyor_C22_Link);
M536: NOP   0; 
NETWORK
TITLE =Packet Counter - Delivery Conveyor 23 (High)

      A     "A 54.0"; 
      L     S5T#1S; 
      SF    "Timer 127"; // Call Hold 1s
      A     "Timer 127"; 
      =     "M 143.7"; 
      JNB   M540; 
      L     "HMI_DB".CONVEYOR_MAXCOUNT_W; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C23_Delivery.Maximum_Count; 
      A     "B 15.5"; 
      A     "M 87.1"; 
      AN    "M 87.2"; 
      =     #BIT0; 
      A     "M 87.4"; 
      AN    "M 87.5"; 
