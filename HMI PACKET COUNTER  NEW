TITLE =Packet Counter Call Hold - Conveyor 11
//CONVEYOR 11
//31.0 m/min for Filling and Transfering
      A     "A 48.3"; 
      L     S5T#1S; 
      SF    "Timer 122"; 
//;
      A     "Timer 122"; 
      =     "M 143.2"; 
NETWORK
TITLE =Packet Counter - Cumul Conveyor 11 (End Sensor On When Full)

      A     "M 143.2"; 
      JNB   M483; 

      L     "HMI_DB".CONVEYOR_MAXCOUNT_W; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C11_Link.Maximum_Count; 

//   CALL  "DE-BOUNCER / COUNTER"
//       Bit_0               :="B 10.6"   // C10 Exit Sens
//       Bit_1               :="B 10.7"   // C11 Exit Sens
//       Transfer_Start      :="M 59.3"   // Transfering Step
//       Space_DX_mS         :=600
