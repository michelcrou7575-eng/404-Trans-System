      L     "DEBOUNCER COUNTER DB".Conveyor_C23_Delivery.Count_Result; 
      T     "HMI DB NEW".CONV_23_COUNT; 

M540: NOP   0; 
NETWORK
TITLE =HMI Packet Counters Reset

      A     "M 10.2"; 
      JNB   F102; 
      L     0; 
      T     "HMI DB NEW".CONV_3_COUNT; 

F102: NOP   0; 

      A     "M 31.7"; 
      JNB   F317; 
      L     0; 
      T     "HMI DB NEW".CONV_4_COUNT; 

F317: NOP   0; 

