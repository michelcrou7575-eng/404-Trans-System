      A     "M 51.4"; 
      JCN   M514; 
      L     1; 

M514: T     "HMI DB NEW".ROLLER_PACK_PRESENCE; 

NETWORK
TITLE =Packet Counter - Pusher 2

      L     0; 
      A     "M 51.5"; 
      JCN   M515; 
      L     1; 

M515: T     "HMI DB NEW".PUSHER_PACK_PRESENCE; 

NETWORK
TITLE =Packet Counter - Pivot Conveyor 10 
//CONVEYOR 10
//27.0 m/min for Collating & 31.0 m/min for Transfering
      A     "A 48.0"; 
      FP    "FP 226.0"; 
      JNB   NP10; 
      L     "COLLATORS DB".Packet_Width_C10_mS; 
      L     "MW 354"; 
      <>R   ; 
      TAK   ; 
      T     "MW 354"; // Low Speed Packet Width [mS]
      L     2; 
      /I    ; 
      T     "MW 356"; // High Speed Packet Width [mS]

NP10: NOP   0; 

      A     "A 48.0"; 
      JNB   M480; 

      L     "HMI_DB".CONVEYOR_MAXCOUNT_W; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C10_Collator.Maximum_Count; 

//    CALL  "DE-BOUNCER / COUNTER"
//       Bit_0               :="B 10.4"   // InFeed Sens - Count UP
//       Bit_1               :="B 10.6"   // Exit Sens - Count DN
//       Transfer_Start      :="M 55.5"   // C10 Transfer Step
