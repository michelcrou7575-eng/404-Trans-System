//       HighSpd_Dimension_mS:="DEBOUNCER COUNTER DB".Conveyor_C4_Collator.Exit_Window_mS    // Length @ High Speed [mS](Actual 31.0 m/min)
//       Plc_Scan_mS         :="DB UTILITY".Scan_Cycle_Previous
//       Q_Error             :=#ERROR
//       IO_DB               :="DEBOUNCER COUNTER DB".Conveyor_C6_Delivery

      L     "DEBOUNCER COUNTER DB".Conveyor_C6_Delivery.Count_Result; 
      T     "HMI DB NEW".CONV_6_COUNT; 

M453: NOP   0; 
NETWORK
TITLE =Packet Counter - Flipper

      L     0; 
      A     "M 43.4"; 
      JCN   M434; 
      L     1; 

M434: T     "HMI DB NEW".FLIPPER_PACK_PRESENCE; 

NETWORK
TITLE =Packet Counter - TurnTable

      L     0; 
      A     "M 47.4"; 
      JCN   M474; 
      L     1; 

M474: T     "HMI DB NEW".TURNTABLE_PACK_PRESENCE; 

NETWORK
