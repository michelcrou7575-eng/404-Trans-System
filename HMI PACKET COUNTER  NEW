//       Q_Error             :=#ERROR
//       IO_DB               :="DEBOUNCER COUNTER DB".Conveyor_C21_Link

      L     "DEBOUNCER COUNTER DB".Conveyor_C21_Link.Count_Result; 
      T     "HMI DB NEW".CONV_21_COUNT; 

M534: NOP   0; 
NETWORK
TITLE =Packet Counter Call Hold - Conveyor 22
//CONVEYOR 22
//31.0 m/min for Filling and Transfering
      A     "A 53.6"; 
      L     S5T#1S; 
      SF    "Timer 126"; 
//;
      A     "Timer 126"; 
      =     "M 143.6"; 
NETWORK
TITLE =Packet Counter - Cumul Conveyor 22 (End Sensor On When Full)

      A     "M 143.6"; 
      JNB   M536; 

      L     "HMI_DB".CONVEYOR_MAXCOUNT_W; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C22_Link.Maximum_Count; 

//   CALL  "DE-BOUNCER / COUNTER"
//       Bit_0               :="B 15.4"   // C21 Exit Sens
//       Bit_1               :="B 15.5"   // C22 Exit Sens
//       Transfer_Start      :="M 83.3"   // C22 Transfering Step
//       Space_DX_mS         :=600
//       ReSample_DX         :=85         // % of Packet
//       Conveyor_Type       :=3          // Link Type
//       Preset_MIN_mS       :=500
//       LowSpd_Dimension_mS :=0
//       HighSpd_Dimension_mS:="DEBOUNCER COUNTER DB".Conveyor_C10_Collator.Exit_Window_mS    // Length @ High Speed [mS](Actual 31.0 m/min)
