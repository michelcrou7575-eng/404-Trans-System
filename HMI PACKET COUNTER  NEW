FUNCTION "HMI PACKET COUNTER  NEW" : VOID
TITLE =HMI Conveyors Display Packet Counter  FC1208
//Replaces FC1206 "HMI PACKET COUNTER OLD" + FC6 - Uses FC8 v0.7 / DB8 / UDT8.
//Counts are kept in "HMI_DB" (read by HMI, LIGHT BAR, C5 Re-Sync), same as
//FC1206, and mirrored to "HMI DB NEW".
//Bit_0 = InFeed (gated like FC1206)  /  Bit_1 = RAW Exit Sensor  /
//Transfer_Start = Transfer Step Active.
VERSION : 0.3


VAR_TEMP
  ERROR : BOOL ;
  BIT0 : BOOL ;	//Count UP Input
  XFER : BOOL ;	//Transfer Active
  DIM_31 : INT ;	//C10 Width @ 31.0 m/min [mS]
  DIM_237 : INT ;	//C10 Width @ 23.7 m/min [mS]
END_VAR
BEGIN
NETWORK
TITLE =Packet Length mm - To Conveyor 4 HMI (as FC1206)

      L     "COLLATORS DB".PacketLength_C4; 
      ITD   ; 
      DTR   ; 
      L     6.673000e+000; 
      *R    ; 
      RND   ; 
      T     "MW 202"; 
NETWORK
TITLE =C10 Packet Width [mS] - Scaled to Link & Delivery Speeds

      L     "COLLATORS DB".Packet_Width_C10_mS; // Measured @ 27.0 m/min
      L     L#27; 
      *D    ; 
      L     L#31; 
      /D    ; 
      T     #DIM_31; // @ 31.0 m/min
      L     "COLLATORS DB".Packet_Width_C10_mS; 
      L     L#270; 
      *D    ; 
      L     L#237; 
      /D    ; 
      T     #DIM_237; // @ 23.7 m/min
NETWORK
TITLE =Packet Counter - Slat Conveyor 3

      A     "A 44.0"; 
      L     S5T#1S; 
      SF    T    118; // Call Hold 1s
      A     T    118; 
      JNB   M440; 
      L     "HMI_DB".CONVEYOR_MAXCOUNT_L; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C3_Slat.Maximum_Count; 
      A     "B 6.2"; 
      =     #BIT0; 
      A     "A 44.0"; 
      =     #XFER; 
      CALL "DE-BOUNCER / COUNTER" (
           Bit_0                    := #BIT0,
           Bit_1                    := "B 6.4",
           Transfer_Start           := #XFER,
           Error_Reset              := "M 9.1",
           Space_DX_mS              := 600,
           ReSample_DX              := 85,
           Conveyor_Type            := 1,
           Preset_MIN_mS            := 500,
           LowSpd_Dimension_mS      := 0,
           HighSpd_Dimension_mS     := 0,
           Plc_Scan_mS              := "DB UTILITY".Scan_Cycle_Previous,
           Q_Error                  := #ERROR,
           Word_Count               := "HMI_DB".CONV_3_COUNT,
           IO_DB                    := "DEBOUNCER COUNTER DB".Conveyor_C3_Slat);
M440: NOP   0; 
NETWORK
TITLE =Packet Counter - Collator Conveyor 4

      A     "A 44.3"; 
      L     S5T#1S; 
      SF    T    119; // Call Hold 1s
      A     T    119; 
      JNB   M443; 
      L     "HMI_DB".CONVEYOR_MAXCOUNT_L; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C4_Collator.Maximum_Count; 
      A     "B 6.7"; 
      =     #BIT0; 
      A     "M 31.6"; 
      AN    "M 31.7"; 
      =     #XFER; 
      CALL "DE-BOUNCER / COUNTER" (
           Bit_0                    := #BIT0,
           Bit_1                    := "B 7.0",
           Transfer_Start           := #XFER,
           Error_Reset              := "M 9.1",
           Space_DX_mS              := 600,
           ReSample_DX              := 85,
           Conveyor_Type            := 1,
           Preset_MIN_mS            := 500,
           LowSpd_Dimension_mS      := 0,
           HighSpd_Dimension_mS     := "HOUSE_KEEPING DB".C4_Packet_Length_mS,
           Plc_Scan_mS              := "DB UTILITY".Scan_Cycle_Previous,
           Q_Error                  := #ERROR,
           Word_Count               := "HMI_DB".CONV_4_COUNT,
           IO_DB                    := "DEBOUNCER COUNTER DB".Conveyor_C4_Collator);
M443: NOP   0; 
NETWORK
TITLE =Packet Counter - Link Conveyor 5

      A     "A 45.0"; 
      L     S5T#1S; 
      SF    "Timer 120"; // Call Hold 1s
      A     "Timer 120"; 
      =     "M 143.0"; 
      JNB   M450; 
      L     "HMI_DB".CONVEYOR_MAXCOUNT_L; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C5_Link.Maximum_Count; 
      A     "B 7.0"; 
      A     "M 35.1"; 
      AN    "M 35.2"; 
      =     #BIT0; 
      A     "M 35.3"; 
      AN    "M 35.4"; 
      =     #XFER; 
      CALL "DE-BOUNCER / COUNTER" (
           Bit_0                    := #BIT0,
           Bit_1                    := "B 7.1",
           Transfer_Start           := #XFER,
           Error_Reset              := "M 9.1",
           Space_DX_mS              := 600,
