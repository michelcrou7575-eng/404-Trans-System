//       HighSpd_Dimension_mS:="DEBOUNCER COUNTER DB".Conveyor_C10_Collator.Exit_Window_mS    // Length @ High Speed [mS](Actual 31.0 m/min)
//       Plc_Scan_mS         :="DB UTILITY".Scan_Cycle_Previous
//       Q_Error             :=#ERROR
//       IO_DB               :="DEBOUNCER COUNTER DB".Conveyor_C11_Link

      L     "DEBOUNCER COUNTER DB".Conveyor_C11_Link.Count_Result; 
      T     "HMI DB NEW".CONV_11_COUNT; 

M483: NOP   0; 
NETWORK
TITLE =Packet Counter Call Hold - Conveyor 12
//CONVEYOR 12
//31.0 m/min for Filling and Transfering
      A     "A 48.6"; 
      L     S5T#1S; 
      SF    "Timer 123"; 
//;
      A     "Timer 123"; 
      =     "M 143.3"; 

NETWORK
TITLE =Packet Counter - Cumul Conveyor 12 (End Sensor On When Full)

      A     "M 143.3"; 
      JNB   M486; 

      L     "HMI_DB".CONVEYOR_MAXCOUNT_W; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C12_Link.Maximum_Count; 

//   CALL  "DE-BOUNCER / COUNTER"
//       Bit_0               :="B 10.7"   // C11 Exit Sens
//       Bit_1               :="B 11.0"   // C12 Exit Sens
//       Transfer_Start      :="M 63.3"   // Transfering Step
//       Space_DX_mS         :=600
//       ReSample_DX         :=85         // % of Packet
//       Conveyor_Type       :=3          // Link Type
//       Preset_MIN_mS       :=500
//       LowSpd_Dimension_mS :=0
//       HighSpd_Dimension_mS:="DEBOUNCER COUNTER DB".Conveyor_C10_Collator.Exit_Window_mS    // Length @ High Speed [mS](Actual 31.0 m/min)
//       Plc_Scan_mS         :="DB UTILITY".Scan_Cycle_Previous
//       Q_Error             :=#ERROR
//       IO_DB               :="DEBOUNCER COUNTER DB".Conveyor_C12_Link

      L     "DEBOUNCER COUNTER DB".Conveyor_C12_Link.Count_Result; 
      T     "HMI DB NEW".CONV_12_COUNT; 

M486: NOP   0; 
NETWORK
TITLE =Packet Counter Call Hold - Conveyor 13
//CONVEYOR 13
//31.0 m/min for Filling  & 23.7 m/min for Delivering
      A     "A 49.0"; 
      L     S5T#1S; 
      SF    "Timer 124"; 
//;
      A     "Timer 124"; 
      =     "M 143.4"; 
NETWORK
TITLE =Packet Counter - Delivery Conveyor 13 (End Sensor On When Full)

      A     "M 143.4"; 
      JNB   M490; 

      L     "HMI_DB".CONVEYOR_MAXCOUNT_W; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C13_Delivery.Maximum_Count; 

//   CALL  "DE-BOUNCER / COUNTER"
//       Bit_0               :="B 11.0"   // C12 Exit Sens
//       Bit_1               :="B 11.2"   // C13 Exit Sens
//       Transfer_Start      :="M 67.4"   // C13 Delivery Step
//       Space_DX_mS         :=600
//       ReSample_DX         :=85         // % of Packet
//       Conveyor_Type       :=2          // Delivery Type
//       Preset_MIN_mS       :=500
//       LowSpd_Dimension_mS :="MW 354"   // Width Low Speed [mS](Actual 27.0 m/min)
//       HighSpd_Dimension_mS:="DEBOUNCER COUNTER DB".Conveyor_C10_Collator.Exit_Window_mS    // Length @ High Speed [mS](Actual 31.0 m/min)
//       Plc_Scan_mS         :="DB UTILITY".Scan_Cycle_Previous
//       Q_Error             :=#ERROR
//       IO_DB               :="DEBOUNCER COUNTER DB".Conveyor_C13_Delivery

      L     "DEBOUNCER COUNTER DB".Conveyor_C13_Delivery.Count_Result; 
      T     "HMI DB NEW".CONV_13_COUNT; 

M490: NOP   0; 
NETWORK
TITLE =Packet Counter Call Hold - Conveyor 21
//CONVEYOR 21
//31.0 m/min for Filling and Transfering
      A     "A 53.4"; 
      L     S5T#1S; 
      SF    "Timer 125"; 
//;
      A     "Timer 125"; 
      =     "M 143.5"; 

NETWORK
TITLE =Packet Counter - Cumul Conveyor 21 (End Sensor On When Full)

      A     "M 143.5"; 
      JNB   M534; 

      L     "HMI_DB".CONVEYOR_MAXCOUNT_W; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C21_Link.Maximum_Count; 

//   CALL  "DE-BOUNCER / COUNTER"
//       Bit_0               :="B 10.6"   // C10 Exit Sens
//       Bit_1               :="B 15.4"   // C21 Exit Sens
//       Transfer_Start      :="M 63.3"   // C21 Transfering Step
//       Space_DX_mS         :=600
//       ReSample_DX         :=85         // % of Packet
//       Conveyor_Type       :=3          // Link Type
//       Preset_MIN_mS       :=500
//       LowSpd_Dimension_mS :=0
//       HighSpd_Dimension_mS:="DEBOUNCER COUNTER DB".Conveyor_C10_Collator.Exit_Window_mS    // Length @ High Speed [mS](Actual 31.0 m/min)
