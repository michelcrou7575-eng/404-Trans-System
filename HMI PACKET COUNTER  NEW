      L     "DEBOUNCER COUNTER DB".Conveyor_C22_Link.Count_Result; 
      T     "HMI DB NEW".CONV_22_COUNT; 

M536: NOP   0; 
NETWORK
TITLE =Packet Counter Call Hold - Conveyor 23
//CONVEYOR 23
//31.0 m/min for Filling  & 23.7 m/min for Delivering
      A     "A 54.0"; 
      L     S5T#1S; 
      SF    "Timer 127"; 
//;
