FUNCTION "HMI PACKET COUNTER  NEW" : VOID
TITLE =HMI Conveyors Display Packet Counter
VERSION : 0.2


VAR_TEMP
  UPDATE : BOOL ;	
  PIVOT_HIGH : BOOL ;	//Pivot Conveyor 10 -> High Position
  PIVOT_LOW : BOOL ;	//Pivot Conveyor 10 -> Low Position
  C3_TRANSFER : BOOL ;	//C3 Slat Transfer to C4
  ERROR : BOOL ;	
  PACKET_LENGTH_mS : INT ;	//Packet Length [mS]
  I_O_DB : "Debouncer Counter Struct";	
END_VAR
BEGIN
NETWORK
TITLE =Data Transfers





NETWORK
TITLE =Packet Counter - Slat Conveyor 3 
//CONVEYOR 3
//15.5 m/min for Collating / Transfering
      A     "A 44.0"; 
      JNB   M440; 

      L     "HMI_DB".CONVEYOR_MAXCOUNT_L; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C3_Slat.Maximum_Count; 
//;
      A     "B 6.4"; 
      A     "M 27.1"; // C3 Feed/Transfer Step
      =     #C3_TRANSFER; 

      CALL "DE-BOUNCER / COUNTER" (
           Bit_0                    := "B 6.2",// C3 InFeed Sens
           Bit_1                    := "B 6.4",// C3 Exit Sens
           Transfer_Start           := #C3_TRANSFER,// C3 Transfer Step
           Space_DX_mS              := 600,// mS
           ReSample_DX              := 85,// % of Packet
           Conveyor_Type            := 1,
           Preset_MIN_mS            := 500,
           LowSpd_Dimension_mS      := 0,
           HighSpd_Dimension_mS     := "COLLATORS DB".Packet_Length_C4_mS,// Added ScanCycles  
           Plc_Scan_mS              := "DB UTILITY".Scan_Cycle_Previous,
           Q_Error                  := #ERROR,
           IO_DB                    := "DEBOUNCER COUNTER DB".Conveyor_C3_Slat);

      L     "DEBOUNCER COUNTER DB".Conveyor_C3_Slat.Count_Result; 
      T     "HMI DB NEW".CONV_3_COUNT; 

M440: NOP   0; 
NETWORK
TITLE =Packet Counter - Collator Conveyor 4
//CONVEYOR 4
//15.5 m/min for Collating & 31.0 m/min for Transfering
      A     "A 44.3"; 
      O     "TESTM 400.0"; 
      JNB   M443; 

      L     "HMI_DB".CONVEYOR_MAXCOUNT_L; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C4_Collator.Maximum_Count; 

      CALL "DE-BOUNCER / COUNTER" (
           Bit_0                    := "B 6.7",// C4 InFeed Sens
           Bit_1                    := "B 7.0",// C4 Exit Sens
           Transfer_Start           := "M 31.6",// C4 Transfer Step
           Space_DX_mS              := 600,// Normal Space mS
           ReSample_DX              := 85,// % of Packet
           Conveyor_Type            := 1,// Collator Type
           Preset_MIN_mS            := 500,// Debounce mS
           LowSpd_Dimension_mS      := 0,
           HighSpd_Dimension_mS     := "HOUSE_KEEPING DB".C4_Packet_Length_mS,// Packet Length mS @ 31 m/min
           Plc_Scan_mS              := "DB UTILITY".Scan_Cycle_Previous,
           Q_Error                  := #ERROR,
           IO_DB                    := "DEBOUNCER COUNTER DB".Conveyor_C4_Collator);

      L     "DEBOUNCER COUNTER DB".Conveyor_C4_Collator.Count_Result; 
      T     "HMI DB NEW".CONV_4_COUNT; 

M443: NOP   0; 
NETWORK
TITLE =Packet Counter Call Hold - Conveyor 5
//CONVEYOR 5
//31.0 m/min for Filling and Transfering
      A     "A 45.0"; 
      L     S5T#1S; 
      SF    "Timer 120"; 
//;
      A     "Timer 120"; 
      =     "M 143.0"; 
NETWORK
TITLE =Packet Counter - Link Conveyor 5 (End Sensor On When Full)

      A     "M 143.0"; 
      O     M    400.1; 
      JNB   M450; 

      L     "HMI_DB".CONVEYOR_MAXCOUNT_L; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C5_Link.Maximum_Count; 

      CALL "DE-BOUNCER / COUNTER" (
           Bit_0                    := "B 7.0",// C5 InFeed Sens
           Bit_1                    := "B 7.1",// C5 Exit Sens
           Transfer_Start           := "M 35.3",// C5 Transfer Step
           Space_DX_mS              := 600,
           ReSample_DX              := 85,// % of Packet
           Conveyor_Type            := 3,// Link Type
           Preset_MIN_mS            := 500,
           LowSpd_Dimension_mS      := 0,
           HighSpd_Dimension_mS     := "DEBOUNCER COUNTER DB".Conveyor_C4_Collator.Exit_Window_mS,// Length @ High Speed [mS](Actual 31.0 m/min)
           Plc_Scan_mS              := "DB UTILITY".Scan_Cycle_Previous,
           Q_Error                  := #ERROR,
           IO_DB                    := "DEBOUNCER COUNTER DB".Conveyor_C5_Link);

      L     "DEBOUNCER COUNTER DB".Conveyor_C5_Link.Count_Result; 
      T     "HMI DB NEW".CONV_5_COUNT; 

M450: NOP   0; 
NETWORK
TITLE =Packet Counter Call Hold - Conveyor 6
//CONVEYOR 6
//31.0 m/min for Filling and Delivering
      A     "A 45.3"; 
      L     S5T#1S; 
      SF    "Timer 121"; 
//;
      A     "Timer 121"; 
      =     "M 143.1"; 
NETWORK
TITLE =Packet Counter - Delivery Conveyor 6 (End Sensor On When Full)

