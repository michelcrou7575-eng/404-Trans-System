DATA_BLOCK "PACKET WIDTH DB"
TITLE =Packet Width Measure
VERSION : 0.9


  STRUCT 	
   Gap_Min_mm : INT  := 150;	//TUNE - OFF Shorter = Sag (U-Shape), Longer = Real Gap [mm]
   Tolerance_Pct : INT  := 10;	//B10.5 / B10.6 Must Agree Within [%]
   Enc_Direct : BOOL  := TRUE;	//1 = PIW 334 Direct Word, Every Scan (Default, HW Config 2026-11-19) / 0 = "FM35
   Enc_PIW_Addr : INT  := 334;	//FM350-2 Direct Low Word of Ch5 (C10) - User_Type2 Right=334 (After HW Config)
   Enc_Word_Last : INT ;	//Last Direct Word Read (Wrap Handling)
   Enc_Direct_Mem : BOOL ;	//Direct Mode Last Scan (First Scan Init)
   Enc_Live : DINT ;	//Encoder Value Used This Scan
   Active : BOOL ;	//C10 Transfering
   FP_Start : BOOL ;	//Edge Memory
   FN_End : BOOL ;	//Edge Memory
   Valid : BOOL ;	//A Verified Width Exists
   Last_OK : BOOL ;	//Last Transfer Verified
   Spare_1 : BOOL ;	
   Spare_2 : BOOL ;	
   Spare_3 : BOOL ;	
   C10_Count_Start : INT ;	//C10 Packet Count at Transfer Start
   Width_mm : INT ;	//VERIFIED Packet Width [mm]
   Width_ms_31 : INT ;	//MEASURED Width [mS] @ 31 m/min: C11/C12/C21/C22 + C13/C23 LOADING
   Speed_mm_s : INT ;	//Check: C10 Fast Speed Measured [mm/s] (Real 30.6 m/min = 510)
   Good_Count : INT ;	//Transfers Verified
   Bad_Count : INT ;	//Transfers Rejected (Packets Seen but Not Verified)
   Empty_Count : INT ;	//Transfers Without Any Packet (e.g. Clearing Re-Call of C10)
   Sensor_Dist_mm : INT  := 568;	//EFFECTIVE Distance B10.5 -> B10.6 [mm] (Tape 527, Calibrated 568 = 510 mm/s, 20
   Pend : BOOL ;	//A B10.5 Front Waits for B10.6
   T_ms : DINT ;	//Time Since Transfer Start [mS]
   Pend_Enc : DINT ;	//Encoder at B10.5 Front
   Pend_T : DINT ;	//Time at B10.5 Front
   Cal_Pulse_Sum : DINT ;	//Pulses B10.5 -> B10.6 (Sum)
   Cal_ms_Sum : DINT ;	//mS B10.5 -> B10.6 (Sum)
   Cal_Count : INT ;	//Fronts Seen at Both Sensors This Transfer
   Cal_mm_Pulse : REAL ;	//CALIBRATED Encoder Factor [mm/pulse] (Code Uses 0.31)
   Cal_Speed_mm_s : INT ;	//CALIBRATED C10 Fast Speed [mm/s] (Real 30.6 m/min = 510)
   Width_mm_Cal : INT ;	//Verified Width with Calibrated Factor [mm]
   S5 : "Width Sensor Struct";	//B10.5 C10 Full Sens
   S6 : "Width Sensor Struct";	//B10.6 C10 Exit Sens
  END_STRUCT ;	
BEGIN
   Gap_Min_mm := 150; 
   Tolerance_Pct := 10; 
   Enc_Direct := TRUE; 
   Enc_PIW_Addr := 334; 
   Enc_Word_Last := 0; 
   Enc_Direct_Mem := FALSE; 
   Enc_Live := L#0; 
   Active := FALSE; 
   FP_Start := FALSE; 
   FN_End := FALSE; 
   Valid := FALSE; 
   Last_OK := FALSE; 
   Spare_1 := FALSE; 
   Spare_2 := FALSE; 
   Spare_3 := FALSE; 
   C10_Count_Start := 0; 
   Width_mm := 0; 
   Width_ms_31 := 0; 
   Speed_mm_s := 0; 
   Good_Count := 0; 
   Bad_Count := 0; 
   Empty_Count := 0; 
   Sensor_Dist_mm := 568; 
   Pend := FALSE; 
   T_ms := L#0; 
   Pend_Enc := L#0; 
   Pend_T := L#0; 
   Cal_Pulse_Sum := L#0; 
   Cal_ms_Sum := L#0; 
   Cal_Count := 0; 
   Cal_mm_Pulse := 0.000000e+000; 
   Cal_Speed_mm_s := 0; 
   Width_mm_Cal := 0; 
   S5.Was_On := FALSE; 
   S5.Open := FALSE; 
   S5.Low := FALSE; 
   S5.Skip := FALSE; 
   S5.Front := FALSE; 
   S5.Spare_2 := FALSE; 
   S5.Spare_3 := FALSE; 
   S5.Spare_4 := FALSE; 
   S5.Start_Pos := L#0; 
   S5.Fall_Pos := L#0; 
   S5.Count := 0; 
   S5.Skipped := 0; 
   S5.Sag_Count := 0; 
   S5.Width_Sum_mm := L#0; 
   S5.Width_Min_mm := 0; 
   S5.Width_Max_mm := 0; 
   S5.Width_Avg_mm := 0; 
   S5.Last_Width_mm := 0; 
   S5.Sag_Max_mm := 0; 
   S5.Gap_Min_mm := 0; 
   S5.Time_ms := L#0; 
   S5.Fall_ms := L#0; 
   S5.Width_Sum_ms := L#0; 
   S5.Width_Avg_ms := 0; 
   S5.Last_Width_ms := 0; 
   S6.Was_On := FALSE; 
   S6.Open := FALSE; 
   S6.Low := FALSE; 
   S6.Skip := FALSE; 
   S6.Front := FALSE; 
   S6.Spare_2 := FALSE; 
   S6.Spare_3 := FALSE; 
   S6.Spare_4 := FALSE; 
   S6.Start_Pos := L#0; 
   S6.Fall_Pos := L#0; 
   S6.Count := 0; 
   S6.Skipped := 0; 
   S6.Sag_Count := 0; 
   S6.Width_Sum_mm := L#0; 
   S6.Width_Min_mm := 0; 
   S6.Width_Max_mm := 0; 
   S6.Width_Avg_mm := 0; 
   S6.Last_Width_mm := 0; 
   S6.Sag_Max_mm := 0; 
   S6.Gap_Min_mm := 0; 
   S6.Time_ms := L#0; 
   S6.Fall_ms := L#0; 
   S6.Width_Sum_ms := L#0; 
   S6.Width_Avg_ms := 0; 
   S6.Last_Width_ms := 0; 
END_DATA_BLOCK
