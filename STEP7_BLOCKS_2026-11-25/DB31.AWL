DATA_BLOCK "BLANKING DB"
TITLE =Packet Blanking - Shadow Counters
VERSION : 0.1


  STRUCT 	
   Width_ms : INT ;	//Packet Time Used [mS] (DB30 Width_ms_31, Else 855)
   Blank_Pct : INT  := 90;	//TUNE - Blanking After a Front [% of Packet Time]
   Butt_Pct : INT  := 140;	//TUNE - Sensor Still ON -> Butted Packet [% of Packet Time]
   Pulse_ms : INT  := 400;	//Cleaned Pulse Length [mS] (FC8: > 300 ON, Gap > 300)
   C10_Exit_B10_6 : "Blanking Struct";	//C10 Exit = C11 / C21 InFeed (Run: C10 Fast A48.0+A48.1)
   C11_Exit_B10_7 : "Blanking Struct";	//C11 Exit = C12 InFeed (Run: C11 A48.3)
   C12_Exit_B11_0 : "Blanking Struct";	//C12 Exit = C13 InFeed (Run: C12 A48.6)
   C21_Exit_B15_4 : "Blanking Struct";	//C21 Exit = C22 InFeed (Run: C21 A53.4)
   C22_Exit_B15_5 : "Blanking Struct";	//C22 Exit = C23 InFeed (Run: C22 A53.6)
  END_STRUCT ;	
