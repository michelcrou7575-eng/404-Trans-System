DATA_BLOCK DB 15
TITLE =Packet Positioning - Flipper C7 + Pusher 2 C9 - Stop Time per Length (HMI)
//One stop time per packet length class (15 mm classes, 510 ... > 975 mm).
//Time = belt run after the packet tail leaves B7.4 (step 8N5 -> 8N6, Timer 42).
//Time_ms[class] = 0 -> Default_ms (1500 = as before v1.0).
//v1.1 2026-11-24: HMI packet drawing: Disp_Length_mm (DBW86) + 4 width class
//bits (DBX90.0...90.3, one ON) from the C10 measured width (DB30 Width_mm_Cal).
//v1.2 2026-11-24: + C9 Pusher 2 conveyor (feeder lateral position, Timer 62): one
//time per length class too, Time 0 = "HMI_DB".CONV_9_POS_mS x 10 (as before).
//DBW98 / DBW100 reserved for the flipper drawing (tail / front, later).
//v1.3 2026-11-24: C9 HMI drawing: one packet drawing, 16 copies at 16 lateral
//positions, one shown (C9_Pos_Bits, one bit ON) from the C9 stop time used.
//v1.4 2026-11-24: DB15 symbol renamed "PACKET POSITION DB" (was "FLIPPER POS DB").
//v1.5 2026-11-25: Spare_9 -> FP_Tst_On (DBX104.4, edge memory of M140.3), layout unchanged.
//v1.6 2026-11-25: + C9_Default_ms 250 (center) and C9_Max_ms 500 (physical limit
//from the sensor), DBW180 / DBW182. Drawing step 32 mS (16 copies = 0...500 mS).
//v1.7 2026-11-26: names say C7 (flipper) or C9 (pusher 2): flipper fields renamed
//C7_... (layout and addresses unchanged). C9_Default_ms 90 mS, C9_Max_ms 200 mS,
//C9 drawing step 13 mS (16 copies = 0...200 mS). Shared: Length_mm, Class,
//Class_Lamps (length class), Step_ms (arrow step).
//v1.8 2026-11-26: C7 HMI drawing like C9: one packet, 16 copies at 16 positions
//(C7_Pos_Bits DBW184, one bit ON) from the C7 time shown. Defaults 700 / 100 mS:
//16 copies = 700...2200 mS, 1500 mS (default) = copy 8.
VERSION : 1.8

  STRUCT 
   Length_mm : INT ;	//Packet Length Used [mm] ("HOUSE_KEEPING DB".C4_Packet_Length_mm)
   Class : INT ;	//Length Class 0 = < 525 mm ... 31 = >= 975 mm (15 mm Steps from 510)
   C7_Time_Used_ms : INT ;	//Stop Time Used for This Class [mS] - HMI Display
   C7_Default_ms : INT  := 1500;	//Stop Time When the Class Has No Time Set [mS] (= Before v1.0)
   Step_ms : INT  := 10;	//One Arrow Press [mS]
   C7_Min_ms : INT  := 200;	//Lowest Time Allowed [mS]
   C7_Max_ms : INT  := 5000;	//Highest Time Allowed [mS]
   C7_Plus_PB : BOOL ;	//HMI Arrow -> : Longer (Packet Stops Further) - Momentary
   C7_Minus_PB : BOOL ;	//HMI Arrow <- : Shorter (Packet Stops Earlier) - Momentary
   C7_Reset_PB : BOOL ;	//HMI: This Class Back to Default - Momentary
   C7_Use_Table : BOOL  := TRUE;	//1 = Table / 0 = Default_ms Always (Old Fixed 1.5 s)
   Spare_1 : BOOL ;	
   Spare_2 : BOOL ;	
   Spare_3 : BOOL ;	
   Spare_4 : BOOL ;	
   Class_Lamps : DWORD ;	//One Bit per Class (HMI Lamps) - Class 0 = DBX19.0 ... 7 = DBX19.7, 8 = DBX18.0 ... 31 = DBX16.7
   C7_Stop_S5T : S5TIME  := S5T#1S500MS;	//Stop Time for FC942 Timer 42
   C7_Time_ms : ARRAY  [0 .. 31 ] OF INT ;	//Stop Time per Class [mS] - 0 = Default_ms
   C7_Disp_Length_mm : INT ;	//HMI Packet Drawing - Length [mm] (DBW86)
   C7_Width_mm : INT ;	//Packet Width Used [mm] ("PACKET WIDTH DB".Width_mm_Cal, C10 Measured)
   C7_Width_Class_1 : BOOL ;	//HMI Drawing Pair 1 - Width < Width_Lim_1 (DBX90.0)
   C7_Width_Class_2 : BOOL ;	//HMI Drawing Pair 2 - Width_Lim_1 ... Width_Lim_2 (DBX90.1)
   C7_Width_Class_3 : BOOL ;	//HMI Drawing Pair 3 - Width_Lim_2 ... Width_Lim_3 (DBX90.2)
   C7_Width_Class_4 : BOOL ;	//HMI Drawing Pair 4 - Width >= Width_Lim_3 (DBX90.3)
   Spare_5 : BOOL ;	
   Spare_6 : BOOL ;	
   Spare_7 : BOOL ;	
   Spare_8 : BOOL ;	
   C7_Width_Lim_1 : INT  := 450;	//Width Class Limit 1/2 [mm]
   C7_Width_Lim_2 : INT  := 500;	//Width Class Limit 2/3 [mm]
   C7_Width_Lim_3 : INT  := 550;	//Width Class Limit 3/4 [mm]
   C7_Tail_mm : INT ;	//Reserved: Flipper Drawing - Packet Tail Position [mm] (DBW98)
   C7_Front_mm : INT ;	//Reserved: Flipper Drawing - Packet Front Position [mm] (DBW100)
   C9_Time_Used_ms : INT ;	//C9 Stop Time Used for This Class [mS] - HMI Display (DBW102)
   C9_Plus_PB : BOOL ;	//HMI C9 Arrow -> : Longer - Momentary (DBX104.0)
   C9_Minus_PB : BOOL ;	//HMI C9 Arrow <- : Shorter - Momentary (DBX104.1)
   C9_Reset_PB : BOOL ;	//HMI C9: This Class Back to Default - Momentary (DBX104.2)
   C9_Use_Table : BOOL  := TRUE;	//1 = Table / 0 = "HMI_DB".CONV_9_POS_mS Always (DBX104.3)
   FP_Tst_On : BOOL ;	//Edge Memory - M140.3 (NS12 Takes Over) (DBX104.4)
   Spare_10 : BOOL ;	
   Spare_11 : BOOL ;	
   Spare_12 : BOOL ;	
   C9_Stop_S5T : S5TIME ;	//C9 Stop Time for FC950 Timer 62 (DBW106)
   C9_Time_ms : ARRAY  [0 .. 31 ] OF INT ;	//C9 Stop Time per Class [mS] - 0 = CONV_9_POS_mS x 10 (DBW108...170)
   C9_Pos_Bits : WORD ;	//C9 Drawing: One Bit ON = Copy Shown - Copy 0 = DBX173.0 ... 7 = DBX173.7, 8 = DBX172.0 ... 15 = DBX172.7
   C9_View_Min_ms : INT ;	//C9 Drawing: Time of Copy 0 (Left) [mS] (DBW174)
   C9_View_Step_ms : INT  := 13;	//C9 Drawing: Time Between 2 Copies [mS] (DBW176) - 16 Copies = 0...200 mS
   C9_Pos_Step : INT ;	//C9 Drawing: Copy Shown 0...15 (DBW178)
   C9_Default_ms : INT  := 90;	//C9 Default (DEFAULT Button / Class Without Time) [mS] (DBW180)
   C9_Max_ms : INT  := 200;	//C9 Highest Time [mS] - Physical Limit From the Sensor (DBW182)
   C7_Pos_Bits : WORD ;	//C7 Drawing: One Bit ON = Copy Shown - Copy 0 = DBX185.0 ... 7 = DBX185.7, 8 = DBX184.0 ... 15 = DBX184.7
   C7_View_Min_ms : INT  := 700;	//C7 Drawing: Time of Copy 0 (Left) [mS] (DBW186)
   C7_View_Step_ms : INT  := 100;	//C7 Drawing: Time Between 2 Copies [mS] (DBW188) - 16 Copies = 700...2200 mS
   C7_Pos_Step : INT ;	//C7 Drawing: Copy Shown 0...15 (DBW190)
  END_STRUCT ;
BEGIN
END_DATA_BLOCK

FUNCTION FC 1215 : VOID
TITLE =Packet Positioning - Flipper C7 + Pusher 2 C9 - Stop Time per Length (HMI)
//v1.0 2026-11-23: called by FC942 v1.0. Picks the stop time of the length class
//of the packets (C4 measurement), lights the class lamp, and lets the operator
//change that class time with the HMI arrows (+/- Step_ms, Min_ms...Max_ms).
//Writes only DB15 "PACKET POSITION DB". Empty table = Default_ms = 1.5 s as before.
//v1.1 2026-11-24: HMI packet drawing: length (DBW86) + width class bits (DBX90.x).
//v1.2 2026-11-24: renumbered FC1221 -> FC1215 (same name "FLIPPER POS ADJ", no
//code change). FC942 calls it by name.
//v1.3 2026-11-24: renamed "PACKET POSITIONING". + C9 Pusher 2 conveyor: same
//length class, own table / arrows, default = "HMI_DB".CONV_9_POS_mS x 10 (as
//before). Output C9_Stop_S5T for FC950 v1.0 Timer 62.
//v1.4 2026-11-24: C9 HMI drawing: C9_Pos_Bits (one of 16 lateral positions).
//v1.5 2026-11-24: DB15 symbol renamed "PACKET POSITION DB" - no code change.
//v1.6 2026-11-25: LAUER in charge (M140.3 = 0): the NS12 times are a PREVIEW
//(arrows + drawings work, the machine keeps the LAUER values: flipper 1.5 s,
//C9 = LAUER time via FC950 Timer 50). When the NS12 takes over (M140.3 0 -> 1)
//the current class starts from the LAUER actual values: flipper = Default
//1500 mS, C9 = LAUER DB50.DBW248 (x 10 mS, also copied to CONV_9_POS_mS).
//v1.7 2026-11-25: C9 default = "PACKET POSITION DB".C9_Default_ms (250 mS, center)
//instead of CONV_9_POS_mS x 10. C9 limited to 1...C9_Max_ms (500 mS). The LAUER
//time copied at takeover is limited the same way.
//v1.8 2026-11-26: DB15 flipper fields renamed C7_... (no code change). C9 defaults
//now in DB15 v1.7: 90 / 200 mS.
//v1.9 2026-11-26: C7 HMI drawing: C7_Pos_Bits (one of 16 positions) from the C7
//time shown (C7_Time_Used_ms), same as C9.
VERSION : 1.9


VAR_TEMP
  CLASS : INT ;	
  T_TAB : INT ;	
  T_NEW : INT ;	
  T_DEF : INT ;	
  TST_ON : BOOL ;	//M140.3 0 -> 1 (NS12 Takes Over) - One Scan
  T_TIME : TIME ;	
  S5 : S5TIME ;	
END_VAR
BEGIN
NETWORK
TITLE =NS12 Takes Over (M140.3 0 -> 1) - Start From the LAUER Actual Values

      A     "M 140.3"; // NS12 in Control (FC1100, Tst)
      FP    "PACKET POSITION DB".FP_Tst_On; 
      =     #TST_ON; 
NETWORK
TITLE =Packet Length -> Class (15 mm Steps from 510 mm, 0...31)

      L     "HOUSE_KEEPING DB".C4_Packet_Length_mm; 
      T     "PACKET POSITION DB".Length_mm; 
      L     510; 
      -I    ; 
      L     15; 
      /I    ; 
      T     #CLASS; 
      L     0; 
      >=I   ; 
      JC    K001; 

      L     0; 
      T     #CLASS; 

K001: L     #CLASS; 
      L     31; 
      <=I   ; 
      JC    K002; 

      L     31; 
      T     #CLASS; 

K002: L     #CLASS; 
      T     "PACKET POSITION DB".Class; 
//;
      L     #CLASS; // Class Lamp: Bit = Class
      L     L#1; 
      SLD   ; 
      T     "PACKET POSITION DB".Class_Lamps; 
NETWORK
TITLE =C7 Flipper - Read the Class Time (Time_ms[Class], DB15.DBW22 + 2 x Class)

      L     #CLASS; 
      SLW   1; 
      L     22; 
      +I    ; 
      SLD   3; 
      LAR1  ; 
      OPN   "PACKET POSITION DB"; 
      L     DBW [AR1,P#0.0]; 
      T     #T_TAB; 
NETWORK
TITLE =C7 Flipper - HMI Arrows / Reset - Change This Class Time
//The HMI sets Plus_PB / Minus_PB / Reset_PB, the PLC resets them after use:
//one press = one step.

      L     #T_TAB; // Start From the Time Used (0 = Default)
      L     0; 
      <>I   ; 
      JC    K010; 

      L     "PACKET POSITION DB".C7_Default_ms; 
      JU    K011; 

K010: L     #T_TAB; 
K011: T     #T_NEW; 
//;
      A     "PACKET POSITION DB".C7_Plus_PB; 
      JCN   K012; 

      L     #T_NEW; 
      L     "PACKET POSITION DB".Step_ms; 
      +I    ; 
      T     #T_NEW; 

K012: A     "PACKET POSITION DB".C7_Minus_PB; 
      JCN   K013; 

      L     #T_NEW; 
      L     "PACKET POSITION DB".Step_ms; 
      -I    ; 
      T     #T_NEW; 

K013: L     #T_NEW; // Clamp Min...Max
      L     "PACKET POSITION DB".C7_Min_ms; 
      >=I   ; 
      JC    K014; 

      L     "PACKET POSITION DB".C7_Min_ms; 
      T     #T_NEW; 

K014: L     #T_NEW; 
      L     "PACKET POSITION DB".C7_Max_ms; 
      <=I   ; 
      JC    K015; 

      L     "PACKET POSITION DB".C7_Max_ms; 
      T     #T_NEW; 

K015: NOP   0; 
NETWORK
TITLE =C7 Flipper - Write Back After an Arrow / Reset

      A     "PACKET POSITION DB".C7_Reset_PB; 
      O     #TST_ON; // NS12 Takes Over: LAUER Actual = 1.5 s = Default
      JCN   K020; 

      L     0; // Class Back to Default
      T     #T_TAB; 
      JU    K021; 

K020: A(    ; 
      O     "PACKET POSITION DB".C7_Plus_PB; 
      O     "PACKET POSITION DB".C7_Minus_PB; 
      )     ; 
      JCN   K022; 

      L     #T_NEW; 
      T     #T_TAB; 

K021: L     #CLASS; 
      SLW   1; 
      L     22; 
      +I    ; 
      SLD   3; 
      LAR1  ; 
      OPN   "PACKET POSITION DB"; 
      L     #T_TAB; 
      T     DBW [AR1,P#0.0]; 

K022: SET   ; // Momentary: Reset by the PLC
      R     "PACKET POSITION DB".C7_Plus_PB; 
      R     "PACKET POSITION DB".C7_Minus_PB; 
      R     "PACKET POSITION DB".C7_Reset_PB; 
NETWORK
TITLE =HMI Packet Drawing - Length + Width Class (4 Pairs of Level Meters)
//Width = C10 measured width (DB30 Width_mm_Cal, last verified, same order).
//0 (not measured yet) = smallest class.

      L     "PACKET POSITION DB".Length_mm; 
      T     "PACKET POSITION DB".C7_Disp_Length_mm; 
//;
      L     "PACKET WIDTH DB".Width_mm_Cal; 
      T     "PACKET POSITION DB".C7_Width_mm; 
//;
      L     "PACKET POSITION DB".C7_Width_mm; 
      L     "PACKET POSITION DB".C7_Width_Lim_1; 
      <I    ; 
      =     "PACKET POSITION DB".C7_Width_Class_1; 
//;
      A(    ; 
      L     "PACKET POSITION DB".C7_Width_mm; 
      L     "PACKET POSITION DB".C7_Width_Lim_1; 
      >=I   ; 
      )     ; 
      A(    ; 
      L     "PACKET POSITION DB".C7_Width_mm; 
      L     "PACKET POSITION DB".C7_Width_Lim_2; 
      <I    ; 
      )     ; 
      =     "PACKET POSITION DB".C7_Width_Class_2; 
//;
      A(    ; 
      L     "PACKET POSITION DB".C7_Width_mm; 
      L     "PACKET POSITION DB".C7_Width_Lim_2; 
      >=I   ; 
      )     ; 
      A(    ; 
      L     "PACKET POSITION DB".C7_Width_mm; 
      L     "PACKET POSITION DB".C7_Width_Lim_3; 
      <I    ; 
      )     ; 
      =     "PACKET POSITION DB".C7_Width_Class_3; 
//;
      L     "PACKET POSITION DB".C7_Width_mm; 
      L     "PACKET POSITION DB".C7_Width_Lim_3; 
      >=I   ; 
      =     "PACKET POSITION DB".C7_Width_Class_4; 
NETWORK
TITLE =C7 Flipper - Stop Time Used -> S5TIME for FC942 Timer 42

      L     #T_TAB; 
      L     0; 
      <>I   ; 
      A     "PACKET POSITION DB".C7_Use_Table; 
      JC    K030; 

      L     "PACKET POSITION DB".C7_Default_ms; 
      JU    K031; 

K030: L     #T_TAB; 
K031: T     "PACKET POSITION DB".C7_Time_Used_ms; // HMI (Preview When LAUER)
      A     "M 140.3"; // Machine: Table Only When NS12 in Control
      JC    K032; 

      L     "PACKET POSITION DB".C7_Default_ms; // LAUER in Control: Fixed 1.5 s
K032: ITD   ; 
      T     #T_TIME; 

      CALL "TIM_S5TI" (
           IN                       := #T_TIME,
           RET_VAL                  := #S5);

      L     #S5; 
      T     "PACKET POSITION DB".C7_Stop_S5T; 
NETWORK
TITLE =C9 Pusher 2 - Read the Class Time (C9_Time_ms[Class], DB15.DBW108 + 2 x Class)

      L     "PACKET POSITION DB".Class; 
      T     #CLASS; 
      SLW   1; 
      L     108; 
      +I    ; 
      SLD   3; 
      LAR1  ; 
      OPN   "PACKET POSITION DB"; 
      L     DBW [AR1,P#0.0]; 
      T     #T_TAB; 
//;
      L     "PACKET POSITION DB".C9_Default_ms; // C9 Default (DB15, 90 mS)
      T     #T_DEF; 
NETWORK
TITLE =C9 Pusher 2 - HMI Arrows / Reset - Change This Class Time

      L     #T_TAB; 
      L     0; 
      <>I   ; 
      JC    C010; 

      L     #T_DEF; 
      JU    C011; 

C010: L     #T_TAB; 
C011: T     #T_NEW; 
//;
      A     "PACKET POSITION DB".C9_Plus_PB; 
      JCN   C012; 

      L     #T_NEW; 
      L     "PACKET POSITION DB".Step_ms; 
      +I    ; 
      T     #T_NEW; 

C012: A     "PACKET POSITION DB".C9_Minus_PB; 
      JCN   C013; 

      L     #T_NEW; 
      L     "PACKET POSITION DB".Step_ms; 
      -I    ; 
      T     #T_NEW; 

C013: L     #T_NEW; // Clamp 1...Max (0 Means Default)
      L     1; 
      >=I   ; 
      JC    C014; 

      L     1; 
      T     #T_NEW; 

C014: L     #T_NEW; 
      L     "PACKET POSITION DB".C9_Max_ms; 
      <=I   ; 
      JC    C015; 

      L     "PACKET POSITION DB".C9_Max_ms; 
      T     #T_NEW; 

C015: NOP   0; 
NETWORK
TITLE =C9 Pusher 2 - Write Back After an Arrow / Reset

      A     #TST_ON; // NS12 Takes Over: Start From the LAUER C9 Time
      JCN   C018; 

      L     DB50.DBW  248; // LAUER C9 Time [x 10 mS] (FC950 Timer 50)
      T     "HMI_DB".CONV_9_POS_mS; // Also the NS12 "x 10 mS" Field
      L     10; 
      *I    ; 
      T     #T_TAB; 
      L     "PACKET POSITION DB".C9_Max_ms; // Not Above the Physical Limit
      <=I   ; 
      JC    C021; 

      L     "PACKET POSITION DB".C9_Max_ms; 
      T     #T_TAB; 
      JU    C021; 

C018: A     "PACKET POSITION DB".C9_Reset_PB; 
      JCN   C020; 

      L     0; // Class Back to Default
      T     #T_TAB; 
      JU    C021; 

C020: A(    ; 
      O     "PACKET POSITION DB".C9_Plus_PB; 
      O     "PACKET POSITION DB".C9_Minus_PB; 
      )     ; 
      JCN   C022; 

      L     #T_NEW; 
      T     #T_TAB; 

C021: L     #CLASS; 
      SLW   1; 
      L     108; 
      +I    ; 
      SLD   3; 
      LAR1  ; 
      OPN   "PACKET POSITION DB"; 
      L     #T_TAB; 
      T     DBW [AR1,P#0.0]; 

C022: SET   ; // Momentary: Reset by the PLC
      R     "PACKET POSITION DB".C9_Plus_PB; 
      R     "PACKET POSITION DB".C9_Minus_PB; 
      R     "PACKET POSITION DB".C9_Reset_PB; 
NETWORK
TITLE =C9 Pusher 2 - Stop Time Used -> S5TIME for FC950 Timer 62

      L     #T_TAB; 
      L     0; 
      <>I   ; 
      A     "PACKET POSITION DB".C9_Use_Table; 
      JC    C030; 

      L     #T_DEF; 
      JU    C031; 

C030: L     #T_TAB; 
C031: T     "PACKET POSITION DB".C9_Time_Used_ms; 
      ITD   ; 
      T     #T_TIME; 

      CALL "TIM_S5TI" (
           IN                       := #T_TIME,
           RET_VAL                  := #S5);

      L     #S5; 
      T     "PACKET POSITION DB".C9_Stop_S5T; 
NETWORK
TITLE =C9 Pusher 2 - HMI Drawing: 1 of 16 Lateral Positions (Longer Time = Right)

      L     "PACKET POSITION DB".C9_View_Step_ms; // Step 0 -> Copy 0
      L     0; 
      >I    ; 
      JC    C040; 

      L     0; 
      JU    C042; 

C040: L     "PACKET POSITION DB".C9_Time_Used_ms; 
      L     "PACKET POSITION DB".C9_View_Min_ms; 
      -I    ; 
      L     "PACKET POSITION DB".C9_View_Step_ms; 
      /I    ; 
      T     #T_NEW; 
      L     0; 
      >=I   ; 
      JC    C041; 

      L     0; 
      T     #T_NEW; 

C041: L     #T_NEW; 
      L     15; 
      <=I   ; 
      L     #T_NEW; 
      JC    C042; 

      L     15; 
C042: T     "PACKET POSITION DB".C9_Pos_Step; 
//;
      L     "PACKET POSITION DB".C9_Pos_Step; // One Bit = Step
      L     L#1; 
      SLD   ; 
      T     "PACKET POSITION DB".C9_Pos_Bits; 
NETWORK
TITLE =C7 Flipper - HMI Drawing: 1 of 16 Lateral Positions (Longer Time = Right)

      L     "PACKET POSITION DB".C7_View_Step_ms; // Step 0 -> Copy 0
      L     0; 
      >I    ; 
      JC    K040; 

      L     0; 
      JU    K042; 

K040: L     "PACKET POSITION DB".C7_Time_Used_ms; 
      L     "PACKET POSITION DB".C7_View_Min_ms; 
      -I    ; 
      L     "PACKET POSITION DB".C7_View_Step_ms; 
      /I    ; 
      T     #T_NEW; 
      L     0; 
      >=I   ; 
      JC    K041; 

      L     0; 
      T     #T_NEW; 

K041: L     #T_NEW; 
      L     15; 
      <=I   ; 
      L     #T_NEW; 
      JC    K042; 

      L     15; 
K042: T     "PACKET POSITION DB".C7_Pos_Step; 
//;
      L     "PACKET POSITION DB".C7_Pos_Step; // One Bit = Step
      L     L#1; 
      SLD   ; 
      T     "PACKET POSITION DB".C7_Pos_Bits; 
END_FUNCTION
