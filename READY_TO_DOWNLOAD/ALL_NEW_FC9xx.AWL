      L     S5T#30S; 
      SD    "Timer 63"; 
NETWORK
TITLE =Conveyor 12 - Steps Register - Reset

      A(    ; 
      A     "M 63.1"; 
      AN    "M 63.2"; 
      A     "Timer 63"; 
      O     "M 63.4"; 
      )     ; 
      A     "M 62.0"; 
      JC    M001; 
      JU    M002; 

M001: L     W#16#0; 
      T     "MW 63"; 
      T     "MB 65"; 

M002: NOP   0; 
NETWORK
TITLE =Step 13N1 - Power On

      A     "M 62.0"; 
      S     "M 63.0"; 
NETWORK
TITLE =Step 13N2 - Conveyor 12 - Packet Filling

      A(    ; 
      A     "M 59.2"; 
      AN    "M 59.3"; 
      O     ; 
      A     "B 11.0"; 
      AN    "M 63.1"; 
      )     ; 
      O     #SERVICE_RUN; // Drive Test - Logic : DON'T CARE!
      A     "M 62.0"; 
      A     "M 63.0"; 
      S     "M 63.1"; 
NETWORK
TITLE =Step 13N3 - Conveyor 12 - Stop Filling

      A     "B 11.0"; 
      A     "M 62.0"; 
      A     "M 63.1"; 
      S     "M 63.2"; 
NETWORK
TITLE =Step 13N4 - Conveyor 12 - Transfering

      A     "M 67.1"; 
      AN    "M 67.2"; 
      A     "M 62.0"; 
      A     "M 63.2"; 
      S     "M 63.3"; 
NETWORK
TITLE =Step 13N5 - Conveyor 12 - Steps Register - Reset

      A(    ; 
      O     "B 11.1"; 
      O     "Timer 63"; 
      )     ; 
      A     "M 62.0"; 
      A     "M 63.3"; 
      S     "M 63.4"; 
NETWORK
TITLE =Conveyor 12 VFD - Release

      A(    ; 
      A     "M 63.1"; 
      AN    "M 63.2"; 
      O     ; 
      A     "M 63.3"; 
      AN    "M 63.4"; 
      )     ; 
      A     "M 62.0"; 
      AN    "M 11.1"; // VFD NOT All Ready !
      =     "A 48.6"; 
      =     "A 48.7"; 
END_FUNCTION


FUNCTION FC 966 : VOID
TITLE =NEW FC966 (was FC1066) - Conveyor 13 - Delivery First Level
NAME : POS_15_L
VERSION : 0.0


VAR_TEMP
  MAIN_SERVICE_2_SW : BOOL ;	
  SERVICE_RUN : BOOL ;	
  BARRIER_BLINKER : BOOL ;	//Feeder Safety Light Barrier
END_VAR
BEGIN
NETWORK
TITLE =Conveyor 13 - Service

      A     "HMI_DB".ALL_SERVICE_ENABLE_SW; 
      A     "HMI_DB".CONVEYOR_11_SERVICE_SW; 
      A     "HMI_DB".SERVICE_SW_2_STATUS; 
      =     #MAIN_SERVICE_2_SW; 
//;
      A     #MAIN_SERVICE_2_SW; 
      O     "M 66.1"; 
      JNB   CO13; 
//;    
      A     "HMI_DB".HMI_CONVEYOR_13_TEST_SSW; 
      =     #SERVICE_RUN; 
//;
      AN    #MAIN_SERVICE_2_SW; 
      R     "HMI_DB".HMI_CONVEYOR_13_TEST_SSW; 

CO13: R     #SERVICE_RUN; 
      FP    "FP 148.2"; 
      =     "M 66.1"; 
NETWORK
TITLE =Delivery Conveyor 13 - Running TimeOut  30s

      A     "M 67.1"; 
      AN    "M 67.3"; 
      A     "A 49.0"; 
      A     "M 66.0"; 
      L     S5T#30S; 
      SD    "Timer 66"; 
NETWORK
TITLE =Conveyor 13 - Next Delivery

      A     "B 11.2"; 
      A     "M 67.5"; 
      AN    "M 67.6"; 
      A     "M 0.3"; 
      S     "M 66.6"; 
//;
      A     "M 67.3"; 
      AN    "M 67.4"; 
      R     "M 66.6"; 
NETWORK
TITLE =Delivery Conveyor 13 - Empty Sens TimeOut  3s

      A     "M 67.4"; 
      AN    "M 67.5"; 
      A     "B 11.2"; 
      A     "M 0.3"; 
      A     "A 49.0"; 
      L     S5T#3S; 
      SD    "Timer 67"; 
NETWORK
TITLE =Delivery Conveyor 13 - Ready

      A     "Timer 67"; 
      S     "M 66.7"; 
//;
      A     "M 9.1"; 
      AN    "B 11.2"; 
      A     "M 0.3"; 
      R     "M 66.7"; 
NETWORK
TITLE =Conveyor 13 - Power Enable

      A     "M 0.3"; 
      AN    "DB UTILITY".Conveyor_13_Disable; 
      =     "M 66.0"; 
NETWORK
TITLE =Step 14N1 - Conveyor 13 - Power On

      A     "M 66.0"; 
      S     "M 67.0"; 
NETWORK
TITLE =Step 14N2 - Conveyor 13 - Filling

      A(    ; 
      A     "M 63.2"; 
      AN    "M 63.3"; 
      O     ; 
      A(    ; 
      O     "B 11.1"; 
      O     "B 11.2"; 
      )     ; 
//      O     #SERVICE_RUN
      AN    "M 67.1"; 
      )     ; 
      A     "M 66.0"; 
      A     "M 67.0"; 
      S     "M 67.1"; 
NETWORK
TITLE =Step 14N3 - Conveyor 13 - Stop

      A(    ; 
      O     "B 11.1"; 
      O     "B 11.2"; 
      )     ; 
      A     "M 66.0"; 
      A     "M 67.1"; 
      S     "M 67.2"; 
NETWORK
TITLE =Step 14N4 - Conveyor 13 - Packets Present

      A     "B 11.2"; 
      A     "M 66.0"; 
      A     "M 67.2"; 
      S     "M 67.3"; 
NETWORK
TITLE =Step 14N5 - Conveyor 13 - Delivery

      A(    ; 
      AN    "P 11.4"; 
      A     "M 71.2"; 
      AN    "M 71.3"; 
      A     "M 73.6"; 
      ON    "B 11.2"; 
      )     ; 
      AN    "M 66.7"; 
      A     "M 66.0"; 
      A     "M 67.3"; 
      S     "M 67.4"; 
NETWORK
TITLE =Write 1 to Steps 0-3 Byte Register MB67

      A(    ; 
      O     "M 66.6"; 
      O     "M 66.7"; 
      )     ; 
      A     "M 67.4"; 
      A     "M 66.0"; 
      JC    M001; 
      JU    M002; 

M001: L     2#1111; 
      T     "MB 67"; 

M002: NOP   0; 
NETWORK
TITLE =Step 14N6 - Conveyor 13 - Delivery Done

      AN    "B 11.2"; 
      A     "M 66.0"; 
      A     "M 67.4"; 
      S     "M 67.5"; 
NETWORK
TITLE =Delivery Conveyor 13 - Next Delivery - Delay

      A     "M 67.5"; 
      AN    "M 67.6"; 
      A     "A 49.0"; 
      A     "M 66.0"; 
      L     S5T#3S; 
      SD    "Timer 69"; 
NETWORK
TITLE =Step 14N7 - Conveyor 13 - Next Delivery

      A     "Timer 69"; 
      A     "M 66.0"; 
      A     "M 67.5"; 
      S     "M 67.6"; 
NETWORK
TITLE =Steps Register - Reset

      A(    ; 
      O     "M 67.6"; 
      O     "Timer 66"; 
      )     ; 
      A     "M 66.0"; 
      JC    M003; 
      JU    M004; 

M003: L     2#0; 
      T     "MW 67"; 

M004: NOP   0; 
NETWORK
TITLE =Conveyor 13 VFD - Release

      A(    ; 
      A     "M 67.1"; 
      AN    "M 67.3"; 
      O     ; 
      A     "M 67.4"; 
      AN    "M 67.5"; 
      A     "M 70.0"; 
      O     ; 
      A     "M 67.5"; 
      AN    "M 67.6"; 
      O     "M 66.4"; 
      )     ; 
      A     "M 66.0"; 
      =     "A 49.0"; 
NETWORK
TITLE =Conveyor Filling

      A     "M 67.1"; 
      AN    "M 67.2"; 
      A     "M 66.0"; 
      =     "A 49.1"; 
NETWORK
TITLE =Conveyor 13 VFD - Slow

      A(    ; 
      A     "M 67.2"; 
      AN    "M 67.3"; 
      O     ; 
      A     "M 67.4"; 
      AN    "M 67.6"; 
      O     "M 66.4"; 
      )     ; 
      A     "M 66.0"; 
      =     "A 49.2"; 
NETWORK
TITLE =Conveyor 13 - Delivering ON

      A     "M 67.2"; 
      AN    "M 67.3"; 
      S     "M 66.4"; 
//;
      A(    ; 
      ON    "M 67.2"; 
      O     "M 67.3"; 
      )     ; 
      R     "M 66.4"; 
END_FUNCTION


FUNCTION FC 970 : VOID
TITLE =NEW FC970 (was FC1070) - Feeder Fingers
//
NAME : FEEDER
VERSION : 0.0


VAR_TEMP
  MAIN_SERVICE_3_SW : BOOL ;	
  FEEDER_SERVICE_SW : BOOL ;	
  FINGERS_SERVICE_SW : BOOL ;	
  LIGHT_BARRIER : BOOL ;	
  FINGERS_EXTEND : BOOL ;	
  FINGERS_RETRACT : BOOL ;	
  FINGERS_TILT : BOOL ;	
  BELT_ON : BOOL ;	
  INITIALISATION : BOOL ;	
END_VAR
BEGIN
NETWORK
TITLE =Light Barrier Buffer

      A     "E 1.4"; 
      O     "M 90.0"; 
      =     #LIGHT_BARRIER; 
//;
      A     "E 1.4"; 
      R     "M 90.0"; 
NETWORK
TITLE =Feeder Service 

      A     "HMI_DB".ALL_SERVICE_ENABLE_SW; 
      A     "HMI_DB".LOADER_SERVICE_ENABLE_SW; 
      A     "HMI_DB".SERVICE_SW_3_STATUS; 
      =     #MAIN_SERVICE_3_SW; 
//;
      A     #MAIN_SERVICE_3_SW; 
      O     "M 70.7"; 
      JNB   FEED; 
      A     "HMI_DB".LOADER_LIFT_SERVICE_SSW; 
      =     #FEEDER_SERVICE_SW; 
//;
      A     #FEEDER_SERVICE_SW; 
      A     "HMI_DB".LOADER_FING_SERVICE_SSW; 
      =     #FINGERS_SERVICE_SW; 
      =     "DB UTILITY".Conveyor_13_Disable; 
      =     "DB UTILITY".Conveyor_23_Disable; 
//;  
      A     #FEEDER_SERVICE_SW; 
      A     #FINGERS_SERVICE_SW; 
      A     "HMI_DB".FINGER_EXTEND_TEST_PB; 
      AN    #FINGERS_RETRACT; 
      =     #FINGERS_EXTEND; 
//;  
      A     #FEEDER_SERVICE_SW; 
      A     #FINGERS_SERVICE_SW; 
      A     "HMI_DB".FINGER_RETRACT_TEST_PB; 
      AN    #FINGERS_EXTEND; 
      =     #FINGERS_RETRACT; 
//;  
      A     #FEEDER_SERVICE_SW; 
      A     #FINGERS_SERVICE_SW; 
      A     "HMI_DB".FINGER_BELT_TEST_SW; 
      =     #BELT_ON; 
//;
      A     #FEEDER_SERVICE_SW; 
      A     #FINGERS_SERVICE_SW; 
      A     "HMI_DB".FINGER_TILT_TEST_PB; 
      =     #FINGERS_TILT; 
//;
      AN    #MAIN_SERVICE_3_SW; 
      ON    #FEEDER_SERVICE_SW; 
      R     "HMI_DB".LOADER_FING_SERVICE_SSW; 
      R     "HMI_DB".LOADER_LIFT_SERVICE_SSW; 
      R     "HMI_DB".FINGER_RETRACT_TEST_PB; 
      R     "HMI_DB".FINGER_EXTEND_TEST_PB; 
      R     "HMI_DB".FINGER_TILT_TEST_PB; 
      R     "HMI_DB".FINGER_BELT_TEST_SW; 

FEED: R     #FEEDER_SERVICE_SW; 
      R     #FINGERS_SERVICE_SW; 
      R     #FINGERS_EXTEND; 
      R     #FINGERS_RETRACT; 
      R     #FINGERS_TILT; 
      FP    "FP 159.7"; 
      =     "M 70.7"; 
//;
      A     "HMI_DB".SERVICE_INIT_PB; 
      A     #FEEDER_SERVICE_SW; 
      A     #MAIN_SERVICE_3_SW; 
      =     #INITIALISATION; 
NETWORK
TITLE =Feeder - Power Enable

      A     "M 0.3"; 
      A     "M 74.0"; 
      A     "E 13.6"; 
      =     "M 70.0"; 
NETWORK
TITLE =Feeder Fingers - VFD Release

      A     "P 12.0"; 
      S     "M 70.4"; 
//;
      A     "K 50.5"; 
      R     "M 70.4"; 
NETWORK
TITLE =Feeder Fingers Belt - Run TimeOut  6s

      A     "M 71.3"; 
      AN    "M 71.4"; 
      A     "A 51.1"; 
      A     "M 70.0"; 
      L     S5T#6S; 
      SD    "Timer 70"; 
NETWORK
TITLE =Step 15N1 - Power On

      A     "M 70.0"; 
      S     "M 71.0"; 
NETWORK
TITLE =Step 15N2 - Feeder Fingers - Step Run

      A     "M 70.4"; 
      A     "M 70.0"; 
      A     "M 71.0"; 
      S     "M 71.1"; 
NETWORK
TITLE =Packets Movements - UpDate

      A(    ; 
      A     "B 11.2"; 
      A     "M 73.6"; 
      AN    "M 66.7"; 
      A     "M 67.3"; 
      AN    "M 67.4"; 
      O     ; 
      A     "B 15.7"; 
      A     "M 73.7"; 
      AN    "M 86.7"; 
      A     "M 87.3"; 
      AN    "M 87.4"; 
      )     ; 
      A     "S 2.6"; 
      AN    "E 12.2"; 
      =     "M 9.0"; 
NETWORK
TITLE =Step 15N3 - Feeder Fingers Belt - Packet Loading

      A     "M 9.0"; 
      AN    "B 12.3"; 
      A     "M 70.4"; 
      A     "M 75.4"; 
      AN    "M 75.5"; 
      A     "M 70.0"; 
      A     "M 71.1"; 
      S     "M 71.2"; 
NETWORK
TITLE =Feeder - Packet Loading Delay

      A(    ; 
      AN    "B 11.2"; 
      A     "M 73.6"; 
      A     "M 67.3"; 
      O     ; 
      AN    "B 15.7"; 
      A     "M 73.7"; 
      A     "M 87.3"; 
      )     ; 
      A     "M 70.0"; 
      A     "M 71.2"; 
      AN    "M 71.3"; 
      L     S5T#50MS; 
      SD    "Timer 71"; 
NETWORK
TITLE =Step 15N4 - Feeder Fingers Belt - Packet Loaded

      A     "Timer 71"; 
      A     "M 70.0"; 
      A     "M 71.2"; 
      S     "M 71.3"; 
NETWORK
TITLE =Feeder - Fingers Extend - Delay

      A     "B 12.3"; 
      A     "M 70.0"; 
