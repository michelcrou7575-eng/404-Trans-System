FUNCTION FC 911 : VOID
TITLE =NEW FC911 (was FC1011) - Conveyors - Clearing Function
//New Order Sequence
NAME : CLEARING
VERSION : 0.0


VAR_TEMP
  EMPTY_11 : BOOL ;	//Empty Conveyor 11
  EMPTY_21 : BOOL ;	//Empty Conveyor 21
  EMPTY_12_22 : BOOL ;	//Empty Conveyor 12 & 22
  EMPTY_13_23 : BOOL ;	//Empty Conveyor 13 & 23
  C10_EMPTY_TEST : BOOL ;	
  CLEARING_ABORT : BOOL ;	
END_VAR
BEGIN
NETWORK
TITLE =HMI Clearing Call

      A     "M 140.3"; 
      A     "HMI_DB".CLEARING_SSW_MAIN; 
      =     "M 5.2"; 
//;
      L     8; 
      A     "M 10.0"; 
      =     "HMI_DB".CLEARING_SSW_STATUS; 
      JC    CLEA; 

      L     0; 

CLEA: T     "HMI_DB".CLEARING_FUNCTION; 

      A     "M 10.0"; 
      FN    "FN 155.7"; 
      R     "HMI_DB".CLEARING_SSW_MAIN; 
      R     "M 54.2"; 
//;
      A     "M 5.2"; 
      FP    "FP 147.4"; 
      AN    "B 10.7"; // C11 - Empty
      AN    "B 11.0"; // C12 - Empty
      AN    "B 11.1"; // C13 - Empty
      AN    "B 11.2"; // C13 - Empty
      AN    "B 15.4"; // C21 - Empty
      AN    "B 15.5"; // C22 - Empty
      AN    "B 15.6"; // C23 - Empty
      AN    "B 15.7"; // C23 - Empty
      S     "M 54.2"; // Empty C11...C23
NETWORK
TITLE =New Order Seq - First New Order Packet to Pivot Conveyor 10

      A     "M 55.2"; 
      A     "M 8.5"; 
      A     "M 0.3"; 
      S     "M 7.4"; // C10 New Order - Filling - Set
//;
      A(    ; 
      A     "M 55.6"; 
      A     "M 7.5"; // C10 New Order - Full
      O     ; 
      AN    "M 7.5"; // C10 New Order -  Not Full Yet
      A     "Timer 57"; 
      A     "M 0.3"; 
      )     ; 
      R     "M 7.4"; // C10 New Order - Ready - Reset
NETWORK
TITLE =New Order Seq - Conveyor 10 Full with New Order

      A     "M 7.4"; // C10 New Order - Ready
      A     "M 55.4"; // C10 - Full Step
      A     "M 0.3"; 
      S     "M 7.5"; // C10 New Order - Full - Set [Case:A]
//;
      A     "M 7.6"; // New Order - C11...23 Ready
      A     "M 0.3"; 
      R     "M 7.5"; // C10 New Order - Full - Reset
NETWORK
TITLE =New Order Seq
//New Order Seq - Waiting for the last Order Packets to Run out !


NETWORK
TITLE =Conveyor 11 - Ready

      A     "M 59.0"; 
      AN    "M 59.1"; 
      AN    "M 59.3"; 
      =     #EMPTY_11; 
NETWORK
TITLE =Conveyor 21 - Ready

      A     "M 79.0"; 
      AN    "M 79.1"; 
      AN    "M 79.3"; 
      =     #EMPTY_21; 
NETWORK
TITLE =Conveyor 12 & 22 - Ready

      A     "M 63.0"; 
      AN    "M 63.1"; 
      AN    "M 63.3"; 
      A     "M 83.0"; 
      AN    "M 83.1"; 
      AN    "M 83.3"; 
      =     #EMPTY_12_22; 
NETWORK
TITLE =Conveyor 13 & 23 - Ready

      A     "M 67.0"; 
      AN    "M 67.1"; 
      AN    "M 67.3"; 
      A     "M 87.0"; 
      AN    "M 87.1"; 
      AN    "M 87.3"; 
      =     #EMPTY_13_23; 
NETWORK
TITLE =New Order Seq - Conveyor 11, 12, 13, 21, 22, 23 - Empty
//Case A: C10 becomes Full with New Order before C11...23 are Empty.
//Case B: C10 becomes Full with New Order After C11...23 are Empty.
      A     "M 7.5"; // New Order - C10 Full [Case:A]
      A(    ; 
      A     "M 55.6"; // C10 Step Register - Reset
      O     ; 
      A     #EMPTY_11; 
      A     #EMPTY_21; 
      A     #EMPTY_12_22; 
      A     #EMPTY_13_23; 
      )     ; 
      A     "M 0.3"; 
      S     "M 7.6"; // New Order - C11...23 Ready - Set
//;
      A     "M 7.7"; 
      A     "M 0.3"; 
      R     "M 7.6"; // New Order - C11...23 Ready - Reset
NETWORK
TITLE =Events UpDate - Conveyor 11 & 21 Waiting for Packets

      A     "M 59.0"; 
      AN    "M 59.1"; 
      AN    "M 59.3"; 
      A     "M 79.0"; 
      AN    "M 79.1"; 
      AN    "M 79.3"; 
      =     "M 9.0"; 
NETWORK
TITLE =New Order Seq - Conveyors 11, 21 - Empty

      A     "M 9.0"; 
      A     "M 7.6"; // New Order - C11...23 Ready
      A     "M 0.3"; 
      S     "M 7.7"; // New Order - C11, 21 Ready - Set
//;
      A     "M 8.0"; // New Order - C12, 22 Ready 
      A     "M 0.3"; 
      R     "M 7.7"; // New Order - C11, 22 Ready - Reset
NETWORK
TITLE =Events UpDate - Conveyor 12 & 22 Waiting for Packets

      A     "M 63.0"; 
      AN    "M 63.1"; 
      AN    "M 63.3"; 
      A     "M 83.0"; 
      AN    "M 83.1"; 
      AN    "M 83.3"; 
      =     "M 9.0"; 
NETWORK
TITLE =New Order Seq - Conveyors 11, 21, 12, 22 - Empty

      A     "M 9.0"; 
      A     "M 7.7"; 
      A     "M 0.3"; 
      S     "M 8.0"; // New Order - C12, 22 Ready - Set
//;
      A     "M 8.1"; // New Order - C13, 23 Ready 
      A     "M 0.3"; 
      R     "M 8.0"; // New Order - C12, 22 Ready - Reset
NETWORK
TITLE =Events UpDate - Conveyor 13 & 23 Waiting for Packets

      A     "M 67.0"; 
      AN    "M 67.1"; 
      AN    "M 67.3"; 
      A     "M 87.0"; 
      AN    "M 87.1"; 
      AN    "M 87.3"; 
      =     "M 9.0"; 
NETWORK
TITLE =New Order Seq - Conveyor 11, 21, 12, 22, 13, 23 - Empty

      A     "M 9.0"; 
      A     "M 8.0"; 
      A     "M 0.3"; 
      S     "M 8.1"; // New Order - C13, 23 Ready - Set
//;
      A     "M 8.2"; 
      A     "M 0.3"; 
      R     "M 8.1"; // New Order - C13, 23 Ready - Reset
NETWORK
TITLE =New Order Seq - Feeder Done & Empty

      A     "M 8.1"; // New Order - C13, 23 Ready 
      A     "M 71.1"; 
      AN    "M 71.2"; 
      AN    "M 71.4"; 
      A     "M 0.3"; 
      S     "M 8.2"; // New Order - Feeder Empty / Ready - Set
//;
      A     "M 8.3"; // New Order - Operator Enabled
      A     "M 0.3"; 
      R     "M 8.2"; // New Order - Feeder Empty / Ready - Reset
NETWORK
TITLE =Conveyor 10 Clearing Enable after New Order

      A     "S 3.2"; // Operator Switch
      A     "M 8.2"; // New Order - Feeder Empty / Ready
      A     "M 0.3"; 
      S     "M 8.3"; // New Order - Operator Enabled
      S     "M 59.4"; // C11-12-21-22 - Registers Reset
      S     "M 63.4"; 
      S     "M 79.4"; 
      S     "M 83.4"; 
//;
      R     "M 7.4"; 
      R     "M 7.5"; 
      R     "M 7.6"; 
      R     "M 7.7"; 
      R     "M 8.0"; 
      R     "M 8.1"; 
      R     "M 8.4"; 
      R     "M 8.5"; 
//;
      ON    "M 8.2"; 
      R     "M 8.3"; 
NETWORK
TITLE =New Order - Status Lamp

      A     "M 8.2"; // New Order - Feeder Empty / Ready
      AN    "M 8.3"; // New Order - Operator Not Enabled Yet
      A     "M 145.0"; 
      O     "Timer 0"; 
      =     "H 49.5"; // Feeder Enable PB Lamp  (Amber)
NETWORK
TITLE =Conveyors Clearing Blink

      A     "M 10.0"; 
      A     "M 145.4"; 
      =     "M 142.0"; 
NETWORK
TITLE =After Clearing - Delay  10s

      A     "M 0.3"; 
      A     "M 11.6"; 
      L     S5T#10S; 
      SD    "Timer 9"; 
NETWORK
TITLE =Clearing Done - Ready

      A     "M 0.3"; 
      A     "Timer 9"; 
      ON    "M 11.6"; 
      S     "M 9.7"; 
//;
      ON    "M 0.3"; 
      R     "M 9.7"; 
NETWORK
TITLE =Clearing Command
//Clearing Command


NETWORK
TITLE =Conveyors Clearing - Cmd

      A(    ; 
      A     "M 5.2"; 
      FP    "FP 157.2"; 
      O     ; 
      A     "M 150.4"; // F4
      )     ; 
      S     "M 10.0"; 
//;
      A     "HMI_DB".CLEARING_SSW_MAIN; // Fix: Abort only on a real HMI Switch OFF
      FN    "FN 155.6"; 
      A     "M 140.3"; // ... while New HMI in Control (not when M140.3 drops)
      A     "M 10.0"; 
      =     "M 5.4"; // Clearing ABORT !
      R     "M 5.2"; 
//;
      A(    ; 
      A     "M 150.4"; // Clearing ON
      A     "M 171.4"; // ENT PB
      A     "M 171.5"; // CLR PB
      O     "M 5.4"; // Clearing ABORT !
      O     "M 10.6"; 
      )     ; 
      =     #CLEARING_ABORT; 
NETWORK
TITLE =Clearing Start - Release a Hold Left from the Previous Clearing
//Fix 2026-11-19: F4 pressed while C10 still held a new order (M8.4, S3.2 not
//pressed yet) -> C10 could not transfer, the clearing could never finish.
//F4 = clear everything: at every clearing start the hold and the new-order
//sequence are reset. They are set again when this clearing is done.

      A     "M 10.0"; // Clearing CMD
      FP    M    283.4; // Edge Memory (Free)
      JCN   CST1; 

      R     "M 7.4"; 
      R     "M 7.5"; 
      R     "M 7.6"; 
      R     "M 7.7"; 
      R     "M 8.0"; 
      R     "M 8.1"; 
      R     "M 8.2"; 
      R     "M 8.3"; 
      R     "M 8.4"; // C10 Hold - Released
      R     "M 8.5"; // Clearing Done - Reset

CST1: NOP   0; 
NETWORK
TITLE =Conveyors Clearing Conveyors 1,2,3,4 - TimeOut 30S

      A     "M 10.0"; 
      A     "M 10.1"; 
      A     "M 10.2"; 
      AN    "M 10.3"; 
      L     S5T#30S; 
      SD    "Timer 128"; 
//;
      A     "Timer 128"; 
      O     #CLEARING_ABORT; 
      JNB   NCLR; 

      L     0; 
      T     "MB 10"; // Clearing OFF

NCLR: NOP   0; 
NETWORK
TITLE =Events UpDate - Clearing + Elevator + Conveyor 1, 2 - Empty

      A     "M 10.0"; 
      A     "M 15.3"; 
      AN    "M 15.4"; 
      A     "M 19.1"; 
      AN    "M 19.2"; 
      A     "M 23.0"; 
      AN    "M 23.1"; 
      AN    "B 5.4"; 
      AN    "B 6.0"; 
      AN    "B 6.1"; 
      AN    "B 6.2"; 
      =     "M 9.0"; 
NETWORK
TITLE =Elevator + Conveyor 1, 2 - Cleared -> Start Slat Clearing

      A     "M 9.0"; 
      A     "M 0.3"; 
      AN    "A 44.0"; 
      =     "M 10.1"; 
NETWORK
TITLE =Elevator + Conveyor 1, 2 - NOT Empty Alarm

      A     "M 10.0"; 
      AN    "M 9.0"; 
      S     "M 11.4"; 
NETWORK
TITLE =Clearing Sequence
//Clearing Sequence from Slat 3 to Pivot 10 Conveyors


NETWORK
TITLE =Conveyors 4 - Clearing Start - Enable Delay  3s

      A     "M 10.1"; // C1-2 Cleared
      L     S5T#2S; 
      SD    "Timer 10"; 
NETWORK
TITLE =Slat Conveyor 3 - Cleared -> Start Conveyor 4 Clearing

      A     "M 10.1"; // C1-2 Cleared
      A     "M 26.7"; 
      A     "M 0.3"; 
      S     "M 10.2"; // C3 Cleared
//;
      AN    "M 10.0"; // Clearing Off
      R     "M 10.2"; // Coherence - Reset
NETWORK
TITLE =Conveyors 3, 4 - Cleared -> Start Conveyor 5, 6 Clearing

      A(    ; 
      O     "M 31.5"; 
      O     "DB UTILITY".T33_DN; // Fix: was S5 "Timer 33" - never started (C4 uses Soft Timer T33 20s)
      )     ; 
      A     "M 10.2"; 
      A     "M 0.3"; 
      S     "M 10.3"; // C4 Cleared
//;
      AN    "M 10.2"; 
      R     "M 10.3"; // Coherence - Reset
NETWORK
TITLE =Conveyors 5, 6 - Clearing Start Delay  3s

      A     "M 10.3"; // C4 Cleared
      L     S5T#3S; 
      SD    "Timer 11"; // C4 Cleared Delayed
NETWORK
TITLE =Events UpDate - Conveyors 5, 6 - Clearing 

      A     "M 10.3"; // C4 Cleared  
      A     "Timer 11"; // C4 Cleared Delayed 
      A     "M 35.0"; 
      AN    "M 35.1"; 
      A     "M 39.0"; 
      AN    "M 39.1"; 
      =     "M 9.0"; // C5-6 Cleared  
NETWORK
TITLE =Conveyors 3, 4, 5, 6 - Cleared -> Start Conveyor 7 Clearing

      A     "M 9.0"; // C5-6 Cleared  
      A     "M 0.3"; 
      S     "M 10.4"; // C5,6 Cleared - Latch
//;
      AN    "M 10.3"; // C4 Not Cleared
      R     "M 10.4"; // Coherence - Reset
NETWORK
TITLE =Events UpDate - Flipper Belt 7 - Ready

      A     "M 10.4"; // C5-6 Cleared
      A     "M 43.1"; // C7 Cleared
      AN    "M 43.2"; 
      =     "M 9.0"; // C5-6-7 Cleared
NETWORK
TITLE =Conveyors 3, 4, 5, 6, 7, 8, 9 - Clearing - Cleared / Ready

      A     "M 9.0"; // C5-6-7 Cleared
      A     "M 47.2"; // C8 Cleared
      AN    "M 47.3"; 
      A     "M 51.1"; // C9 Cleared
      AN    "M 51.2"; 
      AN    "B 9.7"; // C9 - Pusher2 - Edge Cleared
      A     "M 0.3"; 
      L     S5T#3S; 
      SD    "Timer 56"; // Delay 3s
//;
      A     "Timer 56"; 
      =     "M 10.5"; // C10 UpStream Cleared 
      FP    "M 188.4"; 
      S     "M 58.2"; // C10 UpStream Cleared - Trigger Set
//;
      A     "M 10.5"; 
      L     S5T#1S; 
      SE    "Timer 58"; // UpStream Cleared - Pulse 1s 
NETWORK
TITLE =Clearing - C10 Proven Empty (Exit Sens Clear While Belt Runs Fast)
//Fix: Clearing used to end with packets left on C10 (nothing checked C10 itself).
//C10 is proven empty when its Exit Sens B10.6 stays clear while the belt runs
//FAST (transfer) for the time a packet needs to cross the whole belt.
//TUNE: C10 belt length / 0.52 m/s (31 m/min) + margin.  10s = about 5 m.
//Any packet seen on C10 (B10.3 / B10.4 / B10.5 / B10.6) or a Pusher 2 push
//cancels the proof (a pushed packet can sit at the infeed without C10 starting).
      A     "M 10.0"; // Clearing CMD
      A     "A 48.0"; // C10 Belt Running
      A     "A 48.1"; // C10 Fast = Transfer
      AN    "B 10.6"; // C10 Exit Sens Clear
      L     S5T#10S; // TUNE - Belt Length @ Fast
      SD    T    137; 
//;
      A     T    137; 
      S     "M 10.7"; // C10 Proven Empty - Set
//;
      A(    ; 
      O     "B 10.3"; // Pusher Extended - Packet Sens (C10 Infeed)
      O     "M 51.7"; // Pusher 2 FWD - Packet Being Pushed
      O     "B 10.4"; // C10 InFeed Sens
      O     "B 10.5"; // C10 Full Sens
      O     "B 10.6"; // C10 Exit Sens
      )     ; 
      R     "M 10.7"; // Packet Seen - Not Empty
NETWORK
TITLE =Clearing - C10 Not Proven Empty -> Call C10 Transfer Again
//Fix: After a C10 transfer ends (C11/C21 full or 20s), packets could stay on C10
//and nothing called C10 again. While clearing and C10 is not proven empty,
//re-arm the C11/C21 call (M58.2) each time C10 is back to idle.
      A     "M 10.0"; // Clearing CMD
      A     "M 10.5"; // C3...C9 Cleared
      AN    "M 10.6"; // C10 Not Cleared Yet
      AN    "M 10.7"; // C10 Not Proven Empty
      A     "M 58.3"; // C10 Did a Transfer & Stopped
      A     "M 55.0"; // C10 Steps Idle
      AN    "M 55.1"; 
      AN    "M 55.5"; // Not Transfering
      AN    "M 58.2"; // Not Already Called
      A     "M 0.3"; 
      S     "M 58.2"; // C11/C21 Trigger -> C10 Transfer
NETWORK
TITLE =Pivot Conveyor 10 - Clearing - Cleared / Ready
//"C10_EMPTY_TEST" : Work Around to "Will NOT Empty Conveyor 10 - Pivot after a 
//Clearing (F4)".
      A     "M 10.0"; // Clearing CMD - Latch
      AN    "M 10.6"; // C10 Pivot Not Cleared
      A(    ; 
      AN    "B 10.7"; // C11 Exit Sens
      A     "P 15.1"; // Pivot Low Ready
      O     ; 
      AN    "B 15.4"; // C21 Exit Sens
      A     "P 15.0"; // Pivot Hi Ready
      O     "Timer 57"; 
      )     ; 
      A     "M 6.5"; // System Clock 1s
      A     "M 10.5"; // C10 UpStream Cleared
      A     "M 10.7"; // Fix: C10 Proven Empty (No Packet Left)
      A     "M 0.3"; 
      =     #C10_EMPTY_TEST; // C10 UpStream Cleared - Pulse
//;
      A     #C10_EMPTY_TEST; // C10 UpStream Cleared - Pulse
      A     "M 58.3"; // All Steps - Reset Mem 
      S     "M 10.6"; // C10 Pivot Cleared - Set
//;
      AN    "M 10.4"; // C5 or C6 Not Empty !
      R     "M 10.6"; // C10 Pivot Cleared - Reset
NETWORK
TITLE =C10 Clearing Trigger via C11 or C21

      A     "M 9.3"; // C10 Clearing via C11-21 - Trigger 1 Scan
      R     "M 9.3"; // C10 Clearing via C11-21 - Trigger Reset
//;
      A     "Timer 58"; // UpStream Cleared - Pulse 1s
      A     "M 10.0"; // Clearing CMD - Confirm
      S     "M 9.3"; // C10 Clearing via C11-21 - Trigger Set
NETWORK
TITLE =Conveyors 1 - 9 Clearing - Clearing Done !
//New Order: C10 Full AND C11...23 Not Empty = Hold Bit! - M8.4  [Case:A]
//
//- Clearing Initiated with an empty Conveyors 11-13, 21-23: No HOLD for New 
//Order!  [Case:B]
//
//Fix: S3.2 confirmation ALWAYS required (Case B "lines empty" removed: it only
//looked at exit sensors and could skip the hold). Old M54.6 line removed (wrong bit).
      A     "M 10.6"; // Clearing Done / Off Pulse
      A     "M 0.3"; 
      S     "M 8.4"; // New Order - Wait Set (Always)
      S     "M 8.5"; // New Order - Clearing Done - Set
NETWORK
TITLE =Events UpDate - Clearing Stop - Command

      AN    "M 10.0"; 
      =     "M 9.0"; 
NETWORK
TITLE =Events UpDate - Clearing Stop - Ready

      A     "M 9.0"; 
      AN    "M 12.0"; 
      AN    "M 12.1"; 
      AN    "M 15.4"; 
      AN    "M 19.2"; 
      AN    "M 23.2"; 
      =     "M 9.0"; 
NETWORK
TITLE =Conveyors Clearing Stop - Ready

      A     "M 9.0"; 
      AN    "M 43.2"; 
      AN    "M 47.3"; 
      AN    "M 51.2"; 
      =     "M 11.6"; 
NETWORK
TITLE =New Order 
//New Order : Start Filling Conveyors


NETWORK
TITLE =Events UpDate - Elevator Packet IN

      A     "M 15.5"; 
      =     "M 9.0"; 
NETWORK
TITLE =Events UpDate - Conveyor 1 - 9 - Packet Present

      A     "M 9.0"; 
      A     "M 19.3"; 
      A     "M 23.2"; 
      A     "M 43.4"; 
      A     "M 47.4"; 
      A     "M 51.5"; 
      =     "M 11.7"; 
NETWORK
TITLE =Collator Conveyor 4 - Packet Presence - Monitor

      A     "M 31.1"; // C4 Collator Trigger Step
      AN    "M 31.2"; // C4 Collating Done / Packet ON
      A     "M 0.3"; 
      S     "M 12.0"; // 1st Packet OFF -> ON
//;
      A(    ; 
      ON    "M 31.0"; 
      O     "M 31.7"; // C4 Step Register - Reset
      )     ; 
      R     "M 12.0"; // Last Packet ON -> OFF
NETWORK
TITLE =Collator Conveyor 10 - Packet Presence - Monitor

      A     "B 10.4"; // C10 Collator Trigger Sens
      A     "M 55.1"; // C10 Collator Trigger Step
      AN    "M 55.2"; // Collating Done / Packet ON
      A     "M 0.3"; 
      S     "M 12.1"; // 1st Packet OFF -> ON
//;
      A(    ; 
      ON    "M 55.0"; 
      O     "M 55.6"; // C10 Step Register - Reset
      )     ; 
      R     "M 12.1"; // Last Packet ON -> OFF
NETWORK
TITLE =Clearing - Cancelling

      A     "M 0.3"; 
      A     "M 150.4"; 
      A     "M 171.4"; 
      A     "M 171.5"; 
      O     "M 5.4"; 
      O(    ; 
      A     "M 8.4"; 
      AN    "M 10.0"; 
      A     "M 5.0"; 
      )     ; 
      R     "M 7.4"; 
      R     "M 7.5"; 
      R     "M 7.6"; 
      R     "M 7.7"; 
      R     "M 8.0"; 
      R     "M 8.1"; 
      R     "M 8.2"; 
      R     "M 8.3"; // New Order - Operator Enabled - Reset
      R     "M 8.4"; 
      R     "M 8.5"; 
NETWORK
TITLE =Function Key F4 - Reset

      AN    "M 10.0"; 
      R     "M 150.4"; 
END_FUNCTION


FUNCTION FC 912 : VOID
TITLE =NEW FC912 (was FC1012) - Conveyor 0 & Pusher 0
NAME : 'Pos.1'
VERSION : 0.1


VAR_TEMP
  TIMER_RESET : BOOL ;	
  MAIN_SERVICE_1_SW : BOOL ;	
  CONV_0_SERVICE_FWD : BOOL ;	
  CONV_0_SERVICE_REV : BOOL ;	
  RESET_1 : BOOL ;	
  RESET_2 : BOOL ;	
  PUSHER_PUSH : BOOL ;	
END_VAR
BEGIN
NETWORK
TITLE =Conveyor 0 - Service

      A     "HMI_DB".ALL_SERVICE_ENABLE_SW; 
      A     "HMI_DB".CONVEYOR_0_SERVICE_SW; 
      A     "HMI_DB".SERVICE_SW_1_STATUS; 
      =     #MAIN_SERVICE_1_SW; 
//;
      A     #MAIN_SERVICE_1_SW; 
      O     "M 14.0"; 
      JNB   PUS0; 
      A     "HMI_DB".HMI_ROLLER_TEST_FWD_SSW; 
      FP    "FP 168.3"; 
      R     "HMI_DB".HMI_ROLLER_TEST_REV_SSW; 
      =     #RESET_1; 
//;
      A     "HMI_DB".HMI_ROLLER_TEST_REV_SSW; 
      FP    "FP 168.4"; 
      R     "HMI_DB".HMI_ROLLER_TEST_FWD_SSW; 
      =     #RESET_2; 
//;
      A(    ; 
      O     #RESET_1; 
      O     #RESET_2; 
      )     ; 
      L     S5T#1S; 
      SF    "Timer 110"; 
//;
      A     "HMI_DB".HMI_ROLLER_TEST_FWD_SSW; 
      AN    "Timer 110"; 
      =     #CONV_0_SERVICE_FWD; 
//;
      A     "HMI_DB".HMI_ROLLER_TEST_REV_SSW; 
      AN    "Timer 110"; 
      =     #CONV_0_SERVICE_REV; 
//;
      A     "HMI_DB".HMI_PUSHER_0_TEST_SSW; 
      =     #PUSHER_PUSH; 
//;
      AN    #MAIN_SERVICE_1_SW; 
      R     "HMI_DB".HMI_ROLLER_TEST_FWD_SSW; 
      R     "HMI_DB".HMI_ROLLER_TEST_REV_SSW; 

PUS0: R     #CONV_0_SERVICE_FWD; 
      R     #CONV_0_SERVICE_REV; 
      R     #RESET_1; 
      R     #RESET_2; 
      R     #PUSHER_PUSH; 
      FP    "FP 158.0"; 
      =     "M 14.0"; 
NETWORK
TITLE =Function Keys <F5 > on HMI - Reset

      A     "M 13.3"; 
      AN    "M 153.7"; 
      R     "M 150.3"; 
NETWORK
TITLE =Packet goes Through - 2145 Desk R-21 - Run / Timeout

      A     "B 35.3"; 
      FP    "FP 168.1"; 
      =     #TIMER_RESET; // TimeOut - Reset Trigger
//;
      A     "S 28.3"; 
      O     "M 111.0"; 
      O     "M 11.1"; // VFD NOT All Ready !... Goes Through
      AN    #TIMER_RESET; // TimeOut - Reset Action
      L     S5T#10M; 
      SD    "Timer 34"; // TimeOut 10m
//;
      A     "S 28.3"; // R-21 Operator Switch
      O     "M 111.0"; // New HMI SSW
      O     "M 11.1"; // VFD NOT All Ready !... Goes Through
      FP    "FP 168.2"; // Turn ON - Pulse
      S     "M 133.4"; // Goes Through - Set
//;
      A     "S 28.3"; // Goes Through - Refresh
      O     "M 111.0"; 
      O     "M 11.1"; // VFD NOT All Ready !... Goes Through
      A(    ; 
      O     "E 34.7"; // Turn ON - Refresh 
      O     "M 37.1"; 
      O     "B 35.3"; // Turn ON - Refresh 
      )     ; 
      S     "M 133.4"; // Goes Through - Set
//;
      A(    ; 
      O(    ; 
      AN    "S 28.3"; 
      FP    "FP 147.1"; // Turn OFF - Pulse
      )     ; 
      O(    ; 
      AN    "M 111.0"; 
      FP    "FP 147.3"; // Turn OFF - Pulse
      O     "Timer 34"; // TimeOut 10m - Flag
      )     ; 
      O(    ; 
      AN    "M 11.1"; // VFD NOT All Ready !... Goes Through - Reset
      FP    "FP 157.7"; 
      )     ; 
      )     ; 
      R     "M 133.4"; // Goes Through
      R     "HMI_DB".ROLLER_SSW_MAIN; 
NETWORK
TITLE =
//
//      A     "E 2.4"
//      S     "M 33.0"                    // Solid Detected ?
////;
//      A     "M 33.0"                    // Delay Timer - Start
//      L     S5T#300MS
//      SD    "Timer 26"                  // Debouncer 300mS
////;
//      A     "Timer 26"                  // Delayed Test Pulse
//      AN    "E 2.4"                     // Foul Detection
//      R     "M 33.0"                    // Not Detected !
////;
//      A     "Timer 26"                  // Delayed Test Pulse
//      A     "M 33.0"                    // Detection Comfirm !
//      =     "M 33.1"                    // Packet Height OK
//      R     "M 33.0"                    // Reset
//


NETWORK
TITLE =Packet Height - Sensing / Debouncing

      A     "B 35.2"; // B72.0 Adjustable
      S     "M 37.0"; // Solid Detected ?
//;
      A     "M 37.0"; // Delay Timer - Start
      L     S5T#200MS; 
      SD    "Timer 76"; // Debouncer 300mS
//;
      A     "Timer 76"; // Delayed Test Pulse
      AN    "B 35.2"; // Foul Detection
      R     "M 37.0"; // Not Detected !
//;
      A     "Timer 76"; // Delayed Test Pulse
      A     "M 37.0"; // Detection Comfirm !
      =     "M 37.1"; // Packet Height OK
      R     "M 37.0"; // Reset
NETWORK
TITLE =Packet Infeed / Height Eject

      A     "M 134.0"; 
      S     "M 33.6"; // Presumed too small
//;
      AN    "E 34.7"; // Flap Closing
      L     S5T#5S; // TimeOut Reset 5s
      SD    "Timer 61"; 
//;
      A     "M 33.6"; // Presumed too small
//    A     "M 33.1"                    // Packet Height OK ?
      O     "Timer 61"; // 5 Sec Delayed Reset
      R     "M 33.6"; // Not too small
//;
      A     "B 35.3"; // Sliding Sensor
      FP    "FP 147.6"; 
      A     "M 33.6"; // Is too small ?
      S     "M 33.3"; // Eject Action !     
//;
      A     "M 34.7"; // Eject Done
      R     "M 33.3"; // Eject Action      
      R     "M 34.7"; // Eject Done
NETWORK
TITLE =Eject Comfirmation

      A     "M 13.0"; 
      JNB   OUT1; 

      A     "B 35.3"; 
      AN    "M 132.6"; // Not Triggered by Pusher
      S     "M 34.3"; // Eject Step 1
//;
      A     "B 35.4"; 
      AN    "M 132.6"; // Not Triggered by Pusher
      S     "M 34.4"; // Eject Step 2
//;
      A     "K 62.0"; // Conveyor 0 - Running
      A     "M 153.7"; 
      A     "M 34.3"; // Eject Step 1
      A     "M 34.4"; // Eject Step 2
      S     "M 34.5"; // Eject Step 3
//;
      A     "M 34.5"; // Eject Step 3
      AN    "B 35.4"; // Eject Step 4
      S     "M 34.7"; // Eject Done
      R     "M 34.3"; // Eject Step 1 - Reset
      R     "M 34.4"; // Eject Step 2 - Reset
      R     "M 34.5"; // Eject Step 3 - Reset   
      R     "M 33.3"; // Eject Action - Reset
//;
      A     "M 132.5"; // Reset with Pusher Extend
      A     "B 35.4"; 
      R     "M 34.3"; // Eject Step 1 - Reset
      R     "M 34.4"; // Eject Step 2 - Reset
      R     "M 34.5"; // Eject Step 3 - Reset   
      R     "M 33.3"; // Eject Action - Reset

OUT1: CLR   ; 
NETWORK
TITLE =Packet goes Through - Conveyor 0 Man Run - LAUER F5

      O     "M 150.3"; 
      O     "M 133.4"; // Goes Through - Trigger
      O     "M 33.7"; 
      O     "M 33.3"; 
