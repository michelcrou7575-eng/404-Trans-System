CO12: R     #SERVICE_RUN; 
      FP    "FP 148.1"; 
      =     "M 62.7"; 
NETWORK
TITLE =FL Power Enable

      A     "M 0.3"; 
      =     "M 62.0"; 
NETWORK
TITLE =Conveyor 12 - Running TimeOut  30s

      A(    ; 
      A     "M 63.1"; 
      AN    "M 63.2"; 
      O     ; 
      A     "M 63.3"; 
      AN    "M 63.4"; 
      A     "A 48.6"; 
      )     ; 
