FUNCTION FC 978 : VOID
TITLE =NEW FC978 (was FC1078) - Conveyor 21 - Link 1H Pos. 13 High Leve
//
NAME : POS_13_H
VERSION : 0.0


VAR_TEMP
  MAIN_SERVICE_2_SW : BOOL ;	
  SERVICE_RUN : BOOL ;	
  INITIALISATION : BOOL ;	
  BARRIER_BLINKER : BOOL ;	
END_VAR
BEGIN
NETWORK
TITLE =Conveyor 21 - Service

      A     "HMI_DB".ALL_SERVICE_ENABLE_SW; 
      A     "HMI_DB".CONVEYOR_21_SERVICE_SW; 
      A     "HMI_DB".SERVICE_SW_2_STATUS; 
      =     #MAIN_SERVICE_2_SW; 
//;
      A     #MAIN_SERVICE_2_SW; 
      O     "M 78.7"; 
      JNB   CO21; 
//;    
      A     "HMI_DB".HMI_CONVEYOR_21_TEST_SSW; 
      AN    "A 48.0"; 
      =     #SERVICE_RUN; 
      S     "DB UTILITY".Conveyor_10_Disable; 
      S     "DB UTILITY".Pivot_Disable; 
//;
      A     "HMI_DB".SERVICE_INIT_PB; 
      =     #INITIALISATION; 
//;
      AN    #MAIN_SERVICE_2_SW; 
      R     "HMI_DB".HMI_CONVEYOR_21_TEST_SSW; 
      R     "DB UTILITY".Conveyor_10_Disable; 
      R     "DB UTILITY".Pivot_Disable; 

CO21: R     #SERVICE_RUN; 
      R     #INITIALISATION; // Fix: temp not written when service is off
      FP    "FP 148.3"; 
      =     "M 78.7"; 
NETWORK
TITLE =Power Enable

      A     "M 0.3"; 
      AN    "DB UTILITY".Conveyor_21_Disable; 
      =     "M 78.0"; 
NETWORK
TITLE =Conveyor 21- Running TimeOut  30s

      A(    ; 
      A     "M 79.1"; 
      AN    "M 79.2"; 
      O     ; 
      A     "M 79.3"; 
      AN    "M 79.4"; 
      A     "A 53.4"; 
      )     ; 
      A     "M 78.0"; 
      L     S5T#30S; 
      SD    "Timer 79"; // C21 TimeOut
NETWORK
TITLE =Steps Register - Reset

      A(    ; 
      A     "M 79.1"; // Filling Step
      AN    "M 79.2"; // Filling Step - Done
      A     "Timer 79"; // C21 TimeOut
      O     "M 79.4"; 
      O     #INITIALISATION; 
      O     "DB UTILITY".Conveyor_21_Disable; 
      )     ; 
      A     "M 78.0"; 
      JC    M001; 
      JU    M002; 

M001: L     W#16#0; 
      T     "MW 79"; // Step Register - Reset
      T     "MB 81"; // Step Register - Reset

M002: NOP   0; 
NETWORK
TITLE =Step 22N1 - Power ON

      A     "M 78.0"; 
      S     "M 79.0"; 
NETWORK
TITLE =Step 22N2 - Conveyor 21 - Packet Filling & Trig Conveyor 10
//Flag M 8.4 Holds the Conveyor 21 Belt until New Order Confirm
      A(    ; 
      A     "P 15.0"; // Pivot Position HIGH OK
      A(    ; 
      O     "M 55.4"; // C10 Collator Full - Step - C21 Trigger
      O     "M 58.2"; // C10 Clearing - UpStream Cleared - C21 Trigger
      )     ; 
      AN    "M 55.5"; // C10 Not Tranfering
      AN    "M 8.4"; // Not Wait After Clearing
      O     ; 
      A     "B 15.4"; // Re-Trigger...
      AN    "M 79.1"; // If Not Filling
      O     ; 
      A     "M 9.3"; // C10 Clearing - Transfer Trigger 
      A     "P 15.0"; // Fix: Only if the Pivot is HIGH (C10 can only transfer to C21)
      )     ; 
      O     #SERVICE_RUN; // Drive Test - Logic : DON'T CARE!
      A     "M 78.0"; 
      A     "M 79.0"; 
      S     "M 79.1"; // C21 Filling Step - Set
NETWORK
TITLE =Step 22N3 - Conveyor 21 - Stop Filling

      A     "B 15.4"; // C21 Exit Sens
      A     "M 78.0"; 
      A     "M 79.1"; // C21 Filling Step
      S     "M 79.2"; // Filling Stop Step - Set
NETWORK
TITLE =Step 22N4 - Conveyor 21 - Transfering

      A     "M 83.1"; // Called by C22
      AN    "M 83.2"; // C22 Not Full Yet!
      A     "M 78.0"; 
      A     "M 79.2"; // C21 Filling Stop Step - Done
      S     "M 79.3"; // C21 Transfering Step - Set
NETWORK
TITLE =Step 22N5 - Conveyor 21 - Steps Register - Reset

      A(    ; 
      O     "B 15.5"; // C22 Full -> Stop C21
      O     "Timer 79"; // C21 TimeOut
      )     ; 
      A     "M 78.0"; 
      A     "M 79.3"; // Transfering Step 
      S     "M 79.4"; // Register Reset - Trigger Set
NETWORK
TITLE =Conveyor  21 VFD - Release

      A(    ; 
      A     "M 79.1"; // Filling Step 
      AN    "M 79.2"; // Filling Step - Done
      O     ; 
      A     "M 79.3"; // Transfering Step
      AN    "M 79.4"; // Transfering Done - Register Reset
      )     ; 
      A     "M 78.0"; 
      AN    "M 11.1"; // VFD NOT All Ready !
      =     "A 53.4"; 
      =     "A 53.5"; 
END_FUNCTION


FUNCTION FC 982 : VOID
TITLE =NEW FC982 (was FC1082) - Conveyor 22 - Link 2H Pos. 14 High Leve
//  
NAME : POS_14_H
VERSION : 0.0


VAR_TEMP
  MAIN_SERVICE_2_SW : BOOL ;	
  SERVICE_RUN : BOOL ;	
END_VAR
BEGIN
NETWORK
TITLE =Conveyor 22 - Service

      A     "HMI_DB".ALL_SERVICE_ENABLE_SW; 
      A     "HMI_DB".CONVEYOR_21_SERVICE_SW; 
      A     "HMI_DB".SERVICE_SW_2_STATUS; 
      =     #MAIN_SERVICE_2_SW; 
//;
      A     #MAIN_SERVICE_2_SW; 
      O     "M 82.7"; 
      JNB   CO22; 
//;    
      A     "HMI_DB".HMI_CONVEYOR_22_TEST_SSW; 
      =     #SERVICE_RUN; 
//;
      AN    #MAIN_SERVICE_2_SW; 
      R     "HMI_DB".HMI_CONVEYOR_22_TEST_SSW; 

CO22: R     #SERVICE_RUN; 
      FP    "FP 148.4"; 
      =     "M 82.7"; 
NETWORK
TITLE =Power Enable

      A     "M 0.3"; 
      =     "M 82.0"; 
NETWORK
TITLE =Conveyor 22 - Running TimeOut  30s

      A(    ; 
      A     "M 83.1"; 
      AN    "M 83.2"; 
      O     ; 
      A     "M 83.3"; 
      AN    "M 83.4"; 
      A     "A 53.6"; 
      )     ; 
      A     "M 82.0"; 
      L     S5T#30S; 
      SD    "Timer 83"; 
NETWORK
TITLE =Conveyor 22 - Steps Register - Reset

      A(    ; 
      A     "M 83.1"; 
      AN    "M 83.2"; 
      A     "Timer 83"; 
      O     "M 83.4"; 
      )     ; 
      A     "M 82.0"; 
      JC    M001; 
      JU    M002; 

M001: L     W#16#0; 
      T     "MW 83"; 
      T     "MB 85"; 

M002: NOP   0; 
NETWORK
TITLE =Step 23N1 - Power On

      A     "M 82.0"; 
      S     "M 83.0"; 
NETWORK
TITLE =Step 23N2 - Conveyor 22 - Packet Filling

      A(    ; 
      A     "M 79.2"; 
      AN    "M 79.3"; 
      O     ; 
      A     "B 15.5"; 
      AN    "M 83.1"; 
      )     ; 
      O     #SERVICE_RUN; // Drive Test - Logic : DON'T CARE!
      A     "M 82.0"; 
      A     "M 83.0"; 
      S     "M 83.1"; 
NETWORK
TITLE =Step 23N3 - Conveyor 22 - Stop Filling

      A     "B 15.5"; 
      A     "M 82.0"; 
      A     "M 83.1"; 
      S     "M 83.2"; 
NETWORK
TITLE =Step 23N4 - Conveyor 22 - Transfering

      A     "M 87.1"; 
      AN    "M 87.2"; 
      A     "M 82.0"; 
      A     "M 83.2"; 
      S     "M 83.3"; 
NETWORK
TITLE =Step 23N5 - Conveyor 22 - Steps Register - Reset

      A(    ; 
      O     "B 15.7"; 
      O     "Timer 83"; 
      )     ; 
      A     "M 82.0"; 
      A     "M 83.3"; 
      S     "M 83.4"; 
NETWORK
TITLE =Conveyor  22 VFD - Release

      A(    ; 
      A     "M 83.1"; 
      AN    "M 83.2"; 
      O     ; 
      A     "M 83.3"; 
      AN    "M 83.4"; 
      )     ; 
      A     "M 82.0"; 
      AN    "M 11.1"; // VFD NOT All Ready !
      =     "A 53.6"; 
      =     "A 53.7"; 
END_FUNCTION


FUNCTION FC 986 : VOID
TITLE =NEW FC986 (was FC1086) - Conveyor 23 - Delivery Second Level
//
NAME : POS_15_H
VERSION : 0.0


VAR_TEMP
  MAIN_SERVICE_2_SW : BOOL ;	
  SERVICE_RUN : BOOL ;	
END_VAR
BEGIN
NETWORK
TITLE =Conveyor 23 - Service

      A     "HMI_DB".ALL_SERVICE_ENABLE_SW; 
      A     "HMI_DB".CONVEYOR_21_SERVICE_SW; 
      A     "HMI_DB".SERVICE_SW_2_STATUS; 
      =     #MAIN_SERVICE_2_SW; 
//;
      A     #MAIN_SERVICE_2_SW; 
      O     "M 86.1"; 
      JNB   CO23; 
//;    
      A     "HMI_DB".HMI_CONVEYOR_23_TEST_SSW; 
      =     #SERVICE_RUN; 
//;
      AN    #MAIN_SERVICE_2_SW; 
      R     "HMI_DB".HMI_CONVEYOR_23_TEST_SSW; 

CO23: R     #SERVICE_RUN; 
      FP    "FP 149.3"; 
      =     "M 86.1"; 
NETWORK
TITLE =Delivery Conveyor 23 - Running TimeOut  30s

      A     "M 87.1"; 
      AN    "M 87.3"; 
      A     "A 54.0"; 
      A     "M 86.0"; 
      L     S5T#30S; 
      SD    "Timer 86"; 
NETWORK
TITLE =FL Conveyor 23 - Next Delivery

      A     "B 15.7"; 
      A     "M 87.5"; 
      AN    "M 87.6"; 
      A     "M 0.3"; 
      S     "M 86.6"; 
//;
      A     "M 87.3"; 
      AN    "M 87.4"; 
      R     "M 86.6"; 
NETWORK
TITLE =Delivery Conveyor 23 - Empty TimeOut  3s

      A     "M 87.4"; 
      AN    "M 87.5"; 
      A     "B 15.7"; 
      A     "M 0.3"; 
      A     "A 54.0"; 
      L     S5T#3S; 
      SD    "Timer 87"; 
NETWORK
TITLE =Delivery Conveyor 23 - Ready

      A     "Timer 87"; 
      S     "M 86.7"; 
//;
      A     "M 9.1"; // Fix: Same as C13 - All Reset PBs (S0.7, S2.7, HMI E34.1) - Was S 2.7 only
      AN    "B 15.7"; 
      A     "M 0.3"; 
      R     "M 86.7"; 
NETWORK
TITLE =FL Conveyor 23 - Power Enable

      A     "M 0.3"; 
      AN    "DB UTILITY".Conveyor_23_Disable; 
      =     "M 86.0"; 
NETWORK
TITLE =Step     24N1 - Conveyor 23 - Power On

      A     "M 86.0"; 
      S     "M 87.0"; 
NETWORK
TITLE =Step     24N2 - Conveyor 23 - Filling

      A(    ; 
      A     "M 83.2"; 
      AN    "M 83.3"; 
      O     ; 
      A(    ; 
      O     "B 15.6"; 
      O     "B 15.7"; 
      )     ; 
//      O     #SERVICE_RUN
      AN    "M 87.1"; 
      )     ; 
      A     "M 86.0"; 
      A     "M 87.0"; 
      S     "M 87.1"; 
NETWORK
TITLE =Step     24N3 - Conveyor 23 - Stop

      A(    ; 
      O     "B 15.6"; 
      O     "B 15.7"; 
      )     ; 
      A     "M 86.0"; 
      A     "M 87.1"; 
      S     "M 87.2"; 
NETWORK
TITLE =Step     24N4 - Conveyor 23 - No Vacancy

      A     "B 15.7"; 
      A     "M 86.0"; 
      A     "M 87.2"; 
      S     "M 87.3"; 
NETWORK
TITLE =Step     24N5 - Conveyor 23 - Delivery

      A(    ; 
      AN    "P 13.2"; 
      A     "M 71.2"; 
      AN    "M 71.3"; 
      A     "M 73.7"; 
      ON    "B 15.7"; 
      )     ; 
      AN    "M 86.7"; 
      A     "M 86.0"; 
      A     "M 87.3"; 
      S     "M 87.4"; 
NETWORK
TITLE =Write 1 to Steps 0-3 Byte Register MB87

      A(    ; 
      O     "M 86.6"; 
      O     "M 86.7"; 
      )     ; 
      A     "M 87.4"; 
      A     "M 86.0"; 
      JC    M001; 
      JU    M002; 

M001: L     2#1111; 
      T     "MB 87"; 

M002: NOP   0; 
NETWORK
TITLE =Step     24N6 - Conveyor 23 - Delivery Done

      AN    "B 15.7"; 
      A     "M 86.0"; 
      A     "M 87.4"; 
      S     "M 87.5"; 
NETWORK
TITLE =Delivery Conveyor 23 - Next Delivery - Delay

      A     "M 87.5"; 
      AN    "M 87.6"; 
      A     "A 54.0"; 
      A     "M 86.0"; 
      L     S5T#3S; 
      SD    "Timer 89"; 
NETWORK
TITLE =Step     24N7 - Conveyor 23 - Steps Reset

      A     "Timer 89"; 
      A     "M 86.0"; 
      A     "M 87.5"; 
      S     "M 87.6"; 
NETWORK
TITLE =Steps Register - Reset

      A(    ; 
      O     "M 87.6"; 
      O     "Timer 86"; 
      )     ; 
      A     "M 86.0"; 
      JC    M003; 
      JU    M004; 

M003: L     2#0; 
      T     "MW 87"; 

M004: NOP   0; 
NETWORK
TITLE =Conveyor  23 VFD - Release

      A(    ; 
      A     "M 87.1"; 
      AN    "M 87.3"; 
      O     ; 
      A     "M 87.4"; 
      AN    "M 87.5"; 
      A     "M 70.0"; 
      O     ; 
      A     "M 87.5"; 
      AN    "M 87.6"; 
      O     "M 86.4"; 
      )     ; 
      A     "M 86.0"; 
      =     "A 54.0"; 
NETWORK
TITLE =Conveyor Filling

      A     "M 87.1"; 
      AN    "M 87.2"; 
      A     "M 86.0"; 
      =     "A 54.1"; 
NETWORK
TITLE =Conveyor  23 VFD - Slow

      A(    ; 
      A     "M 87.2"; 
      AN    "M 87.3"; 
      O     ; 
      A     "M 87.4"; 
      AN    "M 87.6"; 
      O     "M 86.4"; 
      )     ; 
      A     "M 86.0"; 
      =     "A 54.2"; 
NETWORK
TITLE =Conveyor 23 - Delivering ON

      A     "M 87.2"; 
      AN    "M 87.3"; 
      S     "M 86.4"; 
      A(    ; 
      ON    "M 87.2"; 
      O     "M 87.3"; 
      )     ; 
      R     "M 86.4"; 
END_FUNCTION


