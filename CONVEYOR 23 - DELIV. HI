FUNCTION "CONVEYOR 23 - DELIV. HI" : VOID
TITLE =Conveyor 23 - Delivery Second Level
//
NAME : POS_15_H
VERSION : 0.0


VAR_TEMP
  MAIN_SERVICE_2_SW : BOOL ;	
  SERVICE_RUN : BOOL ;	
END_VAR
BEGIN
NETWORK
TITLE =Conveyor 23 - Service

      A     "HMI_DB".ALL_SERVICE_ENABLE_SW; 
      A     "HMI_DB".CONVEYOR_21_SERVICE_SW; 
      A     "HMI_DB".SERVICE_SW_2_STATUS; 
      =     #MAIN_SERVICE_2_SW; 
//;
      A     #MAIN_SERVICE_2_SW; 
      O     "M 86.1"; 
      JNB   CO23; 
//;    
      A     "HMI_DB".HMI_CONVEYOR_23_TEST_SSW; 
      =     #SERVICE_RUN; 
//;
      AN    #MAIN_SERVICE_2_SW; 
      R     "HMI_DB".HMI_CONVEYOR_23_TEST_SSW; 

CO23: R     #SERVICE_RUN; 
      FP    "FP 149.3"; 
      =     "M 86.1"; 
NETWORK
TITLE =Delivery Conveyor 23 - Running TimeOut  30s

      A     "M 87.1"; 
      AN    "M 87.3"; 
      A     "A 54.0"; 
      A     "M 86.0"; 
      L     S5T#30S; 
      SD    "Timer 86"; 
NETWORK
TITLE =FL Conveyor 23 - Next Delivery

      A     "B 15.7"; 
      A     "M 87.5"; 
      AN    "M 87.6"; 
      A     "M 0.3"; 
      S     "M 86.6"; 
//;
      A     "M 87.3"; 
      AN    "M 87.4"; 
      R     "M 86.6"; 
NETWORK
TITLE =Delivery Conveyor 23 - Empty TimeOut  3s

      A     "M 87.4"; 
      AN    "M 87.5"; 
      A     "B 15.7"; 
      A     "M 0.3"; 
      A     "A 54.0"; 
      L     S5T#3S; 
      SD    "Timer 87"; 
NETWORK
TITLE =Delivery Conveyor 23 - Ready

      A     "Timer 87"; 
      S     "M 86.7"; 
//;
      A     "S 2.7"; 
      AN    "B 15.7"; 
      A     "M 0.3"; 
      R     "M 86.7"; 
NETWORK
TITLE =FL Conveyor 23 - Power Enable

      A     "M 0.3"; 
      AN    "DB UTILITY".Conveyor_23_Disable; 
      =     "M 86.0"; 
NETWORK
TITLE =Step     24N1 - Conveyor 23 - Power On

      A     "M 86.0"; 
      S     "M 87.0"; 
NETWORK
TITLE =Step     24N2 - Conveyor 23 - Filling

      A(    ; 
      A     "M 83.2"; 
      AN    "M 83.3"; 
      O     ; 
      A(    ; 
      O     "B 15.6"; 
      O     "B 15.7"; 
      )     ; 
//      O     #SERVICE_RUN
      AN    "M 87.1"; 
      )     ; 
      A     "M 86.0"; 
      A     "M 87.0"; 
      S     "M 87.1"; 
NETWORK
TITLE =Step     24N3 - Conveyor 23 - Stop

      A(    ; 
      O     "B 15.6"; 
      O     "B 15.7"; 
      )     ; 
      A     "M 86.0"; 
      A     "M 87.1"; 
      S     "M 87.2"; 
NETWORK
TITLE =Step     24N4 - Conveyor 23 - No Vacancy

      A     "B 15.7"; 
      A     "M 86.0"; 
      A     "M 87.2"; 
      S     "M 87.3"; 
NETWORK
TITLE =Step     24N5 - Conveyor 23 - Delivery

      A(    ; 
      AN    "P 13.2"; 
      A     "M 71.2"; 
      AN    "M 71.3"; 
      A     "M 73.7"; 
      ON    "B 15.7"; 
      )     ; 
      AN    "M 86.7"; 
      A     "M 86.0"; 
      A     "M 87.3"; 
      S     "M 87.4"; 
NETWORK
TITLE =Write 1 to Steps 0-3 Byte Register MB87

      A(    ; 
      O     "M 86.6"; 
      O     "M 86.7"; 
      )     ; 
      A     "M 87.4"; 
      A     "M 86.0"; 
      JC    M001; 
      JU    M002; 

M001: L     2#1111; 
      T     "MB 87"; 

M002: NOP   0; 
NETWORK
TITLE =Step     24N6 - Conveyor 23 - Delivery Done

      AN    "B 15.7"; 
      A     "M 86.0"; 
      A     "M 87.4"; 
      S     "M 87.5"; 
NETWORK
TITLE =Delivery Conveyor 23 - Next Delivery - Delay

      A     "M 87.5"; 
      AN    "M 87.6"; 
      A     "A 54.0"; 
      A     "M 86.0"; 
      L     S5T#3S; 
      SD    "Timer 89"; 
NETWORK
TITLE =Step     24N7 - Conveyor 23 - Steps Reset

      A     "Timer 89"; 
      A     "M 86.0"; 
      A     "M 87.5"; 
      S     "M 87.6"; 
NETWORK
TITLE =Steps Register - Reset

      A(    ; 
      O     "M 87.6"; 
      O     "Timer 86"; 
      )     ; 
      A     "M 86.0"; 
      JC    M003; 
      JU    M004; 

M003: L     2#0; 
      T     "MW 87"; 

M004: NOP   0; 
NETWORK
TITLE =Conveyor  23 VFD - Release

      A(    ; 
      A     "M 87.1"; 
      AN    "M 87.3"; 
      O     ; 
      A     "M 87.4"; 
      AN    "M 87.5"; 
      A     "M 70.0"; 
      O     ; 
      A     "M 87.5"; 
      AN    "M 87.6"; 
      O     "M 86.4"; 
      )     ; 
      A     "M 86.0"; 
      =     "A 54.0"; 
NETWORK
TITLE =Conveyor Filling

      A     "M 87.1"; 
      AN    "M 87.2"; 
      A     "M 86.0"; 
      =     "A 54.1"; 
NETWORK
TITLE =Conveyor  23 VFD - Slow

      A(    ; 
      A     "M 87.2"; 
      AN    "M 87.3"; 
      O     ; 
      A     "M 87.4"; 
      AN    "M 87.6"; 
      O     "M 86.4"; 
      )     ; 
      A     "M 86.0"; 
      =     "A 54.2"; 
NETWORK
TITLE =Conveyor 23 - Delivering ON

      A     "M 87.2"; 
      AN    "M 87.3"; 
      S     "M 86.4"; 
      A(    ; 
      ON    "M 87.2"; 
      O     "M 87.3"; 
      )     ; 
      R     "M 86.4"; 
END_FUNCTION

