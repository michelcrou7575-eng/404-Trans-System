   Bit_1_FrontEnd : BOOL ;	
   Bit_0_RearEnd : BOOL ;	
   Bit_1_RearEnd : BOOL ;	
   Packet_Exiting : BOOL ;	
   Count_Error : BOOL ;	
   Sens_Error : BOOL ;	
   FirstScan_Init_Done : BOOL ;	
