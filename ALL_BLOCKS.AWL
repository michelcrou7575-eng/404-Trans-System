END_FUNCTION

FUNCTION "HMI PACKET COUNTER  NEW" : VOID
TITLE =HMI Conveyors Display Packet Counter  FC1208
//Counts are kept in "HMI_DB" (read by HMI, LIGHT BAR, C5 Re-Sync)
//Bit_0 = InFeed  /  Bit_1 = RAW Exit Sensor  /
//Transfer_Start = Transfer Step Active.
VERSION : 0.3


VAR_TEMP
  ERROR : BOOL ;	
  BIT0 : BOOL ;	//Count UP Input
  XFER : BOOL ;	//Transfer Active
  DIM_31 : INT ;	//C10 Width @ 31.0 m/min [mS]
  DIM_237 : INT ;	//C10 Width @ 23.7 m/min [mS]
END_VAR
BEGIN
NETWORK
TITLE =Packet Length mm - To Conveyor 4 HMI (as FC1206)

      L     "COLLATORS DB".PacketLength_C4; 
      ITD   ; 
      DTR   ; 
      L     6.673000e+00; 
      *R    ; 
      RND   ; 
      T     "MW 202"; 
NETWORK
TITLE =C10 Packet Width [mS] - Scaled to Link & Delivery Speeds

      L     "COLLATORS DB".Packet_Width_C10_mS; // Measured @ 27.0 m/min
      L     L#27; 
      *D    ; 
      L     L#31; 
      /D    ; 
      T     #DIM_31; // @ 31.0 m/min
      L     "COLLATORS DB".Packet_Width_C10_mS; 
      L     L#270; 
      *D    ; 
      L     L#237; 
      /D    ; 
      T     #DIM_237; // @ 23.7 m/min
NETWORK
TITLE =Packet Counter - Slat Conveyor 3

      A     "A 44.0"; 
      L     S5T#1S; 
      SF    T    118; // Call Hold 1s
      A     T    118; 
      JNB   M440; 
      L     "HMI_DB".CONVEYOR_MAXCOUNT_L; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C3_Slat.Maximum_Count; 
      A     "B 6.2"; 
      =     #BIT0; 
      A     "A 44.0"; 
      =     #XFER; 
      CALL "DE-BOUNCER / COUNTER" (
           Bit_0                    := #BIT0,
           Bit_1                    := "B 6.4",
           Transfer_Start           := #XFER,
           Error_Reset              := "M 9.1",
           Space_DX_mS              := 600,
           ReSample_DX              := 85,
           Conveyor_Type            := 1,
           Preset_MIN_mS            := 500,
           LowSpd_Dimension_mS      := 0,
           HighSpd_Dimension_mS     := 0,
           Plc_Scan_mS              := "DB UTILITY".Scan_Cycle_Previous,
           Q_Error                  := #ERROR,
           Word_Count               := "HMI_DB".CONV_3_COUNT,
           IO_DB                    := "DEBOUNCER COUNTER DB".Conveyor_C3_Slat);
M440: NOP   0; 
NETWORK
TITLE =Packet Counter - Collator Conveyor 4

      A     "A 44.3"; 
      L     S5T#1S; 
      SF    T    119; // Call Hold 1s
      A     T    119; 
      JNB   M443; 
      L     "HMI_DB".CONVEYOR_MAXCOUNT_L; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C4_Collator.Maximum_Count; 
      A     "B 6.7"; 
      =     #BIT0; 
      A     "M 31.6"; 
      AN    "M 31.7"; 
      =     #XFER; 
      CALL "DE-BOUNCER / COUNTER" (
           Bit_0                    := #BIT0,
           Bit_1                    := "B 7.0",
           Transfer_Start           := #XFER,
           Error_Reset              := "M 9.1",
           Space_DX_mS              := 600,
           ReSample_DX              := 85,
           Conveyor_Type            := 1,
           Preset_MIN_mS            := 500,
           LowSpd_Dimension_mS      := 0,
           HighSpd_Dimension_mS     := "HOUSE_KEEPING DB".C4_Packet_Length_mS,
           Plc_Scan_mS              := "DB UTILITY".Scan_Cycle_Previous,
           Q_Error                  := #ERROR,
           Word_Count               := "HMI_DB".CONV_4_COUNT,
           IO_DB                    := "DEBOUNCER COUNTER DB".Conveyor_C4_Collator);
M443: NOP   0; 
NETWORK
TITLE =Packet Counter - Link Conveyor 5

      A     "A 45.0"; 
      L     S5T#1S; 
      SF    "Timer 120"; // Call Hold 1s
      A     "Timer 120"; 
      =     "M 143.0"; 
      JNB   M450; 
      L     "HMI_DB".CONVEYOR_MAXCOUNT_L; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C5_Link.Maximum_Count; 
      A     "B 7.0"; 
      A     "M 35.1"; 
      AN    "M 35.2"; 
      =     #BIT0; 
      A     "M 35.3"; 
      AN    "M 35.4"; 
      =     #XFER; 
      CALL "DE-BOUNCER / COUNTER" (
           Bit_0                    := #BIT0,
           Bit_1                    := "B 7.1",
           Transfer_Start           := #XFER,
           Error_Reset              := "M 9.1",
           Space_DX_mS              := 600,
           ReSample_DX              := 85,
           Conveyor_Type            := 3,
           Preset_MIN_mS            := 500,
           LowSpd_Dimension_mS      := 0,
           HighSpd_Dimension_mS     := "HOUSE_KEEPING DB".C4_Packet_Length_mS,
           Plc_Scan_mS              := "DB UTILITY".Scan_Cycle_Previous,
           Q_Error                  := #ERROR,
           Word_Count               := "HMI_DB".CONV_5_COUNT,
           IO_DB                    := "DEBOUNCER COUNTER DB".Conveyor_C5_Link);
M450: NOP   0; 
NETWORK
TITLE =Packet Counter - Delivery Conveyor 6

      A     "A 45.3"; 
      L     S5T#1S; 
      SF    "Timer 121"; // Call Hold 1s
      A     "Timer 121"; 
      =     "M 143.1"; 
      JNB   M453; 
      L     "HMI_DB".CONVEYOR_MAXCOUNT_L; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C6_Delivery.Maximum_Count; 
      A     "B 7.1"; 
      A     "M 39.1"; 
      AN    "M 39.2"; 
      =     #BIT0; 
      A     "M 39.4"; 
      AN    "M 39.5"; 
      =     #XFER; 
      CALL "DE-BOUNCER / COUNTER" (
           Bit_0                    := #BIT0,
           Bit_1                    := "B 7.3",
           Transfer_Start           := #XFER,
           Error_Reset              := "M 9.1",
           Space_DX_mS              := 600,
           ReSample_DX              := 85,
           Conveyor_Type            := 2,
           Preset_MIN_mS            := 500,
           LowSpd_Dimension_mS      := 0,
           HighSpd_Dimension_mS     := "HOUSE_KEEPING DB".C4_Packet_Length_mS,
           Plc_Scan_mS              := "DB UTILITY".Scan_Cycle_Previous,
           Q_Error                  := #ERROR,
           Word_Count               := "HMI_DB".CONV_6_COUNT,
           IO_DB                    := "DEBOUNCER COUNTER DB".Conveyor_C6_Delivery);
M453: NOP   0; 
NETWORK
TITLE =Packet Presence - Flipper / TurnTable / Conveyor 9 / Pusher 2

      L     0; 
      A     "M 43.4"; 
      JCN   M434; 
      L     1; 
M434: T     "HMI_DB".FLIPPER_PACK_PRESENCE; 
      T     "HMI_DB".FLIPPER_PACK_PRESENCE; 
      L     0; 
      A     "M 47.4"; 
      JCN   M474; 
      L     1; 
M474: T     "HMI_DB".TURNTABLE_PACK_PRESENCE; 
      T     "HMI_DB".TURNTABLE_PACK_PRESENCE; 
      L     0; 
      A     "M 51.4"; 
      JCN   M514; 
      L     1; 
M514: T     "HMI_DB".ROLLER_PACK_PRESENCE; 
      T     "HMI_DB".ROLLER_PACK_PRESENCE; 
      L     0; 
      A     "M 51.5"; 
      JCN   M515; 
      L     1; 
M515: T     "HMI_DB".PUSHER_PACK_PRESENCE; 
      T     "HMI_DB".PUSHER_PACK_PRESENCE; 
NETWORK
TITLE =Packet Counter - Pivot Conveyor 10

      A     "A 48.0"; 
      L     S5T#1S; 
      SF    T    134; // Call Hold 1s
      A     T    134; 
      JNB   M480; 
      L     "HMI_DB".CONVEYOR_MAXCOUNT_W; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C10_Collator.Maximum_Count; 
      A     "B 10.4"; 
      =     #BIT0; 
      A     "M 55.5"; 
      AN    "M 55.6"; 
      =     #XFER; 
      CALL "DE-BOUNCER / COUNTER" (
           Bit_0                    := #BIT0,
           Bit_1                    := "B 10.6",
           Transfer_Start           := #XFER,
           Error_Reset              := "M 9.1",
           Space_DX_mS              := 600,
           ReSample_DX              := 85,
           Conveyor_Type            := 1,
           Preset_MIN_mS            := 500,
           LowSpd_Dimension_mS      := 0,
           HighSpd_Dimension_mS     := #DIM_31,
           Plc_Scan_mS              := "DB UTILITY".Scan_Cycle_Previous,
           Q_Error                  := #ERROR,
           Word_Count               := "HMI_DB".CONV_10_COUNT,
           IO_DB                    := "DEBOUNCER COUNTER DB".Conveyor_C10_Collator);
M480: NOP   0; 
NETWORK
TITLE =Packet Counter - Link Conveyor 11 (Low)

      A     "A 48.3"; 
      L     S5T#1S; 
      SF    "Timer 122"; // Call Hold 1s
      A     "Timer 122"; 
      =     "M 143.2"; 
      JNB   M483; 
      L     "HMI_DB".CONVEYOR_MAXCOUNT_W; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C11_Link.Maximum_Count; 
      A     "B 10.6"; 
      A     "M 59.1"; 
      AN    "M 59.2"; 
      A     "P 15.1"; 
      =     #BIT0; 
      A     "M 59.3"; 
      AN    "M 59.4"; 
      =     #XFER; 
      CALL "DE-BOUNCER / COUNTER" (
           Bit_0                    := #BIT0,
           Bit_1                    := "B 10.7",
           Transfer_Start           := #XFER,
           Error_Reset              := "M 9.1",
           Space_DX_mS              := 600,
           ReSample_DX              := 85,
           Conveyor_Type            := 3,
           Preset_MIN_mS            := 300,
           LowSpd_Dimension_mS      := 0,
           HighSpd_Dimension_mS     := #DIM_31,
           Plc_Scan_mS              := "DB UTILITY".Scan_Cycle_Previous,
           Q_Error                  := #ERROR,
           Word_Count               := "HMI_DB".CONV_11_COUNT,
           IO_DB                    := "DEBOUNCER COUNTER DB".Conveyor_C11_Link);
M483: NOP   0; 
NETWORK
TITLE =Packet Counter - Link Conveyor 12 (Low)

      A     "A 48.6"; 
      L     S5T#1S; 
      SF    "Timer 123"; // Call Hold 1s
      A     "Timer 123"; 
      =     "M 143.3"; 
      JNB   M486; 
      L     "HMI_DB".CONVEYOR_MAXCOUNT_W; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C12_Link.Maximum_Count; 
      A     "B 10.7"; 
      A     "M 63.1"; 
      AN    "M 63.2"; 
      =     #BIT0; 
      A     "M 63.3"; 
      AN    "M 63.4"; 
      =     #XFER; 
      CALL "DE-BOUNCER / COUNTER" (
           Bit_0                    := #BIT0,
           Bit_1                    := "B 11.0",
           Transfer_Start           := #XFER,
           Error_Reset              := "M 9.1",
           Space_DX_mS              := 600,
           ReSample_DX              := 85,
           Conveyor_Type            := 3,
           Preset_MIN_mS            := 300,
           LowSpd_Dimension_mS      := 0,
           HighSpd_Dimension_mS     := #DIM_31,
           Plc_Scan_mS              := "DB UTILITY".Scan_Cycle_Previous,
           Q_Error                  := #ERROR,
           Word_Count               := "HMI_DB".CONV_12_COUNT,
           IO_DB                    := "DEBOUNCER COUNTER DB".Conveyor_C12_Link);
M486: NOP   0; 
NETWORK
TITLE =Packet Counter - Delivery Conveyor 13 (Low)

      A     "A 49.0"; 
      L     S5T#1S; 
      SF    "Timer 124"; // Call Hold 1s
      A     "Timer 124"; 
      =     "M 143.4"; 
      JNB   M490; 
      L     "HMI_DB".CONVEYOR_MAXCOUNT_W; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C13_Delivery.Maximum_Count; 
      A     "B 11.0"; 
      A     "M 67.1"; 
      AN    "M 67.2"; 
      =     #BIT0; 
      A     "M 67.4"; 
      AN    "M 67.5"; 
      =     #XFER; 
      CALL "DE-BOUNCER / COUNTER" (
           Bit_0                    := #BIT0,
           Bit_1                    := "B 11.2",
           Transfer_Start           := #XFER,
           Error_Reset              := "M 9.1",
           Space_DX_mS              := 600,
           ReSample_DX              := 85,
           Conveyor_Type            := 2,
           Preset_MIN_mS            := 300,
           LowSpd_Dimension_mS      := 0,
           HighSpd_Dimension_mS     := #DIM_237,
           Plc_Scan_mS              := "DB UTILITY".Scan_Cycle_Previous,
           Q_Error                  := #ERROR,
           Word_Count               := "HMI_DB".CONV_13_COUNT,
           IO_DB                    := "DEBOUNCER COUNTER DB".Conveyor_C13_Delivery);
M490: NOP   0; 
NETWORK
TITLE =Packet Counter - Link Conveyor 21 (High)

      A     "A 53.4"; 
      L     S5T#1S; 
      SF    "Timer 125"; // Call Hold 1s
      A     "Timer 125"; 
      =     "M 143.5"; 
      JNB   M534; 
      L     "HMI_DB".CONVEYOR_MAXCOUNT_W; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C21_Link.Maximum_Count; 
      A     "B 10.6"; 
      A     "M 79.1"; 
      AN    "M 79.2"; 
      A     "P 15.0"; 
      =     #BIT0; 
      A     "M 79.3"; 
      AN    "M 79.4"; 
      =     #XFER; 
      CALL "DE-BOUNCER / COUNTER" (
           Bit_0                    := #BIT0,
           Bit_1                    := "B 15.4",
           Transfer_Start           := #XFER,
           Error_Reset              := "M 9.1",
           Space_DX_mS              := 600,
           ReSample_DX              := 85,
           Conveyor_Type            := 3,
           Preset_MIN_mS            := 300,
           LowSpd_Dimension_mS      := 0,
           HighSpd_Dimension_mS     := #DIM_31,
           Plc_Scan_mS              := "DB UTILITY".Scan_Cycle_Previous,
           Q_Error                  := #ERROR,
           Word_Count               := "HMI_DB".CONV_21_COUNT,
           IO_DB                    := "DEBOUNCER COUNTER DB".Conveyor_C21_Link);
M534: NOP   0; 
NETWORK
TITLE =Packet Counter - Link Conveyor 22 (High)

      A     "A 53.6"; 
      L     S5T#1S; 
      SF    "Timer 126"; // Call Hold 1s
      A     "Timer 126"; 
      =     "M 143.6"; 
      JNB   M536; 
      L     "HMI_DB".CONVEYOR_MAXCOUNT_W; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C22_Link.Maximum_Count; 
      A     "B 15.4"; 
      A     "M 83.1"; 
      AN    "M 83.2"; 
      =     #BIT0; 
      A     "M 83.3"; 
      AN    "M 83.4"; 
      =     #XFER; 
      CALL "DE-BOUNCER / COUNTER" (
           Bit_0                    := #BIT0,
           Bit_1                    := "B 15.5",
           Transfer_Start           := #XFER,
           Error_Reset              := "M 9.1",
           Space_DX_mS              := 600,
           ReSample_DX              := 85,
           Conveyor_Type            := 3,
           Preset_MIN_mS            := 300,
           LowSpd_Dimension_mS      := 0,
           HighSpd_Dimension_mS     := #DIM_31,
           Plc_Scan_mS              := "DB UTILITY".Scan_Cycle_Previous,
           Q_Error                  := #ERROR,
           Word_Count               := "HMI_DB".CONV_22_COUNT,
           IO_DB                    := "DEBOUNCER COUNTER DB".Conveyor_C22_Link);
M536: NOP   0; 
NETWORK
TITLE =Packet Counter - Delivery Conveyor 23 (High)

      A     "A 54.0"; 
      L     S5T#1S; 
      SF    "Timer 127"; // Call Hold 1s
      A     "Timer 127"; 
      =     "M 143.7"; 
      JNB   M540; 
      L     "HMI_DB".CONVEYOR_MAXCOUNT_W; 
      T     "DEBOUNCER COUNTER DB".Conveyor_C23_Delivery.Maximum_Count; 
      A     "B 15.5"; 
      A     "M 87.1"; 
      AN    "M 87.2"; 
      =     #BIT0; 
      A     "M 87.4"; 
      AN    "M 87.5"; 
      =     #XFER; 
      CALL "DE-BOUNCER / COUNTER" (
           Bit_0                    := #BIT0,
           Bit_1                    := "B 15.7",
           Transfer_Start           := #XFER,
           Error_Reset              := "M 9.1",
           Space_DX_mS              := 600,
           ReSample_DX              := 85,
           Conveyor_Type            := 2,
           Preset_MIN_mS            := 300,
           LowSpd_Dimension_mS      := 0,
           HighSpd_Dimension_mS     := #DIM_237,
           Plc_Scan_mS              := "DB UTILITY".Scan_Cycle_Previous,
           Q_Error                  := #ERROR,
           Word_Count               := "HMI_DB".CONV_23_COUNT,
           IO_DB                    := "DEBOUNCER COUNTER DB".Conveyor_C23_Delivery);
M540: NOP   0; 
NETWORK
TITLE =HMI Packet Counters Reset (Same Conditions as FC1206)

      A     "M 10.2"; 
      JNB   F102; 
      L     0; 
      T     "HMI_DB".CONV_3_COUNT; // FC8 Takes Over 0 on Next Call
F102: NOP   0; 
      A     "M 31.7"; 
      JNB   F317; 
      L     0; 
      T     "HMI_DB".CONV_4_COUNT; // FC8 Takes Over 0 on Next Call
F317: NOP   0; 
      A     "M 35.4"; 
      JNB   F354; 
      L     0; 
      T     "HMI_DB".CONV_5_COUNT; // FC8 Takes Over 0 on Next Call
F354: NOP   0; 
      A     "M 35.3"; 
      FP    "FP 154.4"; 
      JNB   F396; 
      L     0; 
      T     "HMI_DB".CONV_6_COUNT; // FC8 Takes Over 0 on Next Call
F396: NOP   0; 
      A     "M 55.6"; 
      JNB   F556; 
      L     0; 
      T     "HMI_DB".CONV_10_COUNT; // FC8 Takes Over 0 on Next Call
F556: NOP   0; 
      A     "M 59.4"; 
      JNB   F594; 
      L     0; 
      T     "HMI_DB".CONV_11_COUNT; // FC8 Takes Over 0 on Next Call
F594: NOP   0; 
      A     "M 63.4"; 
      JNB   F634; 
      L     0; 
      T     "HMI_DB".CONV_12_COUNT; // FC8 Takes Over 0 on Next Call
F634: NOP   0; 
      AN    "B 11.1"; 
      L     S5T#30S; 
      SD    "Timer 80"; 
      A     "Timer 80"; 
      FP    "HMI_DB".FP131; 
      JNB   F676; 
      L     0; 
      T     "HMI_DB".CONV_13_COUNT; // FC8 Takes Over 0 on Next Call
F676: NOP   0; 
      A     "M 79.4"; 
      JNB   F794; 
      L     0; 
      T     "HMI_DB".CONV_21_COUNT; // FC8 Takes Over 0 on Next Call
F794: NOP   0; 
      A     "M 83.4"; 
      JNB   F834; 
      L     0; 
      T     "HMI_DB".CONV_22_COUNT; // FC8 Takes Over 0 on Next Call
F834: NOP   0; 
      AN    "B 15.6"; 
      L     S5T#30S; 
      SD    "Timer 81"; 
      A     "Timer 81"; 
      FP    "HMI_DB".FP132; 
      JNB   F876; 
      L     0; 
      T     "HMI_DB".CONV_23_COUNT; // FC8 Takes Over 0 on Next Call
F876: NOP   0; 
END_FUNCTION

FUNCTION "FM350 COUNTERS" : VOID
TITLE =Counters
//FM350-2 : Counter Module Added to measure Collator Conveyors 4 & 10 Filling 
//Surface Left, and to measure Packets Length & Width in order to Fit the Most 
//Packets Number onto the Respective Conveyor... May 22
VERSION : 0.1


VAR_TEMP
  ENCODER_STOP : BOOL ;	
  RETURN_RD : INT ;	//Print Pulse Read Function Return
  PRESS_LENGTH_3 : WORD ;	//Slat Conveyor 3 - Surface per Packet
  PACKET_LENGTH_4 : WORD ;	//Collator Conveyor 4 - Packet Length 
  HALF_PACKET_LENGTH_4 : WORD ;	//Collator Conveyor 4 - Packet Length - Half
  PACKET_LENGTH_HALF_4 : WORD ;	//Collator Conveyor 4 - Packet Length + Half
  SURFACE_LENGTH_LEFT_4 : WORD ;	//Collator Conveyor 4 - Surface Length Left
  QTY_MAX_4 : REAL ;	
  PACKET_WIDTH_10 : WORD ;	//Collator Conveyor 10 - Packet Width 
  HALF_PACKET_WIDTH_10 : WORD ;	//Collator Conveyor 10 - Packet Width - Half
  PACKET_WIDTH_HALF_10 : WORD ;	//Collator Conveyor 10 - Packet Width + Half
  SURFACE_LENGTH_LEFT_10 : WORD ;	
  QTY_MAX_10 : WORD ;	
END_VAR
BEGIN
NETWORK
TITLE =Call DB

      OPN   "FM350 DB"; 
      CALL "CNT2_CTR" (//Control the FM 350-2
           DB_NO                    := W#16#2);

NETWORK
TITLE =FM350-2 Address Resets

      A     "M 167.7"; 
      JNB   M677; 
      L     W#16#140; 
      T     DBW   12; 
//;
      L     DW#16#A00; 
      T     DBD   14; 
//;
      R     "M 167.7"; 

M677: NOP   0; 
NETWORK
TITLE =Read Counters Jobs
//FM350-2 :  Job 100 = Read Counter 0,1,2,3
//           Job 101 = Read Counter 4,5,6,7 
//           Then Transfer to DB2
      A     "M 6.0"; 
      FP    "FP 154.0"; 
      JNB   M154; 
      L     100; 
      T     DBB    2; 
      CALL "CNT2_RD" (
           DB_NO                    := W#16#2,
           RET_VAL                  := #RETURN_RD);

M154: NOP   0; 

      A     "M 6.0"; 
      FN    "FN 155.0"; 
      JNB   M155; 
      L     101; 
      T     DBB    2; 
      CALL "CNT2_RD" (
           DB_NO                    := W#16#2,
           RET_VAL                  := #RETURN_RD);

M155: NOP   0; 
NETWORK
TITLE =
//Encoder Health Monitor


NETWORK
TITLE =Collator Conveyor 4 - has Stop - Timer  1.5s

      A     "A 44.3"; 
      AN    "E 6.6"; 
      AN    "M 30.0"; 
      A     "M 0.3"; 
      L     S5T#1S500MS; 
      SD    "Timer 130"; 
NETWORK
TITLE =Collator Conveyor 4 - has Stop - Timer  1.5s

      A     "A 44.3"; 
      A     "E 6.6"; 
      AN    "M 30.0"; 
      A     "M 0.3"; 
      L     S5T#1S500MS; 
      SD    "Timer 131"; 
NETWORK
TITLE =Collator Conveyors 4 - Fault

      A(    ; 
      A     "A 44.3"; 
      A     "E 6.6"; 
      A     "Timer 131"; 
      O     ; 
      A     "A 44.3"; 
      AN    "E 6.6"; 
      A     "Timer 130"; 
      )     ; 
      A     "M 0.3"; 
      S     "M 30.0"; 
//;
      O     "M 171.5"; 
      R     "M 30.0"; 
NETWORK
TITLE =Collator Conveyors 4 - Lauer Comm

      OPN   "DB LAUER"; 

      A     "E 6.6"; 
      JC    M001; 

      L     2#0; 
      T     DBW  232; 
      JU    M002; 

M001: L     2#1; 
      T     DBW  232; 

M002: NOP   0; 
END_FUNCTION

FUNCTION "ELEVATOR TEST FUNCTION" : VOID
TITLE =
VERSION : 0.1

BEGIN
NETWORK
TITLE =


      A     "A 63.0"; 
      JCN   M003; 
      A     "A 63.3"; 
      JCN   M002; 
      L     MW   950; 
      L     1; 
      -I    ; 
      T     MW   950; 
      JU    M001; 
M002: L     MW   950; 
      L     1; 
      +I    ; 
      T     MW   950; 
M001: L     MW   950; 
      L     200; 
      <=I   ; 
      =     M    930.1; 
      L     MW   950; 
      L     10; 
      <=I   ; 
      =     M    930.0; 
      L     MW   950; 
      L     800; 
      >=I   ; 
      =     M    930.2; 
      L     MW   950; 
      L     990; 
      >=I   ; 
      =     M    930.3; 
M003: CLR   ; 


END_FUNCTION

ORGANIZATION_BLOCK "CYCLIC"
TITLE =Main Cycle
VERSION : 0.0


VAR_TEMP
  OB1_EV_CLASS : BYTE ;	//Bits 0-3 = 1 (Coming event), Bits 4-7 = 1 (Event class 1)
  OB1_SCAN_1 : BYTE ;	//1 (Cold restart scan 1 of OB 1), 3 (Scan 2-n of OB 1)
  OB1_PRIORITY : BYTE ;	//1 (Priority of 1 is lowest)
  OB1_OB_NUMBR : BYTE ;	//1 (Organization block 1, OB1)
  OB1_RESERVED_1 : BYTE ;	//Reserved for system
  OB1_RESERVED_2 : BYTE ;	//Reserved for system
  OB1_PREV_CYCLE : INT ;	//Cycle time of previous OB1 scan (milliseconds)
  OB1_MIN_CYCLE : INT ;	//Minimum cycle time of OB1 (milliseconds)
  OB1_MAX_CYCLE : INT ;	//Maximum cycle time of OB1 (milliseconds)
  OB1_DATE_TIME : DATE_AND_TIME ;	//Date and time OB1 started
END_VAR
BEGIN
NETWORK
TITLE =Scan Time

      L     #OB1_PREV_CYCLE; 
      T     "DB UTILITY".Scan_Cycle_Previous; 
NETWORK
TITLE =Scan Triggers

      A     "M 6.0"; 
      FP    "M 188.0"; 
      =     "M 13.0"; 
//;
      A     "M 6.1"; 
      FP    "M 188.1"; 
      =     "M 13.1"; 
//;
      A     "M 6.3"; 
      FP    "M 188.2"; 
      =     "M 13.2"; 
//;
      A     "M 6.5"; 
      FP    "M 188.3"; 
      =     "M 13.3"; 
NETWORK
TITLE =Packet Counters
//     CALL  "HMI PACKET COUNTER OLD"



//  CALL  "ELEVATOR TEST FUNCTION"

NETWORK
TITLE =Lauer Comms

      CALL "LAUER_RE-START_PUP" ;

NETWORK
TITLE =Utility Blocks

      CALL "CONTROL" ;
      CALL "FM350 COUNTERS" ;
      CALL "BLINKER" ;
      CALL "LIGHT CURTAIN - SAFETY" ;
      CALL "HMI PACKET COUNTER  NEW" ;
NETWORK
TITLE =Program Blocks

      CALL "CONVEYORS CLEARING" ;

      CALL "CONVEYOR 0 + PUSHER 0" ;
      CALL "ELEVATOR + PUSHER 1" ;
      CALL "CONVEYOR 1 - BELT" ;
      CALL "CONVEYOR 2 - ANGLE B+R" ;
      CALL "CONVEYOR 3 - SLAT" ;
      CALL "CONVEYOR 4 - COLLATOR" ;
      CALL "CONVEYOR 5 - LINK" ;

      CALL "CONVEYOR 6 - FLIP DELIV." ;
      CALL "CONVEYOR 7 - FLIPPER" ;

      CALL "CONVEYOR 8 - TURNTABLE" ;

      CALL "CONVEYOR 9 - PUSHER 2" ;
      CALL "CONVEYOR 10 - PIVOT" ;
      CALL "CONVEYOR 11 - LINK 1 LO" ;
      CALL "CONVEYOR 12 - LINK 2 LO" ;
      CALL "CONVEYOR 13 - DELIV. LO" ;
      CALL "LOADER FINGERS" ;
      CALL "LOADER LIFT" ;
      CALL "CONVEYOR 21 - LINK 1 HI" ;
      CALL "CONVEYOR 22 - LINK 2 HI" ;
      CALL "CONVEYOR 23 - DELIV. HI" ;


NETWORK
TITLE =Program Init - Switch ON

      A     "M 0.3"; 
      A     "S 2.2"; 
      JNB   M022; 
      CALL "SETUP" ;

M022: NOP   0; 
NETWORK
TITLE =Faults Monitor

      A     "M 0.4"; 
      A     "M 0.5"; 
      A     "M 0.6"; 
      A(    ; 
      L     "MD 1"; 
      L     0; 
      >D    ; 
      )     ; 
      =     "M 5.1"; 
NETWORK
TITLE =Blinker

      A(    ; 
      A     "M 6.3"; 
      A     "M 6.7"; 
      AN    "M 5.1"; 
      O     ; 
      A     "M 5.1"; 
      A     "M 6.1"; 
      )     ; 
      A     "M 0.3"; 
      =     "M 5.7"; 
NETWORK
TITLE =Always ON

      AN    "M 50.0"; 
      S     "M 50.0"; 
END_ORGANIZATION_BLOCK

ORGANIZATION_BLOCK "Cyclic 100mS"
TITLE = "Cyclic Interrupt"
VERSION : 0.1


VAR_TEMP
  OB35_EV_CLASS : BYTE ;	//Bits 0-3 = 1 (Coming event), Bits 4-7 = 1 (Event class 1)
  OB35_STRT_INF : BYTE ;	//16#36 (OB 35 has started)
  OB35_PRIORITY : BYTE ;	//Priority of OB Execution
  OB35_OB_NUMBR : BYTE ;	//35 (Organization block 35, OB35)
  OB35_RESERVED_1 : BYTE ;	//Reserved for system
  OB35_RESERVED_2 : BYTE ;	//Reserved for system
  OB35_PHASE_OFFSET : WORD ;	//Phase offset (msec)
  OB35_RESERVED_3 : INT ;	//Reserved for system
  OB35_EXC_FREQ : INT ;	//Frequency of execution (msec)
  OB35_DATE_TIME : DATE_AND_TIME ;	//Date and time OB35 started
END_VAR
BEGIN
NETWORK
TITLE =CYCLIC 100 mS 

      CALL "GENERAL FAULTS" ;
      CALL "HMI CONTROL" ;
      CALL "HMI COMMS" ;
      CALL "LIGHT BAR" ;

//  CALL  "Sensor Check Calls"
NETWORK
TITLE =Lauer Comms

      CALL "LAUER CALL" ;

NETWORK
TITLE =Lauer Comms

      CALL "LAUER COMM FC" (
           UBDB                     := "DB LAUER",
           RXFA                     := 36,
           RXLE                     := 32,
           TXFA                     := 3,
           TXLE                     := 32,
           RSET                     := "M 210.1",
           TIMT                     := T    105,
           TIMZ                     := S5T#1S,
           COFF                     := "LAUER RESTART FC",
           INIT                     := "LAUER COMM ERR FC",
           RFLM                     := "M 210.0",
           EROR                     := "M 210.2");
END_ORGANIZATION_BLOCK

ORGANIZATION_BLOCK "I/O_FLT1"
TITLE = "I/O Point Fault"
VERSION : 0.1


VAR_TEMP
  OB82_EV_CLASS : BYTE ;	//16#39, Event class 3, Entering event state, Internal fault event
  OB82_FLT_ID : BYTE ;	//16#XX, Fault identifcation code
  OB82_PRIORITY : BYTE ;	//Priority of OB Execution
  OB82_OB_NUMBR : BYTE ;	//82 (Organization block 82, OB82)
  OB82_RESERVED_1 : BYTE ;	//Reserved for system
  OB82_IO_FLAG : BYTE ;	//Input (01010100), Output (01010101)
  OB82_MDL_ADDR : WORD ;	//Base address of module with fault
  OB82_MDL_DEFECT : BOOL ;	//Module defective
  OB82_INT_FAULT : BOOL ;	//Internal fault
  OB82_EXT_FAULT : BOOL ;	//External fault
  OB82_PNT_INFO : BOOL ;	//Point information
  OB82_EXT_VOLTAGE : BOOL ;	//External voltage low
  OB82_FLD_CONNCTR : BOOL ;	//Field wiring connector missing
  OB82_NO_CONFIG : BOOL ;	//Module has no configuration data
  OB82_CONFIG_ERR : BOOL ;	//Module has configuration error
  OB82_MDL_TYPE : BYTE ;	//Type of module
  OB82_SUB_MDL_ERR : BOOL ;	//Sub-Module is missing or has error
  OB82_COMM_FAULT : BOOL ;	//Communication fault
  OB82_MDL_STOP : BOOL ;	//Module is stopped
  OB82_WTCH_DOG_FLT : BOOL ;	//Watch dog timer stopped module
  OB82_INT_PS_FLT : BOOL ;	//Internal power supply fault
  OB82_PRIM_BATT_FLT : BOOL ;	//Primary battery is in fault
  OB82_BCKUP_BATT_FLT : BOOL ;	//Backup battery is in fault
  OB82_RESERVED_2 : BOOL ;	//Reserved for system
  OB82_RACK_FLT : BOOL ;	//Rack fault, only for bus interface module
  OB82_PROC_FLT : BOOL ;	//Processor fault
  OB82_EPROM_FLT : BOOL ;	//EPROM fault
  OB82_RAM_FLT : BOOL ;	//RAM fault
  OB82_ADU_FLT : BOOL ;	//ADU fault
  OB82_FUSE_FLT : BOOL ;	//Fuse fault
  OB82_HW_INTR_FLT : BOOL ;	//Hardware interupt input in fault
  OB82_RESERVED_3 : BOOL ;	//Reserved for system  
  OB82_DATE_TIME : DATE_AND_TIME ;	//Date and time OB82 started   
END_VAR
BEGIN
NETWORK
TITLE =

END_ORGANIZATION_BLOCK

ORGANIZATION_BLOCK "RACK_FLT"
TITLE = "Loss Of Rack Fault"
VERSION : 0.1


VAR_TEMP
  OB86_EV_CLASS : BYTE ;	//16#38/39 Event class 3
  OB86_FLT_ID : BYTE ;	//16#C1/C4/C5, Fault identifcation code
  OB86_PRIORITY : BYTE ;	//Priority of OB Execution
  OB86_OB_NUMBR : BYTE ;	//86 (Organization block 86, OB86)
  OB86_RESERVED_1 : BYTE ;	//Reserved for system
  OB86_RESERVED_2 : BYTE ;	//Reserved for system
  OB86_MDL_ADDR : WORD ;	//Base address of IM module in rack with fault
  OB86_RACKS_FLTD : ARRAY  [0 .. 31 ] OF BOOL ;	//Racks in fault
