FUNCTION "LOADER LIFT" : VOID
TITLE =Feeder Lift   Pos. 16
//
NAME : FEEDER
VERSION : 0.0


VAR_TEMP
  MAIN_SERVICE_3_SW : BOOL ;	
  FEEDER_SW : BOOL ;	
  FEEDER_SERVICE_SW : BOOL ;	
  LIGHT_BARRIER : BOOL ;	
  FEEDER_LIFT_TOP_PB : BOOL ;	
  FEEDER_LIFT_UP_PB : BOOL ;	
  FEEDER_LIFT_DN_PB : BOOL ;	
  FEEDER_LIFT_JOG_UP : BOOL ;	
  FEEDER_LIFT_JOG_DN : BOOL ;	
END_VAR
BEGIN
NETWORK
TITLE =Light Barrier Buffer

      A     "E 1.4"; 
      O     "M 90.0"; 
      =     #LIGHT_BARRIER; 
//;
      A     "E 1.4"; 
      R     "M 90.0"; 
NETWORK
TITLE =Feeder Service 

      A     "HMI_DB".ALL_SERVICE_ENABLE_SW; 
      A     "HMI_DB".LOADER_SERVICE_ENABLE_SW; 
      A     "HMI_DB".SERVICE_SW_3_STATUS; 
      =     #MAIN_SERVICE_3_SW; 
//;
      A     #MAIN_SERVICE_3_SW; 
      O     "M 74.7"; 
      JNB   FEED; 
      A     "HMI_DB".LOADER_LIFT_SERVICE_SSW; 
      =     #FEEDER_SERVICE_SW; 
      S     "DB UTILITY".Conveyor_13_Disable; 
      S     "DB UTILITY".Conveyor_23_Disable; 
      R     "M 74.2"; 
//;  
      A     #FEEDER_SERVICE_SW; 
      A     "HMI_DB".LOADER_LIFT_TOP_PB; 
      =     #FEEDER_LIFT_TOP_PB; 
//;  
      A     #FEEDER_SERVICE_SW; 
      A     "HMI_DB".LOADER_LIFT_UP_PB; 
      =     #FEEDER_LIFT_UP_PB; 
//;
      A     #FEEDER_SERVICE_SW; 
      A     "HMI_DB".LOADER_LIFT_DN_PB; 
      =     #FEEDER_LIFT_DN_PB; 
//;
      AN    #MAIN_SERVICE_3_SW; 
      ON    #FEEDER_SERVICE_SW; 
      R     "HMI_DB".LOADER_FING_SERVICE_SSW; 
      R     "HMI_DB".LOADER_LIFT_SERVICE_SSW; 
      R     "HMI_DB".LOADER_LIFT_TOP_PB; 
      R     "HMI_DB".LOADER_LIFT_UP_PB; 
      R     "HMI_DB".LOADER_LIFT_DN_PB; 
      R     "DB UTILITY".Conveyor_13_Disable; 
      R     "DB UTILITY".Conveyor_23_Disable; 

FEED: R     #FEEDER_SERVICE_SW; 
      R     #FEEDER_LIFT_TOP_PB; 
      R     #FEEDER_LIFT_UP_PB; 
      R     #FEEDER_LIFT_DN_PB; 
      FP    "FP 159.6"; 
      =     "M 74.7"; 
NETWORK
TITLE =Automatic Trigger

      O     "M 9.1"; 
      A     "S 2.6"; 
      FP    "FP 169.6"; 
      S     "M 74.2"; 
//;
      AN    "S 2.6"; 
      R     "M 74.2"; 
NETWORK
TITLE =Feeder Lift - Ready

      A     "M 0.3"; 
      AN    "M 7.0"; 
      A     "E 0.5"; 
      A     "E 12.5"; 
      =     "M 74.0"; 
NETWORK
TITLE =Feeder Lift - Manual Mode

      A(    ; 
      A     "M 75.0"; 
      AN    "M 75.5"; 
      O     ; 
      A     "M 75.6"; 
      AN    "M 76.0"; 
      )     ; 
      A     "M 74.0"; 
      A     "M 190.4"; 
      =     "M 74.4"; 
NETWORK
TITLE =Door Open Status

      AN    "E 12.5"; 
      A     "M 0.3"; 
      S     "M 74.5"; 
//;
      A     "E 12.5"; 
      A     "S 2.7"; 
      R     "M 74.5"; 
NETWORK
TITLE =Fault Reset Status        X121     transfered to FC 212 Net 79
//      A(    
//      O     "M 54.7"
//      O     "M 66.7"
//      O     "M 86.7"
//      )     
//      A     "M 145.0"
//      O     "M 74.5"
//      O     "Timer 0"
//      =     "H 40.3"
// 
//is transfered to FC 212 Net 79


NETWORK
TITLE =Feeder - Hold 10s - Steps Chain Register Reset Timer

