FUNCTION "BLINKER" : VOID
TITLE =Blinker
VERSION : 0.0

BEGIN
NETWORK
TITLE =

      AN    "M 145.1"; 
      AN    "M 54.7"; 
      L     S5T#200MS; 
      SD    "Timer 98"; 
NETWORK
TITLE =

      AN    "M 145.1"; 
      A     "M 54.7"; 
      L     S5T#1S500MS; 
      SD    "Timer 99"; 
NETWORK
TITLE =Blinker Mem

      O     "Timer 99"; 
      O     "Timer 98"; 
      =     "M 145.1"; 
NETWORK
TITLE =Blinker Bit Out - Fast

      A     "M 145.1"; 
      AN    "M 145.2"; 
      S     "M 145.0"; 
//;
      A     "M 145.1"; 
      A     "M 145.2"; 
      R     "M 145.0"; 
NETWORK
TITLE =Blinker Mem

      AN    "M 145.1"; 
      A     "M 145.0"; 
      S     "M 145.2"; 
//;
      AN    "M 145.0"; 
      AN    "M 145.1"; 
      R     "M 145.2"; 
NETWORK
TITLE =Blinker Bit Out - Slow

      A     "M 145.0"; 
      AN    "M 145.6"; 
      S     "M 145.4"; 
//;
      A     "M 145.0"; 
      A     "M 145.6"; 
      R     "M 145.4"; 
NETWORK
TITLE =Blinker Mem

      AN    "M 145.0"; 
      A     "M 145.4"; 
      S     "M 145.6"; 
//;
      AN    "M 145.4"; 
      AN    "M 145.0"; 
      R     "M 145.6"; 
END_FUNCTION

FUNCTION "LIGHT CURTAIN - SAFETY" : VOID
TITLE =Conveyors Catways - Access Safety 
//Access to Conveyor 1-2-3 & 4 : Crossing Light Curtains Latches / Freezes these 
//Conveyors !
//- To Resume Run, CatWay 1 (Conveyors 1-2-3) :  Push Top PB (Catway) 
//and Push Lower PB (Main Floor) within 15sec . 
//- To Resume Run, CatWay 2 (Conveyors 3-4) :  Push Top PB (Catway) .
//
//If Crossing CatWay 2 Light Curtain while No Conveyors are running, Run will 
//resume automatic after 1 sec of free Light Curtain.
//
//Big Red Light will Blink to confirm the Conveyors are disabled / Safe .
VERSION : 0.1

BEGIN
NETWORK
TITLE =Safety Light Curtains -  Trigger 2 - Momentary SF = 1s 

      AN    "M 300.0"; // Safety ByPass (NOT)
      AN    "E 16.6"; // Light Curtain 2 - Triggered (NOT)
      AN    "A 44.3"; // AND IF Conveyor 4,3 and 2R ...
      AN    "A 44.0"; // are OFF when Triggered +
      AN    "K 43.5"; // Conveyor 2 Roller = Off +
      AN    "Y 43.6"; // Conveyor 2 Roller - Frame Up = Off
      L     S5T#2S; 
      SF    "Timer 136"; // Debouncer 2s
//;
      A     "Timer 136"; 
      =     "M 300.6"; // Resume Automatic after 2 Sec

NETWORK
TITLE =Safety Light Curtains - Trigger 1 - Latch

      AN    "M 300.0"; // Safety ByPass (NOT)
      AN    "E 16.2"; // Light Curtain 1 - Trigger (NOT)
      S     "M 300.1"; // Light Curtain 1 - Triggered - Latch
//;
      AN    "M 300.0"; // Safety ByPass (NOT)
      AN    "E 16.6"; // Light Curtain 2 - Trigger (NOT)
      A(    ; 
      O     "A 44.0"; // AND IF Conveyor 3 or ...
      O     "A 44.3"; // Conveyor 4 is ON
      )     ; 
      AN    "M 300.6"; 
      S     "M 300.2"; // Light Curtain 2 - Triggered - Latch
NETWORK
TITLE =Big Red Light - Blinking

      A(    ; 
      O     "M 300.1"; // Light Curtain 1 - Triggered - Latch
      O     "M 300.2"; // Light Curtain 2 - Triggered - Latch
      O     "M 300.6"; // Light Curtain 2 - Triggered - Momentary
      )     ; 
      =     "H 55.2"; // Big Red Light (Top Catway)
NETWORK
TITLE =Freeze Sequences

      A     "M 300.1"; // Light Curtain 1 - Triggered - Latch
      AN    "M 300.0"; // Safety ByPass Flag    
      =     "DB UTILITY".Freeze_Sequence_1; //   Freezes E1 + C1 + C2 Belt      
//;
      A     "M 300.1"; // Light Curtain 1 - Triggered - Latch
      O     "M 300.2"; // Light Curtain 2 - Triggered - Latch
      AN    "M 300.0"; // Safety ByPass Flag    
      O     "M 300.6"; // Safety Momentary
      =     "DB UTILITY".Freeze_Sequence_2; //  Freezes C2 Roller + C3 + C4  
NETWORK
TITLE =Safety ByPass - While blocking Curtain, Push Top Button for 5s

      AN    "E 16.2"; 
      A     "E 16.1"; 
      L     S5T#5S; 
      SD    "Timer 129"; 
//;
      A     "Timer 129"; 
      S     "M 300.0"; // Safety ByPass Flag - Set
//;
      A     "M 300.0"; // Safety ByPass Flag
      A     "M 6.1"; 
      AN    "M 300.5"; // Safety Reset Flag - Set
      =     "M 301.0"; // Safety ByPass Flag - Blinker

NETWORK
TITLE =TEST REMOTE B+

      R     "A 58.4"; 

NETWORK
TITLE =PB Led - Control

      A     "M 300.1"; // Light Curtain 1 - Triggered - Latch
      A     "M 145.4"; 
      AN    "M 300.0"; // Safety ByPass Flag
      O     "M 301.0"; // ByPass Fast Blink
      =     "M 300.3"; // PB Led - Flag
//;
      A     "M 300.1"; // Light Curtain 1 - Triggered - Latc
      AN    "M 145.4"; 
      AN    "M 300.0"; // Safety ByPass Flag    
      O     "M 301.0"; // ByPass Fast Blink
      =     "M 300.4"; // PB Led - Flag
NETWORK
TITLE =Re-Arm (Resume) Process - Safety Slat-In Catway Light Curtain

      A     "M 300.1"; // Light Curtain 1 - Triggered - Latch
      A     "E 16.2"; // Light Curtain Need to be Clear ...
      A     "E 16.1"; // While PB Push !
      FP    "FP 157.5"; 
      S     "M 300.5"; // Safety Reset Flag - Set
//;
      A     "M 300.5"; // Safety Reset Flag - Set
      L     S5T#15S; 
      SD    "Timer 135"; // Safety Reset Flag - TimeOut
//;                        
      A     "Timer 135"; 
      R     "M 300.5"; // Safety Reset Flag - Reset
//;
      A     "M 300.1"; // Light Curtain 1 - Triggered - Latch
      A     "M 300.5"; // Safety Reset Flag 
      A     "E 16.0"; 
      R     "M 300.1"; 
      R     "M 300.5"; // Safety Reset Flag - Reset
      R     "M 300.0"; // Safet ByPass Flag - Reset
NETWORK
TITLE =Re-Arm (Resume) Process - Safety Slat-Out Catway Light Curtain

      A     "M 300.2"; // Light Curtain 2 - Triggered - Latch
      A     "K 40.6"; // PB Led / Start / Alarm Buzzer - Output
      A     "E 16.4"; // PB Light Curtain 2
      R     "M 300.2"; // Light Curtain 2 - Triggered - Latch -> Reset
//;
      A     "M 300.2"; // Light Curtain 2 - Triggered - Latch
      =     "M 300.7"; // PB Led / Start / Alarm Buzzer
NETWORK
TITLE =PB Led - Out

      A     "M 300.3"; 
      O     "M 300.5"; // Safety Reset Flag - Set
      =     "H 55.1"; 
//;
      A     "M 300.4"; 
      O     "M 300.5"; // Safety Reset Flag - Set
      =     "H 55.0"; 
END_FUNCTION

FUNCTION "CONVEYORS CLEARING" : VOID
TITLE =Conveyors - Clearing Function
//New Order Sequence
NAME : CLEARING
VERSION : 0.0


VAR_TEMP
  EMPTY_11 : BOOL ;	//Empty Conveyor 11
  EMPTY_21 : BOOL ;	//Empty Conveyor 21
  EMPTY_12_22 : BOOL ;	//Empty Conveyor 12 & 22
  EMPTY_13_23 : BOOL ;	//Empty Conveyor 13 & 23
  C10_EMPTY_TEST : BOOL ;	
  CLEARING_ABORT : BOOL ;	
END_VAR
BEGIN
NETWORK
TITLE =HMI Clearing Call

      A     "M 140.3"; 
      A     "HMI_DB".CLEARING_SSW_MAIN; 
      =     "M 5.2"; 
//;
      L     8; 
      A     "M 10.0"; 
      =     "HMI_DB".CLEARING_SSW_STATUS; 
      JC    CLEA; 
      L     0; 

CLEA: T     "HMI_DB".CLEARING_FUNCTION; 

      A     "M 10.0"; 
      FN    "FN 155.7"; 
      R     "HMI_DB".CLEARING_SSW_MAIN; 
      R     "M 54.2"; 
//;
      A     "M 5.2"; 
      FP    "FP 147.4"; 
      AN    "B 10.7"; // C11 - Empty
      AN    "B 11.0"; // C12 - Empty
      AN    "B 11.1"; // C13 - Empty
      AN    "B 11.2"; // C13 - Empty
      AN    "B 15.4"; // C21 - Empty
      AN    "B 15.5"; // C22 - Empty
      AN    "B 15.6"; // C23 - Empty
      AN    "B 15.7"; // C23 - Empty
      S     "M 54.2"; // Empty C11...C23
NETWORK
TITLE =New Order Seq - First New Order Packet to Pivot Conveyor 10

      A     "M 55.2"; 
      A     "M 8.5"; 
      A     "M 0.3"; 
      S     "M 7.4"; // C10 New Order - Filling - Set
//;
      A(    ; 
      A     "M 55.6"; 
      A     "M 7.5"; // C10 New Order - Full
      O     ; 
      AN    "M 7.5"; // C10 New Order -  Not Full Yet
      A     "Timer 57"; 
      A     "M 0.3"; 
      )     ; 
      R     "M 7.4"; // C10 New Order - Ready - Reset
NETWORK
TITLE =New Order Seq - Conveyor 10 Full with New Order

      A     "M 7.4"; // C10 New Order - Ready
      A     "M 55.4"; // C10 - Full Step
      A     "M 0.3"; 
      S     "M 7.5"; // C10 New Order - Full - Set [Case:A]
//;
      A     "M 7.6"; // New Order - C11...23 Ready
      A     "M 0.3"; 
      R     "M 7.5"; // C10 New Order - Full - Reset
NETWORK
TITLE =New Order Seq
//New Order Seq - Waiting for the last Order Packets to Run out !


NETWORK
TITLE =Conveyor 11 - Ready

      A     "M 59.0"; 
      AN    "M 59.1"; 
      AN    "M 59.3"; 
      =     #EMPTY_11; 
NETWORK
TITLE =Conveyor 21 - Ready

      A     "M 79.0"; 
      AN    "M 79.1"; 
      AN    "M 79.3"; 
      =     #EMPTY_21; 
NETWORK
TITLE =Conveyor 12 & 22 - Ready

      A     "M 63.0"; 
      AN    "M 63.1"; 
      AN    "M 63.3"; 
      A     "M 83.0"; 
      AN    "M 83.1"; 
      AN    "M 83.3"; 
      =     #EMPTY_12_22; 
NETWORK
TITLE =Conveyor 13 & 23 - Ready

      A     "M 67.0"; 
      AN    "M 67.1"; 
      AN    "M 67.3"; 
      A     "M 87.0"; 
      AN    "M 87.1"; 
      AN    "M 87.3"; 
      =     #EMPTY_13_23; 
NETWORK
TITLE =New Order Seq - Conveyor 11, 12, 13, 21, 22, 23 - Empty
//Case A: C10 becomes Full with New Order before C11...23 are Empty.
//Case B: C10 becomes Full with New Order After C11...23 are Empty.
      A     "M 7.5"; // New Order - C10 Full [Case:A]
      A(    ; 
      A     "M 55.6"; // C10 Step Register - Reset
      O     ; 
      A     #EMPTY_11; 
      A     #EMPTY_21; 
      A     #EMPTY_12_22; 
      A     #EMPTY_13_23; 
      )     ; 
      A     "M 0.3"; 
      S     "M 7.6"; // New Order - C11...23 Ready - Set
//;
      A     "M 7.7"; 
      A     "M 0.3"; 
      R     "M 7.6"; // New Order - C11...23 Ready - Reset
NETWORK
TITLE =Events UpDate - Conveyor 11 & 21 Waiting for Packets

      A     "M 59.0"; 
      AN    "M 59.1"; 
      AN    "M 59.3"; 
      A     "M 79.0"; 
      AN    "M 79.1"; 
      AN    "M 79.3"; 
      =     "M 9.0"; 
NETWORK
TITLE =New Order Seq - Conveyors 11, 21 - Empty

      A     "M 9.0"; 
      A     "M 7.6"; // New Order - C11...23 Ready
      A     "M 0.3"; 
      S     "M 7.7"; // New Order - C11, 21 Ready - Set
//;
      A     "M 8.0"; // New Order - C12, 22 Ready 
      A     "M 0.3"; 
      R     "M 7.7"; // New Order - C11, 22 Ready - Reset
NETWORK
TITLE =Events UpDate - Conveyor 12 & 22 Waiting for Packets

      A     "M 63.0"; 
      AN    "M 63.1"; 
      AN    "M 63.3"; 
      A     "M 83.0"; 
      AN    "M 83.1"; 
      AN    "M 83.3"; 
      =     "M 9.0"; 
NETWORK
TITLE =New Order Seq - Conveyors 11, 21, 12, 22 - Empty

      A     "M 9.0"; 
      A     "M 7.7"; 
      A     "M 0.3"; 
      S     "M 8.0"; // New Order - C12, 22 Ready - Set
//;
      A     "M 8.1"; // New Order - C13, 23 Ready 
      A     "M 0.3"; 
      R     "M 8.0"; // New Order - C12, 22 Ready - Reset
NETWORK
TITLE =Events UpDate - Conveyor 13 & 23 Waiting for Packets

      A     "M 67.0"; 
      AN    "M 67.1"; 
      AN    "M 67.3"; 
      A     "M 87.0"; 
      AN    "M 87.1"; 
      AN    "M 87.3"; 
      =     "M 9.0"; 
NETWORK
TITLE =New Order Seq - Conveyor 11, 21, 12, 22, 13, 23 - Empty

      A     "M 9.0"; 
      A     "M 8.0"; 
      A     "M 0.3"; 
      S     "M 8.1"; // New Order - C13, 23 Ready - Set
//;
      A     "M 8.2"; 
      A     "M 0.3"; 
      R     "M 8.1"; // New Order - C13, 23 Ready - Reset
NETWORK
TITLE =New Order Seq - Feeder Done & Empty

      A     "M 8.1"; // New Order - C13, 23 Ready 
      A     "M 71.1"; 
      AN    "M 71.2"; 
      AN    "M 71.4"; 
      A     "M 0.3"; 
      S     "M 8.2"; // New Order - Feeder Empty / Ready - Set
//;
      A     "M 8.3"; // New Order - Operator Enabled
      A     "M 0.3"; 
      R     "M 8.2"; // New Order - Feeder Empty / Ready - Reset
NETWORK
TITLE =Conveyor 10 Clearing Enable after New Order

      A     "S 3.2"; // Operator Switch
      A     "M 8.2"; // New Order - Feeder Empty / Ready
      A     "M 0.3"; 
      S     "M 8.3"; // New Order - Operator Enabled
      S     "M 59.4"; // C11-12-21-22 - Registers Reset
      S     "M 63.4"; 
      S     "M 79.4"; 
      S     "M 83.4"; 
//;
      R     "M 7.4"; 
      R     "M 7.5"; 
      R     "M 7.6"; 
      R     "M 7.7"; 
      R     "M 8.0"; 
      R     "M 8.1"; 
      R     "M 8.4"; 
      R     "M 8.5"; 
//;
      ON    "M 8.2"; 
      R     "M 8.3"; 
NETWORK
TITLE =New Order - Status Lamp

      A     "M 8.2"; // New Order - Feeder Empty / Ready
      AN    "M 8.3"; // New Order - Operator Not Enabled Yet
      A     "M 145.0"; 
      O     "Timer 0"; 
      =     "H 49.5"; // Feeder Enable PB Lamp  (Amber)
NETWORK
TITLE =Conveyors Clearing Blink

      A     "M 10.0"; 
      A     "M 145.4"; 
      =     "M 142.0"; 
NETWORK
TITLE =After Clearing - Delay  10s

      A     "M 0.3"; 
      A     "M 11.6"; 
      L     S5T#10S; 
      SD    "Timer 9"; 
NETWORK
TITLE =Clearing Done - Ready

      A     "M 0.3"; 
      A     "Timer 9"; 
      ON    "M 11.6"; 
      S     "M 9.7"; 
//;
      ON    "M 0.3"; 
      R     "M 9.7"; 
NETWORK
TITLE =Clearing Command
//Clearing Command


NETWORK
TITLE =Conveyors Clearing - Cmd

      A(    ; 
      A     "M 5.2"; 
      FP    "FP 157.2"; 
      O     ; 
      A     "M 150.4"; // F4
      )     ; 
      S     "M 10.0"; 
//;
      A     "M 5.2"; 
      FN    "FN 155.6"; 
      A     "M 10.0"; 
      =     "M 5.4"; // Clearing ABORT !
      R     "M 5.2"; 
//;
      A(    ; 
      A     "M 150.4"; // Clearing ON
      A     "M 171.4"; // ENT PB
      A     "M 171.5"; // CLR PB
      O     "M 5.4"; // Clearing ABORT !
      O     "M 10.6"; 
      )     ; 
      =     #CLEARING_ABORT; 
NETWORK
TITLE =Conveyors Clearing Conveyors 1,2,3,4 - TimeOut 30S

      A     "M 10.0"; 
      A     "M 10.1"; 
      A     "M 10.2"; 
      AN    "M 10.3"; 
      L     S5T#30S; 
      SD    "Timer 128"; 
//;
      A     "Timer 128"; 
      O     #CLEARING_ABORT; 
      JNB   NCLR; 
      L     0; 
      T     "MB 10"; // Clearing OFF

NCLR: NOP   0; 
NETWORK
TITLE =Events UpDate - Clearing + Elevator + Conveyor 1, 2 - Empty

      A     "M 10.0"; 
      A     "M 15.3"; 
      AN    "M 15.4"; 
      A     "M 19.1"; 
      AN    "M 19.2"; 
      A     "M 23.0"; 
      AN    "M 23.1"; 
      AN    "B 5.4"; 
      AN    "B 6.0"; 
      AN    "B 6.1"; 
      AN    "B 6.2"; 
      =     "M 9.0"; 
NETWORK
TITLE =Elevator + Conveyor 1, 2 - Cleared -> Start Slat Clearing

      A     "M 9.0"; 
      A     "M 0.3"; 
      AN    "A 44.0"; 
      =     "M 10.1"; 
NETWORK
TITLE =Elevator + Conveyor 1, 2 - NOT Empty Alarm

      A     "M 10.0"; 
      AN    "M 9.0"; 
      S     "M 11.4"; 
NETWORK
TITLE =Clearing Sequence
//Clearing Sequence from Slat 3 to Pivot 10 Conveyors


NETWORK
TITLE =Conveyors 4 - Clearing Start - Enable Delay  3s

      A     "M 10.1"; // C1-2 Cleared
      L     S5T#2S; 
      SD    "Timer 10"; 
NETWORK
TITLE =Slat Conveyor 3 - Cleared -> Start Conveyor 4 Clearing

      A     "M 10.1"; // C1-2 Cleared
      A     "M 26.7"; 
      A     "M 0.3"; 
      S     "M 10.2"; // C3 Cleared
//;
      AN    "M 10.0"; // Clearing Off
      R     "M 10.2"; // Coherence - Reset
NETWORK
TITLE =Conveyors 3, 4 - Cleared -> Start Conveyor 5, 6 Clearing

      A(    ; 
      O     "M 31.5"; 
      O     "Timer 33"; 
      )     ; 
      A     "M 10.2"; 
      A     "M 0.3"; 
      S     "M 10.3"; // C4 Cleared
//;
      AN    "M 10.2"; 
      R     "M 10.3"; // Coherence - Reset
NETWORK
TITLE =Conveyors 5, 6 - Clearing Start Delay  3s

      A     "M 10.3"; // C4 Cleared
      L     S5T#3S; 
      SD    "Timer 11"; // C4 Cleared Delayed
NETWORK
TITLE =Events UpDate - Conveyors 5, 6 - Clearing 

      A     "M 10.3"; // C4 Cleared  
      A     "Timer 11"; // C4 Cleared Delayed 
      A     "M 35.0"; 
      AN    "M 35.1"; 
      A     "M 39.0"; 
      AN    "M 39.1"; 
      =     "M 9.0"; // C5-6 Cleared  
NETWORK
TITLE =Conveyors 3, 4, 5, 6 - Cleared -> Start Conveyor 7 Clearing

      A     "M 9.0"; // C5-6 Cleared  
      A     "M 0.3"; 
      S     "M 10.4"; // C5,6 Cleared - Latch
//;
      AN    "M 10.3"; // C4 Not Cleared
      R     "M 10.4"; // Coherence - Reset
NETWORK
TITLE =Events UpDate - Flipper Belt 7 - Ready

      A     "M 10.4"; // C5-6 Cleared
      A     "M 43.1"; // C7 Cleared
      AN    "M 43.2"; 
      =     "M 9.0"; // C5-6-7 Cleared
NETWORK
TITLE =Conveyors 3, 4, 5, 6, 7, 8, 9 - Clearing - Cleared / Ready

      A     "M 9.0"; // C5-6-7 Cleared
      A     "M 47.2"; // C8 Cleared
      AN    "M 47.3"; 
      A     "M 51.1"; // C9 Cleared
      AN    "M 51.2"; 
      AN    "B 9.7"; // C9 - Pusher2 - Edge Cleared
      A     "M 0.3"; 
      L     S5T#3S; 
      SD    "Timer 56"; // Delay 3s
//;
      A     "Timer 56"; 
      =     "M 10.5"; // C10 UpStream Cleared 
      FP    "M 188.4"; 
      S     "M 58.2"; // C10 UpStream Cleared - Trigger Set
//;
      A     "M 10.5"; 
      L     S5T#1S; 
      SE    "Timer 58"; // UpStream Cleared - Pulse 1s 
NETWORK
TITLE =Pivot Conveyor 10 - Clearing - Cleared / Ready
//"C10_EMPTY_TEST" : Work Around to "Will NOT Empty Conveyor 10 - Pivot after a 
//Clearing (F4)".
      A     "M 10.0"; // Clearing CMD - Latch
      AN    "M 10.6"; // C10 Pivot Not Cleared
      A(    ; 
      AN    "B 10.7"; // C11 Exit Sens
      A     "P 15.1"; // Pivot Low Ready
      O     ; 
      AN    "B 15.4"; // C21 Exit Sens
      A     "P 15.0"; // Pivot Hi Ready
      O     "Timer 57"; 
      )     ; 
      A     "M 6.5"; // System Clock 1s
      A     "M 10.5"; // C10 UpStream Cleared
      A     "M 0.3"; 
      =     #C10_EMPTY_TEST; // C10 UpStream Cleared - Pulse
//;
      A     #C10_EMPTY_TEST; // C10 UpStream Cleared - Pulse
      A     "M 58.3"; // All Steps - Reset Mem 
      S     "M 10.6"; // C10 Pivot Cleared - Set
//;
      AN    "M 10.4"; // C5 or C6 Not Empty !
      R     "M 10.6"; // C10 Pivot Cleared - Reset
NETWORK
TITLE =C10 Clearing Trigger via C11 or C21

      A     "M 9.3"; // C10 Clearing via C11-21 - Trigger 1 Scan
      R     "M 9.3"; // C10 Clearing via C11-21 - Trigger Reset
//;
      A     "Timer 58"; // UpStream Cleared - Pulse 1s
      A     "M 10.0"; // Clearing CMD - Confirm
      S     "M 9.3"; // C10 Clearing via C11-21 - Trigger Set
NETWORK
TITLE =Conveyors 1 - 9 Clearing - Clearing Done !
//New Order: C10 Full AND C11...23 Not Empty = Hold Bit! - M8.4  [Case:A]
//
//- Clearing Initiated with an empty Conveyors 11-13, 21-23: No HOLD for New 
//Order!  [Case:B]
//
      AN    "M 54.2"; // Non-Empty C11...C23   [Case:A] 
      A     "M 10.6"; // Clearing Done / Off Pulse 
      A     "M 0.3"; 
      S     "M 8.4"; // New Order - Wait Set   [Case:A] 
      S     "M 8.5"; // New Order - Clearing Done - Set
//;
      A     "M 54.6"; // Empty C11...C23
      R     "M 8.5"; // New Order - Clearing Done - Reset   [Case:B] 
NETWORK
TITLE =Events UpDate - Clearing Stop - Command

      AN    "M 10.0"; 
      =     "M 9.0"; 
NETWORK
TITLE =Events UpDate - Clearing Stop - Ready

      A     "M 9.0"; 
      AN    "M 12.0"; 
      AN    "M 12.1"; 
      AN    "M 15.4"; 
      AN    "M 19.2"; 
      AN    "M 23.2"; 
      =     "M 9.0"; 
NETWORK
TITLE =Conveyors Clearing Stop - Ready

      A     "M 9.0"; 
      AN    "M 43.2"; 
      AN    "M 47.3"; 
      AN    "M 51.2"; 
      =     "M 11.6"; 
NETWORK
TITLE =New Order 
//New Order : Start Filling Conveyors


NETWORK
TITLE =Events UpDate - Elevator Packet IN

      A     "M 15.5"; 
      =     "M 9.0"; 
NETWORK
TITLE =Events UpDate - Conveyor 1 - 9 - Packet Present

      A     "M 9.0"; 
      A     "M 19.3"; 
      A     "M 23.2"; 
      A     "M 43.4"; 
      A     "M 47.4"; 
      A     "M 51.5"; 
      =     "M 11.7"; 
NETWORK
TITLE =Collator Conveyor 4 - Packet Presence - Monitor

      A     "M 31.1"; // C4 Collator Trigger Step
      AN    "M 31.2"; // C4 Collating Done / Packet ON
      A     "M 0.3"; 
      S     "M 12.0"; // 1st Packet OFF -> ON
//;
      A(    ; 
      ON    "M 31.0"; 
      O     "M 31.7"; // C4 Step Register - Reset
      )     ; 
      R     "M 12.0"; // Last Packet ON -> OFF
NETWORK
TITLE =Collator Conveyor 10 - Packet Presence - Monitor

      A     "B 10.4"; // C10 Collator Trigger Sens
      A     "M 55.1"; // C10 Collator Trigger Step
      AN    "M 55.2"; // Collating Done / Packet ON
      A     "M 0.3"; 
      S     "M 12.1"; // 1st Packet OFF -> ON
//;
      A(    ; 
      ON    "M 55.0"; 
      O     "M 55.6"; // C10 Step Register - Reset
      )     ; 
      R     "M 12.1"; // Last Packet ON -> OFF
NETWORK
TITLE =Clearing - Cancelling

      A     "M 0.3"; 
      A     "M 150.4"; 
      A     "M 171.4"; 
      A     "M 171.5"; 
      O     "M 5.4"; 
      O(    ; 
      A     "M 8.4"; 
      AN    "M 10.0"; 
      A     "M 5.0"; 
      )     ; 
      R     "M 7.4"; 
      R     "M 7.5"; 
      R     "M 7.6"; 
      R     "M 7.7"; 
      R     "M 8.0"; 
      R     "M 8.1"; 
      R     "M 8.2"; 
      R     "M 8.3"; // New Order - Operator Enabled - Reset
      R     "M 8.4"; 
      R     "M 8.5"; 
NETWORK
TITLE =Function Key F4 - Reset

      AN    "M 10.0"; 
      R     "M 150.4"; 
END_FUNCTION

FUNCTION "CONVEYOR 0 + PUSHER 0" : VOID
TITLE =Conveyor 0 & Pusher 0
NAME : 'Pos.1'
VERSION : 0.1


VAR_TEMP
  TIMER_RESET : BOOL ;	
  MAIN_SERVICE_1_SW : BOOL ;	
  CONV_0_SERVICE_FWD : BOOL ;	
  CONV_0_SERVICE_REV : BOOL ;	
  RESET_1 : BOOL ;	
  RESET_2 : BOOL ;	
  PUSHER_PUSH : BOOL ;	
END_VAR
BEGIN
NETWORK
TITLE =Conveyor 0 - Service

      A     "HMI_DB".ALL_SERVICE_ENABLE_SW; 
      A     "HMI_DB".CONVEYOR_0_SERVICE_SW; 
      A     "HMI_DB".SERVICE_SW_1_STATUS; 
      =     #MAIN_SERVICE_1_SW; 
//;
      A     #MAIN_SERVICE_1_SW; 
      O     "M 14.0"; 
      JNB   PUS0; 
      A     "HMI_DB".HMI_ROLLER_TEST_FWD_SSW; 
      FP    "FP 168.3"; 
      R     "HMI_DB".HMI_ROLLER_TEST_REV_SSW; 
      =     #RESET_1; 
//;
      A     "HMI_DB".HMI_ROLLER_TEST_REV_SSW; 
      FP    "FP 168.4"; 
      R     "HMI_DB".HMI_ROLLER_TEST_FWD_SSW; 
      =     #RESET_2; 
//;
      A(    ; 
      O     #RESET_1; 
      O     #RESET_2; 
      )     ; 
      L     S5T#1S; 
      SF    "Timer 110"; 
//;
      A     "HMI_DB".HMI_ROLLER_TEST_FWD_SSW; 
      AN    "Timer 110"; 
      =     #CONV_0_SERVICE_FWD; 
//;
      A     "HMI_DB".HMI_ROLLER_TEST_REV_SSW; 
      AN    "Timer 110"; 
      =     #CONV_0_SERVICE_REV; 
//;
      A     "HMI_DB".HMI_PUSHER_0_TEST_SSW; 
      =     #PUSHER_PUSH; 
//;
      AN    #MAIN_SERVICE_1_SW; 
      R     "HMI_DB".HMI_ROLLER_TEST_FWD_SSW; 
      R     "HMI_DB".HMI_ROLLER_TEST_REV_SSW; 

PUS0: R     #CONV_0_SERVICE_FWD; 
      R     #CONV_0_SERVICE_REV; 
      R     #RESET_1; 
      R     #RESET_2; 
      R     #PUSHER_PUSH; 
      FP    "FP 158.0"; 
      =     "M 14.0"; 
NETWORK
TITLE =Function Keys <F5 > on HMI - Reset

      A     "M 13.3"; 
      AN    "M 153.7"; 
      R     "M 150.3"; 
NETWORK
TITLE =Packet goes Through - 2145 Desk R-21 - Run / Timeout

      A     "B 35.3"; 
      FP    "FP 168.1"; 
      =     #TIMER_RESET; // TimeOut - Reset Trigger
//;
      A     "S 28.3"; 
      O     "M 111.0"; 
      O     "M 11.1"; // VFD NOT All Ready !... Goes Through
      AN    #TIMER_RESET; // TimeOut - Reset Action
      L     S5T#10M; 
      SD    "Timer 34"; // TimeOut 10m
//;
      A     "S 28.3"; // R-21 Operator Switch
      O     "M 111.0"; // New HMI SSW
      O     "M 11.1"; // VFD NOT All Ready !... Goes Through
      FP    "FP 168.2"; // Turn ON - Pulse
      S     "M 133.4"; // Goes Through - Set
//;
      A     "S 28.3"; // Goes Through - Refresh
      O     "M 111.0"; 
      O     "M 11.1"; // VFD NOT All Ready !... Goes Through
      A(    ; 
      O     "E 34.7"; // Turn ON - Refresh 
      O     "M 37.1"; 
      O     "B 35.3"; // Turn ON - Refresh 
      )     ; 
      S     "M 133.4"; // Goes Through - Set
//;
      A(    ; 
      O(    ; 
      AN    "S 28.3"; 
      FP    "FP 147.1"; // Turn OFF - Pulse
      )     ; 
      O(    ; 
      AN    "M 111.0"; 
      FP    "FP 147.3"; // Turn OFF - Pulse
      O     "Timer 34"; // TimeOut 10m - Flag
      )     ; 
      O(    ; 
      AN    "M 11.1"; // VFD NOT All Ready !... Goes Through - Reset
      FP    "FP 157.7"; 
      )     ; 
      )     ; 
      R     "M 133.4"; // Goes Through
      R     "HMI_DB".ROLLER_SSW_MAIN; 
NETWORK
TITLE =
//
//      A     "E 2.4"
//      S     "M 33.0"                    // Solid Detected ?
////;
//      A     "M 33.0"                    // Delay Timer - Start
//      L     S5T#300MS
//      SD    "Timer 26"                  // Debouncer 300mS
////;
//      A     "Timer 26"                  // Delayed Test Pulse
//      AN    "E 2.4"                     // Foul Detection
//      R     "M 33.0"                    // Not Detected !
////;
//      A     "Timer 26"                  // Delayed Test Pulse
//      A     "M 33.0"                    // Detection Comfirm !
//      =     "M 33.1"                    // Packet Height OK
//      R     "M 33.0"                    // Reset
//


NETWORK
TITLE =Packet Height - Sensing / Debouncing

      A     "B 35.2"; // B72.0 Adjustable
      S     "M 37.0"; // Solid Detected ?
//;
      A     "M 37.0"; // Delay Timer - Start
      L     S5T#200MS; 
      SD    "Timer 76"; // Debouncer 300mS
//;
      A     "Timer 76"; // Delayed Test Pulse
      AN    "B 35.2"; // Foul Detection
      R     "M 37.0"; // Not Detected !
//;
      A     "Timer 76"; // Delayed Test Pulse
      A     "M 37.0"; // Detection Comfirm !
      =     "M 37.1"; // Packet Height OK
      R     "M 37.0"; // Reset
NETWORK
TITLE =Packet Infeed / Height Eject

      A     "M 134.0"; 
      S     "M 33.6"; // Presumed too small
//;
      AN    "E 34.7"; // Flap Closing
      L     S5T#5S; // TimeOut Reset 5s
      SD    "Timer 61"; 
//;
      A     "M 33.6"; // Presumed too small
//    A     "M 33.1"                    // Packet Height OK ?
      O     "Timer 61"; // 5 Sec Delayed Reset
      R     "M 33.6"; // Not too small
//;
      A     "B 35.3"; // Sliding Sensor
      FP    "FP 147.6"; 
      A     "M 33.6"; // Is too small ?
      S     "M 33.3"; // Eject Action !     
//;
      A     "M 34.7"; // Eject Done
      R     "M 33.3"; // Eject Action      
      R     "M 34.7"; // Eject Done
NETWORK
TITLE =Eject Comfirmation

      A     "M 13.0"; 
      JNB   OUT1; 

      A     "B 35.3"; 
      AN    "M 132.6"; // Not Triggered by Pusher
      S     "M 34.3"; // Eject Step 1
//;
      A     "B 35.4"; 
      AN    "M 132.6"; // Not Triggered by Pusher
      S     "M 34.4"; // Eject Step 2
//;
      A     "K 62.0"; // Conveyor 0 - Running
      A     "M 153.7"; 
      A     "M 34.3"; // Eject Step 1
      A     "M 34.4"; // Eject Step 2
      S     "M 34.5"; // Eject Step 3
//;
      A     "M 34.5"; // Eject Step 3
      AN    "B 35.4"; // Eject Step 4
      S     "M 34.7"; // Eject Done
      R     "M 34.3"; // Eject Step 1 - Reset
      R     "M 34.4"; // Eject Step 2 - Reset
      R     "M 34.5"; // Eject Step 3 - Reset   
      R     "M 33.3"; // Eject Action - Reset
//;
      A     "M 132.5"; // Reset with Pusher Extend
      A     "B 35.4"; 
      R     "M 34.3"; // Eject Step 1 - Reset
      R     "M 34.4"; // Eject Step 2 - Reset
      R     "M 34.5"; // Eject Step 3 - Reset   
      R     "M 33.3"; // Eject Action - Reset

OUT1: CLR   ; 
NETWORK
TITLE =Packet goes Through - Conveyor 0 Man Run - LAUER F5

      O     "M 150.3"; 
      O     "M 133.4"; // Goes Through - Trigger
      O     "M 33.7"; 
      O     "M 33.3"; 
      =     "M 133.5"; // Goes Through - Flag
NETWORK
TITLE =LAUER <F18> - Link Feed by Hand - Reset

      A     "M 13.3"; 
      A     "M 133.5"; 
      R     "M 152.0"; 
NETWORK
TITLE =LAUER <F18> - Link Feed by Hand - Reset by <F19> LAUER

      A     "M 13.3"; 
      A     "M 153.7"; 
      R     "M 152.0"; 
NETWORK
TITLE =Packetizer Flap - Open Pulse

      A     "E 34.7"; 
      FP    "FP 169.5"; 
      =     "M 134.0"; 
NETWORK
TITLE =Packetizer Flap - Close Pulse

      A     "E 34.7"; 
      FN    "FN 155.5"; 
      =     "M 134.2"; 
NETWORK
TITLE =F18 Key - Reseted by Packetizer Flap Door - Delay 5s

      A     "E 34.7"; // Flap Door
      L     S5T#5S; 
      SD    "Timer 16"; // Setup Mode Trigger
NETWORK
TITLE =F18 Key - Reseted by Packetizer Flap Door

      A     "E 34.7"; 
      R     "M 152.0"; 
NETWORK
TITLE =Events UpDate - Packet InFeed

      A(    ; 
      A     "E 34.7"; // Feed by 2145 Run
      A     "M 0.3"; 
      O     "M 133.5"; 
      O     "Timer 16"; 
      A     "M 153.7"; 
      O     ; 
      A     "S 34.6"; // Feed by Hand Run
      A     "M 152.0"; 
      A     "K 41.1"; 
      )     ; 
      =     "M 9.0"; 
NETWORK
TITLE =SEQ InFeed Step 0 Packet InFeed

      A     "M 9.0"; 
      AN    "M 132.1"; 
      AN    "M 132.2"; 
      AN    "M 132.3"; 
      AN    "M 132.4"; 
      AN    "M 132.5"; 
      S     "M 132.0"; 
NETWORK
TITLE =Process Default Trigger

      A     "K 62.0"; 
      AN    "M 37.1"; 
      L     S5T#3S; 
      SD    "Timer 18"; 
NETWORK
TITLE =Events UpDate

      A     "M 132.0"; 
      A(    ; 
      O     "M 37.1"; 
      O     "Timer 18"; 
      )     ; 
      A     "M 153.7"; 
      A     "K 41.0"; 
      A     "K 41.1"; 
      AN    "M 132.4"; 
      AN    "M 133.5"; 
      =     "M 9.0"; 
NETWORK
TITLE =SEQ InFeed Step 1 Packet Height - OK

      A     "M 9.0"; 
      AN    "Timer 16"; 
      S     "M 132.1"; 
NETWORK
TITLE =SEQ InFeed Step 9 Packet Height - NOT OK

      AN    "M 132.1"; 
      A     "B 35.3"; 
      O     "M 132.4"; 
      O     "M 133.5"; 
      O     "Timer 16"; 
      O     "Timer 18"; 
      S     "M 133.1"; 
NETWORK
TITLE =Rollers Conveyor - Clearing Laps - Resets

      A     "M 133.1"; 
      AN    "Timer 16"; 
      AN    "M 133.5"; 
      L     S5T#7S; 
      SD    "Timer 12"; 
//;
      A     "Timer 12"; 
      R     "M 132.0"; 
      R     "M 132.1"; 
      R     "M 132.2"; 
      R     "M 132.4"; 
      R     "M 133.1"; 
NETWORK
TITLE =SEQ InFeed Packet - NOT OK - Reset

      A     "M 133.1"; 
      A(    ; 
      A     "M 134.0"; 
      A     "M 153.7"; 
      AN    "M 133.5"; 
      O     ; 
      AN    "M 133.5"; 
      AN    "M 153.7"; 
      A     "M 152.0"; 
      )     ; 
      R     "M 132.0"; 
      R     "M 132.1"; 
      R     "M 132.2"; 
      R     "M 132.4"; 
      R     "M 133.1"; 
NETWORK
TITLE =SEQ InFeed Step 2 Packet Going IN 

      A(    ; 
      A     "B 35.3"; 
      A     "M 153.7"; 
      A     "M 132.1"; 
      AN    "M 133.5"; // 20220720 TEST
      O     ; 
      A     "B 35.4"; 
      A     "M 152.0"; 
      )     ; 
      A     "M 132.0"; 
      A     "K 41.0"; 
      A     "K 41.1"; 
      S     "M 132.2"; 
NETWORK
TITLE =SEQ InFeed Step 3 Conveyor Stop

      A     "M 132.2"; 
      AN    "M 132.4"; 
      A(    ; 
      AN    "B 35.3"; 
      AN    "B 35.4"; 
      A     "M 153.7"; 
      O     ; 
      AN    "B 35.4"; 
      A     "M 152.0"; 
      )     ; 
      S     "M 132.3"; 
      R     "M 132.0"; 
      R     "M 132.1"; 
      R     "M 132.2"; 
NETWORK
TITLE =SEQ InFeed Step 4 Packet too Long

      A     "M 132.2"; 
      A     "B 35.3"; 
      A     "B 35.4"; 
      A     "M 153.7"; 
      S     "M 132.4"; 
NETWORK
TITLE =SEQ Pusher 0 Extended - Acknowledge

      A     "M 132.3"; 
      AN    "P 35.5"; 
      L     S5T#700MS; 
      SD    "Timer 7"; 
//;
      A     "Timer 7"; 
      S     "M 132.5"; 
      R     "M 132.3"; 
NETWORK
TITLE =SEQ InFeed Step 6 Pusher - Home

      A     "M 132.5"; 
      AN    "P 35.6"; 
      S     "M 132.6"; 
      R     "M 132.5"; 
NETWORK
TITLE =SEQ InFeed Step 7 Link Signal

      A     "M 132.6"; 
      AN    "P 35.7"; 
      S     "M 132.7"; 
NETWORK
TITLE =SEQ InFeed Step 8 End of Cycle

      A     "M 132.6"; 
      AN    "P 35.5"; 
      S     "M 133.0"; 
      R     "M 132.6"; 
      R     "M 132.7"; 
NETWORK
TITLE =Cumul Empty - Delay

      A     "M 133.0"; 
      L     S5T#2S; 
      SD    "Timer 8"; 
//;
      A     "Timer 8"; 
      R     "M 133.0"; 
NETWORK
TITLE =Elevator - Conveyor 0 - FWD

      A(    ; 
      A     "M 132.0"; 
      A     "M 153.7"; 
      AN    #MAIN_SERVICE_1_SW; 
      O     #CONV_0_SERVICE_FWD; 
      )     ; 
      AN    "E 35.0"; 
      AN    "M 30.1"; 
      AN    "K 62.1"; 
      =     "K 62.0"; 
NETWORK
TITLE =Elevator - Conveyor 0 - REV

      A(    ; 
      A(    ; 
      AN    "M 140.3"; 
      A     "M 152.0"; 
      O     ; 
      A     "M 140.3"; 
      A     "M 110.0"; 
      )     ; 
      A     "M 132.0"; 
//     A     "M 152.0"
      AN    #MAIN_SERVICE_1_SW; 
      O     #CONV_0_SERVICE_REV; 
      )     ; 
      AN    "E 35.0"; 
      AN    "M 30.1"; 
      AN    "K 62.0"; 
      =     "K 62.1"; 
NETWORK
TITLE =Elevator - Pusher 0 - FWD

      A(    ; 
      AN    "M 37.7"; 
      AN    "DB UTILITY".Freeze_Sequence_1; //  Freezes E1 + C1 + C2 Belt    
      A     "M 132.5"; 
      AN    "K 62.3"; 
      AN    #MAIN_SERVICE_1_SW; 
      AN    "DB UTILITY".Pusher_0_Disable; 
      O(    ; 
      A     #MAIN_SERVICE_1_SW; 
      A     #PUSHER_PUSH; 
      )     ; 
      O     ; 
      A     "M 161.0"; 
      A     "M 161.1"; 
      A     "M 14.4"; 
      )     ; 
      A     "P 35.6"; 
      AN    "E 35.1"; 
      AN    "M 11.1"; // VFD NOT All Ready !
      AN    "M 30.2"; 
      =     "K 62.2"; 
NETWORK
TITLE =Elevator - Pusher 0 - REV

      A(    ; 
      A     "M 132.6"; 
      AN    #MAIN_SERVICE_1_SW; 
      O(    ; 
      A     #MAIN_SERVICE_1_SW; 
      AN    #PUSHER_PUSH; 
      )     ; 
      O     ; 
      A     "M 161.1"; 
      AN    "M 161.0"; 
      A     "M 14.4"; 
      )     ; 
      A     "P 35.5"; 
      AN    "K 62.2"; 
      AN    "E 35.1"; 
      AN    "M 30.2"; 
      =     "K 62.3"; 
NETWORK
TITLE =Conveyor 0 - Fault

      A(    ; 
      O     "K 62.0"; 
      O     "K 62.1"; 
      )     ; 
      AN    "M 133.5"; 
      AN    "E 34.7"; 
      L     S5T#20S; 
      SD    "Timer 13"; 
//;
      A     "Timer 13"; 
      S     "M 30.1"; 
NETWORK
TITLE =Conveyor 0 - Fault - Reset

      A     "M 171.5"; 
      R     "M 30.1"; 
NETWORK
TITLE =Pusher 0 - Fault

      A(    ; 
      O     "K 62.2"; 
      O     "K 62.3"; 
      )     ; 
      L     S5T#10S; 
      SD    "Timer 14"; 
//;
      A     "Timer 14"; 
      S     "M 30.2"; 
NETWORK
TITLE =Pusher 0 - Fault - Reset

      A     "M 171.5"; 
      R     "M 30.2"; 
END_FUNCTION

FUNCTION "ELEVATOR + PUSHER 1" : VOID
TITLE =Elevator + Pusher 1   Pos.2  FC1016
//
NAME : POS_2
VERSION : 0.0


VAR_TEMP
  ELEVATOR_UP_OUT : BOOL ;	
  ELEVATOR_DN_OUT : BOOL ;	
  MAIN_SERVICE_1_SW : BOOL ;	
  ELEVATOR_SERVICE_SW : BOOL ;	
  ELEVATOR_DN_PB : BOOL ;	
  ELEVATOR_UP_PB : BOOL ;	
  ELEVATOR_ROUNDTRIP : BOOL ;	
  PUSHER_PUSH : BOOL ;	
  INITIALISATION : BOOL ;	
  BRAKE_RELEASE_OK : BOOL ;	
  BRAKE_CONTACTOR_KO : BOOL ;	
END_VAR
BEGIN
NETWORK
TITLE =Elevator - Health OK

      A     "M 0.3"; 
      AN    "M 3.0"; 
      A     "E 0.3"; 
      A     "E 4.6"; 
      =     "M 14.3"; 
NETWORK
TITLE =Elevator - Service

      A     "HMI_DB".ALL_SERVICE_ENABLE_SW; 
      A     "HMI_DB".ELEVATOR_SERVICE_SW; 
      A     "HMI_DB".SERVICE_SW_1_STATUS; 
      =     #MAIN_SERVICE_1_SW; 
//;
      A     #MAIN_SERVICE_1_SW; 
      O     "M 14.1"; 
      JNB   PUS1; 
      A     "HMI_DB".HMI_ELEVATOR_SERVICE_SSW; 
      =     #ELEVATOR_SERVICE_SW; 
      S     "DB UTILITY".Pusher_0_Disable; 
//;
      A     #ELEVATOR_SERVICE_SW; 
      A(    ; 
      A     "HMI_DB".HMI_ELEVATOR_TEST_DN_SSW; 
      )     ; 
      =     #ELEVATOR_DN_PB; 
//;
      A     #ELEVATOR_SERVICE_SW; 
      A(    ; 
      A     "HMI_DB".HMI_ELEVATOR_TEST_UP_SSW; 
      )     ; 
      =     #ELEVATOR_UP_PB; 
//;
      A     #MAIN_SERVICE_1_SW; 
      AN    #ELEVATOR_SERVICE_SW; 
      A     "HMI_DB".ELEVATOR_ROUND_TRIP_SSW; 
      =     #ELEVATOR_ROUNDTRIP; 
//;
      A     "HMI_DB".HMI_PUSHER_1_TEST_SSW; 
      =     #PUSHER_PUSH; 
//;
      AN    #MAIN_SERVICE_1_SW; 
      R     "HMI_DB".HMI_ELEVATOR_SERVICE_SSW; 
      R     "HMI_DB".HMI_ELEVATOR_TEST_DN_SSW; 
      R     "HMI_DB".HMI_ELEVATOR_TEST_UP_SSW; 
      R     "DB UTILITY".Pusher_0_Disable; 

PUS1: R     #ELEVATOR_SERVICE_SW; 
      R     #ELEVATOR_DN_PB; 
      R     #ELEVATOR_UP_PB; 
      R     #ELEVATOR_ROUNDTRIP; 
      R     #PUSHER_PUSH; 
      FP    "FP 158.1"; 
      =     "M 14.1"; 
//;
      A     "HMI_DB".SERVICE_INIT_PB; 
      A     #ELEVATOR_SERVICE_SW; 
      A     #MAIN_SERVICE_1_SW; 
      =     #INITIALISATION; 
NETWORK
TITLE =Elevator - Manual Run - Conditions

      A(    ; 
      A     "M 15.0"; // Elevator Ready
      AN    "M 15.6"; // Not Going Up
      O     ; // or
      A     "M 15.6"; 
      AN    "M 16.2"; 
      )     ; 
      A     "M 190.0"; // LAUER Panel
      O     #ELEVATOR_SERVICE_SW; // HMI
      A     "M 14.3"; 
      =     "M 14.4"; 
NETWORK
TITLE =Elevator - Fault - Packet not Centered on Platform !

      A(    ; 
      O     "B 5.1"; 
      O     "B 5.2"; 
      )     ; 
      AN    "P 4.0"; 
      A     "M 15.6"; 
      AN    "M 16.1"; 
      A     "M 0.3"; 
      S     "M 14.7"; 
//;
      AN    "B 5.1"; 
      AN    "B 5.2"; 
      A     "S 4.7"; 
      A     "M 14.3"; 
      R     "M 14.7"; 
NETWORK
TITLE =Step 1N1 - Elevator Ready

      A     "M 14.3"; 
      S     "M 15.0"; 
NETWORK
TITLE =Step 1N2 - Pusher 0 - Retracted

      AN    "P 35.5"; 
      A     "P 35.6"; 
      A     "P 35.7"; 
      A     "M 14.3"; 
      A     "M 15.0"; 
      S     "M 15.1"; 
NETWORK
TITLE =Step 1N3 - Elevator Down Slow / Bot Position

      A(    ; 
      ON    "P 4.0"; 
      ON    "P 4.1"; 
      )     ; 
      A     "M 14.3"; 
      A     "M 15.1"; 
      S     "M 15.2"; 
NETWORK
TITLE =Step 1N4 - Elevator Bot Position

      AN    "P 4.0"; 
      A     "M 14.3"; 
      A     "M 15.2"; 
      S     "M 15.3"; 
NETWORK
TITLE =Step 1N5 - Elevator - Packet Runs IN

      A     "M 132.7"; 
      A     "M 0.3"; 
      A     "M 15.3"; 
      S     "M 15.4"; 
NETWORK
TITLE =Step 1N6 - Elevator - Packet IN

      A     "M 132.7"; 
      A     "M 0.3"; 
      A     "M 15.4"; 
      S     "M 15.5"; 
NETWORK
TITLE =Step 1N7 - Elevator Going Up - Command

      A     "M 0.3"; 
      A     "M 15.5"; 
      AN    #MAIN_SERVICE_1_SW; 
      O     #ELEVATOR_ROUNDTRIP; 
      S     "M 15.6"; 
NETWORK
TITLE =Step 1N8 - Elevator Going Up - Trigger

      AN    "P 4.4"; 
      A     "M 14.3"; 
      AN    "DB UTILITY".Freeze_Sequence_1; 
      AN    "M 14.7"; 
      A     "M 15.6"; 
      S     "M 15.7"; 
NETWORK
TITLE =Step 1N9 - Elevator Going Up - Slow

      A(    ; 
      ON    "P 4.2"; 
      ON    "P 4.3"; 
      )     ; 
      A     "M 14.3"; 
      A     "M 15.7"; 
      S     "M 16.0"; 
NETWORK
TITLE =Step 1N10 - Elevator Top Position - Stop

      AN    "P 4.3"; 
      A     "M 14.3"; 
      A     "M 16.0"; 
      S     "M 16.1"; 
NETWORK
TITLE =Step 1N11 - Pusher 1 - FWD

      A     "M 19.1"; 
      AN    "M 19.2"; 
      AN    "DB UTILITY".Freeze_Sequence_1; //  Freezes E1 + P1 + C1 + C2 Belt    
      A     "M 0.3"; 
      A     "M 16.1"; 
      S     "M 16.2"; 
NETWORK
TITLE =Step 1N12 - Pusher 1 - End Stop

      AN    "P 4.5"; 
      A     "M 0.3"; 
      A     "M 16.2"; 
      S     "M 16.3"; 
NETWORK
TITLE =Soft Timer 15 Reset

      A     "M 16.3"; 
      AN    "M 16.4"; 
      A     "M 14.3"; 
      A     "M 0.3"; 
      JCN   R151; 
      JU    E151; 

R151: L     L#0; 
      T     "DB UTILITY".T15_ET; 
      R     "DB UTILITY".T15_DN; 

E151: NOP   0; 

NETWORK
TITLE =Soft Timer 15 Add

      A     "M 16.3"; 
      AN    "M 16.4"; 
      A     "M 14.3"; 
      A     "M 0.3"; 
      AN    "DB UTILITY".Freeze_Sequence_1; 
      AN    "DB UTILITY".T15_DN; 
      JCN   E152; 

      L     "DB UTILITY".T15_ET; 
      L     "DB UTILITY".Scan_Cycle_Previous; 
      ITD   ; 
      +D    ; 
      T     "DB UTILITY".T15_ET; 

E152: NOP   0; 

NETWORK
TITLE =Soft Timer 15 Done 100mS

      L     "DB UTILITY".T15_ET; 
      L     L#100; 
      >=D   ; 
      =     "DB UTILITY".T15_DN; 

NETWORK
TITLE =Step 1N13 - Elevator Steps Register - Reset

      A     "DB UTILITY".T15_DN; 
      A     "M 0.3"; 
      A     "M 16.3"; 
      S     "M 16.4"; 
NETWORK
TITLE =Elevator Steps Register - Reset

      A(    ; 
      A     "M 190.0"; 
      A     "M 171.4"; 
      A     "M 171.5"; 
      O     "M 16.4"; 
      O     #INITIALISATION; 
      O     "DB UTILITY".Elevator_Disable; 
      )     ; 
      A     "M 0.3"; 
      JC    M001; 
      JU    M002; 

M001: L     W#16#0; 
      T     "MW 15"; 

M002: CLR   ; 
NETWORK
TITLE =Trans System - Ready -> Tuber 2145

      AN    "M 3.0"; 
      AN    "M 10.0"; 
      A     "M 0.3"; 
      =     "K 41.0"; // Trans System OK !
NETWORK
TITLE =Elevator - Ready -> Tuber 2145

      A     "M 15.3"; 
      AN    "M 15.5"; 
      A     "M 0.3"; 
      =     "K 41.1"; 
NETWORK
TITLE =Elevator - Brake Release Confirm

      A     "E 28.4"; 
      L     S5T#100MS; 
      SF    "Timer 20"; 
//;
      A     "Timer 20"; 
      =     #BRAKE_RELEASE_OK; 
NETWORK
TITLE =Elevator - VFD Release + Rise

      A(    ; 
      AN    "M 14.7"; 
      A     "M 15.7"; 
      AN    "M 16.1"; 
      AN    #ELEVATOR_SERVICE_SW; 
      O     ; 
      A(    ; 
      O     "M 161.0"; 
      O     #ELEVATOR_UP_PB; 
      )     ; 
      A     "M 14.4"; 
      AN    "P 35.5"; 
      A     #ELEVATOR_SERVICE_SW; 
      )     ; 
      A     "P 35.6"; // Pusher 0 Cleared Platform Area
      A     "P 4.3"; // Not if Already at Top
      AN    "M 92.1"; // Not While Going Down
      A     "M 14.3"; 
      AN    "M 11.1"; // VFD NOT All Ready ! - Keep Brake Applied
      =     "M 92.0"; 
      =     #ELEVATOR_UP_OUT; 
NETWORK
TITLE =Elevator - VFD Release + Fall

      A(    ; 
      A     "M 15.1"; 
      AN    "M 15.3"; 
      AN    #ELEVATOR_SERVICE_SW; 
      O     ; 
      A(    ; 
      O     "M 161.1"; 
      O     #ELEVATOR_DN_PB; 
      )     ; 
      A     "M 14.4"; 
      AN    "P 35.5"; 
      A     #ELEVATOR_SERVICE_SW; 
      )     ; 
      AN    "P 35.5"; // Pusher 0 is Home
      A     "P 35.6"; // Pusher 0 Cleared Platform Area
      A     "P 4.0"; // Not at Bottom Position
      AN    "M 92.0"; // Not Drive Release
      A     "M 14.3"; // Clear to Proceed
      AN    "M 11.1"; // VFD NOT All Ready ! - Keep Brake Applied
      =     "M 92.1"; 
      =     #ELEVATOR_DN_OUT; 
NETWORK
TITLE =Elevator - Brake

      A(    ; 
      O     #ELEVATOR_UP_OUT; 
      O     #ELEVATOR_DN_OUT; 
      )     ; 
      =     "A 56.2"; // Brake Release
NETWORK
TITLE =Safety Brake

      AN    "E 15.3"; // Motor Stopped
      R     "A 56.2"; // Apply Brake
NETWORK
TITLE =Elevator - Fast Mode 

      A(    ; 
      A     "M 15.1"; 
      AN    "M 15.2"; 
      A     "M 92.1"; 
      O     ; 
      A     "M 15.7"; 
      AN    "M 16.0"; 
      A     "M 92.0"; 
      )     ; 
      A     "M 14.3"; 
      AN    #ELEVATOR_SERVICE_SW; 
      =     "M 92.3"; 
NETWORK
TITLE =Elevator - Slow

      A(    ; 
      A     "M 15.2"; 
      AN    "M 15.3"; 
      A     "M 92.1"; 
      O     ; 
      A     "M 16.0"; 
      AN    "M 16.1"; 
      A     "M 92.0"; 
      O     ; 
      A(    ; 
      A     "M 161.0"; 
      AN    "M 92.1"; 
      A     "P 4.3"; 
      O     ; 
      A     "M 161.1"; 
      AN    "M 92.0"; 
      A     "P 4.0"; 
      )     ; 
      A     "M 14.4"; 
      )     ; 
      A     "M 14.3"; 
      O     #ELEVATOR_SERVICE_SW; 
      =     "M 92.2"; 
NETWORK
TITLE =Pusher 1 FWD - Contactor K42.6

      A(    ; 
      A     "M 16.2"; 
      AN    "M 16.3"; 
      AN    #PUSHER_PUSH; 
      AN    "DB UTILITY".Pusher_1_Disable; 
      O(    ; 
      A     #MAIN_SERVICE_1_SW; 
      A     #PUSHER_PUSH; 
      )     ; 
      O     ; 
      A     "M 14.4"; 
      A     "M 161.0"; 
      AN    "P 4.3"; 
      )     ; 
      A     "P 4.5"; 
      A     "M 14.3"; 
      AN    "K 42.7"; 
      =     "K 42.6"; 
NETWORK
TITLE =Pusher 1 REV - Contactor K42.7

      A(    ; 
      A     "M 15.1"; 
      AN    "M 15.4"; 
      AN    #PUSHER_PUSH; 
      O(    ; 
      A     #MAIN_SERVICE_1_SW; 
      AN    #PUSHER_PUSH; 
      )     ; 
      O     ; 
      A     "M 14.4"; 
      A     "M 161.1"; 
      )     ; 
      A     "P 4.4"; 
      A     "M 14.3"; 
      AN    "K 42.6"; 
      =     "K 42.7"; 
NETWORK
TITLE =Brake Contactor - Monitor

      A     "A 56.2"; // Brake Release 
      L     S5T#1S; // 1 sec Delay
      SD    "Timer 133"; 
//;
      A     "Timer 133"; 
      AN    #BRAKE_RELEASE_OK; // Release Brake - Confirm
      =     #BRAKE_CONTACTOR_KO; // Contactor Malfunction !
NETWORK
TITLE =New Elevator VFD PARKER - Ready

      AN    "E 14.4"; // DRIVE TEST
      O     #BRAKE_CONTACTOR_KO; // Contactor Monitor = Contactor Malfunction !
      JCN   NFLT; // No fault
      S     "M 92.5"; // Set Fault Bit
      JU    OFF; // Turn Off
NETWORK
TITLE =New Elevator VFD with Dynamic Resistor - Go Up

NFLT: A     #ELEVATOR_UP_OUT; // VFD Release Command UP
      A     "M 92.3"; // Fast Speed Command
      AN    "M 92.5"; // Fault Bit
      AN    "M 11.1"; // VFD NOT All Ready !
      JCN   UPLO; 
      S     "A 63.0"; // Release Drive - Go Up
      S     "A 63.2"; // Speed 2 / Speed 0.0
//;                                       
      A     #BRAKE_RELEASE_OK; // Release Brake - Confirm
      JCN   END; 
      =     "A 63.1"; // Speed 1
      =     "A 63.2"; // Speed 2 + Speed 1 = Fast
      R     "A 63.3"; // L = Forward (Up)
      JU    END; 

UPLO: A     #ELEVATOR_UP_OUT; // VFD Release Command UP
      A     "M 92.2"; // Slow Speed Command
      AN    "M 92.5"; // Fault Bit
      AN    "M 11.1"; // VFD NOT All Ready !
      JCN   DNHI; 
      S     "A 63.0"; // Release Drive - Go Up
      S     "A 63.2"; // Speed 2 / Speed 0.0
//;
      A     #BRAKE_RELEASE_OK; // Release Brake - Confirm
      JCN   END; 
      =     "A 63.1"; // Speed 1
      R     "A 63.2"; // Speed 2 = Off
      R     "A 63.3"; // L = Forward (Up)
      JU    END; 
NETWORK
TITLE =New Elevator VFD with Dynamic Resistor - Go Down

DNHI: A     #ELEVATOR_DN_OUT; // VFD Release Command DN
      A     "M 92.3"; // Fast Speed Command
      AN    "M 92.5"; // Fault Bit
      JCN   DNLO; 
      S     "A 63.0"; // Release Drive - Go Dn
      S     "A 63.2"; // Speed 2 / Speed 0.0
//;
      A     #BRAKE_RELEASE_OK; // Release Brake - Confirm
      JCN   END; 
      =     "A 63.1"; // Speed 1
      =     "A 63.2"; // Speed 2 + Speed 1 = Fast
      =     "A 63.3"; // H = Reverse (Dn)
      JU    END; 

DNLO: A     #ELEVATOR_DN_OUT; // VFD Release Command DN
      A     "M 92.2"; // Slow Speed Command
      AN    "M 92.5"; // Fault Bit
      JCN   OFF; 
      S     "A 63.0"; // Release Drive - Go Dn
      S     "A 63.2"; // Speed 2 / Speed 0.0
//;
      A     #BRAKE_RELEASE_OK; // Release Brake - Confirm
      JCN   END; 
      =     "A 63.1"; // Speed 1
      R     "A 63.2"; // Speed 2 = Off
      =     "A 63.3"; // H = Reverse (Dn)
      JU    END; 
NETWORK
TITLE =Drive Off

OFF:  AN    #BRAKE_RELEASE_OK; // Brake ON Status
      R     "A 63.0"; // Drive - Off
NETWORK
TITLE =Elevator Off

END:  AN    #ELEVATOR_UP_OUT; 
      AN    #ELEVATOR_DN_OUT; 
      R     "A 63.1"; // Speed 1 - Off
      S     "A 63.2"; // Speed 2 / Speed 0.0 - Off
      R     "A 63.3"; // L = Forward (Up)
END_FUNCTION

FUNCTION "CONVEYOR 1 - BELT" : VOID
TITLE =Conveyor 1  Pos. 1
//
NAME : POS_3
VERSION : 0.0


VAR_TEMP
  MAIN_SERVICE_1_SW : BOOL ;	
  SERVICE_RUN : BOOL ;	
  INITIALISATION : BOOL ;	
  SENSOR_TEST : BOOL ;	
END_VAR
BEGIN
NETWORK
TITLE =Service Test

      A     "HMI_DB".ALL_SERVICE_ENABLE_SW; 
      A     "HMI_DB".CONVEYOR_1_SERVICE_SW; 
      A     "HMI_DB".SERVICE_SW_1_STATUS; 
      =     #MAIN_SERVICE_1_SW; 
//;
      A     #MAIN_SERVICE_1_SW; 
      O     "M 18.1"; 
      JNB   CON1; 
      A     "HMI_DB".HMI_CONVEYOR_1_TEST_SSW; 
      =     #SERVICE_RUN; 
      S     "DB UTILITY".Elevator_Disable; 
      S     "DB UTILITY".Pusher_1_Disable; 
//;
      A     "HMI_DB".SERVICE_INIT_PB; 
      =     #INITIALISATION; 
//;
      AN    #MAIN_SERVICE_1_SW; 
      R     "HMI_DB".HMI_CONVEYOR_1_TEST_SSW; 
      R     "DB UTILITY".Elevator_Disable; 
      R     "DB UTILITY".Pusher_1_Disable; 

CON1: R     #SERVICE_RUN; 
      R     #INITIALISATION; 
      FP    "FP 158.2"; 
      =     "M 18.1"; 
NETWORK
TITLE =Step 2N1 - Power ON

      A     "M 0.3"; 
      S     "M 19.0"; 
NETWORK
TITLE =Step 2N2 - Conveyor 1 - Ready

      AN    "B 5.4"; 
      A     "M 0.3"; 
      A     "M 19.0"; 
      S     "M 19.1"; 
NETWORK
TITLE =Step 2N3 - Conveyor 1 - Packet Runs IN

      A     "M 16.2"; 
      AN    "M 16.3"; 
      A     "M 0.3"; 
      A     "M 19.1"; 
      S     "M 19.2"; 
NETWORK
TITLE =Step 2N4 - Conveyor 1 - Packet IN

      A     "B 5.4"; 
      A     "M 0.3"; 
      A     "M 19.2"; 
      S     "M 19.3"; 
NETWORK
TITLE =Step 2N5 - Conveyor 1 - Packet Exits

      A     "M 23.0"; 
      AN    "M 23.1"; 
      A     "M 0.3"; 
      A     "M 19.3"; 
      S     "M 19.4"; 
NETWORK
TITLE =Step 2N6 - Conveyor 1 - Packet Out

      AN    "B 5.4"; 
      A     "M 0.3"; 
      A     "M 19.4"; 
      S     "M 19.5"; 
NETWORK
TITLE =Step 2N7 - Conveyor 1 - Done

      A     "B 5.5"; 
      A     "M 0.3"; 
      A     "M 19.5"; 
      S     "M 19.6"; 
NETWORK
TITLE =Step 2N8 - Conveyor 1 - Steps Register - Reset

      AN    "B 5.5"; 
      A     "M 0.3"; 
      A     "M 19.6"; 
      S     "M 19.7"; 
NETWORK
TITLE =Conveyor 1 - Steps Register - Reset

      A(    ; 
      O     "M 19.7"; 
      O     "DB UTILITY".T19_DN; 
      O     #INITIALISATION; 
      O     "DB UTILITY".Conveyor_1_Disable; 
      )     ; 
      A     "M 0.3"; 
      JNB   INIT; 
      L     W#16#0; 
      T     "MW 19"; 

INIT: CLR   ; 
NETWORK
TITLE =Soft Timer 19 Reset

      A     "M 19.2"; 
      AN    "M 19.3"; 
      A     "M 0.3"; 
      JCN   R191; 
      JU    E191; 

R191: L     L#0; 
      T     "DB UTILITY".T19_ET; 
      R     "DB UTILITY".T19_DN; 

E191: NOP   0; 

NETWORK
TITLE =Soft Timer 19 Add

      A     "M 19.2"; 
      AN    "M 19.3"; 
      A     "M 0.3"; 
      AN    "DB UTILITY".Freeze_Sequence_1; 
      AN    "DB UTILITY".T19_DN; 
      JCN   E192; 

      L     "DB UTILITY".T19_ET; 
      L     "DB UTILITY".Scan_Cycle_Previous; 
      ITD   ; 
      +D    ; 
      T     "DB UTILITY".T19_ET; 

E192: NOP   0; 

NETWORK
TITLE =Soft Timer 19 Done 10s

      L     "DB UTILITY".T19_ET; 
      L     L#10000; 
      >=D   ; 
      =     "DB UTILITY".T19_DN; 
NETWORK
TITLE =Cross Conveyor - Fast (Always)

      A(    ; 
      A     "M 19.2"; 
      AN    "M 19.3"; 
      O     ; 
      A     "M 19.4"; 
      AN    "M 19.7"; 
      )     ; 
      AN    #MAIN_SERVICE_1_SW; 
      O     #SERVICE_RUN; 
      AN    "DB UTILITY".Freeze_Sequence_1; 
      A     "M 0.3"; 
      =     "A 43.1"; 

NETWORK
TITLE =Cross Conveyor - VFD Release

      A(    ; 
      A     "M 19.2"; 
      AN    "M 19.3"; 
      O     ; 
      A     "M 19.4"; 
      AN    "M 19.7"; 
      )     ; 
      AN    #MAIN_SERVICE_1_SW; 
      O(    ; 
      A     #SERVICE_RUN; 
      AN    "B 5.4"; 
      )     ; 
      A     "A 43.1"; 
      AN    "DB UTILITY".Freeze_Sequence_1; 
      AN    "M 11.1"; // VFD NOT All Ready !
      A     "M 0.3"; 
      =     "A 43.0"; 
NETWORK
TITLE =Any Conveyors Packet mS Test

//    A     "B 10.7"
//    A     "A 48.6"


      A     "B 10.6"; 
      A     "A 48.3"; 






      =     #SENSOR_TEST; 
//;
      A     #SENSOR_TEST; 
      FP    "FP 147.7"; 
      JNB   NRST; 
      L     0; 
      T     "COLLATORS DB".Any_Conveyors_mS; 

NRST: A     #SENSOR_TEST; 
      JNB   NCNT; 
      L     "COLLATORS DB".Any_Conveyors_mS; 
      L     "DB UTILITY".Scan_Cycle_Previous; 
      ITD   ; 
      +D    ; 
      T     "COLLATORS DB".Any_Conveyors_mS; 

NCNT: CLR   ; 

END_FUNCTION

FUNCTION "CONVEYOR 2 - ANGLE B+R" : VOID
TITLE =Angle Conveyor 2  Pos. 4
NAME : POS_4
VERSION : 0.0


VAR_TEMP
  MAIN_SERVICE_1_SW : BOOL ;	
  SERVICE_BELT_RUN : BOOL ;	
  SERVICE_ROLLER_LIFT : BOOL ;	
  SERVICE_ROLLER_RUN : BOOL ;	
  INITIALISATION : BOOL ;	
  PACKET_MEASURE_FLAG : BOOL ;	
END_VAR
BEGIN
NETWORK
TITLE =Service Test

      A     "HMI_DB".ALL_SERVICE_ENABLE_SW; 
      A     "HMI_DB".CONVEYOR_2_SERVICE_SW; 
      A     "HMI_DB".SERVICE_SW_1_STATUS; 
      =     #MAIN_SERVICE_1_SW; 
//;
      A     #MAIN_SERVICE_1_SW; 
      O     "M 22.1"; 
      JNB   CON2; 
      A     "HMI_DB".HMI_CONVEYOR_2B_TEST_SSW; 
      =     #SERVICE_BELT_RUN; 
      S     "DB UTILITY".Conveyor_1_Disable; 
//;
      A     "HMI_DB".HMI_CONVEYOR_2L_TEST_SSW; 
      =     #SERVICE_ROLLER_LIFT; 
      S     "DB UTILITY".Conveyor_1_Disable; 
//;
      A     "HMI_DB".HMI_CONVEYOR_2R_TEST_SSW; 
      =     #SERVICE_ROLLER_RUN; 
      S     "DB UTILITY".Conveyor_1_Disable; 
//;
      A     "HMI_DB".SERVICE_INIT_PB; 
      =     #INITIALISATION; 
//;
      AN    #MAIN_SERVICE_1_SW; 
      R     "HMI_DB".HMI_CONVEYOR_2B_TEST_SSW; 
      R     "HMI_DB".HMI_CONVEYOR_2L_TEST_SSW; 
      R     "HMI_DB".HMI_CONVEYOR_2R_TEST_SSW; 
      R     "DB UTILITY".Conveyor_1_Disable; 

CON2: R     #SERVICE_BELT_RUN; 
      R     #SERVICE_ROLLER_LIFT; 
      R     #SERVICE_ROLLER_RUN; 
      R     #INITIALISATION; 
      FP    "FP 158.3"; 
      =     "M 22.1"; 

NETWORK
TITLE =Angle Conveyor - Fault / Ready

      A     "M 23.3"; // Packet in Position - Memory
      AN    "E 5.7"; // Conv 2 NOT High Position
      A     "DB UTILITY".T23_DN; // Lift Fault TimeOut 2s
      A     "M 0.3"; 
      S     "M 22.7"; // Angle Conv 2 - Fault Set
//;
      A     "M 171.5"; // Lauer Clr PB
      AN    "B 5.5"; // NO Packet Entering -> Conv 2
      A     "M 0.3"; 
      R     "M 22.7"; // Angle Conv 2 - Fault ReSet

NETWORK
TITLE =Step 3N1 - Power ON

      A     "M 0.3"; 
      S     "M 23.0"; 

NETWORK
TITLE =Step 3N2 - Angle Belt 2 - Packet Exits Conveyor 1

      A     "B 5.4"; // Packet exits Conv 1
      AN    "B 6.0"; // Conv 2 Free
      A     "E 5.6"; // Conv 2 Low Position
      AN    "DB UTILITY".Freeze_Sequence_1; 
      A     "M 0.3"; 
      A     "M 23.0"; 
      S     "M 23.1"; // Packet Loading -> Conv 2
NETWORK
TITLE =Step 3N3 - Angle Belt 2 - Packet Runs IN

      A     "B 5.5"; // Packet Entering -> Conv 2
      A     "M 0.3"; 
      A     "M 23.1"; // Packet Loading -> Conv 2
      S     "M 23.2"; // Packet Runs IN - Mem Set
//;
      ON    "M 23.1"; // NO Packet Loading -> Conv 2
      R     "M 23.2"; // Packet Runs IN - Mem ReSet

NETWORK
TITLE =Step 3N4 - Angle Belt 2 - Packet in Position

      A     "B 6.0"; // Packet in Position - Sens
      A     "M 0.3"; 
      A     "M 23.2"; // Packet Runs IN - Memory
      S     "M 23.3"; // Packet in Position - Mem
NETWORK
TITLE =Packet Width Measure Bit - Conv 2 Effective

      A     "B 5.4"; // Upstream Conveyor End Sensor
      A     "M 23.1"; // Packet Loading -> Conv 2
      A     "K 43.4"; // Belt Running
      AN    "M 23.4"; // NO Lift Up Command
      AN    "DB UTILITY".Freeze_Sequence_1; 
      =     #PACKET_MEASURE_FLAG; 

NETWORK
TITLE =Packet Width Time Reset - Freeze Safe

      A     "M 23.1"; // Packet Loading -> Conv 2
      O     "DB UTILITY".Freeze_Sequence_1; 
      JC    NRS1; 

      L     L#0; 
      T     "MD 260"; // Width [mS]

NRS1: NOP   0; 
NETWORK
TITLE =Packet Width Time Count Up From Sensor "B 5.4" 

      A     #PACKET_MEASURE_FLAG; 
      JCN   NMES; 

      L     "MD 260"; // Width [mS]
      L     "DB UTILITY".Scan_Cycle_Previous; 
      ITD   ; 
      +D    ; 
      T     "MD 260"; // Width [mS]

NMES: NOP   0; 
NETWORK
TITLE =Middle Travel Time Reset - Freeze Safe

      A     "M 23.3"; // Packet in Position - Mem
      O     "DB UTILITY".Freeze_Sequence_1; 
      JC    NRS2; 

      L     L#0; 
      T     "MD 264"; // Half Width [mS] - Zeroed

NRS2: NOP   0; 
NETWORK
TITLE =Middle Travel Time Count Up From B 6.0

      ON    "M 23.3"; // NO Packet in Position - Mem
      O     "M 23.4"; // Lift Up Command
      ON    "K 43.4"; // Belt Stopped
      ON    "M 0.3"; // No Power
      AN    "DB UTILITY".Freeze_Sequence_1; 
      JC    NCNT; 

      L     "MD 264"; // Half Width [mS]
      L     "DB UTILITY".Scan_Cycle_Previous; 
      ITD   ; 
      +D    ; 
      T     "MD 264"; // Half Width [mS] - Add

NCNT: NOP   0; 
NETWORK
TITLE =Middle Travel Time Clamp Zero

      L     "MD 264"; // Half Width [mS]
      L     L#0; 
      >=D   ; 
      JC    NMID; 

      L     L#0; 
      T     "MD 264"; // Half Width [mS] - Reset

NMID: NOP   0; 
NETWORK
TITLE =Soft Timer 23 Reset - Lift Fault TimeOut 2s + Freeze Option

      A     "M 23.3"; // Packet in Position - Memory
      AN    "M 23.4"; // NO Lift Up Command
      A     "M 0.3"; 
      JCN   R231; 
      JU    E231; 

R231: L     L#0; 
      T     "DB UTILITY".T23_ET; 
      R     "DB UTILITY".T23_DN; 

E231: NOP   0; 

NETWORK
TITLE =Soft Timer 23 Add

      A     "M 23.3"; // Packet in Position - Memory
      AN    "M 23.4"; // NO Lift Up Command
      A     "M 0.3"; 
      AN    "DB UTILITY".Freeze_Sequence_1; // Sequence Freezer Bit
      AN    "DB UTILITY".T23_DN; 
      JCN   E232; 

      L     "DB UTILITY".T23_ET; 
      L     "DB UTILITY".Scan_Cycle_Previous; 
      ITD   ; 
      +D    ; 
      T     "DB UTILITY".T23_ET; 

E232: NOP   0; 

NETWORK
TITLE =Soft Timer 23 Done 2s

      L     "DB UTILITY".T23_ET; 
      L     L#2500; // [mS]
      >=D   ; 
      =     "DB UTILITY".T23_DN; 
NETWORK
TITLE =Soft Timer 24 Reset - Belt TimeOut 8s + Freeze Option

      A     "M 23.1"; 
      AN    "M 23.3"; 
      A     "K 43.4"; 
      A     "M 0.3"; 
      JCN   R241; 
      JU    E241; 

R241: L     L#0; 
      T     "DB UTILITY".T24_ET; 
      R     "DB UTILITY".T24_DN; 

E241: NOP   0; 

NETWORK
TITLE =Soft Timer 24 Add

      A     "M 23.1"; 
      AN    "M 23.3"; 
      A     "K 43.4"; 
      A     "M 0.3"; 
      AN    "DB UTILITY".Freeze_Sequence_1; 
      AN    "DB UTILITY".T24_DN; 
      JCN   E242; 

      L     "DB UTILITY".T24_ET; 
      L     "DB UTILITY".Scan_Cycle_Previous; 
      ITD   ; 
      +D    ; 
      T     "DB UTILITY".T24_ET; 

E242: NOP   0; 

NETWORK
TITLE =Soft Timer 24 Done 8s

      L     "DB UTILITY".T24_ET; 
      L     L#8000; 
      >=D   ; 
      =     "DB UTILITY".T24_DN; 
      S     "M 24.4"; 
NETWORK
TITLE =Step 3N5 - Angle Belt - Lift ("MD 264" to Center the Packet)

      A(    ; 
      A(    ; 
      L     "MD 264"; 
      L     L#2; 
      *D    ; 
      L     "MD 260"; 
      >=D   ; 
      )     ; 
      AN    #PACKET_MEASURE_FLAG; 
      AN    "B 5.5"; 
      O     "DB UTILITY".T23_DN; 
      )     ; 
      A     "M 0.3"; 
      A     "M 23.3"; 
      S     "M 23.4"; 
NETWORK
TITLE =Step 3N6 - Angle Rollers - Up

      AN    "B 5.5"; 
      A     "M 0.3"; 
      A     "M 23.4"; 
      S     "M 23.5"; 

NETWORK
TITLE =Step 3N7 - Angle Rollers - Rollers Up

      A     "E 5.7"; 
      A     "M 0.3"; 
      A     "M 23.5"; 
      S     "M 23.6"; 

NETWORK
TITLE =Step 3N8 - Angle Rollers - Rollers Run

      A     "M 31.0"; 
      AN    "M 31.1"; 
      AN    "M 33.7"; // If No Obstruction Slat End
      AN    "A 44.3"; // If Conv 4 Not Running 
      A     "M 27.0"; 
      AN    "M 27.1"; 
      AN    "M 22.7"; 
      A     "M 0.3"; 
      A     "M 23.6"; 
      S     "M 23.7"; 

NETWORK
TITLE =Step 3N9 - Angle Rollers - Packet Exits

      A     "B 6.1"; 
      A     "M 0.3"; 
      A     "M 23.7"; 
      S     "M 24.0"; 

NETWORK
TITLE =Angle Rollers Done - Delay (Helps Uneven Packets to reach Slat)

      AN    "B 6.0"; // Packet just left 
      FP    "FP 147.5"; 
      L     S5T#3S; 
      SF    "Timer 65"; // Time Extension 3s
NETWORK
TITLE =Step 3N10 - Angle Rollers - Steps Register - Reset

      AN    "B 6.1"; // Packet just freed sensor
      AN    "Timer 65"; // Wait for Time Extension 3s
      A     "M 0.3"; 
      A     "M 24.0"; // Packet Exiting
      S     "M 24.1"; // Conv 2 - Reset
NETWORK
TITLE =Conveyor 2 - Steps Register - Reset

      A(    ; 
      O     "M 24.1"; 
      O     "DB UTILITY".T24_DN; 
      O     "DB UTILITY".T25_DN; 
      O     #INITIALISATION; 
      O     "DB UTILITY".Conveyor_1_Disable; 
      )     ; 
      A     "M 0.3"; 
      JC    M001; 
      JU    M002; 

M001: L     W#16#0; 
      T     "MW 23"; 

M002: NOP   0; 
NETWORK
TITLE =Soft Timer 25 Reset - Roller TimeOut 8s + Freeze Option

      A     "M 23.7"; 
      AN    "M 24.1"; 
      A     "M 0.3"; 
      JCN   R251; 
      JU    E251; 

R251: L     L#0; 
      T     "DB UTILITY".T25_ET; 
      R     "DB UTILITY".T25_DN; 

E251: NOP   0; 

NETWORK
TITLE =Soft Timer 25 Add

      A     "M 23.7"; 
      AN    "M 24.1"; 
      A     "M 0.3"; 
      AN    "DB UTILITY".Freeze_Sequence_2; 
      AN    "DB UTILITY".T25_DN; 
      JCN   E252; 

      L     "DB UTILITY".T25_ET; 
      L     "DB UTILITY".Scan_Cycle_Previous; 
      ITD   ; 
      +D    ; 
      T     "DB UTILITY".T25_ET; 

E252: NOP   0; 

NETWORK
TITLE =Soft Timer 25 Done 8s

      L     "DB UTILITY".T25_ET; 
      L     L#8000; 
      >=D   ; 
      =     "DB UTILITY".T25_DN; 
NETWORK
TITLE =Angle Conveyor Belt - Run

      A     "M 23.1"; 
      AN    "M 23.4"; 
      AN    #MAIN_SERVICE_1_SW; 
      O(    ; 
      A     #SERVICE_BELT_RUN; 
      A(    ; 
      A     "B 6.0"; 
      L     S5T#200MS; 
      SD    "Timer 21"; 
//;
      AN    "Timer 21"; 
      )     ; 
      )     ; 
      AN    "M 22.7"; 
      AN    "DB UTILITY".Freeze_Sequence_1; 
      AN    "M 11.1"; // VFD NOT All Ready !
      A     "M 0.3"; 
      =     "K 43.4"; 

NETWORK
TITLE =Angle Conveyor Rollers - Run

      A     "M 23.7"; 
      AN    "M 24.1"; 
      AN    #MAIN_SERVICE_1_SW; 
      O     #SERVICE_ROLLER_RUN; 
      AN    "DB UTILITY".Freeze_Sequence_2; 
      AN    "M 11.1"; // VFD NOT All Ready !
      A     "M 0.3"; 
      =     "K 43.5"; 

NETWORK
TITLE =Angle Conveyor Rollers - Up

      A     "M 23.5"; 
      AN    "M 24.1"; 
      AN    #MAIN_SERVICE_1_SW; 
      O     #SERVICE_ROLLER_LIFT; 
      AN    "M 22.7"; 
      A     "M 0.3"; 
      =     "Y 43.6"; 
END_FUNCTION

FUNCTION "CONVEYOR 3 - SLAT" : VOID
TITLE =Slat Conveyor 3  Pos.5
NAME : POS_5
VERSION : 0.0


VAR_TEMP
  MAIN_SERVICE_1_SW : BOOL ;	
  SERVICE_RUN : BOOL ;	
  INITIALISATION : BOOL ;	
END_VAR
BEGIN
NETWORK
TITLE =Service Test

      A     "HMI_DB".ALL_SERVICE_ENABLE_SW; 
      A     "HMI_DB".CONVEYOR_3_SERVICE_SW; 
      A     "HMI_DB".SERVICE_SW_1_STATUS; 
      =     #MAIN_SERVICE_1_SW; 
//;  
      A     #MAIN_SERVICE_1_SW; 
      O     M     26.3; 
      JNB   CON3; 
      A     "HMI_DB".HMI_CONVEYOR_3_TEST_SSW; 
      =     #SERVICE_RUN; 
      S     "DB UTILITY".Conveyor_2_Disable; 
//;
      AN    #MAIN_SERVICE_1_SW; 
      R     "HMI_DB".HMI_CONVEYOR_3_TEST_SSW; 
      R     "DB UTILITY".Conveyor_2_Disable; 
//;
      A     "HMI_DB".SERVICE_INIT_PB; 
      A     #MAIN_SERVICE_1_SW; 
      =     #INITIALISATION; 

CON3: R     #SERVICE_RUN; 
      FP    "FP 227.0"; 
      =     M     26.3; 
NETWORK
TITLE =Packet Length Measurements [mm] - While Collating

      A     "B 6.2"; // C3 InFeed Sens - New Packet
      FP    "FP 227.1"; 
      A     "A 44.0"; 
      JC    PRNT; 
      JU    RPRT; 

PRNT: L     "FM350 DB".ACT_CNTV0; 
      T     "HOUSE_KEEPING DB".C3_Encoder_READ_Mem; 

RPRT: AN    "B 6.2"; // C3 InFeed Sens - New Packet End
      FP    "FP 227.2"; 
      JCN   NTKE; 

      L     "FM350 DB".ACT_CNTV0; 
      L     "HOUSE_KEEPING DB".C3_Encoder_READ_Mem; 
      -I    ; 
      T     "HOUSE_KEEPING DB".C3_Packet_Length_ep; 
      DTR   ; 
//;
      L     1.300000e+00; //  Encoder Wheel 900mm / 600 PPR  [mm/pulse]
      *R    ; 
      RND   ; 
      T     "HOUSE_KEEPING DB".C3_Packet_Length_mm; 

NTKE: NOP   0; 
NETWORK
TITLE =Slat Conveyor 3 - Packets / Conveyor Length - Calculation

      A     "M 27.1"; 
      FP    "FP 227.3"; 
      JNB   M271; 
      L     "COLLATORS DB".Conveyor_Length_C3; 
      ITD   ; 
      DTR   ; 
      L     5.000000e+00; 
      /R    ; 
      RND   ; 
      T     "COLLATORS DB".Press_Length_C3; 
      T     "MW 212"; 

M271: NOP   0; 
NETWORK
TITLE =Slat Conveyor 3 - Surface Length Manager (PulseUnit)

      A     "M 27.1"; 
      O     "M 26.6"; 
      S     "M 166.0"; 
//;
      A     "M 166.0"; 
      O(    ; 
      AN    "M 10.0"; 
      FP    "FP 227.4"; 
      )     ; 
      =     "FM350 DB".CONTROL_SIGNALS.SW_GATE0; // C3 Surface Count
//;



////////////////////////////////////////


      A     "M 166.0"; // Start Count (100mS Pulse)
      A(    ; 
      L     "FM350 DB".ACT_CNTV0; // C3 Surface Count
      L     "MW 212"; 
      >=I   ; 
      )     ; 
      A     "M 0.3"; 
      JCN   R291; 
      JU    E291; 

R291: L     L#0; 
      T     "DB UTILITY".T27_ET; 
      R     "DB UTILITY".T27_DN; 

E291: NOP   0; 

NETWORK
TITLE =Soft Timer 27 Add - FM350 needs a 100mS Pulse !

      A     "M 166.0"; 
      A(    ; 
      L     "FM350 DB".ACT_CNTV0; // C3 Surface Count
      L     "MW 212"; 
      >=I   ; 
      )     ; 
      A     "M 0.3"; 
      AN    "DB UTILITY".Freeze_Sequence_2; 
      AN    "DB UTILITY".T27_DN; 
      JCN   E292; 

      L     "DB UTILITY".T27_ET; 
      L     "DB UTILITY".Scan_Cycle_Previous; 
      ITD   ; 
      +D    ; 
      T     "DB UTILITY".T27_ET; 

E292: NOP   0; 

NETWORK
TITLE =Soft Timer 27 Done 100mS  // Start Count (100mS Pulse)

      L     "DB UTILITY".T27_ET; 
      L     L#100; 
      >=D   ; 
      =     "DB UTILITY".T27_DN; 

NETWORK
TITLE =Slat Conveyor 3 - Surface Length Manager

      A     "M 166.0"; 
      A(    ; 
      L     "FM350 DB".ACT_CNTV0; // C3 Surface Count
      L     "MW 212"; 
      >=I   ; 
      )     ; 
      S     "M 27.5"; 
//;
      A     "DB UTILITY".T27_DN; 
      AN    "M 26.6"; 
      R     "M 166.0"; 




////////////////////////////////////////




NETWORK
TITLE =Slat Conveyor - Press Enable
//Slat Conveyor - Press Enable
      A     "M 50.0"; 
      =     "M 26.2"; 
NETWORK
TITLE =Slat Conveyor - Clearing Start

      A     "M 10.1"; 
      A     "M 0.3"; 
      S     "M 9.6"; 
NETWORK
TITLE =Slat Conveyor - Clearing
//Counting 9K Pulses Should Suffice !
      A     "M 10.1"; 
      AN    "M 10.2"; 
      AN    "A 44.0"; 
      S     "M 26.6"; 
//;
      A     "M 26.6"; 
      JNB   M266; 
      A(    ; 
      L     "FM350 DB".ACT_CNTV0; // C3 Surface Count
      L     10000; 
      >I    ; 
      )     ; 
      =     "M 26.7"; 

M266: NOP   0; 

      A     "M 26.7"; 
      ON    "M 10.0"; 
      R     "M 26.6"; 
NETWORK
TITLE =Slat Conveyor Steps
//Slat Conveyor Steps


NETWORK
TITLE =Step 4N1 - Power ON

      A     "M 0.3"; 
      S     "M 27.0"; 
NETWORK
TITLE =Step 4N2 - Slat Conveyor - Collating Start

      A     "M 26.2"; 
      A(    ; 
      O     "B 6.1"; 
      O(    ; 
      A     #SERVICE_RUN; 
      AN    "B 6.4"; 
      )     ; 
      )     ; 
      A     "M 31.0"; 
      AN    "M 31.1"; 
      AN    "M 33.7"; // If No Obstruction Slat End
      AN    "DB UTILITY".Freeze_Sequence_2; 
      A     "M 0.3"; 
      A     "M 27.0"; 
      S     "M 27.1"; 



////////////////////////////////////////



NETWORK
TITLE =Soft Timer 28 Reset - Collating TimeOut + Freeze Option

      A     "M 27.1"; 
      AN    "M 27.4"; 
      A     "M 0.3"; 
      JCN   R271; 
      JU    E271; 

R271: L     L#0; 
      T     "DB UTILITY".T28_ET; 
      R     "DB UTILITY".T28_DN; 

E271: NOP   0; 

NETWORK
TITLE =Soft Timer 28 Add

      A     "M 27.1"; 
      AN    "M 27.4"; 
      A     "M 0.3"; 
      AN    "DB UTILITY".Freeze_Sequence_2; 
      AN    "DB UTILITY".T28_DN; 
      JCN   E272; 

      L     "DB UTILITY".T28_ET; 
      L     "DB UTILITY".Scan_Cycle_Previous; 
      ITD   ; 
      +D    ; 
      T     "DB UTILITY".T28_ET; 

E272: NOP   0; 

NETWORK
TITLE =Soft Timer 27 Done 11s

      L     "DB UTILITY".T28_ET; 
      L     L#11000; 
      >=D   ; 
      =     "DB UTILITY".T28_DN; 

NETWORK
TITLE =Slat Conveyor - Collating TimeOut Done

      A     "DB UTILITY".T28_DN; 
      S     "M 27.4"; 



////////////////////////////////////////




NETWORK
TITLE =Step 4N6 - Slat Conveyor - Steps Reset

      O     "M 27.4"; 
      O     "M 27.5"; 
      A     "M 0.3"; 
      S     "M 27.6"; 
NETWORK
TITLE =Slat Conveyor - Steps Register - Reset

      A(    ; 
      O     "M 27.6"; 
      O     #INITIALISATION; 
      O     "DB UTILITY".Conveyor_3_Disable; 
      )     ; 
      A     "M 0.3"; 
      JC    M001; 
      JU    M002; 

M001: L     W#16#0; 
      T     "MB 27"; 
      R     "M 26.7"; 

M002: NOP   0; 
NETWORK
TITLE =Slat Conveyor - VFD Release

      A(    ; 
      O     "M 27.1"; 
      O     "M 26.6"; 
      )     ; 
      AN(   ; 
      A     "M 26.6"; 
      A     "M 31.5"; 
      )     ; 
      AN    "DB UTILITY".Freeze_Sequence_2; 
      AN    "M 11.1"; // VFD NOT All Ready !
      A     "M 0.3"; 
      =     "A 44.0"; 
      =     "A 44.1"; 
END_FUNCTION

FUNCTION "CONVEYOR 4 - COLLATOR" : VOID
TITLE =Collator Conveyor 4  Pos.6
//Collator Conveyor 4 - Is On Both Service Pages 1 & 2
NAME : POS_6
VERSION : 0.0


VAR_TEMP
  MAIN_SERVICE_1_2_SW : BOOL ;	//Collator Conveyor 4 - On Service 1 & 2
  SERVICE_RUN : BOOL ;	
  INITIALISATION : BOOL ;	
  COUNTER_TRIGGER : BOOL ;	
  PACKET_LENGTH_4 : WORD ;	//Collator Conveyor 4 - Packet Length 
  W_TUBE_mm : WORD ;	
  W_TUBE_PERCENT : WORD ;	//Tube 5 % Value
  R_TUBE_PERCENT : REAL ;	//Tube 5 % Value
  R_TUBE_mm : REAL ;	
END_VAR
BEGIN
NETWORK
TITLE =Conveyor 4 - Service

      A     "HMI_DB".ALL_SERVICE_ENABLE_SW; 
      A     "HMI_DB".CONVEYOR_4_SERVICE_SW; 
      A(    ; 
      O     "HMI_DB".SERVICE_SW_1_STATUS; 
      O     "HMI_DB".SERVICE_SW_2_STATUS; 
      )     ; 
      =     "HMI_DB".SERVICE_SW_1_2_STATUS; 
      =     #MAIN_SERVICE_1_2_SW; 
//;
      A     #MAIN_SERVICE_1_2_SW; 
      O     "M 26.1"; 
      JNB   CON4; 
      A     "HMI_DB".HMI_CONVEYOR_4_TEST_SSW; 
      =     #SERVICE_RUN; 
      S     "DB UTILITY".Conveyor_3_Disable; 
//;
      A     "HMI_DB".SERVICE_INIT_PB; 
      A     #MAIN_SERVICE_1_2_SW; 
      =     #INITIALISATION; 
//;
      AN    #MAIN_SERVICE_1_2_SW; 
      R     "HMI_DB".HMI_CONVEYOR_4_TEST_SSW; 
      R     "DB UTILITY".Conveyor_3_Disable; 

CON4: R     #SERVICE_RUN; 
      R     #INITIALISATION; 
      FP    "FP 158.4"; 
      =     "M 26.1"; 
NETWORK
TITLE =Soft Timer 90 Reset Conveyor 4 - Encoder has Stop L - Timer  500

      AN    "E 6.6"; 
      AN    "M 30.0"; 
      A     "M 0.3"; 
      JCN   R900; 
      JU    E900; 

R900: L     L#0; 
      T     "DB UTILITY".T90_ET; 
      R     "DB UTILITY".T90_DN; 

E900: NOP   0; 
NETWORK
TITLE =Soft Timer 90 Add Conveyor 4 - Encoder has Stop H - Timer  500mS

      AN    "E 6.6"; 
      AN    "M 30.0"; 
      A     "M 0.3"; 
      AN    "DB UTILITY".Freeze_Sequence_2; 
      AN    "DB UTILITY".T90_DN; 
      JCN   E901; 

      L     "DB UTILITY".T90_ET; 
      L     "DB UTILITY".Scan_Cycle_Previous; 
      ITD   ; 
      +D    ; 
      T     "DB UTILITY".T90_ET; 

E901: NOP   0; 
NETWORK
TITLE =Soft Timer 90 Done 500mS

      L     "DB UTILITY".T90_ET; 
      L     L#500; 
      >=D   ; 
      =     "DB UTILITY".T90_DN; 
NETWORK
TITLE =Soft Timer 91 Reset

      A     "E 6.6"; 
      AN    "M 30.0"; 
      A     "M 0.3"; 
      JCN   R910; 
      JU    E910; 

R910: L     L#0; 
      T     "DB UTILITY".T91_ET; 
      R     "DB UTILITY".T91_DN; 

E910: NOP   0; 
NETWORK
TITLE =Soft Timer 91 Add

      A     "E 6.6"; 
      AN    "M 30.0"; 
      A     "M 0.3"; 
      AN    "DB UTILITY".Freeze_Sequence_2; 
      AN    "DB UTILITY".T91_DN; 
      JCN   E911; 

      L     "DB UTILITY".T91_ET; 
      L     "DB UTILITY".Scan_Cycle_Previous; 
      ITD   ; 
      +D    ; 
      T     "DB UTILITY".T91_ET; 

E911: NOP   0; 
NETWORK
TITLE =Soft Timer 91 Done 500mS

      L     "DB UTILITY".T91_ET; 
      L     L#500; 
      >=D   ; 
      =     "DB UTILITY".T91_DN; 
NETWORK
TITLE =Conveyor 4 - Encoder Stopped & Reset

      A     "M 167.0"; 
      A(    ; 
      O     "DB UTILITY".T90_DN; 
      O     "DB UTILITY".T91_DN; 
      )     ; 
      R     "M 166.3"; 
      R     "M 167.0"; 
NETWORK
TITLE =Conveyor 4 - Packet Length - Measurements

      A     "B 6.7"; 
      A     "M 31.1"; 
      S     "M 166.2"; // Counter 2 Gate - Set
      =     #COUNTER_TRIGGER; 
//;
      A     "M 166.2"; // Counter 2 
      =     "FM350 DB".CONTROL_SIGNALS.SW_GATE2; // C4 Length Count
//;
      A     "M 166.2"; // Counter 2 
      O     "B 6.4"; 
      FP    "FP 149.4"; 
      JNB   NRAZ; 
      L     0; // Reset First
      T     "COLLATORS DB".Packet_Length_C4_mS; 

NRAZ: A     "M 166.2"; // Counter 2
      JNB   NCNT; 
      L     "COLLATORS DB".Packet_Length_C4_mS; 
      L     "DB UTILITY".Scan_Cycle_Previous; 
      +I    ; 
      T     "COLLATORS DB".Packet_Length_C4_mS; // Added ScanCycles  

NCNT: A     "M 166.2"; // Counter 2
      AN    "B 6.4"; 
      AN    "B 6.7"; 
      JNB   B067; 
      L     "FM350 DB".ACT_CNTV2; // C4 Length Count
      T     "COLLATORS DB".PacketLength_C4; // Encoder Pulses - Length
      T     #PACKET_LENGTH_4; 
//;
      L     #PACKET_LENGTH_4; 
      ITD   ; 
      DTR   ; 
      L     2.000000e-01; 
      *R    ; 
      RND   ; 


      T     "COLLATORS DB".Frac_Packet_Length_C4; 


      L     #PACKET_LENGTH_4; 
      +I    ; 
      T     "COLLATORS DB".Packet_Length_Frac_C4; 
      R     "M 166.2"; // Counter 2 Gate - Reset
      S     "M 167.1"; 
      S     "M 167.4"; 

B067: NOP   0; 














NETWORK
TITLE =Packet Length Measurements [mm] - While Collating

//    A     "HOUSE_KEEPING DB".C4_First_Collating
      A     "B 6.7"; // C4 InFeed Sens - New Packet
      FP    "FP 226.1"; 
      A     "A 44.3"; 
      JCN   NPRT; 

      L     "FM350 DB".ACT_CNTV3; 
      T     "HOUSE_KEEPING DB".C4_Encoder_READ_Mem; 

//NPRT: A     "HOUSE_KEEPING DB".C4_First_Collating
NPRT: AN    "B 6.7"; // C4 InFeed Sens - New Packet End
      FP    "FP 226.2"; 
      JCN   NTKE; 

      L     "FM350 DB".ACT_CNTV3; 
      L     "HOUSE_KEEPING DB".C4_Encoder_READ_Mem; 
      -I    ; 
      T     "HOUSE_KEEPING DB".C4_Packet_Length_ep; // C4 Packet Length [ep] 
      DTR   ; 
//;
      L     6.350000e+00; //  Encoder Wheel 635mm / 100 PPR  [mm/pulse]
      *R    ; 
      RND   ; 
      T     "HOUSE_KEEPING DB".C4_Packet_Length_mm; 

NTKE: NOP   0; 
NETWORK
TITLE =Packet Length Measurements [mS] - While Transfering to C5

      A     "M 31.6"; // C4 Transfer Step
      A     "B 7.0"; // C4 This Packet Exiting
      JCN   NMSR; 
      L     "HOUSE_KEEPING DB".C4_Added_Scans_mS; 
      L     "DB UTILITY".Scan_Cycle_Previous; 
      +I    ; 
      T     "HOUSE_KEEPING DB".C4_Added_Scans_mS; // Adding mS

NMSR: A     "M 31.6"; // C4 Transfer Step
      AN    "B 7.0"; // C4 This Packet Exiting Done
      FP    "FP 226.3"; 
      JCN   NLNT; 

      L     "HOUSE_KEEPING DB".C4_Added_Scans_mS; 
      T     "HOUSE_KEEPING DB".C4_Packet_Length_mS; // Packet Length mS @ 31 m/min
//;
      L     0; 
      T     "HOUSE_KEEPING DB".C4_Added_Scans_mS; // Packet Length mS - Zeroed

NLNT: NOP   0; 
NETWORK
TITLE =Between Packets Spaces - Measurements [mm]

      A     #COUNTER_TRIGGER; 
      AN    "HOUSE_KEEPING DB".C4_First_Collating_Done; 
      S     "HOUSE_KEEPING DB".C4_First_Collating; // First Collating - Set
      S     "HOUSE_KEEPING DB".C4_First_Collating_Done; 
//;
      A     "M 31.4"; // Collating Stop
      AN    "M 31.5"; // Collator Not Full
      FP    "FP 226.4"; 
      R     "HOUSE_KEEPING DB".C4_First_Collating; // First Collating - Reset
//;
      AN    "HOUSE_KEEPING DB".C4_First_Collating; // Reading Info
      FP    "FP 226.5"; 
      JCN   N1ST; 

      L     "FM350 DB".ACT_CNTV3; 
      L     "FM350 DB".ACT_CNTV2; 
      -I    ; 
      T     "HOUSE_KEEPING DB".C4_RampDown_Dx_ep; 

N1ST: NOP   0; 

      AN    "M 31.6"; // Register Reset - Transfer End
      FP    "FP 226.6"; 
      R     "HOUSE_KEEPING DB".C4_First_Collating_Done; 
NETWORK
TITLE =Conveyor 4 - Surface Length Left (PulseUnit) - Measurements

      A     "M 31.1"; 
      S     "M 166.3"; 
//;
      A     "M 166.3"; 
      AN    "M 31.7"; 
      =     "FM350 DB".CONTROL_SIGNALS.SW_GATE3; 
//;
      A     "M 166.3"; 
      A     "M 31.1"; 
      JNB   M663; 
      L     "COLLATORS DB".Surface_Length_C4; 
      L     "FM350 DB".ACT_CNTV3; 
      -D    ; 
      T     "COLLATORS DB".Surface_Left_C4; 
      L     0; 
      >=I   ; 
      JNB   T004; 
      L     "COLLATORS DB".Surface_Left_C4; 
      T     "COLLATORS DB".Surface_Length_Left_C4; 

T004: CLR   ; 

M663: CLR   ; 
NETWORK
TITLE =Conveyor 4 - Space Between - Calculator

      A     "M 167.1"; 
      FP    "FP 154.2"; 
      JNB   M581; 
      L     "COLLATORS DB".Surface_Left_C4; 
      L     "COLLATORS DB".Frac_Packet_Length_C4; 
      -I    ; 
      T     "MW 214"; 

M581: CLR   ; 

      A     "M 167.1"; 
      JNB   M671; 
      A(    ; 
      L     "COLLATORS DB".Surface_Left_C4; 
      L     "MW 214"; 
      <=I   ; 
      )     ; 
      R     "M 167.1"; 

M671: CLR   ; 
NETWORK
TITLE =Conveyor 4 - Collating Length Manager

      A     "M 166.3"; 
      AN    "M 30.4"; 
      A     "M 31.4"; 
      JNB   M304; 
      L     "COLLATORS DB".Surface_Left_C4; 
      L     "COLLATORS DB".Packet_Length_Frac_C4; 
      <I    ; 
      S     "M 30.4"; 

M304: CLR   ; 

      A     "M 10.1"; 
      FP    "FP 154.7"; 
      O     "M 31.7"; 
      R     "M 30.4"; 
NETWORK
TITLE =Packet Length to HMI + Hysteresis

      A     "M 167.4"; 
      JNB   C167; 
      A(    ; 
      A(    ; 
      L     "MW 202"; 
      L     "MW 204"; 
      >I    ; 
      )     ; 
      O     ; 
      A(    ; 
      L     "MW 202"; 
      L     "MW 206"; 
      <I    ; 
      )     ; 
      )     ; 
      JNB   BYP5; 
      L     "MW 202"; 
      T     "HMI_DB".WORD_PACKET_LENGTH; 

BYP5: CLR   ; 

      L     "MW 202"; 
      L     3.000000e+00; 
      *R    ; 
      L     1.000000e+02; 
      /R    ; 
      T     #R_TUBE_PERCENT; 
      TRUNC ; 
//     T     "COLLATORS DB".Ecoder_Wheel_Circ_C4
      T     #W_TUBE_PERCENT; 
//;
      L     #W_TUBE_PERCENT; 
      L     "MW 202"; 
      +I    ; 
      T     "MW 204"; 
//;
      L     #W_TUBE_PERCENT; 
      L     "MW 202"; 
      -I    ; 
      T     "MW 206"; 
//;
      CLR   ; 
      =     "M 167.4"; 

C167: CLR   ; 
NETWORK
TITLE =Collator
//Collator House Keeping


NETWORK
TITLE =Collator Conveyor 4 - Clearing

      A     "M 10.2"; 
      A     "M 31.4"; 
      AN    "M 31.5"; 
      A     "M 0.3"; 
      =     "M 30.5"; 
NETWORK
TITLE =Soft Timer 33 Reset - Clearing TimeOut 20s + Freeze Option

      A     "M 30.5"; 
      A     "A 44.3"; 
      A     "M 0.3"; 
      JCN   R331; 
      JU    E331; 

R331: L     L#0; 
      T     "DB UTILITY".T33_ET; 
      R     "DB UTILITY".T33_DN; 

E331: NOP   0; 
NETWORK
TITLE =Soft Timer 33 Add

      A     "M 30.5"; 
      A     "A 44.3"; 
      A     "M 0.3"; 
      AN    "DB UTILITY".Freeze_Sequence_2; 
      AN    "DB UTILITY".T33_DN; 
      JCN   E332; 

      L     "DB UTILITY".T33_ET; 
      L     "DB UTILITY".Scan_Cycle_Previous; 
      ITD   ; 
      +D    ; 
      T     "DB UTILITY".T33_ET; 

E332: NOP   0; 
NETWORK
TITLE =Soft Timer 33 Done 20s

      L     "DB UTILITY".T33_ET; 
      L     L#20000; 
      >=D   ; 
      =     "DB UTILITY".T33_DN; 
NETWORK
TITLE =Collator Conveyor 4 - Clearing Surface - Run 2K Encoder Counts

      A     "M 30.5"; 
      A     "A 44.3"; 
      A     "M 0.3"; 
      JNB   M305; 
      A(    ; 
      L     "FM350 DB".ACT_CNTV2; 
      L     2000; 
      >I    ; 
      )     ; 
      =     "M 30.3"; 

M305: CLR   ; 
NETWORK
TITLE =Collator Conveyor 4 - Packet at the End !

      A     "B 7.0"; 
      A     "A 44.3"; 
      O     #SERVICE_RUN; 
      A     "M 0.3"; 
      S     "M 30.6"; 
//;
      A     "M 31.5"; 
      R     "M 30.6"; 
NETWORK
TITLE =Soft Timer 31 Reset - InFeed TimeOut 5s With Freeze Option

      A     "M 31.2"; 
      AN    "M 31.4"; 
      A     "A 44.3"; 
      A     "M 0.3"; 
      JCN   R311; 
      JU    E311; 

R311: L     L#0; 
      T     "DB UTILITY".T31_ET; 
      R     "DB UTILITY".T31_DN; 

E311: NOP   0; 
NETWORK
TITLE =Soft Timer 31 Add

      A     "M 31.2"; 
      AN    "M 31.4"; 
      A     "A 44.3"; 
      A     "M 0.3"; 
      AN    "DB UTILITY".Freeze_Sequence_2; 
      AN    "DB UTILITY".T31_DN; 
      JCN   E312; 

      L     "DB UTILITY".T31_ET; 
      L     "DB UTILITY".Scan_Cycle_Previous; 
      ITD   ; 
      +D    ; 
      T     "DB UTILITY".T31_ET; 

E312: NOP   0; 
NETWORK
TITLE =Soft Timer 31 Done 5s

      L     "DB UTILITY".T31_ET; 
      L     L#5000; 
      >=D   ; 
      =     "DB UTILITY".T31_DN; 
NETWORK
TITLE =Collator Conveyor 4 - InFeed  TimeOut Stop - Fault

      A     "DB UTILITY".T31_DN; 
      A     "M 0.3"; 
      S     "M 30.7"; 
//;
      AN    "B 6.7"; 
      A     "M 0.3"; 
      R     "M 30.7"; 
NETWORK
TITLE =Collator
//Collator Steps


NETWORK
TITLE =Collator Conveyor 4 - Steps Register - Reset

      A(    ; 
      O     "M 31.7"; 
      O     "DB UTILITY".T33_DN; 
      O     #INITIALISATION; 
      O     "DB UTILITY".Conveyor_4_Disable; 
      )     ; 
      A     "M 0.3"; 
      JNB   INIT; 
      L     W#16#0; 
      T     "MW 31"; 
      S     "M 167.0"; 

INIT: CLR   ; 
NETWORK
TITLE =Step 5N1  - Power ON

      A     "M 0.3"; 
      S     "M 31.0"; 
NETWORK
TITLE =Events UpDate - Collator Conveyor 4 - Collating Run - Start

      A(    ; 
      A(    ; 
      O     "B 6.4"; 
      O     "B 6.7"; 
      )     ; 
      A     "A 44.0"; 
      FP    "FP 157.1"; 
      O     ; 
      A     "M 10.2"; 
      AN    "M 10.3"; 
      )     ; 
      AN    "M 33.7"; // If No Obstruction Slat End
      A     "M 0.3"; 
      A     "M 31.0"; 
      S     "M 31.1"; 
NETWORK
TITLE =Soft Timer 29 Reset - LB Obstruction Alarm 10s + Freeze Option

      A(    ; 
      O     "B 6.4"; 
      O     "B 6.7"; 
      )     ; 
      AN    "A 44.0"; 
      JCN   R281; 
      JU    E281; 

R281: L     L#0; 
      T     "DB UTILITY".T29_ET; 
      R     "DB UTILITY".T29_DN; 

E281: NOP   0; 
NETWORK
TITLE =Soft Timer 29 Add

      A(    ; 
      O     "B 6.4"; 
      O     "B 6.7"; 
      )     ; 
      AN    "A 44.0"; 
      AN    "DB UTILITY".Freeze_Sequence_2; 
      AN    "DB UTILITY".T29_DN; 
      JCN   E282; 

      L     "DB UTILITY".T29_ET; 
      L     "DB UTILITY".Scan_Cycle_Previous; 
      ITD   ; 
      +D    ; 
      T     "DB UTILITY".T29_ET; 

E282: NOP   0; 
NETWORK
TITLE =Soft Timer 29 Done 10s

      L     "DB UTILITY".T29_ET; 
      L     L#10000; 
      >=D   ; 
      =     "DB UTILITY".T29_DN; 
NETWORK
TITLE =Collator Conveyor 4 - LB Obstruction Alarm

      A     "DB UTILITY".T29_DN; 
      S     "M 33.7"; 
//;
      A(    ; 
      O     "M 9.1"; 
      O     "S 2.2"; 
      )     ; 
      R     "M 33.7"; 
NETWORK
TITLE =Step 5N2  - Collator Conveyor 4 - Collating Run - Stop

      A(    ; 
      AN    "M 30.4"; 
      AN    "M 10.2"; 
      AN    "M 30.6"; 
      A     "M 31.4"; 
      AN    "M 31.5"; 
      ON    "M 31.0"; 
      O     "DB UTILITY".T29_DN; 
      )     ; 
      R     "M 31.1"; 
NETWORK
TITLE =Step 5N3  - Collator Conveyor 4 - Packet Runs In

      A(    ; 
      O     "B 6.7"; 
      O     "M 10.2"; 
      )     ; 
      A     "M 0.3"; 
      A     "M 31.1"; 
      S     "M 31.2"; 
//;
      AN    "M 31.1"; 
      R     "M 31.2"; 
NETWORK
TITLE =Step 5N4  - Collator Conveyor 4 - Collating Start

      A(    ; 
      ON    "B 6.4"; 
      O     "M 30.7"; 
      )     ; 
      A     "M 0.3"; 
      A     "M 31.2"; 
      S     "M 31.3"; 
//;
      AN    "M 31.2"; 
      R     "M 31.3"; 
NETWORK
TITLE =Step 5N5  - Collator Conveyor 4 - Collating Stop 

      A(    ; 
      AN    "B 6.7"; 
      AN(   ; 
      AN    "M 10.2"; 
      A     "M 167.1"; 
      )     ; 
      O     "M 30.7"; 
      )     ; 
      A     "M 0.3"; 
      A     "M 31.3"; 
      S     "M 31.4"; 
//;
      AN    "M 31.3"; 
      R     "M 31.4"; 
NETWORK
TITLE =Step 5N6  - Collator Conveyor 4 - Full - Start Transfer

      A(    ; 
      A     "M 30.4"; 
      AN    "M 10.2"; 
      A     "M 31.4"; 
      O     "M 30.6"; 
      )     ; 
      A     "M 0.3"; 
      S     "M 31.5"; 
NETWORK
TITLE =Step 5N7  - Collator Conveyor 4 - Transfering

      A     "M 35.1"; 
      AN    "M 35.2"; 
      AN    "M 37.2"; // Not Auto Resync ON
      A     "M 0.3"; 
      A     "M 31.5"; 
      S     "M 31.6"; 
NETWORK
TITLE =Soft Timer 32 Reset - Transfer TimeOut 20s + Freeze Option

      A     "M 31.6"; 
      AN    "M 31.7"; 
      A     "A 44.3"; 
      A     "M 0.3"; 
      JCN   R321; 
      JU    E321; 

R321: L     L#0; 
      T     "DB UTILITY".T32_ET; 
      R     "DB UTILITY".T32_DN; 

E321: NOP   0; 
NETWORK
TITLE =Soft Timer 32 Add

      A     "M 31.6"; 
      AN    "M 31.7"; 
      A     "A 44.3"; 
      A     "M 0.3"; 
      AN    "DB UTILITY".Freeze_Sequence_2; 
      AN    "DB UTILITY".T32_DN; 
      JCN   E322; 

      L     "DB UTILITY".T32_ET; 
      L     "DB UTILITY".Scan_Cycle_Previous; 
      ITD   ; 
      +D    ; 
      T     "DB UTILITY".T32_ET; 

E322: NOP   0; 
NETWORK
TITLE =Soft Timer 32 Done 20s

      L     "DB UTILITY".T32_ET; 
      L     L#20000; 
      >=D   ; 
      =     "DB UTILITY".T32_DN; 
NETWORK
TITLE =Step 5N8 - Conveyor 4 - Stop & Reset - Transfer Done !

      A(    ; 
      O     "B 7.1"; 
      O     "DB UTILITY".T32_DN; 
      )     ; 
      A     "M 0.3"; 
      A     "M 31.6"; 
      S     "M 31.7"; 
NETWORK
TITLE =Conveyor 4 - VFD Release

      A(    ; 
      A     "M 31.1"; 
      AN    "M 31.4"; 
      A     "A 44.5"; 
      O     ; 
      A     "M 31.6"; 
      AN    "M 31.7"; 
      O     "M 30.5"; 
      )     ; 
      AN    "DB UTILITY".Conveyor_4_Disable; 
      AN    "DB UTILITY".Freeze_Sequence_2; 
      AN    "M 11.1"; // VFD NOT All Ready !
      A     "M 0.3"; 
      =     "A 44.3"; 
      =     "A 44.4"; 
NETWORK
TITLE =Conveyor 4 - Slow

      A     "M 31.1"; 
      AN    "M 31.4"; 
      A     "M 0.3"; 
      =     "A 44.5"; 
END_FUNCTION

FUNCTION "CONVEYOR 5 - LINK" : VOID
TITLE =Conveyor 5 - Link   Pos.7
//Using "Soft Timer" cause S5T Timer cannot Pause/Freeze !...
NAME : POS_7
VERSION : 0.0


VAR_TEMP
  MAIN_SERVICE_2_SW : BOOL ;	
  SERVICE_RUN : BOOL ;	
  INITIALISATION : BOOL ;	
END_VAR
BEGIN
NETWORK
TITLE =Conveyor 5 - Service

      A     "HMI_DB".ALL_SERVICE_ENABLE_SW; 
      A     "HMI_DB".CONVEYOR_5_SERVICE_SW; 
      A     "HMI_DB".SERVICE_SW_2_STATUS; 
      =     #MAIN_SERVICE_2_SW; 
//;
      A     #MAIN_SERVICE_2_SW; 
      O     "M 34.1"; 
      JNB   CON5; 
//;    
      A     "HMI_DB".HMI_CONVEYOR_5_TEST_SSW; 
      AN    "A 44.3"; 
      =     #SERVICE_RUN; 
      S     "DB UTILITY".Conveyor_4_Disable; 
//;
      A     "HMI_DB".SERVICE_INIT_PB; 
      =     #INITIALISATION; 
//;
      AN    #MAIN_SERVICE_2_SW; 
      R     "HMI_DB".HMI_CONVEYOR_5_TEST_SSW; 
      R     "DB UTILITY".Conveyor_4_Disable; 

CON5: R     #SERVICE_RUN; 
      R     #INITIALISATION; 
      FP    "FP 158.5"; 
      =     "M 34.1"; 

NETWORK
TITLE =Service Mode

      A(    ; 
      A     "M 190.5"; 
      A     "M 161.0"; 
      O     ; 
      A     #SERVICE_RUN; 
      )     ; 
      A     "M 0.3"; 
      =     "M 34.0"; 

NETWORK
TITLE =Conveyor 5 - Steps Register - Reset

      A(    ; 
      A     "M 35.1"; 
      AN    "M 35.2"; 
      A     "DB UTILITY".T35_DN; 
      O     "M 35.4"; 
      O     #INITIALISATION; 
      O     "DB UTILITY".Conveyor_5_Disable; 
      )     ; 
      A     "M 0.3"; 
      JC    M001; 
      JU    M002; 

M001: L     W#16#0; 
      T     "MW 35"; 
      T     "HMI DB NEW".CONV_5_COUNT; 

M002: NOP   0; 

NETWORK
TITLE =Step 6N1 - Power ON

      A     "M 0.3"; 
      AN    "DB UTILITY".Conveyor_5_Disable; 
      =     "M 35.0"; 

NETWORK
TITLE =Step 6N2 - Conveyor 5 - Packet Filling

      A(    ; 
      A     "M 31.5"; 
      AN    "M 31.6"; 
      O     "B 7.1"; 
      O     "M 30.5"; 
      )     ; 
      A     "M 0.3"; 
      A     "M 35.0"; 
      S     "M 35.1"; 

NETWORK
TITLE =Step 6N3 - Conveyor 5 - End Reached

      A     "B 7.1"; 
      A     "M 0.3"; 
      A     "M 35.1"; 
      S     "M 35.2"; 

NETWORK
TITLE =Step 6N4 - Conveyor 5 - Transfer to 6

      A     "M 39.1"; 
      AN    "M 39.2"; 
      A     "M 0.3"; 
      A(    ; 
      O     "M 35.2"; 
      ON    "M 31.5"; 
      O     "M 34.0"; 
      )     ; 
      S     "M 35.3"; 

NETWORK
TITLE =Soft Timer 35 Reset

      A(    ; 
      A     "M 35.1"; 
      AN    "M 35.2"; 
      O     ; 
      A     "M 35.3"; 
      AN    "M 35.4"; 
      A     "A 45.0"; 
      )     ; 
      A     "M 0.3"; 
      JCN   R351; 
      JU    E351; 

R351: L     L#0; 
      T     "DB UTILITY".T35_ET; 
      R     "DB UTILITY".T35_DN; 

E351: NOP   0; 

NETWORK
TITLE =Soft Timer 35 Add

      A(    ; 
      A     "M 35.1"; 
      AN    "M 35.2"; 
      O     ; 
      A     "M 35.3"; 
      AN    "M 35.4"; 
      A     "A 45.0"; 
      )     ; 
      A     "M 0.3"; 
      JCN   E352; 
//;
      A     "DB UTILITY".Freeze_Sequence_2; 
      A     "M 35.1"; 
      AN    "M 35.2"; 
      JC    E352; 
//;
      AN    "DB UTILITY".T35_DN; 
      JCN   E352; 
//;
      L     "DB UTILITY".T35_ET; 
      L     "DB UTILITY".Scan_Cycle_Previous; 
      ITD   ; 
      +D    ; 
      T     "DB UTILITY".T35_ET; 

E352: NOP   0; 

NETWORK
TITLE =Soft Timer 35 Done 30s

      L     "DB UTILITY".T35_ET; 
      L     L#30000; // [mS]
      >=D   ; 
      =     "DB UTILITY".T35_DN; 

NETWORK
TITLE =Automatic Re-Synchronization
//In Order to keep Synchronized,
//if Every Conditions are there, Conveyor 5 will do a Synchro Run 13sec after 
//every 5 runs !
      A     "A 45.0"; // Count runs
      FP    "FP 169.7"; 
      JNB   ARS1; 

      L     "MW 220"; // Count up
      L     1; 
      +I    ; 
      T     "MW 220"; 
//;
      L     10; 
      >=I   ; 
      JNB   ARS1; 
//;
      S     "M 37.3"; // ARM after 5 runs
      L     0; 
      T     "MW 220"; 

ARS1: NOP   0; 

      A     "M 37.3"; // ARMED
      AN    "M 37.2"; // NOT already running
      AN    "DB UTILITY".Freeze_Sequence_2; 
      AN    "A 45.0"; // wait end of run
      A     "M 35.0"; // power ON
      AN    "M 35.4"; // not in reset/stop
      JNB   ARS2; 
//;
      L     "HMI_DB".CONV_4_COUNT; // Conveyor 4 Must be <= 2
      L     3; 
      <I    ; 
      JNB   ARS2; 
//;
      L     "HMI_DB".CONV_5_COUNT; 
      L     0; // Conveyor 5 Must NOT be Empty
      >I    ; 
      JNB   ARS2; 
//;
      L     "HMI_DB".CONV_6_COUNT; 
      L     0; // Conveyor 6 Must be Empty
      ==I   ; 
      JNB   ARS2; 
//;
      AN    "B 7.2"; // Conveyor 6 Must be Empty
      AN    "M 10.0"; // Not Clearing
      JNB   ARS2; 
//;
      S     "M 37.2"; // START 13s RUN
      R     "M 37.3"; // DISARM

ARS2: NOP   0; 

      A     "M 37.2"; // Re-Sync ON
      L     S5T#13S; 
      SD    "Timer 64"; 
//;
      A     "Timer 64"; // End Re-Sync if TimeOut 13s
      O     "B 7.1"; // or if Packet at END Sensor
      R     "M 37.2"; // Re-Sync OFF
NETWORK
TITLE =Automatic Re-Synchronization - Arm Timeout

      A     "M 37.3"; 
      L     S5T#1M; 
      SD    "Timer 74"; 
//;
      A     "Timer 74"; 
      R     "M 37.3"; 
NETWORK
TITLE =Step 6N5 - Conveyor 5 - Stop & Reset

      A(    ; 
      O     "B 7.2"; 
      O     "DB UTILITY".T35_DN; 
      )     ; 
      A     "M 0.3"; 
      A     "M 35.3"; 
      S     "M 35.4"; 

NETWORK
TITLE =Link Conveyor 5 - VFD Release


      A(    ; 
      A(    ; 
      A     "M 35.1"; 
      AN    "M 35.2"; 
      AN    "DB UTILITY".Freeze_Sequence_2; 
      )     ; 
      O     ; 
      A     "M 35.3"; 
      AN    "M 35.4"; 
      )     ; 
      O     ; 
      A(    ; 
      A     "M 37.2"; // Automatic Re-Synchronization Run
      A     "M 35.0"; // Power ON
      AN    "M 35.4"; // Not in Stop/Reset
      )     ; 
      AN    "DB UTILITY".Conveyor_5_Disable; 
      A     "M 35.0"; 
      =     "A 45.0"; 
      =     "A 45.1"; 
END_FUNCTION

FUNCTION "CONVEYOR 6 - FLIP DELIV." : VOID
TITLE =Conveyor 6 - Delivery to Flipper Pos.8
//
NAME : POS_8
VERSION : 0.0


VAR_TEMP
  MAIN_SERVICE_2_SW : BOOL ;	
  SERVICE_RUN : BOOL ;	
  INITIALISATION : BOOL ;	
END_VAR
BEGIN
NETWORK
TITLE =Slat Conveyor - Service

      A     "HMI_DB".ALL_SERVICE_ENABLE_SW; 
      A     "HMI_DB".CONVEYOR_6_SERVICE_SW; 
      A     "HMI_DB".SERVICE_SW_2_STATUS; 
      =     #MAIN_SERVICE_2_SW; 
//;    
      A     #MAIN_SERVICE_2_SW; 
      O     "M 38.1"; 
      JNB   CON6; 
      A     "HMI_DB".HMI_CONVEYOR_6_TEST_SSW; 
      =     #SERVICE_RUN; 
      S     "DB UTILITY".Conveyor_5_Disable; 
//;
      AN    #MAIN_SERVICE_2_SW; 
      R     "HMI_DB".HMI_CONVEYOR_6_TEST_SSW; 
      R     "DB UTILITY".Conveyor_5_Disable; 

CON6: R     #SERVICE_RUN; 
      R     #INITIALISATION; 
      FP    "FP 158.6"; 
      =     "M 38.1"; 
NETWORK
TITLE =Flipper Delivery Conveyor 6 - Running TimeOut  30s

      A     "M 39.1"; 
      AN    "M 39.3"; 
      A     "M 0.3"; 
      L     S5T#30S; 
      SD    "Timer 40"; 
NETWORK
TITLE =Flipper Delivery Conveyor 6 - Delivering Run

      A     "M 39.4"; 
      AN    "M 39.5"; 
      A     "M 0.3"; 
      S     "M 38.5"; 
//;
      A     "M 43.4"; 
      R     "M 38.5"; 
NETWORK
TITLE =Flipper Delivery Conveyor 6 - Ready to Deliver

      A     "B 7.3"; 
      A     "M 39.5"; 
      AN    "M 39.6"; 
      A     "M 0.3"; 
      S     "M 38.6"; 
//;
      A     "M 39.3"; 
      AN    "M 39.4"; 
      R     "M 38.6"; 
NETWORK
TITLE =Flipper Delivery Conveyor 6 - Run TimeOut  5s

      A     "M 39.3"; 
      AN    "M 39.4"; 
      A     "A 45.3"; 
      A     "M 0.3"; 
      L     S5T#5S; 
      SD    "Timer 38"; 
NETWORK
TITLE =Flipper Delivery Conveyor 6 - Done

      A     "Timer 38"; 
      S     "M 38.7"; 
//;
      AN    "B 7.2"; 
      A     "M 0.3"; 
      R     "M 38.7"; 
NETWORK
TITLE =Conveyor 6 - Steps Register - Reset

      A(    ; 
      O     "M 39.6"; 
      O     "Timer 40"; 
      O     #INITIALISATION; 
      O     "DB UTILITY".Conveyor_6_Disable; 
      )     ; 
      A     "M 0.3"; 
      JC    M001; 
      JU    M002; 

M001: L     W#16#0; 
      T     "MW 39"; 
      T     "MB 41"; 
      T     "HMI DB NEW".CONV_6_COUNT; 

M002: NOP   0; 
NETWORK
TITLE =Step 7N1 - Power ON

      A     "M 0.3"; 
      AN    "DB UTILITY".Conveyor_6_Disable; 
      =     "M 39.0"; 
NETWORK
TITLE =Step 7N2 - Conveyor 6 - Packet Filling

      A(    ; 

      A     "M 35.2"; // 6 Filling Trigger
      AN    "M 35.3"; // AND NOT Triggered
      O     "M 34.0"; // OR Service Run

      O     ; 

      A(    ; 
      O     "B 7.2"; 
      O     "B 7.3"; 
      )     ; 
      A     "M 35.0"; 
      AN    "M 35.3"; 
      A     "M 39.0"; 
      AN    "M 39.1"; 

      O     ; 

      A     #SERVICE_RUN; 
      )     ; 

      A     "M 0.3"; 
      A     "M 39.0"; 
      S     "M 39.1"; 
NETWORK
TITLE =Step 7N3 - Conveyor 6 - Packet Reaching

      A     "B 7.2"; 
      A     "M 0.3"; 
      A     "M 39.1"; 
      S     "M 39.2"; 
NETWORK
TITLE =Step 7N4 - Conveyor 6 - Packet in Position

      A     "B 7.3"; 
      A     "M 0.3"; 
      A     "M 39.2"; 
      S     "M 39.3"; 
NETWORK
TITLE =Step 7N5 - Conveyor 6 - Packet Delivering

      A(    ; 
      A     "M 43.2"; 
      AN    "M 43.3"; 
      AN    "M 38.5"; 
      ON    "B 7.3"; 
      )     ; 
      AN    "M 38.7"; 
      A     "M 0.3"; 
      A     "M 39.3"; 
      S     "M 39.4"; 
//;
      A(    ; 
      O     "M 38.6"; 
      ON    "M 39.3"; 
      )     ; 
      R     "M 39.4"; 
NETWORK
TITLE =Step 7N6 - Conveyor 6 - Packet Delivered

      A(    ; 
      ON    "B 7.3"; // Last LB Free
      O     "M 38.7"; 
      )     ; 
      A     "M 0.3"; 
      A     "M 39.4"; 
      S     "M 39.5"; 
//;
      AN    "M 39.4"; 
      R     "M 39.5"; 
NETWORK
TITLE =Flipper Delivery Conveyor 6 - Last Delivery TimeOut 5s

      A     "M 39.5"; 
      AN    "M 39.6"; 
      A     "M 0.3"; 
      L     S5T#5S; 
      SD    "Timer 39"; 
NETWORK
TITLE =Step 7N7 - Conveyor 6 - Steps Register - Reset

      A     "Timer 39"; // Last Delivery - time to Reset 5s       
      A     "M 0.3"; 
      A     "M 39.5"; // Delivered then Reset
      S     "M 39.6"; 
NETWORK
TITLE =Delivery Conveyor - VFD Release

      A(    ; 
      A     "M 39.1"; // 6 Filling
      AN    "M 39.3"; // Packet Reached
      O     ; 
      A     "M 39.4"; // 6 Delivering
      AN    "M 39.6"; // Delivered
      )     ; 
      AN    "DB UTILITY".Conveyor_6_Disable; 
      A     "M 39.0"; 
      =     "A 45.3"; 
NETWORK
TITLE =Delivery Conveyor - Fast

      A     "M 39.1"; 
      AN    "M 39.2"; 
      A     "M 39.0"; 
      =     "A 45.4"; // Fast for Filling Only
END_FUNCTION

FUNCTION "CONVEYOR 7 - FLIPPER" : VOID
TITLE =Flipper  Pos.9
//Service : With FLIPPER Service SW "ON", To Flip, Hold the FLIP SW Until Reached 
//or JOG to Position.
NAME : POS_9
VERSION : 0.0


VAR_TEMP
  MAIN_SERVICE_2_SW : BOOL ;	
  TIME_SW : BOOL ;	
  FLIPPER_SERVICE_SW : BOOL ;	
  FLIP : BOOL ;	
  FLIP_CW : BOOL ;	
  FLIP_CCW : BOOL ;	
  CONVEYOR_7_RUN : BOOL ;	
  INITIALISATION : BOOL ;	
  POSITION_TIME : S5TIME ;	
  T_ZOOLOO : TIME ;	
  W_ZOOLOO_1 : WORD ;	
  W_ZOOLOO_2 : WORD ;	
END_VAR
BEGIN
NETWORK
TITLE =Service Test

      A     "HMI_DB".ALL_SERVICE_ENABLE_SW; 
      A     "HMI_DB".CONVEYOR_7_SERVICE_SW; 
      A     "HMI_DB".SERVICE_SW_2_STATUS; 
      R     "HMI_DB".SERVICE_SW_2_TIME_ADJ; 
      =     #MAIN_SERVICE_2_SW; 
//;
      A     #MAIN_SERVICE_2_SW; 
      O     "M 42.3"; 
      JNB   FLIN; 
      A     "HMI_DB".HMI_FLIPPER_SERVICE_SSW; 
      =     #FLIPPER_SERVICE_SW; 
      R     "HMI_DB".HMI_CONVEYOR_7_TEST_SSW; 
//;  
      A     "HMI_DB".HMI_CONVEYOR_7_TEST_SSW; 
      =     #CONVEYOR_7_RUN; 
      R     "HMI_DB".HMI_FLIPPER_SERVICE_SSW; 
//;  
      A     "HMI_DB".SERVICE_SW_2_TIME_ADJ; 
      =     #TIME_SW; 
//;
      AN    "P 8.0"; 
      S     "M 46.0"; 
      FP    "FP 168.5"; 
      S     "M 46.5"; 
//;
      AN    "P 8.1"; 
      R     "M 46.0"; 
      FP    "FP 168.6"; 
      S     "M 46.5"; 
//;
      A     #FLIPPER_SERVICE_SW; 
      AN    "HMI_DB".HMI_FLIPPER_FLIP_SSW; 
      L     S5T#3S; 
      SE    "Timer 46"; 
//;
      A     "Timer 46"; 
      FN    "FN 155.1"; 
      R     "M 46.5"; 
//;
      A     #FLIPPER_SERVICE_SW; 
      A     "HMI_DB".HMI_FLIPPER_FLIP_SSW; 
      AN    "M 46.0"; 
      AN    "Timer 46"; 
      AN    "M 46.5"; 
      =     #FLIP_CW; 
//;
      A     #FLIPPER_SERVICE_SW; 
      A     "HMI_DB".HMI_FLIPPER_FLIP_SSW; 
      A     "M 46.0"; 
      AN    "Timer 46"; 
      AN    "M 46.5"; 
      =     #FLIP_CCW; 
//;
      A     "HMI_DB".HMI_CONVEYOR_7_TEST_SSW; 
      =     #CONVEYOR_7_RUN; 
//;
      A(    ; 
      O     #FLIPPER_SERVICE_SW; 
      O     #CONVEYOR_7_RUN; 
      )     ; 
      S     "DB UTILITY".Conveyor_6_Disable; 
//;
      AN    #MAIN_SERVICE_2_SW; 
      R     "HMI_DB".HMI_CONVEYOR_7_TEST_SSW; 
      R     "HMI_DB".HMI_FLIPPER_SERVICE_SSW; 
      R     "HMI_DB".HMI_FLIPPER_FLIP_SSW; 
      R     "HMI_DB".SERVICE_SW_2_TIME_ADJ; 
      R     "DB UTILITY".Conveyor_6_Disable; 

FLIN: R     #TIME_SW; 
      R     #FLIPPER_SERVICE_SW; 
      R     #FLIP_CW; 
      R     #FLIP_CCW; 
      R     #CONVEYOR_7_RUN; 
      FP    "FP 158.7"; 
      =     "M 42.3"; 
//;
      A     "HMI_DB".SERVICE_INIT_PB; 
      A     #MAIN_SERVICE_2_SW; 
      A     #FLIPPER_SERVICE_SW; 
      =     #INITIALISATION; 
NETWORK
TITLE =Flipper - Flip Status

      A(    ; 
      ON    "P 8.0"; 
      ON    "P 8.1"; 
      )     ; 
      AN    "A 45.3"; 
      AN    "A 45.6"; 
      AN    "K 46.0"; 
      AN    "K 46.1"; 
      =     "M 46.1"; 
NETWORK
TITLE =Flipper - Flip Enable

      A(    ; 
      AN    "M 140.3"; 
      A     "M 152.5"; 
      O     ; 
      A     "M 140.3"; 
      A     "M 111.1"; 
      )     ; 
      A     "M 46.1"; 
      AN    "M 43.5"; 
      S     "M 42.0"; 
//;
      A(    ; 
      AN    "M 140.3"; 
      AN    "M 152.5"; 
      O     ; 
      A     "M 140.3"; 
      AN    "M 111.1"; 
      )     ; 
      A     "M 46.1"; 
      AN    "M 43.5"; 
      O     "DB UTILITY".Conveyor_7_Disable; 
      R     "M 42.0"; 
NETWORK
TITLE =Flipper - Door Closed

      A     "E 9.0"; 
      A     "M 0.3"; 
      =     "M 42.2"; 
NETWORK
TITLE =Flipper - Service Mode

      A(    ; 
      A     "M 43.0"; 
      AN    "M 43.2"; 
      O     ; 
      A     "M 43.5"; 
      AN    "M 44.0"; 
      )     ; 
      A     "M 190.1"; 
      A     "M 42.2"; 
      =     "M 42.4"; 
NETWORK
TITLE =Flipper Conveyor 7 - Running TimeOut  30s

      A     "A 45.6"; 
      AN    "Timer 41"; 
      A     "M 0.3"; 
      L     S5T#30S; 
      SD    "Timer 41"; 
NETWORK
TITLE =Flipper Flip - Obstruct - Fault

      A     "M 43.5"; 
      AN    "M 43.6"; 
      A(    ; 
      O     "B 7.4"; 
      O     "B 8.2"; 
      )     ; 
      A     "M 42.2"; 
      S     "M 42.7"; 
//;
      AN    "B 7.4"; 
      AN    "B 8.2"; 
      A     "M 42.2"; 
      R     "M 42.7"; 
NETWORK
TITLE =Step 8N1 - Power ON

      A     "M 42.2"; 
      AN    "DB UTILITY".Conveyor_7_Disable; 
      S     "M 43.0"; 
NETWORK
TITLE =Step 8N2 - Flipper Flip - Stop

      A(    ; 
      ON    "P 8.0"; 
      ON    "P 8.1"; 
      )     ; 
      A     "M 43.0"; 
      S     "M 43.1"; 
NETWORK
TITLE =Step 8N3 - Flipper Belt - Packet Runs IN

      A     "M 39.3"; 
      AN    "M 39.4"; 
      A     "M 42.2"; 
      A     "M 43.1"; 
      S     "M 43.2"; 
NETWORK
TITLE =Step 8N4 - Flipper Conveyor 7 - Packet Runs IN

      A     "B 7.4"; 
      A     "M 42.2"; 
      A     "M 43.2"; 
      S     "M 43.3"; 
NETWORK
TITLE =Flipper Conveyor - Enter Time

      A(    ; 
      A     "M 43.3"; 
      AN    "M 43.4"; 
      O     ; 
      A     "M 44.1"; 
      AN    "M 44.2"; 
      )     ; 
      A     "M 42.2"; 
      L     S5T#500MS; 
      SD    "Timer 43"; 
NETWORK
TITLE =Step 8N5 - Flipper Conveyor 7 - Packet Edge Sens

      A     "Timer 43"; 
      AN    "B 7.4"; 
      A     "M 42.2"; 
      A     "M 43.3"; 
      S     "M 43.4"; 
NETWORK
TITLE =Time Convertion - Lateral Packet Position to Flipper - Adj.(HMI)

//   A     M    140.3
      AN    "M 6.7"; 
      FP    "FP 147.0"; 
      JNB   BYP1; 
      L     "HMI_DB".CONV_7_POS_mS; // Integer contains MILLISECOND seconds
      L     50; // mS
      *I    ; 
      T     #W_ZOOLOO_1; 
      ITD   ; 
      T     #T_ZOOLOO; // Double Int    

      CALL "TIM_S5TI" (
           IN                       := #T_ZOOLOO,// Integer    
           RET_VAL                  := #POSITION_TIME);// Simatic Time

      L     #POSITION_TIME; 
      T     "MW 186"; // Simatic Time
//;
      L     #W_ZOOLOO_1; 
      L     10; 
      /I    ; 
      T     #W_ZOOLOO_2; 
//;
      A(    ; 
      L     #W_ZOOLOO_2; 
      L     "MW 192"; 
      <>I   ; 
      )     ; 
      JNB   BYP1; 
      L     #W_ZOOLOO_2; // Simatic Time
      T     "HMI_DB".DELAY_DISPLAY_7; 
      T     "MW 192"; 

BYP1: CLR   ; 

      A     "M 140.3"; 
      A     "M 43.4"; 
      AN    "M 43.5"; 
      A     "M 42.2"; 
      A     "M 0.3"; 
      L     "MW 186"; // Simatic Time
      SD    "Timer 60"; 
NETWORK
TITLE =Flipper Conveyor Stop - Packet in Position

//     OPN   "DB LAUER"
//;
//      CALL  "LAUER TIME"
//       QUEL :=DBW242
//       _TIME:=MW122
//;
      A     "M 43.4"; 
      AN    "M 43.5"; 
      A     "M 42.2"; 
// L     MW   122
      L     S5T#1S500MS; 
      SD    "Timer 42"; 
NETWORK
TITLE =Step 8N6 - Flipper Belt - Stop

      A     "Timer 42"; 
//    O     T     60
      A     "M 42.2"; 
      A     "M 43.4"; 
      S     "M 43.5"; 
NETWORK
TITLE =Step 8N7 - Flipper - Busy / Not Available

      A(    ; 
      A     "P 8.0"; 
      A     "P 8.1"; 
      ON    "M 42.0"; 
      )     ; 
      A     "M 42.2"; 
      A     "M 43.5"; 
      S     "M 43.6"; 
NETWORK
TITLE =Step 8N8 - Flipper - Flipping Done / Ready

      A(    ; 
      ON    "P 8.0"; 
      ON    "P 8.1"; 
      )     ; 
      A     "M 42.2"; 
      A     "M 43.6"; 
      S     "M 43.7"; 
NETWORK
TITLE =Step 8N9 - Flipper Conveyor 7 - Transfer to 8

      A     "M 47.2"; 
      AN    "M 47.3"; 
      A     "M 42.2"; 
      A     "M 43.7"; 
      S     "M 44.0"; 
NETWORK
TITLE =Flipper Belt  - Exit Run - TimeOut  4s

      A     "M 44.0"; 
      AN    "M 44.1"; 
      A     "A 45.6"; 
      A     "M 42.2"; 
      L     S5T#4S; 
      SD    "Timer 44"; 
NETWORK
TITLE =Step 8N10 - Flipper Belt - Packet Exits

      A(    ; 
      O     "B 8.2"; 
      O     "Timer 44"; 
      )     ; 
      A     "M 42.2"; 
      A     "M 44.0"; 
      S     "M 44.1"; 
NETWORK
TITLE =Step 8N11 - Flipper - Steps Register - Reset

      AN    "B 8.2"; 
      A     "Timer 43"; 
      A     "M 42.2"; 
      A     "M 44.1"; 
      S     "M 44.2"; 
NETWORK
TITLE =Flipper Delivery Conveyor 6 - Run Time   500mS

      A     "M 44.0"; 
      AN    "M 44.2"; 
      A     "M 42.2"; 
      L     S5T#500MS; 
      SF    "Timer 45"; 
NETWORK
TITLE =Flipper Conveyor - VFD Release

      A(    ; 
      A     "M 43.2"; 
      AN    "M 43.5"; 
      O     "Timer 45"; 
      O     #CONVEYOR_7_RUN; 
      )     ; 
      AN    #FLIPPER_SERVICE_SW; 
      A     "M 42.2"; 
      A     "M 43.0"; 
      AN    "M 11.1"; // VFD NOT All Ready !
      =     "A 45.6"; 
      =     "A 45.7"; 
NETWORK
TITLE =Flipper
//Flipper Action


NETWORK
TITLE =Flipper Flip - Steps Register - Reset

      A(    ; 
      A     "M 190.1"; 
      A     "M 171.4"; 
      A     "M 171.5"; 
      O     "M 44.2"; 
      O     "Timer 41"; 
      O     #INITIALISATION; 
      O     "DB UTILITY".Conveyor_7_Disable; 
      )     ; 
      A     "M 42.2"; 
      JC    M001; 
      JU    M002; 

M001: L     W#16#0; 
      T     "MW 43"; 

M002: NOP   0; 
NETWORK
TITLE =Events UpDate - Flipper Flip 1 - CW

      A(    ; 
      A     "P 8.0"; 
      A     "P 8.1"; 
      A     "M 43.0"; 
      AN    "M 43.1"; 
      O     ; 
      A     "M 42.0"; 
      AN    "P 8.1"; 
      A     "M 43.5"; 
      AN    "M 43.7"; 
      )     ; 
      A     "P 8.0"; 
      A     "M 42.2"; 
      AN    "M 42.6"; 
      =     "M 9.0"; 
NETWORK
TITLE =Flipper Flip 2 - CW

      A     "M 9.0"; 
      S     "M 42.5"; 
//;
      A(    ; 
      A     "M 43.1"; 
      AN    "M 43.5"; 
      O     ; 
      A     "M 43.7"; 
      O     ; 
      AN    "P 8.0"; 
      O     "M 42.6"; 
      ON    "M 43.0"; 
      )     ; 
      R     "M 42.5"; 
NETWORK
TITLE =Flipper Flip Motor Contactor - CW

      A(    ; 
      A     "M 42.5"; 
      O     ; 
      A     "M 42.4"; 
      A     "M 161.1"; 
      O     ; 
      A     #FLIP_CW; 
      )     ; 
      A     "P 8.0"; 
      AN    "M 42.7"; 
      AN    "A 45.6"; 
      A     "M 42.2"; 
      AN    "K 46.0"; 
      =     "K 46.1"; 
NETWORK
TITLE =Events UpDate - Flipper Flip 1 - CCW

      A(    ; 
      A     "M 42.0"; 
      AN    "P 8.0"; 
      A     "M 43.5"; 
      AN    "M 43.7"; 
      )     ; 
      A     "P 8.1"; 
      A     "M 42.2"; 
      AN    "M 42.5"; 
      =     "M 9.0"; 
NETWORK
TITLE =Flipper Flip 2 - CCW

      A     "M 9.0"; 
      S     "M 42.6"; 
//;
      A(    ; 
      A     "M 43.7"; 
      O     ; 
      AN    "P 8.1"; 
      O     "M 42.5"; 
      ON    "M 43.0"; 
      )     ; 
      R     "M 42.6"; 
NETWORK
TITLE =Flipper Flip Motor Contactor - CCW

      A(    ; 
      A     "M 42.6"; 
      O     ; 
      A     "M 42.4"; 
      A     "M 161.0"; 
      O     ; 
      A     #FLIP_CCW; 
      )     ; 
      A     "P 8.1"; 
      AN    "A 45.6"; 
      AN    "M 42.7"; 
      A     "M 42.2"; 
      AN    "K 46.1"; 
      =     "K 46.0"; 
END_FUNCTION

FUNCTION "CONVEYOR 8 - TURNTABLE" : VOID
TITLE =Turn Table  Pos.10
//
NAME : POS_10
VERSION : 0.0


VAR_TEMP
  MAIN_SERVICE_2_SW : BOOL ;	
  TURNTABLE_SERVICE_SW : BOOL ;	
  CONVEYOR_SERVICE_SW : BOOL ;	
  TURNTABLE_ROUNDTRIP : BOOL ;	
  TURN_CW : BOOL ;	
  TURN_CCW : BOOL ;	
  AUTO_HOME_SERVICE : BOOL ;	
  CONV_FWD : BOOL ;	
  CONV_REV : BOOL ;	
  INITIALISATION : BOOL ;	
  ZOOLOO : TIME ;	
  PACKET_LENGTH : REAL ;	
  RUN_TIME : REAL ;	
END_VAR
BEGIN
NETWORK
TITLE =Service Test

      A     "HMI_DB".ALL_SERVICE_ENABLE_SW; 
      A     "HMI_DB".CONVEYOR_8_SERVICE_SW; 
      A     "HMI_DB".SERVICE_SW_2_STATUS; 
      =     #MAIN_SERVICE_2_SW; 
//;
      A     #MAIN_SERVICE_2_SW; 
      O     "M 46.7"; 
      JNB   TURN; 
      A     "HMI_DB".HMI_CONVEYOR_8_TEST_SSW; 
      =     #CONVEYOR_SERVICE_SW; 
      R     "HMI_DB".TURNTABLE_SERVICE_SSW; 
//;
      A     "HMI_DB".TURNTABLE_SERVICE_SSW; 
      =     #TURNTABLE_SERVICE_SW; 
      R     "HMI_DB".HMI_CONVEYOR_8_TEST_SSW; 
//;
      A(    ; 
      O     #CONVEYOR_SERVICE_SW; 
      O     #TURNTABLE_SERVICE_SW; 
      )     ; 
      =     "HMI_DB".TURNTABLE_SERVICE_PBSHOW; 
      S     "DB UTILITY".Conveyor_7_Disable; 
//;
      A     "HMI_DB".TURNTABLE_RNDTRIP; 
      S     "DB UTILITY".Conveyor_7_Disable; 
//;
      A     "HMI_DB".SERVICE_INIT_PB; 
      =     #AUTO_HOME_SERVICE; 
//;
      A     #TURNTABLE_SERVICE_SW; 
      A     "HMI_DB".HMI_TURNTABLE_CCW_SSW; 
      AN    #TURN_CW; 
      =     #TURN_CCW; 
//;
      A     #TURNTABLE_SERVICE_SW; 
      A     "HMI_DB".HMI_TURNTABLE_CW_SSW; 
      AN    #TURN_CCW; 
      =     #TURN_CW; 
//;
      AN    #TURNTABLE_SERVICE_SW; 
      =     "HMI_DB".RNDTRIP_PB_VISIBLE; 
//;
      AN    #TURNTABLE_SERVICE_SW; 
      A     "HMI_DB".TURNTABLE_RNDTRIP; 
      =     #TURNTABLE_ROUNDTRIP; 
//;
      A     #CONVEYOR_SERVICE_SW; 
      A     "HMI_DB".HMI_TURNTABLE_CCW_SSW; 
      AN    #CONV_FWD; 
      =     #CONV_REV; 
//;
      A     #CONVEYOR_SERVICE_SW; 
      A     "HMI_DB".HMI_TURNTABLE_CW_SSW; 
      AN    #CONV_REV; 
      =     #CONV_FWD; 
//;
      A     "HMI_DB".SERVICE_INIT_PB; 
      A     #TURNTABLE_SERVICE_SW; 
      =     #INITIALISATION; 
//;
      AN    #MAIN_SERVICE_2_SW; 
      R     "HMI_DB".TURNTABLE_SERVICE_SSW; 
      R     "DB UTILITY".Conveyor_7_Disable; 
      R     "HMI_DB".HMI_CONVEYOR_8_TEST_SSW; 
      R     "HMI_DB".TURNTABLE_SERVICE_PBSHOW; 
      R     "HMI_DB".HMI_TURNTABLE_CCW_SSW; 
      R     "HMI_DB".HMI_TURNTABLE_CW_SSW; 
      R     "HMI_DB".TURNTABLE_RNDTRIP; 
      R     "HMI_DB".RNDTRIP_PB_VISIBLE; 

TURN: R     #TURNTABLE_SERVICE_SW; 
      R     #CONVEYOR_SERVICE_SW; 
      R     #AUTO_HOME_SERVICE; 
      R     #TURNTABLE_ROUNDTRIP; 
      R     #INITIALISATION; 
      R     #TURN_CW; 
      R     #TURN_CCW; 
      R     #CONV_FWD; 
      R     #CONV_REV; 
      FP    "FP 169.0"; 
      =     "M 46.7"; 
NETWORK
TITLE =Turn Direction - Turn Table Turn SW  1:CCW - 0:CW

      A(    ; 
      A(    ; 
      AN    "M 140.3"; 
      A     "M 152.2"; 
      O     ; 
      A     "M 140.3"; 
      A     "HMI_DB".TURNTABLE_SSW_MAIN; // Turn 0:CW  1:CCW
      )     ; 
      AN    #TURNTABLE_SERVICE_SW; 
      )     ; 
      A     "M 47.0"; 
      AN    "M 47.3"; 
      AN    "P 8.6"; 
      S     "M 46.2"; // 1: Packet Sens - Inverted 
//;
      A(    ; 
      A(    ; 
      AN    "M 140.3"; 
      AN    "M 152.2"; 
      O     ; 
      A     "M 140.3"; 
      AN    "HMI_DB".TURNTABLE_SSW_MAIN; 
      )     ; 
      AN    #TURNTABLE_SERVICE_SW; 
      )     ; 
      A     "M 47.0"; 
      AN    "M 47.3"; 
      AN    "P 8.6"; 
      R     "M 46.2"; // 0: Packet Sens - Not Inverted 
NETWORK
TITLE =TurnTable Turn - Direction Memory

      A     "M 46.2"; 
      FP    "FP 169.3"; 
      AN    #TURNTABLE_SERVICE_SW; 
      A     "M 0.3"; 
      S     "M 7.3"; 
//;
      AN    "M 46.2"; 
      FP    "FP 169.4"; 
      AN    #TURNTABLE_SERVICE_SW; 
      A     "M 0.3"; 
      R     "M 7.3"; 
//;
      A     "M 7.3"; 
      =     "HMI_DB".CONV_8_INVERT_SELECT; 
NETWORK
TITLE =TurnTable Turn - Enable

      A     "M 0.3"; 
      AN    "M 3.6"; 
      A     "E 0.4"; 
      A     "E 9.0"; // Door Closed
      AN    "M 46.6"; // Entry Jam Bit
      AN    "DB UTILITY".Conveyor_8_Disable; 
      =     "M 46.3"; 
NETWORK
TITLE =TurnTable + Belt Entry Jam Bit - Reset

      A     "E 9.0"; // Door Closing Reset
      FP    "FP 144.0"; 
      AN    "B 8.2"; // Only reset if entry sensor is clear
      R     "M 46.6"; // Entry Jam Bit - Reset
NETWORK
TITLE =TurnTable Turn - Service Mode (LAUER)

      A(    ; 
      A     "M 47.0"; 
      AN    "M 47.3"; 
      O     ; 
      A     "M 47.5"; 
      AN    "M 47.7"; 
      )     ; 
      A     "M 46.3"; 
      A     "M 190.2"; 
      =     "M 46.4"; 
NETWORK
TITLE =Steps
//TurnTable Steps


NETWORK
TITLE =Step 9N0 - TurnTable Steps Register - Reset

      A(    ; 
      A     "M 190.2"; 
      A     "M 171.4"; 
      A     "M 171.5"; 
      O     "M 48.4"; 
      O     #INITIALISATION; 
      )     ; 
      A     "M 46.3"; 
      O     "M 46.6"; // Entry Jam Fault - Reset
      JC    M001; 
      JU    M002; 

M001: L     W#16#0; 
      T     "MW 47"; 

M002: NOP   0; 
NETWORK
TITLE =Step 9N1 - Power ON

      A     "M 46.3"; 
      S     "M 47.0"; 
NETWORK
TITLE =Step 9N2 - TurnTable Turn - Slow

      A(    ; 
      ON    "P 8.5"; 
      ON    "P 8.6"; 
      )     ; 
      A     "M 46.3"; 
      A     "M 47.0"; 
      S     "M 47.1"; 
NETWORK
TITLE =Step 9N3 - TurnTable Turn - Stop

      AN    "P 8.6"; 
      A     "M 46.3"; 
      A     "M 47.1"; 
      S     "M 47.2"; 
NETWORK
TITLE =Step 9N4 - TurnTable Belt - Packet Runs IN

      A(    ; 
      O     "B 8.2"; 
      O     #TURNTABLE_ROUNDTRIP; 
      )     ; 
      A     "M 46.3"; 
      A     "M 47.2"; 
      S     "M 47.3"; 
NETWORK
TITLE =Step 9N5 - TurnTable Belt 8 - Packet IN

      AN(   ; 
      O     "B 8.2"; 
      O     #TURNTABLE_ROUNDTRIP; 
      )     ; 
      A     "M 46.3"; 
      A     "M 47.3"; 
      S     "M 47.4"; 
NETWORK
TITLE =TurnTable Belt Entry Jam Timeout

      A     "M 47.3"; // Packet Runs IN
      A     "B 8.2"; // Entry sensor still blocked
      A     "M 46.3"; // Enable
      L     S5T#8S; // Adjust as 8s
      SD    "Timer 84"; 
NETWORK
TITLE =TurnTable Belt Entry Jam Stop

      A     "Timer 84"; 
      S     "M 46.6"; // Entry Jam Bit
NETWORK
TITLE =Length Convertion - TurnTable Belt  

      A     "M 31.4"; 
      FP    "FP 157.3"; 
      JNB   M317; 
      L     "COLLATORS DB".PacketLength_C4; 
      ITD   ; 
      DTR   ; 
      T     #PACKET_LENGTH; 

      CALL "SCALER" (
           X                        := #PACKET_LENGTH,
           X1                       := 5.500000e+01,
           Y1                       := 2.000000e+03,
           X2                       := 1.600000e+02,
           Y2                       := 1.000000e+03,
           RET_VAL                  := #RUN_TIME);

      L     #RUN_TIME; 
      RND   ; 
      T     "MW 196"; 

M317: NOP   0; 
NETWORK
TITLE =Time Convertion - TurnTable Belt  
//- Packet Forward : - Run Time   (~1500mS)
//- Packet Reverse : - Run Time   (~300mS)
//950mm Packet : 1300 mS
//Collator 4 - 950 mm = 143 Count  6.6mm per pulse
//
//- Packet Inverting on TurnTable - Belt RunTime at Packet End: Always 300mS to 
//Stay Close to REV Exit Side !
//
//- Packet Non-Inverting on TurnTable - Belt RunTime at Packet End: 500 to 1600mS 
//(Depend on Packet Length) to get Close to FWD Exit Side !...
//
//404 Tube Limit 350 - 1050mm
      AN    "M 7.3"; 
      AN    "M 6.7"; 
      FP    "FP 157.6"; 
      JNB   END; 
      L     "HMI_DB".CONV_8_POS_REV_mS; // Integer contains MILLISECOND seconds
      L     10; 
      *I    ; 
      ITD   ; 
      T     #ZOOLOO; 

      CALL "TIM_S5TI" (
           IN                       := #ZOOLOO,
           RET_VAL                  := "MW 234");

END:  NOP   0; 
NETWORK
TITLE =TurnTable Belt  - Run Time FWD & REV  300mS

      A     "M 47.4"; 
      AN    "M 47.5"; 
      A     "M 0.3"; 
      L     S5T#300MS; 
      SD    "Timer 47"; 
//;
      A     "M 140.3"; 
      AN    "M 7.3"; 
      A     "M 47.4"; 
      AN    "M 47.5"; 
      A     "M 0.3"; 
      A     "Timer 47"; 
      FP    "FP 168.7"; 
      L     "MW 234"; 
      SF    "Timer 49"; 
NETWORK
TITLE =Step 9N6 - TurnTable Belt 8 - Stop

      A     "Timer 47"; 
      A     "M 46.3"; 
      A     "M 47.4"; 
      S     "M 47.5"; 
NETWORK
TITLE =Step 9N7 - TurnTable Turn - Slow

      A(    ; 
      ON    "P 9.2"; 
      ON    "P 9.3"; 
      )     ; 
      A     "M 46.3"; 
      A     "M 47.5"; 
      S     "M 47.6"; 
NETWORK
TITLE =Step 9N8 - TurnTable Turn - Stop

      AN    "P 9.3"; 
      A     "M 46.3"; 
      A     "M 47.6"; 
      S     "M 47.7"; 
NETWORK
TITLE =Step 9N9 - TurnTable Belt - Delivery

      A     "M 51.2"; 
      AN    "M 51.3"; 
      A     "M 46.3"; 
      A     "M 47.7"; 
      S     "M 48.0"; 
NETWORK
TITLE =TurnTable Belt  - Max Run Time  5s

      A     "M 48.0"; 
      AN    "M 48.1"; 
      A     "M 0.3"; 
      A     "M 46.3"; 
      L     S5T#5S; 
      SD    "Timer 48"; 
NETWORK
TITLE =Step 9N10 - TurnTable Belt - Delivering

      A(    ; 
      O     "B 9.6"; 
      O     "Timer 48"; 
      )     ; 
      A     "M 46.3"; 
      A     "M 48.0"; 
      S     "M 48.1"; 
NETWORK
TITLE =Step 9N11 - TurnTable Return - Home

      AN    "B 9.6"; 
      A     "M 46.3"; 
      A     "M 48.1"; 
      S     "M 48.2"; 
NETWORK
TITLE =Step 9N12 - TurnTable Return - Slow

      A(    ; 
      ON    "P 8.5"; 
      ON    "P 8.6"; 
      )     ; 
      A     "M 46.3"; 
      A     "M 48.2"; 
      S     "M 48.3"; 
NETWORK
TITLE =Step 9N13 - TurnTable Steps Register - Reset

      AN    "P 8.6"; 
      A     "M 46.3"; 
      A     "M 48.2"; 
      S     "M 48.4"; 
NETWORK
TITLE =Service Home Position Process - Position Home Test

      A     #TURNTABLE_SERVICE_SW; 
      AN    "P 8.6"; 
      S     "M 49.1"; 
//;
      AN    #TURNTABLE_SERVICE_SW; 
      R     "M 49.1"; 
      R     "M 49.0"; 
NETWORK
TITLE =Service Home Position Process - Position Delivery Test

      A     #TURNTABLE_SERVICE_SW; 
      AN    "P 9.3"; 
      =     "M 49.2"; 
NETWORK
TITLE =Service Home Position Process - UnKnown Position Test

      A     #TURNTABLE_SERVICE_SW; 
      A     "P 8.5"; 
      A     "P 8.6"; 
      A     "P 9.2"; 
      A     "P 9.3"; 
      =     "M 49.3"; 
NETWORK
TITLE =Action from Steps Commands



NETWORK
TITLE =TurnTable Belt - VFD Release Forward
//Comments to be kept ! It is a Modif to Come !
      A(    ; 
      A     "M 47.3"; 
      AN    "M 47.5"; 
      O     ; 
      A     "M 48.0"; 
      AN    "M 48.2"; 
      AN    "M 7.3"; 
      )     ; 
      O     #CONV_FWD; 
      O     "Timer 49"; 
      A     "M 46.3"; 
      AN    "M 11.1"; // VFD NOT All Ready !
      AN    "A 46.5"; 
      =     "A 46.4"; 
NETWORK
TITLE =TurnTable Belt - VFD Release Reverse

      A(    ; 
      A     "M 48.0"; 
      AN    "M 48.2"; 
      A     "M 7.3"; 
      O     #CONV_REV; 
      )     ; 
      A     "M 46.3"; 
      AN    "M 11.1"; // VFD NOT All Ready !
      AN    "A 46.4"; 
      =     "A 46.5"; 
NETWORK
TITLE =TurnTable Belt - Fast

      A     "M 46.3"; 
      =     "A 46.6"; 
NETWORK
TITLE =TurnTable Manual - Turn CW

      A     "M 46.4"; 
      A     "M 161.0"; 
      O     #TURN_CW; 
      =     "M 48.5"; 
NETWORK
TITLE =TurnTable Manual - Turn CCW

      A     "M 46.4"; 
      A     "M 161.1"; 
      O     #TURN_CCW; 
      =     "M 48.6"; 
NETWORK
TITLE =TurnTable Manual - Manual Mode Reset

      AN    "M 150.5"; 
      AN    #TURNTABLE_SERVICE_SW; 
      R     "M 48.5"; 
      R     "M 48.6"; 
NETWORK
TITLE =TurnTable Manual Mode - Auto-Home
//TurnTable Auto-Home : SERVICE 2 SW Then TURNTABLE SW Then INIT PB !
      A     #TURNTABLE_SERVICE_SW; 
      A     #AUTO_HOME_SERVICE; 
      A     "P 8.6"; 
      S     "M 49.0"; 
//;
      AN    "P 8.6"; 
      O     "Timer 52"; 
      ON    #TURNTABLE_SERVICE_SW; 
      O     #TURN_CW; 
      O     #TURN_CCW; 
      R     "M 49.0"; 
//;
      A(    ; 
      O     "A 47.0"; 
      O     "A 47.1"; 
      )     ; 
      A     "M 49.0"; 
      =     "M 49.5"; 
//;
      A     "M 49.5"; 
      L     S5T#20S; 
      SD    "Timer 52"; 
NETWORK
TITLE =TurnTable - Turn CW

      A(    ; 
      A     "M 47.5"; 
      AN    "M 47.7"; 
      A     "P 9.3"; 
      AN    "M 7.3"; 
      AN    #TURNTABLE_SERVICE_SW; 
      O     ; 
      A     "M 48.2"; 
      AN    "M 48.4"; 
      A     "P 8.6"; 
      A     "M 7.3"; 
      AN    #TURNTABLE_SERVICE_SW; 
      O     ; 
      A     #TURNTABLE_SERVICE_SW; 
      A     "M 49.1"; 
      A(    ; 
      A     "P 9.3"; 
      AN    "M 7.3"; 
      A     "M 48.5"; 
      O     ; 
      A     "P 8.6"; 
      A     "M 7.3"; 
      A     "M 48.5"; 
      )     ; 
      O     ; 
      A     #TURNTABLE_SERVICE_SW; 
      AN    "M 49.1"; 
      A     "M 49.0"; 
      A     "P 8.6"; 
      A     "M 7.3"; 
      )     ; 
      A     "M 46.3"; 
      AN    "A 47.0"; 
      =     "A 47.1"; 
NETWORK
TITLE =Step 9N14 - TurnTable - Turn CW - Off

      A     "M 48.5"; 
      A(    ; 
      ON    "P 9.3"; 
      O     "M 171.5"; 
      )     ; 
      R     "M 48.5"; 
NETWORK
TITLE =Turn Table - Turn CCW

      A(    ; 
      A     "M 47.5"; 
      AN    "M 47.7"; 
      A     "P 9.3"; 
      A     "M 7.3"; 
      AN    #TURNTABLE_SERVICE_SW; 
      O     ; 
      A     "M 48.2"; 
      AN    "M 48.4"; 
      A     "P 8.6"; 
      AN    "M 7.3"; 
      AN    #TURNTABLE_SERVICE_SW; 
      O     ; 
      A     #TURNTABLE_SERVICE_SW; 
      A     "M 49.1"; 
      A(    ; 
      A     "P 9.3"; 
      A     "M 7.3"; 
      A     "M 48.6"; 
      O     ; 
      A     "P 8.6"; 
      AN    "M 7.3"; 
      A     "M 48.6"; 
      )     ; 
      O     ; 
      A     #TURNTABLE_SERVICE_SW; 
      AN    "M 49.1"; 
      A     "M 49.0"; 
      A     "P 8.6"; 
      AN    "M 7.3"; 
      )     ; 
      A     "M 46.3"; 
      AN    "A 47.1"; 
      =     "A 47.0"; 
NETWORK
TITLE =Step 9N15 - TurnTable - Turn CW - Off

      A     "M 48.6"; 
      A(    ; 
      ON    "P 8.6"; 
      O     "M 171.5"; 
      )     ; 
      R     "M 48.6"; 
NETWORK
TITLE =TurnTable - Fast

      A(    ; 
      A     "M 47.5"; 
      AN    "M 47.6"; 
      A     "P 9.2"; 
      O     ; 
      A     "M 48.2"; 
      AN    "M 48.3"; 
      A     "P 8.5"; 
      )     ; 
      AN    #TURNTABLE_SERVICE_SW; 
      A     "M 46.3"; 
      =     "A 47.2"; 
NETWORK
TITLE =TurnTable Position : Home = DB50.238:1 / Delivery = DB50.238:2

      OPN   "DB LAUER"; 
      ON    "P 8.6"; 
      ON    "P 9.3"; 
      JC    M003; 
      L     W#16#0; 
      T     DBW  238; 
      BEC   ; 

M003: A     "P 8.6"; 
      JC    M004; 
      L     W#16#1; 
      T     DBW  238; 
      BEC   ; 

M004: L     W#16#2; 
      T     DBW  238; 
END_FUNCTION

FUNCTION "CONVEYOR 9 - PUSHER 2" : VOID
TITLE =Conveyor 9 / Pusher 2  Pos.11
// 
NAME : POS_11
VERSION : 0.0


VAR_TEMP
  MAIN_SERVICE_2_SW : BOOL ;	
  CONVEYOR_9_RUN : BOOL ;	
  PUSHER_PUSH : BOOL ;	
  INITIALISATION : BOOL ;	
  POSITION_TIME : S5TIME ;	
  ZOOLOO : TIME ;	
END_VAR
BEGIN
NETWORK
TITLE =Pusher 2 - Service

      A     "HMI_DB".ALL_SERVICE_ENABLE_SW; 
      A     "HMI_DB".CONVEYOR_9_SERVICE_SW; 
      A     "HMI_DB".SERVICE_SW_2_STATUS; 
      =     #MAIN_SERVICE_2_SW; 
//;    
      A     #MAIN_SERVICE_2_SW; 
      O     "M 50.1"; 
      JNB   CON9; 
      A     "HMI_DB".HMI_CONVEYOR_9_TEST_SSW; 
      =     #CONVEYOR_9_RUN; 
//;
      A     "HMI_DB".HMI_PUSHER_2_TEST_SSW; 
      =     #PUSHER_PUSH; 
//;
      A     "HMI_DB".SERVICE_INIT_PB; 
      =     #INITIALISATION; 
//;
      A     #CONVEYOR_9_RUN; 
      S     "DB UTILITY".Conveyor_8_Disable; 
//;
      A     #PUSHER_PUSH; 
      S     "DB UTILITY".Conveyor_9_Disable; 
//;
      AN    #MAIN_SERVICE_2_SW; 
      R     "HMI_DB".HMI_CONVEYOR_9_TEST_SSW; 
      R     "HMI_DB".HMI_PUSHER_2_TEST_SSW; 
      R     "DB UTILITY".Conveyor_8_Disable; 
      R     "DB UTILITY".Conveyor_9_Disable; 

CON9: R     #CONVEYOR_9_RUN; 
      R     #PUSHER_PUSH; 
      R     #INITIALISATION; 
      FP    "FP 169.1"; 
      =     "M 50.1"; 
NETWORK
TITLE =Pusher Rollers - Max Run Time

      A     "M 51.2"; 
      AN    "M 51.3"; 
      A     "M 0.3"; 
      L     S5T#5S; 
      SD    "Timer 51"; 
NETWORK
TITLE =Conveyor 9 - Pusher Steps Register - Reset

      A(    ; 
      A     "M 52.1"; 
      O     "Timer 51"; 
      O     #INITIALISATION; 
      O     "DB UTILITY".Conveyor_9_Disable; 
      )     ; 
      A     "M 0.3"; 
      JC    M001; 
      JU    M002; 

M001: L     W#16#0; 
      T     "MW 51"; 
      T     "MB 53"; 

M002: NOP   0; 
NETWORK
TITLE =Step 10N1 - Power ON

      A     "M 0.3"; 
      S     "M 51.0"; 
NETWORK
TITLE =Step 10N2 - Conveyor 9 - Ready for InFeed

      AN    "P 10.0"; 
      A     "M 0.3"; 
      A     "M 51.0"; 
      S     "M 51.1"; 
NETWORK
TITLE =Step 10N3 - Conveyor 9 - Start Run

      A     "M 47.7"; 
      AN    "M 48.0"; 
      A     "M 0.3"; 
      A     "M 51.1"; 
      S     "M 51.2"; 
NETWORK
TITLE =Step 10N4 - Conveyor 9 - Packet Runs IN

      A     "B 9.6"; 
      A     "M 0.3"; 
      A     "M 51.2"; 
      S     "M 51.3"; 
NETWORK
TITLE =Step 10N5 - Conveyor 9 - Packet IN

      AN    "B 9.6"; 
      A     "M 0.3"; 
      A     "M 51.3"; 
      S     "M 51.4"; 
NETWORK
TITLE =Step 10N6 - Conveyor 9 - Packet Edge Sens

      A     "B 9.7"; 
      A     "M 0.3"; 
      A     "M 51.4"; 
      S     "M 51.5"; 
NETWORK
TITLE =Time Convertion - Lateral Packet Position to Feeder - Adj.(HMI)

      A     "M 140.3"; 
      AN    "M 6.7"; 
      FP    "FP 147.2"; 
      JNB   BYP1; 
      L     "HMI_DB".CONV_9_POS_mS; // Integer contains MILLISECOND seconds
      L     10; 
      *I    ; 
      ITD   ; 
      T     #ZOOLOO; 

      CALL "TIM_S5TI" (
           IN                       := #ZOOLOO,
           RET_VAL                  := #POSITION_TIME);

      L     #POSITION_TIME; 
      T     "MW 184"; 
BYP1: CLR   ; 

      A     "M 140.3"; 
      A     "M 51.5"; 
      AN    "M 51.6"; 
      A     "M 0.3"; 
      L     "MW 184"; 
      SD    "Timer 62"; // OMRON HMI
NETWORK
TITLE =Conveyor 9 - Lateral Packet Position to Feeder - Adj.(HMI)

      AN    "M 140.3"; 
      AN    "M 6.7"; 
      FP    "FP 149.5"; 
      JNB   BYP2; 
      OPN   "DB LAUER"; 
      CALL "LAUER TIME" (
           QUEL                     := DBW  248,
           _TIME                    := MW   124);

BYP2: NOP   0; 

      AN    "M 140.3"; 
      A     "M 51.5"; 
      AN    "M 51.6"; 
      A     "M 0.3"; 
      L     MW   124; 
      SD    "Timer 50"; // LAUER HMI
NETWORK
TITLE =Step 10N7 - Conveyor 9 - Packet in Position - Stop

      A(    ; 
      O(    ; 
      A     "Timer 50"; // LAUER HMI
      AN    "M 140.3"; 
      )     ; 
      O(    ; 
      A     "Timer 62"; // OMRON HMI
      A     "M 140.3"; 
      )     ; 
      )     ; 
      A     "M 0.3"; 
      A     "M 51.5"; 
      S     "M 51.6"; 
NETWORK
TITLE =Step 10N8 - Conveyor 9 - Pusher FWD

      A     "M 55.0"; 
      AN    "M 167.3"; // C10 Step Reset - Mem 
      AN    "M 55.1"; 
      AN    "M 55.5"; // Not while Transfering !
      A     "M 0.3"; 
      A     "M 51.6"; 
      S     "M 51.7"; 
NETWORK
TITLE =Step 10N9 - Conveyor 9 - Pushing Packet

      AN    "P 10.0"; 
      A     "M 0.3"; 
      A     "M 51.7"; 
      S     "M 52.0"; 
NETWORK
TITLE =Step 10N10 - Conveyor 9 - Pusher Steps Register - Reset

      AN    "P 10.1"; 
      A     "M 0.3"; 
      A     "M 52.0"; 
      S     "M 52.1"; 
NETWORK
TITLE =Pusher Roller Conveyor - Run

      A     "M 51.2"; 
      AN    "M 51.6"; 
      A     "M 0.3"; 
      O(    ; 
      A     #CONVEYOR_9_RUN; 
      AN    "B 9.7"; 
      )     ; 
      AN    "M 11.1"; // VFD NOT All Ready !
      =     "K 47.5"; 
NETWORK
TITLE =Pusher 2 - Retract (Home) After Steps Reset

      A(    ; 
      A     "M 51.0"; 
      AN    "M 51.1"; 
      A     "M 0.3"; 
      O     ; 
      A     "M 190.7"; 
      A     "M 161.1"; 
      O     ; 
      A     #MAIN_SERVICE_2_SW; 
      AN    #PUSHER_PUSH; 
      )     ; 
      A     "P 10.0"; 
      AN    "K 47.6"; 
      =     "K 47.7"; 
NETWORK
TITLE =Events UpDate - Pusher 2 - Forward

      A     "M 51.7"; 
      AN    "M 52.1"; 
      A     "M 0.3"; 
      AN    "M 54.7"; 
      AN    "M 98.1"; 
      A     "P 10.1"; 
      AN    "K 47.7"; 
      =     "M 9.0"; 
NETWORK
TITLE =Pusher 2 - Forward

      A(    ; 
      A     "M 9.0"; 
      AN    "M 98.2"; 
      A(    ; 
      O     "P 15.0"; 
      O     "P 15.1"; 
      )     ; 
      AN    "DB UTILITY".Conveyor_8_Disable; 
      O     ; 
      A     "M 190.7"; 
      A     "M 161.0"; 
      O     ; 
      A     #MAIN_SERVICE_2_SW; 
      A     #PUSHER_PUSH; 
      )     ; 
      AN    "DB UTILITY".Pusher_2_Disable; 
      AN    "M 11.1"; // VFD NOT All Ready !
      AN    "K 47.5"; 
      A     "P 10.1"; 
      AN    "K 47.7"; 
      =     "K 47.6"; 
NETWORK
TITLE =Position Data Return

      OPN   "DB LAUER"; 
//;
      ON    "P 10.0"; 
      ON    "P 10.1"; 
      JC    M003; 
      L     W#16#0; 
      T     DBW  220; 
      BEC   ; 

M003: AN    "P 10.0"; 
      JC    M004; 
      L     W#16#1; 
      T     DBW  220; 
      BEC   ; 

M004: L     W#16#2; 
      T     DBW  220; 
END_FUNCTION

FUNCTION "CONVEYOR 10 - PIVOT" : VOID
TITLE =Pivot Conveyor 10 - Collator  FC1054
NAME : POS_12
VERSION : 0.0


VAR_TEMP
  MAIN_SERVICE_2_SW : BOOL ;	
  PIVOT_SERVICE_SW : BOOL ;	
  PIVOT_UP : BOOL ;	
  PIVOT_DN : BOOL ;	
  CONVEYOR_RUN : BOOL ;	
  INITIALISATION : BOOL ;	
  BARRIER_BLINKER : BOOL ;	//Feeder Safety Light Barrier
  PACKET_WIDTH_10 : WORD ;	//Collator Conveyor 10 - Packet Width
  FRAC_PACKET_WIDTH_10 : WORD ;	//Collator Conveyor 10 - Fraction of Packet Width
  PACKET_WIDTH_FRAC_10 : WORD ;	//Collator Conveyor 10 - Packet Width + Fraction
  SURFACE_LENGTH_LEFT_10 : WORD ;	//Collator Conveyor 10 - Surface Length Left
  QTY_MAX_10 : REAL ;	
END_VAR
BEGIN
NETWORK
TITLE =Pivot Service 

      A     "HMI_DB".ALL_SERVICE_ENABLE_SW; 
      A     "HMI_DB".CONVEYOR_10_SERVICE_SW; 
      A     "HMI_DB".SERVICE_SW_2_STATUS; 
      =     #MAIN_SERVICE_2_SW; 
//;
      A     #MAIN_SERVICE_2_SW; 
      O     "M 54.3"; 
      JNB   PIVO; 

      A     "HMI_DB".HMI_PIVOT_SERVICE_SSW; 
      =     #PIVOT_SERVICE_SW; 
      R     "HMI_DB".HMI_CONVEYOR_10_TEST_SSW; 
//;  
      A     "HMI_DB".HMI_CONVEYOR_10_TEST_SSW; 
      =     #CONVEYOR_RUN; 
      R     "HMI_DB".HMI_PIVOT_SERVICE_SSW; 
//;
      A(    ; 
      O     #PIVOT_SERVICE_SW; 
      O     #CONVEYOR_RUN; 
      )     ; 
      S     "DB UTILITY".Pusher_2_Disable; 
//;
      A     #PIVOT_SERVICE_SW; 
      A     "HMI_DB".HMI_PIVOT_TEST_DN_SSW; 
      AN    "HMI_DB".HMI_PIVOT_TEST_UP_SSW; // Not Both Switches
      =     #PIVOT_DN; 
//;
      A     #PIVOT_SERVICE_SW; 
      A     "HMI_DB".HMI_PIVOT_TEST_UP_SSW; 
      AN    "HMI_DB".HMI_PIVOT_TEST_DN_SSW; // Not Both Switches
      =     #PIVOT_UP; 
//;
      AN(   ; 
      O     "P 15.0"; 
      O     "P 15.1"; 
      )     ; 
      R     #CONVEYOR_RUN; 
//;
      A     "HMI_DB".SERVICE_INIT_PB; 
      =     #INITIALISATION; 
//;
      AN    #MAIN_SERVICE_2_SW; 
      R     "HMI_DB".HMI_PIVOT_SERVICE_SSW; 
      R     "HMI_DB".HMI_CONVEYOR_10_TEST_SSW; 
      R     "HMI_DB".HMI_PIVOT_TEST_DN_SSW; 
      R     "HMI_DB".HMI_PIVOT_TEST_UP_SSW; 
      R     "DB UTILITY".Pusher_2_Disable; 

PIVO: R     #PIVOT_SERVICE_SW; 
      R     #CONVEYOR_RUN; 
      R     #INITIALISATION; 
      R     #PIVOT_DN; 
      R     #PIVOT_UP; 
      FP    "FP 169.2"; 
      =     "M 54.3"; 
NETWORK
TITLE =Conveyor 10 - Packet Width - Measurements [mS]

      A     "B 10.4"; // C10 InFeed Sens
      A     "M 55.1"; // Collator Trigger - Step
      S     "M 166.4"; 
//;
      A     "M 166.4"; 
      =     "FM350 DB".CONTROL_SIGNALS.SW_GATE4; 
//;
      A     "M 166.4"; 
      FP    "FP 149.7"; 
      JNB   NRAZ; 
      L     0; 
      T     "COLLATORS DB".Packet_Width_C10_mS; 

NRAZ: A     "M 166.4"; 
      JNB   NCNT; 
      L     "COLLATORS DB".Packet_Width_C10_mS; 
      L     "DB UTILITY".Scan_Cycle_Previous; 
      ITD   ; 
      +D    ; 
      T     "COLLATORS DB".Packet_Width_C10_mS; 

NCNT: A     "M 166.4"; 
      AN    "B 10.4"; 
      JNB   M104; 
      L     "FM350 DB".ACT_CNTV4; // C10 Encoder Counter
      T     #PACKET_WIDTH_10; 
      T     "COLLATORS DB".Packet_Width_C10; 
//;
      L     #PACKET_WIDTH_10; 
      ITD   ; 
      DTR   ; 
      L     2.000000e-01; 
      *R    ; 
      RND   ; 

      T     "COLLATORS DB".Frac_Packet_Width_C10; 

      T     #FRAC_PACKET_WIDTH_10; 
      L     #PACKET_WIDTH_10; 
      +I    ; 
      T     "COLLATORS DB".Packet_Width_Frac_C10; 
      T     #PACKET_WIDTH_FRAC_10; 
      R     "M 166.4"; 
      S     "M 167.2"; 

M104: NOP   0; 
NETWORK
TITLE =Conveyor 10 - Packet Width Measurements [mm] - While Collating

      A     "B 10.4"; // C10 InFeed Sens - New Packet
      FP    "M 188.5"; 
      A     "A 48.0"; 
      JCN   NPRT; 

      L     "FM350 DB".ACT_CNTV5; // C10 Encoder Counter
      T     "HOUSE_KEEPING DB".C10_Encoder_READ_Mem; 

NPRT: AN    "B 10.4"; // C10 InFeed Sens - New Packet End
      FP    "M 188.6"; 
      JCN   NTKE; 

      L     "FM350 DB".ACT_CNTV5; // C10 Encoder Counter
      L     "HOUSE_KEEPING DB".C10_Encoder_READ_Mem; 
      -I    ; 
      T     "HOUSE_KEEPING DB".C10_Packet_Width_ep; // C4 Packet Length [ep] 
      DTR   ; 
//;
      L     3.100000e-01; //  Encoder Wheel 283mm / 600 PPR  [mm/pulse]
      *R    ; 
      RND   ; 
      T     "HOUSE_KEEPING DB".C10_Packet_Width_mm; 

NTKE: NOP   0; 
NETWORK
TITLE =Conveyor 10 - Packet Width Measurements [mS]



NETWORK
TITLE =Conveyor 10 - Surface Length Left (PulseUnit) - Measurements

      A     "M 166.5"; 
      =     "FM350 DB".CONTROL_SIGNALS.SW_GATE5; 
//;
      A     "M 166.5"; 
      JNB   M665; 
      L     "COLLATORS DB".Surface_Length_10; 
      L     "FM350 DB".ACT_CNTV5; 
      -D    ; 
      T     #SURFACE_LENGTH_LEFT_10; 
      L     0; 
      >=I   ; 
      JNB   T010; 
      L     #SURFACE_LENGTH_LEFT_10; 
      T     "COLLATORS DB".Surface_Length_Left_10; 

T010: NOP   0; 

M665: NOP   0; 

      A     "M 55.1"; // Collator Trigger
      FP    "FP 154.6"; 
      S     "M 166.5"; 
NETWORK
TITLE =Conveyor 10 - Space Between Packet - Calculator

      A     "M 167.2"; 
      FP    "FP 154.5"; 
      JNB   M582; 
      L     #SURFACE_LENGTH_LEFT_10; 
      L     "COLLATORS DB".Frac_Packet_Width_C10; 
      -I    ; 
      T     "MW 216"; 

M582: NOP   0; 

      A     "M 167.2"; 
      A(    ; 
      L     #SURFACE_LENGTH_LEFT_10; 
      L     "MW 216"; 
      <=I   ; 
      )     ; 
      R     "M 167.2"; 
NETWORK
TITLE =Conveyor 10 - Collating Surface Manager

      A     "M 166.5"; 
      AN    "M 55.4"; 
      AN    "M 54.4"; // Collator Full - Count Flag Off
      A     "M 55.3"; 
      JNB   M554; 

      A(    ; 
      L     #SURFACE_LENGTH_LEFT_10; 
      L     "COLLATORS DB".Packet_Width_Frac_C10; 
      <I    ; 
      )     ; 
      S     "M 54.4"; // Collator Full - Count - Set

M554: NOP   0; 

      A     "M 167.3"; // C10 Step Reset - Mem
      R     "M 54.4"; // Collator Full - Count - Reset
NETWORK
TITLE =Conveyor 10 - Surface Length Reset

      ON(   ; 
      O     "P 15.0"; // While C10 Pivoting...
      O     "P 15.1"; 
      )     ; 
      L     S5T#200MS; 
      SD    "Timer 104"; 
//;
      A     "Timer 104"; // C10 Surface Length Reset 
      R     "M 166.4"; 
      R     "M 166.5"; 
NETWORK
TITLE =Clearing - C10 Counters Reset

      A     "M 10.5"; // UpStream Cleared
      A     "M 55.1"; // Collator Trigger
      AN    "M 55.4"; 
      A     "M 54.0"; 
      =     "M 54.5"; // 10 Clearing Command
//;
      A     "M 54.5"; // 10 Clearing Command
      A     "M 6.3"; 
      S     "M 166.4"; // Keep Setting / Reseting 
      S     "M 166.5"; 
//;
      A     "M 54.5"; // 10 Clearing Command
      A     "M 6.3"; 
      FN    "FN 155.2"; 
      R     "M 166.4"; 
      R     "M 166.5"; 
NETWORK
TITLE =Pivot Conveyor 10 - Power Enable

      A     "M 0.3"; 
      =     "M 54.0"; 
NETWORK
TITLE =Pivot Conveyor 10 - Power On - Empty on Initiate

      A     "M 54.0"; 
      FP    "FP 154.1"; // Empty on Power ON
      A     "B 10.5"; 
      S     "M 55.1"; 
NETWORK
TITLE =Pivot Conveyor 10 - Full Status Sensing

      A(    ; 
      O     "B 10.5"; // Collator Full - Sens
      O     "M 54.4"; // Collator Full - Count Flag
      )     ; 
      A     "M 55.1"; // Collator Trigger
      AN    "M 55.4"; // Collator Not Full - Step
      A     "M 54.0"; 
      S     "M 54.6"; // Collator Full - Flag Set
//;
      A     "M 55.4"; // Collator Full - Step
      R     "M 54.6"; // Collator Full - Flag Reset 2
NETWORK
TITLE =Pivot Conveyor 10 - Exit Monitor TimeOut  3s

      A     "B 10.6"; // Exit Sensor - Only Pass-By
      L     S5T#3S; 
      SD    "Timer 116"; // Packet is Stuck !
NETWORK
TITLE =Pivot Conveyor 10 - Infeed TimeOut  6s

      A     "M 55.2"; 
      AN    "M 55.3"; // Collating Stop
      A     "M 54.0"; 
      L     S5T#6S; // Collating TimeOut 6s
      SD    "Timer 54"; 
NETWORK
TITLE =Pivot Conveyor 10 - Fault

      A(    ; 
      A(    ; 
      A     "M 56.2"; 
      AN    "M 56.3"; 
      O     ; 
      A     "M 56.5"; 
      AN    "M 56.6"; 
      )     ; 
      A     "Timer 116"; // Something is Stuck !
      O     "Timer 54"; // Collating Packet Stuck !
      )     ; 
      S     "M 54.7"; 
//;
      A     "M 9.1"; 
      AN    "B 10.4"; 
      AN    "B 10.6"; 
      A     "M 54.0"; 
      R     "M 54.7"; 
NETWORK
TITLE =Pivot Conveyor 10 - InFeed Time Too Long ? - Fault

      A     "Timer 54"; 
      S     "M 54.1"; // C10 has Stopped!? - Set
//;
      A     "M 9.1"; 
      AN    "B 10.4"; 
      AN    "B 10.6"; 
      A     "M 54.0"; 
      R     "M 54.1"; // C10 has Stopped - Reset
NETWORK
TITLE =Pivot Conveyor 10 - Conveyor TimeOut  30s

      A     "M 55.1"; 
      A     "A 48.0"; 
      A     "M 54.0"; 
//    O     "M 10.0"
      L     S5T#30S; 
      SD    "Timer 57"; 
NETWORK
TITLE =Collating
//Collating


NETWORK
TITLE =Pivot Conveyor 10 - Emptying Recovery Delay

      A     "M 55.6"; // C10 Steps Reset
      S     "M 167.3"; // C10 Step Reset - Mem Set
//;
      A     "M 167.3"; // C10 Step Reset - Mem
      L     S5T#5S; 
      SD    "Timer 82"; 
      R     "M 166.5"; 
//;
      A     "Timer 82"; 
      R     "M 167.3"; // C10 Step Reset - Mem Reset
NETWORK
TITLE =Pivot Conveyor 10 - Byte Register - Reset

      A(    ; 
      O     "M 55.6"; // C10 Step Register - Reset
      O     "Timer 57"; 
      O     #INITIALISATION; 
      )     ; 
      A     "M 54.0"; 
      JNB   M001; 
      L     W#16#0; 
      T     "MB 55"; 
      T     "HMI_DB".CONV_10_COUNT; 

M001: NOP   0; 
NETWORK
TITLE =Step 11N1 - Power ON

      A     "M 54.0"; 
      S     "M 55.0"; 
NETWORK
TITLE =Step 11N2 - Conveyor 10 - Run

      A     "B 10.3"; // C10 Start - Sens Trigger
      A     "M 51.7"; // Pusher 2 FWD
      AN    "M 52.1"; // Pusher 2 Not Done
      A     "M 54.0"; 
      A     "M 55.0"; 
      S     "M 55.1"; // C10 Start - Step Set
//;
      A(    ; 
      AN    "M 54.4"; // Collator Full - Count Flag Off
      A     "M 55.3"; // Collating Stop
      AN    "M 55.4"; // Not Full - Collating
      AN    "M 54.6"; // Not Full Yet
      ON    "M 55.0"; 
      )     ; 
      R     "M 55.1"; // Collating Stop - Step 1 Reset
NETWORK
TITLE =Step 11N3 - Conveyor 10 - Collating Start

      A     "B 10.4"; // Collating Start - Sens Trigger
      A     "M 54.0"; 
      A     "M 55.1"; // C10 Started - Step 
      S     "M 55.2"; // Collating Start - Step Set
//;
      AN    "M 55.1"; // Collating Stopped - Step 
      R     "M 55.2"; // Collating Done - Step Reset
NETWORK
TITLE =Step 11N4 - Conveyor 10 - Collating Stop

      A(    ; 
      ON    "B 10.4"; // Collating Start - Sens Trigger Done
      O     "M 54.7"; // Fault Flag
      )     ; 
      A     "M 54.0"; 
      A     "M 55.2"; // Collating Started - Step 
      S     "M 55.3"; // Collating Done - Step Set
//;
      AN    "M 55.2"; // Collating Stopped - Step 
      R     "M 55.3"; // Collating Done - Step Reset
NETWORK
TITLE =Step 11N5 - Conveyor 10 - Conveyor Full - Start Transfer

      A(    ; 
      O     "B 10.5"; // Collator Full - Sens
      O     "M 54.4"; // Collator Full - Count
      )     ; 
      A     "M 54.0"; 
      A     "M 55.3"; // Collating Done - Step
      O     #CONVEYOR_RUN; // SERVICE - Triggers C11 or C21
      S     "M 55.4"; // Collator Full - Step
      R     "M 54.6"; // Collator Full - Flag Reset
NETWORK
TITLE =Step 11N6 - Conveyor 10 - Transfering 
//Called by Empty Conveyors 11, 21 ...
//On Clearing Mode, Flag M 8.4 Holds the Pivot Conveyor 10 Belt from Emptying 
//until New Order Confirm !
      A(    ; 
      A     "P 15.0"; // Pivot Position OK
      A     "M 79.1"; // Called by C21
      AN    "M 79.2"; 
      O     ; 
      A     "P 15.1"; // Pivot Position OK
      A     "M 59.1"; // Called by C11
      AN    "M 59.2"; 
      )     ; 
      AN    "M 54.7"; 
      A     "M 54.0"; 
      AN    "M 8.4"; // Hold After Clearing - Not Yet!
      AN    "P 10.0"; // Pusher 2 Home - Confirm
      S     "M 55.5"; // C10 Transfer Step - Set
      R     "M 58.2"; // C10 Clearing - UpStream Cleared - Trigger Reset
NETWORK
TITLE =Pivot Conveyor 10 - Transfer Max Time 20s

      A     "M 55.5"; // Transfer Step
      A     "A 48.0"; 
      A     "M 54.0"; 
      L     S5T#20S; 
      SD    "Timer 55"; // Transfer TimeOut
NETWORK
TITLE =Step 11N7 - Conveyor 10 - Steps Register - Reset

      A(    ; 
      A     "P 15.0"; 
      A     "M 79.2"; 
      O     ; 
      A     "P 15.1"; 
      A     "M 59.2"; 
      O     "Timer 55"; 
      )     ; 
      A     "M 54.0"; 
      A     "M 55.5"; // Transfer Step
      S     "M 55.6"; // C10 Step Register Reset - Set
      S     "M 58.3"; // C10 All Steps - Reset Memory - Set
NETWORK
TITLE =Pivot Conveyor 10 - VFD Release

      A(    ; 
      A     "M 55.1"; // Collating Start
      AN    "M 55.3"; // Collating Stop
      O     ; 
      A     "M 55.5"; // Transfer Step
      AN    "M 55.6"; // C10 Step Register - Not Yet Reset
      A     "A 48.1"; 
      )     ; 
      A     "M 54.0"; 
      A(    ; 
      O     "P 15.0"; // High or ...
      O     "P 15.1"; // Low Position !
      )     ; 
      AN    "M 98.2"; 
      AN    "M 11.1"; // VFD NOT All Ready !
      =     "A 48.0"; // C10 Belt VFD - Release
      R     "M 58.3"; // C10 All Steps - Reset Memory - Reset
NETWORK
TITLE =Pivot Conveyor VFD - Fast

      A     "M 55.5"; // Transfer Step - Trigger
      AN    "M 55.6"; // C10 Step Register - Not Yet Reset
      A     "M 54.0"; 
      AN    "M 98.2"; 
      AN    "M 11.1"; // VFD NOT All Ready !
      =     "A 48.1"; // C10 Belt VFD - Fast
NETWORK
TITLE =Pivot Conveyor VFD - Master TimeOut

      A     "A 48.0"; // Conveyor Running
      L     S5T#1M; 
      SD    "Timer 109"; // Master TimeOut
//;
      A     "Timer 109"; // Master TimeOut
      S     "M 55.6"; // Step Register - Reset Flag Set
      R     "M 10.0"; // Clearing CMD - Reset
      R     "M 12.1"; // Packet ON - Reset
NETWORK
TITLE =Pivot Action
//Pivot Action


NETWORK
TITLE =Step 11N10 - Conveyor 10 - Pivot Down Ready

      A     "P 15.0"; 
      A     "M 55.5"; 
      A     "M 54.0"; 
      S     "M 56.1"; 
//;
      A     "M 56.3"; 
      O     "M 54.3"; 
      R     "M 56.1"; 
NETWORK
TITLE =Step 11N11 - Conveyor 10 - Pivot Down

      A     "P 15.0"; 
      AN    "M 56.0"; 
      A     "M 79.2"; 
      A     "M 56.1"; 
      A     "M 54.0"; 
      S     "M 56.2"; 
//;
      AN    "M 56.1"; 
      O     "M 54.3"; 
      R     "M 56.2"; 
NETWORK
TITLE =Step 11N12 - Conveyor 10 - Move Dn Stop

      A     "P 15.1"; 
      A     "M 54.0"; 
      A     "M 56.2"; 
      S     "M 56.3"; 
//;
      AN    "M 56.2"; 
      R     "M 56.3"; 
NETWORK
TITLE =Step 11N13 - Conveyor 10 - Pivot Up - Ready

      A     "P 15.1"; 
      A     "M 55.5"; 
      A     "M 54.0"; 
      S     "M 56.4"; 
//;
      A     "M 56.6"; 
      O     "M 54.3"; 
      R     "M 56.4"; 
NETWORK
TITLE =Step 11N14 - Conveyor 10 - Pivot Up

      A     "P 15.1"; 
      AN    "M 56.0"; 
      A     "M 59.2"; 
      A     "M 56.4"; 
      A     "M 54.0"; 
      S     "M 56.5"; 
//;
      AN    "M 56.4"; 
      O     "M 54.3"; 
      R     "M 56.5"; 
NETWORK
TITLE =Step 11N15 - Conveyor 10 - Move Up Stop

      A     "P 15.0"; 
      A     "M 54.0"; 
      A     "M 56.5"; 
      S     "M 56.6"; 
//;
      AN    "M 56.5"; 
      R     "M 56.6"; 
NETWORK
TITLE =Conveyor 10 - Pivot Down - Actuator

      A(    ; 
      A     "M 56.2"; 
      AN    "M 56.3"; 
      AN    "M 54.7"; 
      A     "M 54.0"; 
      AN    #PIVOT_SERVICE_SW; 
      O     ; 
      A     "M 190.6"; 
      A     "M 161.1"; 
      )     ; 
      O     #PIVOT_DN; 
      AN    "P 15.1"; 
      AN    "A 48.0"; 
      AN    "K 53.1"; // Interlock - Not while Going Up     
      =     "K 53.0"; 
NETWORK
TITLE =Conveyor 10 - Pivot Up - Actuator

      A(    ; 
      A     "M 56.5"; 
      AN    "M 56.6"; 
      AN    "M 54.7"; 
      A     "M 54.0"; 
      AN    #PIVOT_SERVICE_SW; 
      O     ; 
      A     "M 190.6"; 
      A     "M 161.0"; 
      )     ; 
      O     #PIVOT_UP; 
      AN    "P 15.0"; 
      AN    "A 48.0"; 
      AN    "K 53.0"; // Interlock - Not while Going Down
      =     "K 53.1"; 
NETWORK
TITLE =Pivot Conveyor 10 - Go Down - TimeOut 10s

      A(    ; 
      A     "K 53.0"; 
      AN    "P 15.1"; 
      O     ; 
      A     "K 53.1"; 
      AN    "P 15.0"; 
      O     ; 
      AN    "P 15.0"; 
      AN    "P 15.1"; 
      )     ; 
      A     "M 0.3"; 
      L     S5T#5S; 
      SD    "Timer 53"; 
NETWORK
TITLE =Pivot Conveyor 10 - Pivot Alarm

      A(    ; 
      A     "M 55.5"; 
      AN    "M 55.6"; 
      A     "A 48.1"; 
      )     ; 
      A(    ; 
      O     "K 53.0"; // Pivot Moving !
      O     "K 53.1"; // Pivot Moving !
      )     ; 
      AN    "M 10.5"; // UpStream Not Cleared
      S     "M 98.2"; 
//;
      A     "M 171.5"; 
      R     "M 98.2"; 
NETWORK
TITLE =Pivot Conveyor 10 Alarm

      A     "Timer 53"; 
      S     "M 98.1"; 
//;
      A     "M 9.1"; 
      R     "M 98.1"; 
NETWORK
TITLE =DBW  236 - Conveyor 10 - Position Transfer

      OPN   "DB LAUER"; 

      O     "P 15.0"; 
      O     "P 15.1"; 
      JC    M003; 
      L     W#16#0; 
      T     DBW  236; 
      BEC   ; 

M003: AN    "P 15.1"; 
      JC    M004; 
      L     W#16#1; 
      T     DBW  236; 
      BEC   ; 

M004: L     W#16#2; 
      T     DBW  236; 
END_FUNCTION

FUNCTION "CONVEYOR 11 - LINK 1 LO" : VOID
TITLE =Conveyor 11 - Link 1L  Pos. 13 Low Level
//
NAME : POS_13_L
VERSION : 0.0


VAR_TEMP
  MAIN_SERVICE_2_SW : BOOL ;	
  SERVICE_RUN : BOOL ;	
  INITIALISATION : BOOL ;	
  BARRIER_BLINKER : BOOL ;	
END_VAR
BEGIN
NETWORK
TITLE =Conveyor 11 - Service

      A     "HMI_DB".ALL_SERVICE_ENABLE_SW; 
      A     "HMI_DB".CONVEYOR_11_SERVICE_SW; 
      A     "HMI_DB".SERVICE_SW_2_STATUS; 
      =     #MAIN_SERVICE_2_SW; 
//;
      A     #MAIN_SERVICE_2_SW; 
      O     "M 58.7"; 
      JNB   CO11; 
//;    
      A     "HMI_DB".HMI_CONVEYOR_11_TEST_SSW; 
      AN    "A 48.0"; 
      =     #SERVICE_RUN; 
      S     "DB UTILITY".Conveyor_10_Disable; 
      S     "DB UTILITY".Pivot_Disable; 
//;
      A     "HMI_DB".SERVICE_INIT_PB; 
      =     #INITIALISATION; 
//;
      AN    #MAIN_SERVICE_2_SW; 
      R     "HMI_DB".HMI_CONVEYOR_11_TEST_SSW; 
      R     "DB UTILITY".Conveyor_10_Disable; 
      R     "DB UTILITY".Pivot_Disable; 

CO11: R     #SERVICE_RUN; 
      R     #INITIALISATION; 
      FP    "FP 148.0"; 
      =     "M 58.7"; 
NETWORK
TITLE =Power Enable

      A     "M 0.3"; 
      AN    "DB UTILITY".Conveyor_11_Disable; 
      =     "M 58.0"; 
NETWORK
TITLE =Conveyor 11 - Running TimeOut  30s

      A(    ; 
      A     "M 59.1"; 
      AN    "M 59.2"; 
      O     ; 
      A     "M 59.3"; 
      AN    "M 59.4"; 
      A     "A 48.3"; 
      )     ; 
      A     "M 58.0"; 
      L     S5T#30S; 
      SD    "Timer 59"; // C11 TimeOut
NETWORK
TITLE =Steps Register - Reset

      A(    ; 
      A     "M 59.1"; // Filling Step
      AN    "M 59.2"; // Filling Step - Done
      A     "Timer 59"; // C11 TimeOut
      O     "M 59.4"; 
      O     #INITIALISATION; 
      O     "DB UTILITY".Conveyor_11_Disable; 
      )     ; 
      A     "M 58.0"; 
      JNB   _001; 
      L     W#16#0; 
      T     "MW 59"; 

_001: NOP   0; 
NETWORK
TITLE =Step 12N1 - Power ON

      A     "M 58.0"; 
      S     "M 59.0"; 
NETWORK
TITLE =Step 12N2 - Conveyor 11 - Packet Filling & Trig Conveyor 10
//Flag M 8.4 Holds the Conveyor 11 Belt until New Order Confirm
      A(    ; 
      A     "P 15.1"; // Pivot Position LOW OK
      A(    ; 
      O     "M 55.4"; // C10 Collator Full - Step - C11 Trigger
      O     "M 58.2"; // C10 Clearing - UpStream Cleared - C11 Trigger
      )     ; 
      AN    "M 55.5"; // C10 Not Tranfering
      AN    "M 8.4"; // Not Wait After Clearing
      O     ; 
      A     "B 10.7"; // Re-Trigger...
      AN    "M 59.1"; // If Not Filling
      O     ; 
      A     "M 9.3"; // C10 Clearing - Transfer Trigger 
      )     ; 
      O     #SERVICE_RUN; // Drive Test - Logic : DON'T CARE!
      A     "M 58.0"; 
      A     "M 59.0"; 
      S     "M 59.1"; // C11 Filling Step - Set
NETWORK
TITLE =Step 12N3 - Conveyor 11 - Stop Filling

      A     "B 10.7"; // C11 Exit Sens
      A     "M 58.0"; 
      A     "M 59.1"; // C11 Filling Step
      S     "M 59.2"; // Filling Stop Step - Set
NETWORK
TITLE =Step 12N4 - Conveyor 11 - Transfering

      A     "M 63.1"; // Called by C12
      AN    "M 63.2"; // C12 Not Full Yet!
      A     "M 58.0"; 
      A     "M 59.2"; // C11 Filling Stop Step - Done
      S     "M 59.3"; // C11 Transfering Step - Set
NETWORK
TITLE =Step 12N5 - Conveyor 11 - Steps Register - Reset

      A(    ; 
      O     "B 11.0"; // C12 Full -> Stop C11
      O     "Timer 59"; // C11 TimeOut
      )     ; 
      A     "M 58.0"; 
      A     "M 59.3"; // Transfering Step 
      S     "M 59.4"; // Register Reset - Trigger Set
NETWORK
TITLE =Conveyor 11 VFD - Release

      A(    ; 
      A     "M 59.1"; // Filling Step 
      AN    "M 59.2"; // Filling Step - Done
      O     ; 
      A     "M 59.3"; // Transfering Step
      AN    "M 59.4"; // Transfering Done - Register Reset
      )     ; 
      A     "M 58.0"; 
      AN    "M 11.1"; // VFD NOT All Ready !
      =     "A 48.3"; 
      =     "A 48.4"; 
END_FUNCTION

FUNCTION "CONVEYOR 12 - LINK 2 LO" : VOID
TITLE =Conveyor 12 - Link 2L  Pos. 14 Low Level
//
NAME : POS_14_L
VERSION : 0.0


VAR_TEMP
  MAIN_SERVICE_2_SW : BOOL ;	
  SERVICE_RUN : BOOL ;	
  BARRIER_BLINKER : BOOL ;	
END_VAR
BEGIN
NETWORK
TITLE =Conveyor 12 - Service

      A     "HMI_DB".ALL_SERVICE_ENABLE_SW; 
      A     "HMI_DB".CONVEYOR_11_SERVICE_SW; 
      A     "HMI_DB".SERVICE_SW_2_STATUS; 
      =     #MAIN_SERVICE_2_SW; 
//;
      A     #MAIN_SERVICE_2_SW; 
      O     "M 62.7"; 
      JNB   CO12; 
//;    
      A     "HMI_DB".HMI_CONVEYOR_12_TEST_SSW; 
      =     #SERVICE_RUN; 
//;
      AN    #MAIN_SERVICE_2_SW; 
      R     "HMI_DB".HMI_CONVEYOR_12_TEST_SSW; 

CO12: R     #SERVICE_RUN; 
      FP    "FP 148.1"; 
      =     "M 62.7"; 
NETWORK
TITLE =FL Power Enable

      A     "M 0.3"; 
      =     "M 62.0"; 
NETWORK
TITLE =Conveyor 12 - Running TimeOut  30s

      A(    ; 
      A     "M 63.1"; 
      AN    "M 63.2"; 
      O     ; 
      A     "M 63.3"; 
      AN    "M 63.4"; 
      A     "A 48.6"; 
      )     ; 
      A     "M 62.0"; 
      L     S5T#30S; 
      SD    "Timer 63"; 
NETWORK
TITLE =Conveyor 12 - Steps Register - Reset

      A(    ; 
      A     "M 63.1"; 
      AN    "M 63.2"; 
      A     "Timer 63"; 
      O     "M 63.4"; 
      )     ; 
      A     "M 62.0"; 
      JC    M001; 
      JU    M002; 

M001: L     W#16#0; 
      T     "MW 63"; 
      T     "MB 65"; 

M002: NOP   0; 
NETWORK
TITLE =Step 13N1 - Power On

      A     "M 62.0"; 
      S     "M 63.0"; 
NETWORK
TITLE =Step 13N2 - Conveyor 12 - Packet Filling

      A(    ; 
      A     "M 59.2"; 
      AN    "M 59.3"; 
      O     ; 
      A     "B 11.0"; 
      AN    "M 63.1"; 
      )     ; 
      O     #SERVICE_RUN; // Drive Test - Logic : DON'T CARE!
      A     "M 62.0"; 
      A     "M 63.0"; 
      S     "M 63.1"; 
NETWORK
TITLE =Step 13N3 - Conveyor 12 - Stop Filling

      A     "B 11.0"; 
      A     "M 62.0"; 
      A     "M 63.1"; 
      S     "M 63.2"; 
NETWORK
TITLE =Step 13N4 - Conveyor 12 - Transfering

      A     "M 67.1"; 
      AN    "M 67.2"; 
      A     "M 62.0"; 
      A     "M 63.2"; 
      S     "M 63.3"; 
NETWORK
TITLE =Step 13N5 - Conveyor 12 - Steps Register - Reset

      A(    ; 
      O     "B 11.1"; 
      O     "Timer 63"; 
      )     ; 
      A     "M 62.0"; 
      A     "M 63.3"; 
      S     "M 63.4"; 
NETWORK
TITLE =Conveyor 12 VFD - Release

      A(    ; 
      A     "M 63.1"; 
      AN    "M 63.2"; 
      O     ; 
      A     "M 63.3"; 
      AN    "M 63.4"; 
      )     ; 
      A     "M 62.0"; 
      AN    "M 11.1"; // VFD NOT All Ready !
      =     "A 48.6"; 
      =     "A 48.7"; 
END_FUNCTION

FUNCTION "CONVEYOR 13 - DELIV. LO" : VOID
TITLE =Conveyor 13 - Delivery First Level
NAME : POS_15_L
VERSION : 0.0


VAR_TEMP
  MAIN_SERVICE_2_SW : BOOL ;	
  SERVICE_RUN : BOOL ;	
  BARRIER_BLINKER : BOOL ;	//Feeder Safety Light Barrier
END_VAR
BEGIN
NETWORK
TITLE =Conveyor 13 - Service

      A     "HMI_DB".ALL_SERVICE_ENABLE_SW; 
      A     "HMI_DB".CONVEYOR_11_SERVICE_SW; 
      A     "HMI_DB".SERVICE_SW_2_STATUS; 
      =     #MAIN_SERVICE_2_SW; 
//;
      A     #MAIN_SERVICE_2_SW; 
      O     "M 66.1"; 
      JNB   CO13; 
//;    
      A     "HMI_DB".HMI_CONVEYOR_13_TEST_SSW; 
      =     #SERVICE_RUN; 
//;
      AN    #MAIN_SERVICE_2_SW; 
      R     "HMI_DB".HMI_CONVEYOR_13_TEST_SSW; 

CO13: R     #SERVICE_RUN; 
      FP    "FP 148.2"; 
      =     "M 66.1"; 
NETWORK
TITLE =Delivery Conveyor 13 - Running TimeOut  30s

      A     "M 67.1"; 
      AN    "M 67.3"; 
      A     "A 49.0"; 
      A     "M 66.0"; 
      L     S5T#30S; 
      SD    "Timer 66"; 
NETWORK
TITLE =Conveyor 13 - Next Delivery

      A     "B 11.2"; 
      A     "M 67.5"; 
      AN    "M 67.6"; 
      A     "M 0.3"; 
      S     "M 66.6"; 
//;
      A     "M 67.3"; 
      AN    "M 67.4"; 
      R     "M 66.6"; 
NETWORK
TITLE =Delivery Conveyor 13 - Empty Sens TimeOut  3s

      A     "M 67.4"; 
      AN    "M 67.5"; 
      A     "B 11.2"; 
      A     "M 0.3"; 
      A     "A 49.0"; 
      L     S5T#3S; 
      SD    "Timer 67"; 
NETWORK
TITLE =Delivery Conveyor 13 - Ready

      A     "Timer 67"; 
      S     "M 66.7"; 
//;
      A     "M 9.1"; 
      AN    "B 11.2"; 
      A     "M 0.3"; 
      R     "M 66.7"; 
NETWORK
TITLE =Conveyor 13 - Power Enable

      A     "M 0.3"; 
      AN    "DB UTILITY".Conveyor_13_Disable; 
      =     "M 66.0"; 
NETWORK
TITLE =Step 14N1 - Conveyor 13 - Power On

      A     "M 66.0"; 
      S     "M 67.0"; 
NETWORK
TITLE =Step 14N2 - Conveyor 13 - Filling

      A(    ; 
      A     "M 63.2"; 
      AN    "M 63.3"; 
      O     ; 
      A(    ; 
      O     "B 11.1"; 
      O     "B 11.2"; 
      )     ; 
//      O     #SERVICE_RUN
      AN    "M 67.1"; 
      )     ; 
      A     "M 66.0"; 
      A     "M 67.0"; 
      S     "M 67.1"; 
NETWORK
TITLE =Step 14N3 - Conveyor 13 - Stop

      A(    ; 
      O     "B 11.1"; 
      O     "B 11.2"; 
      )     ; 
      A     "M 66.0"; 
      A     "M 67.1"; 
      S     "M 67.2"; 
NETWORK
TITLE =Step 14N4 - Conveyor 13 - Packets Present

      A     "B 11.2"; 
      A     "M 66.0"; 
      A     "M 67.2"; 
      S     "M 67.3"; 
NETWORK
TITLE =Step 14N5 - Conveyor 13 - Delivery

      A(    ; 
      AN    "P 11.4"; 
      A     "M 71.2"; 
      AN    "M 71.3"; 
      A     "M 73.6"; 
      ON    "B 11.2"; 
      )     ; 
      AN    "M 66.7"; 
      A     "M 66.0"; 
      A     "M 67.3"; 
      S     "M 67.4"; 
NETWORK
TITLE =Write 1 to Steps 0-3 Byte Register MB67

      A(    ; 
      O     "M 66.6"; 
      O     "M 66.7"; 
      )     ; 
      A     "M 67.4"; 
      A     "M 66.0"; 
      JC    M001; 
      JU    M002; 

M001: L     2#1111; 
      T     "MB 67"; 

M002: NOP   0; 
NETWORK
TITLE =Step 14N6 - Conveyor 13 - Delivery Done

      AN    "B 11.2"; 
      A     "M 66.0"; 
      A     "M 67.4"; 
      S     "M 67.5"; 
NETWORK
TITLE =Delivery Conveyor 13 - Next Delivery - Delay

      A     "M 67.5"; 
      AN    "M 67.6"; 
      A     "A 49.0"; 
      A     "M 66.0"; 
      L     S5T#3S; 
      SD    "Timer 69"; 
NETWORK
TITLE =Step 14N7 - Conveyor 13 - Next Delivery

      A     "Timer 69"; 
      A     "M 66.0"; 
      A     "M 67.5"; 
      S     "M 67.6"; 
NETWORK
TITLE =Steps Register - Reset

      A(    ; 
      O     "M 67.6"; 
      O     "Timer 66"; 
      )     ; 
      A     "M 66.0"; 
      JC    M003; 
      JU    M004; 

M003: L     2#0; 
      T     "MW 67"; 

M004: NOP   0; 
NETWORK
TITLE =Conveyor 13 VFD - Release

      A(    ; 
      A     "M 67.1"; 
      AN    "M 67.3"; 
      O     ; 
      A     "M 67.4"; 
      AN    "M 67.5"; 
      A     "M 70.0"; 
      O     ; 
      A     "M 67.5"; 
      AN    "M 67.6"; 
      O     "M 66.4"; 
      )     ; 
      A     "M 66.0"; 
      =     "A 49.0"; 
NETWORK
TITLE =Conveyor Filling

      A     "M 67.1"; 
      AN    "M 67.2"; 
      A     "M 66.0"; 
      =     "A 49.1"; 
NETWORK
TITLE =Conveyor 13 VFD - Slow

      A(    ; 
      A     "M 67.2"; 
      AN    "M 67.3"; 
      O     ; 
      A     "M 67.4"; 
      AN    "M 67.6"; 
      O     "M 66.4"; 
      )     ; 
      A     "M 66.0"; 
      =     "A 49.2"; 
NETWORK
TITLE =Conveyor 13 - Delivering ON

      A     "M 67.2"; 
      AN    "M 67.3"; 
      S     "M 66.4"; 
//;
      A(    ; 
      ON    "M 67.2"; 
      O     "M 67.3"; 
      )     ; 
      R     "M 66.4"; 
END_FUNCTION

FUNCTION "LOADER FINGERS" : VOID
TITLE =Feeder Fingers
//
NAME : FEEDER
VERSION : 0.0


VAR_TEMP
  MAIN_SERVICE_3_SW : BOOL ;	
  FEEDER_SERVICE_SW : BOOL ;	
  FINGERS_SERVICE_SW : BOOL ;	
  LIGHT_BARRIER : BOOL ;	
  FINGERS_EXTEND : BOOL ;	
  FINGERS_RETRACT : BOOL ;	
  FINGERS_TILT : BOOL ;	
  BELT_ON : BOOL ;	
  INITIALISATION : BOOL ;	
END_VAR
BEGIN
NETWORK
TITLE =Light Barrier Buffer

      A     "E 1.4"; 
      O     "M 90.0"; 
      =     #LIGHT_BARRIER; 
//;
      A     "E 1.4"; 
      R     "M 90.0"; 
NETWORK
TITLE =Feeder Service 

      A     "HMI_DB".ALL_SERVICE_ENABLE_SW; 
      A     "HMI_DB".LOADER_SERVICE_ENABLE_SW; 
      A     "HMI_DB".SERVICE_SW_3_STATUS; 
      =     #MAIN_SERVICE_3_SW; 
//;
      A     #MAIN_SERVICE_3_SW; 
      O     "M 70.7"; 
      JNB   FEED; 
      A     "HMI_DB".LOADER_LIFT_SERVICE_SSW; 
      =     #FEEDER_SERVICE_SW; 
//;
      A     #FEEDER_SERVICE_SW; 
      A     "HMI_DB".LOADER_FING_SERVICE_SSW; 
      =     #FINGERS_SERVICE_SW; 
      =     "DB UTILITY".Conveyor_13_Disable; 
      =     "DB UTILITY".Conveyor_23_Disable; 
//;  
      A     #FEEDER_SERVICE_SW; 
      A     #FINGERS_SERVICE_SW; 
      A     "HMI_DB".FINGER_EXTEND_TEST_PB; 
      AN    #FINGERS_RETRACT; 
      =     #FINGERS_EXTEND; 
//;  
      A     #FEEDER_SERVICE_SW; 
      A     #FINGERS_SERVICE_SW; 
      A     "HMI_DB".FINGER_RETRACT_TEST_PB; 
      AN    #FINGERS_EXTEND; 
      =     #FINGERS_RETRACT; 
//;  
      A     #FEEDER_SERVICE_SW; 
      A     #FINGERS_SERVICE_SW; 
      A     "HMI_DB".FINGER_BELT_TEST_SW; 
      =     #BELT_ON; 
//;
      A     #FEEDER_SERVICE_SW; 
      A     #FINGERS_SERVICE_SW; 
      A     "HMI_DB".FINGER_TILT_TEST_PB; 
      =     #FINGERS_TILT; 
//;
      AN    #MAIN_SERVICE_3_SW; 
      ON    #FEEDER_SERVICE_SW; 
      R     "HMI_DB".LOADER_FING_SERVICE_SSW; 
      R     "HMI_DB".LOADER_LIFT_SERVICE_SSW; 
      R     "HMI_DB".FINGER_RETRACT_TEST_PB; 
      R     "HMI_DB".FINGER_EXTEND_TEST_PB; 
      R     "HMI_DB".FINGER_TILT_TEST_PB; 
      R     "HMI_DB".FINGER_BELT_TEST_SW; 

FEED: R     #FEEDER_SERVICE_SW; 
      R     #FINGERS_SERVICE_SW; 
      R     #FINGERS_EXTEND; 
      R     #FINGERS_RETRACT; 
      R     #FINGERS_TILT; 
      FP    "FP 159.7"; 
      =     "M 70.7"; 
//;
      A     "HMI_DB".SERVICE_INIT_PB; 
      A     #FEEDER_SERVICE_SW; 
      A     #MAIN_SERVICE_3_SW; 
      =     #INITIALISATION; 
NETWORK
TITLE =Feeder - Power Enable

      A     "M 0.3"; 
      A     "M 74.0"; 
      A     "E 13.6"; 
      =     "M 70.0"; 
NETWORK
TITLE =Feeder Fingers - VFD Release

      A     "P 12.0"; 
      S     "M 70.4"; 
//;
      A     "K 50.5"; 
      R     "M 70.4"; 
NETWORK
TITLE =Feeder Fingers Belt - Run TimeOut  6s

      A     "M 71.3"; 
      AN    "M 71.4"; 
      A     "A 51.1"; 
      A     "M 70.0"; 
      L     S5T#6S; 
      SD    "Timer 70"; 
NETWORK
TITLE =Step 15N1 - Power On

      A     "M 70.0"; 
      S     "M 71.0"; 
NETWORK
TITLE =Step 15N2 - Feeder Fingers - Step Run

      A     "M 70.4"; 
      A     "M 70.0"; 
      A     "M 71.0"; 
      S     "M 71.1"; 
NETWORK
TITLE =Packets Movements - UpDate

      A(    ; 
      A     "B 11.2"; 
      A     "M 73.6"; 
      AN    "M 66.7"; 
      A     "M 67.3"; 
      AN    "M 67.4"; 
      O     ; 
      A     "B 15.7"; 
      A     "M 73.7"; 
      AN    "M 86.7"; 
      A     "M 87.3"; 
      AN    "M 87.4"; 
      )     ; 
      A     "S 2.6"; 
      AN    "E 12.2"; 
      =     "M 9.0"; 
NETWORK
TITLE =Step 15N3 - Feeder Fingers Belt - Packet Loading

      A     "M 9.0"; 
      AN    "B 12.3"; 
      A     "M 70.4"; 
      A     "M 75.4"; 
      AN    "M 75.5"; 
      A     "M 70.0"; 
      A     "M 71.1"; 
      S     "M 71.2"; 
NETWORK
TITLE =Feeder - Packet Loading Delay

      A(    ; 
      AN    "B 11.2"; 
      A     "M 73.6"; 
      A     "M 67.3"; 
      O     ; 
      AN    "B 15.7"; 
      A     "M 73.7"; 
      A     "M 87.3"; 
      )     ; 
      A     "M 70.0"; 
      A     "M 71.2"; 
      AN    "M 71.3"; 
      L     S5T#50MS; 
      SD    "Timer 71"; 
NETWORK
TITLE =Step 15N4 - Feeder Fingers Belt - Packet Loaded

      A     "Timer 71"; 
      A     "M 70.0"; 
      A     "M 71.2"; 
      S     "M 71.3"; 
NETWORK
TITLE =Feeder - Fingers Extend - Delay

      A     "B 12.3"; 
      A     "M 70.0"; 
      A     "M 71.3"; 
      AN    "M 71.4"; 
      L     S5T#500MS; 
      SD    "Timer 72"; 
NETWORK
TITLE =Step 15N5 - Feeder Fingers - Extend

      A     "Timer 72"; 
      A     "M 70.0"; 
      A     "M 71.3"; 
      S     "M 71.4"; 
NETWORK
TITLE =Step 15N6 - Feeder Fingers Belt - Stop

      A     "P 12.1"; 
      A     "M 70.0"; 
      A     "M 71.4"; 
      S     "M 71.5"; 
NETWORK
TITLE =Step 15N7 - Feeder Fingers Tilt - Ready

      A     "M 76.0"; 
      AN    "M 76.1"; 
      A     "M 70.0"; 
      A     "M 71.5"; 
      S     "M 71.6"; 
//;
      O     "M 76.1"; 
      R     "M 71.6"; 
NETWORK
TITLE =Step 15N8 - Feeder Fingers Tilt - Down

      A     "S 2.6"; 
      AN    "B 13.0"; 
      A     "M 70.0"; 
      A     "M 71.6"; 
      S     "M 71.7"; 
NETWORK
TITLE =Step 15N9 - Feeder Fingers Belt - Run

      A     "E 12.2"; 
      A     "M 70.0"; 
      A     "M 71.7"; 
      S     "M 72.0"; 
NETWORK
TITLE =Feeder Fingers - Operator's Packet Delivery Timer
//Operator Packet Drop Timer - Deck
      A     "M 72.0"; 
      AN    "M 72.1"; 
      A     "M 70.0"; 
      =     "K 49.4"; 
NETWORK
TITLE =Step 15N10 - Feeder Fingers - Retract

      A     "E 3.1"; 
      A     "M 70.0"; 
      A     "M 72.0"; 
      S     "M 72.1"; 
NETWORK
TITLE =Step 15N11 - Feeder - Hold Down Devise

      A     "M 70.4"; 
      A     "M 70.0"; 
      A     "M 72.1"; 
      S     "M 72.2"; 
NETWORK
TITLE =Feeder - Hold Down Devise - ON Pulse

      A     "S 3.3"; 
      A     "M 72.2"; 
      A     "M 70.0"; 
      L     S5T#500MS; 
      SF    "Timer 73"; 

      A     "Timer 73"; 
      =     "K 41.7"; 
NETWORK
TITLE =Feeder Fingers - Steps Chain Register Reset

      A(    ; 
      ON    "M 75.0"; 
      O     "M 72.2"; 
      O     "Timer 70"; 
      O     #FEEDER_SERVICE_SW; 
      )     ; 
      JC    M001; 
