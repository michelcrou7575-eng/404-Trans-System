FUNCTION "LAUER MESSAGE2" : VOID
TITLE =Lauer Message 2
NAME : STATUS
VERSION : 0.0

BEGIN
NETWORK
TITLE =

      OPN   "DB LAUER"; 

NETWORK
TITLE =

      A(    ; 
      O     "M 150.4"; 
      O     "M 150.5"; 
      O     "M 150.7"; 
      ON    "S 2.1"; 
      O     "S 2.2"; 
      )     ; 
      AN    "M 0.1"; 
      AN    "M 0.2"; 
      AN    "M 0.3"; 
      AN    "M 1.5"; 
      AN    "M 1.7"; 
//;
      JC    M001; 
      JU    M002; 
M001: L     2#100; 
      T     DBW   82; 
      BEC   ; 
M002: NOP   0; 
NETWORK
TITLE =

      A     "M 0.2"; 
      AN    "M 0.3"; 
      JC    M003; 
      JU    M004; 
M003: L     2#1000; 
      T     DBW   82; 
      BEC   ; 
M004: NOP   0; 
NETWORK
TITLE =

      A     "M 0.3"; 
      AN    "M 9.7"; 
      JC    M005; 
      JU    M006; 
M005: L     2#10000; 
      T     DBW   82; 
      BEC   ; 
M006: NOP   0; 
END_FUNCTION

FUNCTION "LAUER CALL" : VOID
TITLE =Lauer Call
// TEXT ORG  
NAME : TEXTORG
VERSION : 0.0

BEGIN
NETWORK
TITLE =

      OPN   "DB LAUER"; 

NETWORK
TITLE =Reset & Preset
//When the communication/control byte is in a neutral state, and those two 
//internal flags are off, the FC restores default preset values in the Lauer DB.
      A(    ; 
      L     "MB 150"; 
      L     W#16#FFF7; 
      AW    ; 
      L     W#16#0; 
      )     ; 
      ==I   ; 
      AN    "M 151.6"; 
      AN    "M 151.7"; 
      JC    M001; 
      JU    M002; 

M001: L     2#0; 
      T     DBW   76; 
//;
      L     2#111100000000; 
      T     DBW   72; 
//;
      L     2#11100000000001; 
      T     DBW   74; 
//;
      L     W#16#0; 
      T     DBW   32; 

M002: NOP   0; 
NETWORK
TITLE =
//transfer keypad/page/request words 
//avoid repeated copying every scan
//only copy 
//once per trigger edge/state
      A     "M 0.3"; 
      AN    "M 200.0"; 
      JC    M003; 
      A     "M 0.2"; 
      AN    "M 200.1"; 
      JC    M004; 
      JU    M005; 

M003: L     "MW 150"; 
      T     "MW 118"; 
//;
      L     "MW 152"; 
      T     "MW 120"; 
//;
      A     "M 0.3"; 
      S     "M 200.0"; 
      R     "M 200.1"; 
      JU    M005; 

M004: L     "MW 118"; 
      T     "MW 150"; 
//;
      L     "MW 120"; 
      T     "MW 152"; 
//;
      A     "M 0.2"; 
      S     "M 200.1"; 
      R     "M 200.0"; 

M005: NOP   0; 
NETWORK
TITLE =
//reopen "DB LAUER"
//
//load DBW48
//
//call LAUER KEYS 1
      OPN   "DB LAUER"; 
      L     DBW   48; 
      CALL "LAUER KEYS 1" ;
NETWORK
TITLE =

      CALL "LAUER SERVICE" ;

NETWORK
TITLE =

      CALL "LAUER KEYS 2" ;

NETWORK
TITLE =

      CALL "LAUER KEYS 3" ;

NETWORK
TITLE =

      CALL "LAUER MESSAGE1" ;

NETWORK
TITLE =

//      CALL  "LAUER"

NETWORK
TITLE =

      CALL "LAUER MESSAGE2" ;

END_FUNCTION

FUNCTION "SETUP" : VOID
TITLE =Setup Values
//Do Not Change These Values !!!
NAME : SETUP
VERSION : 0.1

BEGIN
NETWORK
TITLE =Setup Values - Slat Conveyor 3

      L     8000; 
      T     "COLLATORS DB".Conveyor_Length_C3; 
NETWORK
TITLE =Setup Values - Conveyor 4

      L     800; //900
      T     "COLLATORS DB".Surface_Length_C4; 
NETWORK
TITLE =Setup Value  - TurnTable - Need " Packet IN " to Start

      S     "M 47.4"; 

NETWORK
TITLE =Setup Values - Conveyor 10

      L     13000; 
      T     "COLLATORS DB".Surface_Length_10; 
NETWORK
TITLE =Counter Setup


      S     "M 167.7"; 
NETWORK
TITLE =Packet Counter Constants 11.0 & 5.5

      L     1.000000e+01; 
      T     "DB UTILITY".LENGTH_CONST; 
//;
      L     5.200000e-01; 
      T     "DB UTILITY".WIDTH_CONST; 
NETWORK
TITLE =HMI - Conveyor Time 

      L     150; 
      T     "HMI_DB".CONV_7_POS_mS; 
//;
      L     30; 
      T     "HMI_DB".CONV_8_POS_FWD_mS; 
//;
      L     70; 
      T     "HMI_DB".CONV_8_POS_REV_mS; 
//;
      L     15; 
      T     "HMI_DB".CONV_9_POS_mS; 
NETWORK
TITLE =HMI Control - Reset

      R     "HMI_DB".ON_SW; 
      R     "HMI_DB".SERVICE_SW_1_STATUS; 
      R     "HMI_DB".SERVICE_SW_2_STATUS; 
      R     "HMI_DB".SERVICE_SW_3_STATUS; 
      R     "HMI_DB".SERVICE_SW_1_2_STATUS; 
END_FUNCTION

FUNCTION "SENSOR DE-BOUNCER" : VOID
TITLE =Sensor Debouncer
//Counting Foul Sensor Switching of less than PreSet Time
VERSION : 0.2


VAR_INPUT
  Bit_0 : BOOL ;	
  Bit_1 : BOOL ;	
  Preset_mS : INT ;	
  Debounce_mS : INT ;	
  Plc_Scan_mS : INT ;	
END_VAR
VAR_IN_OUT
  Rising_Pulse_1 : BOOL ;	//Db Struct
  Rising_Pulse_2 : BOOL ;	//Db Struct
  Rising_Pulse_3 : BOOL ;	//Db Struct
  Rising_Pulse_4 : BOOL ;	//Db Struct
  Rising_Pulse_5 : BOOL ;	//Db Struct
  Rising_Pulse_6 : BOOL ;	//Db Struct
  Rising_Pulse_7 : BOOL ;	//Db Struct
  Rising_Pulse_8 : BOOL ;	//Db Struct
  Memory_Bit_1 : BOOL ;	//Db Struct
  Memory_Bit_2 : BOOL ;	//Db Struct
  Memory_Bit_3 : BOOL ;	//Db Struct
  Memory_Bit_4 : BOOL ;	//Db Struct
  Memory_Bit_5 : BOOL ;	//Db Struct
  Memory_Bit_6 : BOOL ;	//Db Struct
  Spare_1 : BOOL ;	//Db Struct
  Spare_2 : BOOL ;	//Db Struct
  Word_Buffer_1 : INT ;	//Db Struct
  Word_Buffer_2 : INT ;	//Db Struct
  Word_Result : INT ;	//Db Struct
  Word_Count_Limit : INT ;	//Db Data
  Word_Count : INT ;	//Db/HMI Data
END_VAR
VAR_TEMP
  MEMORY_1 : BOOL ;	
  MEMORY_2 : BOOL ;	
  MEMORY_3 : BOOL ;	
END_VAR
BEGIN
NETWORK
TITLE =Init on First Call

      A     #Memory_Bit_6; 
      JNB   INI1; 
      JU    INI2; 

INI1: L     0; 
      T     #Word_Buffer_1; 
      T     #Word_Buffer_2; 
      R     #Memory_Bit_1; 
      R     #Memory_Bit_2; 
      R     #Memory_Bit_3; 
      R     #Memory_Bit_4; 
      R     #Memory_Bit_5; 
      S     #Memory_Bit_6; 

INI2: NOP   0; 

NETWORK
TITLE =Input Bits - Start Event
//- #Bit_0 : Conveyor X InFeed Sensor
//- #Bit_1 : Conveyor X Exit Sensor
      A     #Bit_0; 
      FP    #Rising_Pulse_1; 
      JNB   K001; 
      L     0; 
      T     #Word_Buffer_1; 
      R     #Memory_Bit_4; 
      S     #Memory_Bit_1; 

K001: NOP   0; 

      A     #Bit_1; 
      FP    #Rising_Pulse_2; 
      JNB   K002; 
      L     0; 
      T     #Word_Buffer_2; 
      S     #Memory_Bit_2; 

K002: NOP   0; 

NETWORK
TITLE =TimeBase
//TimeBase -> ScanTime
      A     #Memory_Bit_1; 
      A     #Bit_0; 
      JNB   K003; 
      L     #Word_Buffer_1; 
      L     #Plc_Scan_mS; 
      +I    ; 
      T     #Word_Buffer_1; 

K003: NOP   0; 

      A     #Memory_Bit_2; 
      A     #Bit_1; 
      JNB   K004; 
      L     #Word_Buffer_2; 
      L     #Plc_Scan_mS; 
      +I    ; 
      T     #Word_Buffer_2; 

K004: NOP   0; 

NETWORK
TITLE =Debounce mS Compare

      A(    ; 
      L     #Word_Buffer_1; 
      L     #Debounce_mS; 
      >=I   ; 
      )     ; 
      =     #MEMORY_1; 
//;
      A(    ; 
      L     #Word_Buffer_2; 
      L     #Debounce_mS; 
      >=I   ; 
      )     ; 
      =     #MEMORY_2; 

NETWORK
TITLE =Add to Packet Number with Bit_0
//Validated ON event on Bit_0 adds +1 one time
      A     #Memory_Bit_1; 
      A     #MEMORY_1; 
      A     #Bit_0; 
      FP    #Rising_Pulse_4; 
      JNB   K005; 
      L     #Word_Count; 
      L     1; 
      +I    ; 
      T     #Word_Count; 
      R     #Memory_Bit_1; 

K005: NOP   0; 

NETWORK
TITLE =Subtract from Packet Number with Bit_1
//Validated ON event on Bit_1 subtracts -1 on falling edge
      AN    #Bit_1; 
      FP    #Rising_Pulse_5; 
      JNB   K006; 

      A     #Memory_Bit_2; 
      A     #MEMORY_2; 
      JNB   K006; 
//;
      L     #Word_Count; 
      L     1; 
      -I    ; 
      T     #Word_Count; 
      R     #Memory_Bit_2; 

K006: NOP   0; 

NETWORK
TITLE =Clamp Packet Number

      L     #Word_Count; 
      L     0; 
      <I    ; 
      JNB   K007; 
      L     0; 
      T     #Word_Count; 

K007: NOP   0; 

      L     #Word_Count; 
      L     #Word_Count_Limit; 
      >I    ; 
      JNB   K008; 
      L     #Word_Count_Limit; 
      T     #Word_Count; 

K008: NOP   0; 

NETWORK
TITLE =Disable Over 5s ON
//Long switching event on Bit_0 -> bypass foul count
      L     #Word_Buffer_1; 
      L     5000; 
      >=I   ; 
      =     #MEMORY_3; 
//;
      A     #Bit_0; 
      A     #MEMORY_3; 
      S     #Memory_Bit_4; 

NETWORK
TITLE =Result
//Word_Result +1 if Bit_0 turns OFF before Preset_mS and was not bypassed
      AN    #Bit_0; 
      FP    #Rising_Pulse_6; 
      JNB   K009; 

      A     #Memory_Bit_1; 
      AN    #Memory_Bit_4; 
      JNB   K010; 
//;
      L     #Word_Buffer_1; 
      L     #Preset_mS; 
      <I    ; 
      JNB   K010; 
//;
      L     #Word_Result; 
      L     1; 
      +I    ; 
      T     #Word_Result; 

K010: R     #Memory_Bit_1; 
      R     #Memory_Bit_4; 
      L     0; 
      T     #Word_Buffer_1; 

K009: NOP   0; 

NETWORK
TITLE =Reset Exit Event on Falling Edge

      AN    #Bit_1; 
      FP    #Rising_Pulse_7; 
      JNB   K011; 
      R     #Memory_Bit_2; 
      L     0; 
      T     #Word_Buffer_2; 

K011: NOP   0; 

END_FUNCTION

