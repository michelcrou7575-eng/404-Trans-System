FUNCTION "LAUER TIME" : VOID
TITLE =
// TIMER  
NAME : _TIMER
VERSION : 0.0


VAR_OUTPUT
  QUEL : WORD ;	// QUEL
  _TIME : WORD ;	// TIME
END_VAR
BEGIN
NETWORK
TITLE =

      OPN   "DB LAUER"; 
      L     #QUEL; 
      T     DBW  504; 

      L     DBW  504; 
      ITB   ; 
      T     DBW  506; 

      L     DBW  506; 
      T     #_TIME; 
END_FUNCTION

FUNCTION "SENSOR CHECK" : VOID
TITLE =Sensor Check
//Counting Foul Sensor Switching of less than PreSet Time (500mS)
VERSION : 0.1


VAR_INPUT
  Bit : BOOL ;	
  Preset_ms : INT ;	
  Plc_Scan_ms : INT ;	
END_VAR
VAR_IN_OUT
  Rising_Pulse_1 : BOOL ;	//Db3 Struct 
  Rising_Pulse_2 : BOOL ;	//Db3 Struct 
  Memory_Bit_1 : BOOL ;	//Db3 Struct 
  Memory_Bit_2 : BOOL ;	//Db3 Struct 
  Word_Buffer : INT ;	//Db3 Struct 
  Word_Result : INT ;	//Db3 Struct 
END_VAR
VAR_TEMP
  MEMORY_BIT : BOOL ;	
  Bool2 : BOOL ;	
  Bool3 : BOOL ;	
  Bool4 : BOOL ;	
  Bool5 : BOOL ;	
  Bool6 : BOOL ;	
  Bool7 : BOOL ;	
  Bool8 : BOOL ;	
END_VAR
BEGIN
NETWORK
TITLE =Input Bit - Reset

      A     #Bit; 
      FP    #Rising_Pulse_1; 
      JNB   _001; 
      L     0; 
      T     #Word_Buffer; 

_001: NOP   0; 
NETWORK
TITLE =TimeBase 
//TimeBase -> ScanTime 
      A     #Bit; 
      JNB   _002; 
      L     #Word_Buffer; 
      L     #Plc_Scan_ms; 
      +I    ; 
      T     #Word_Buffer; 

_002: NOP   0; 

      A(    ; 
      L     #Word_Buffer; 
      L     10000; 
      >=I   ; 
      )     ; 
      =     #MEMORY_BIT; 
      JNB   _003; 
      L     0; 
      T     #Word_Buffer; 

_003: NOP   0; 
NETWORK
TITLE =ByPass Conditions
//Longer Switching Event Corrector

      A     #Bit; 
      A     #MEMORY_BIT; 
      S     #Memory_Bit_1; 
NETWORK
TITLE =Result
//WordResult + 1 
      A(    ; 
      L     #Word_Buffer; 
      L     #Preset_ms; 
      <I    ; 
      )     ; 
      AN    #Bit; 
      AN    #Memory_Bit_1; 
      FP    #Rising_Pulse_2; 
      JNB   _004; 
      L     #Word_Result; 
      L     1; 
      +I    ; 
      T     #Word_Result; 

_004: NOP   0; 

      AN    #Bit; 
      R     #Memory_Bit_1; 

END_FUNCTION

FUNCTION "DE-BOUNCER / COUNTER" : VOID
TITLE =Packet De-Bouncer / Counter  FC8
//==========================================================================
//  PACKET DE-BOUNCER / COUNTER  -  v0.7  (Replaces FC6 "DE-BOUNCER OLD")
//
//  COUNT UP   (Bit_0 = InFeed Sensor, gated by the caller)
//    - Bit_0 ON time is added while the packet is under the sensor.
//    - +1 once the ON time reaches Preset_MIN_mS.
//    - Re-armed only after Bit_0 stays OFF for the Gap time, so a
//      "U" shaped packet (short opening) is counted ONCE.
//    - A blip shorter than Preset_MIN_mS is dropped at the Gap.
//
//  COUNT DOWN (Bit_1 = RAW Exit Sensor, Transfer_Start = Transfer Step)
//    - Bit_1 ON time is only added while Transfer_Start is ON
//      (a packet parked on the exit sensor is NOT counted).
//    - -1 when the packet has LEFT: Bit_1 OFF for the Gap time and
//      ON time >= Preset_MIN_mS.
//    - Butted packets (exit sensor never clears): -1 every
//      HighSpd_Dimension_mS + Gap of continuous ON time.
//      HighSpd_Dimension_mS = 0 disables this.
//
//  Gap = Space_DX_mS / 2  (min 100 mS)
//
//  HMI (Word_Count, In/Out)
//    - Operator edit or external reset (write 0) is taken over on the
//      next call, as FC6 did.  Result is written back every call.
//
//  ERROR
//    - Bit_0 continuously ON >= 5 s -> IO_DB.Error / Q_Error (latched).
//    - Cleared by Error_Reset.
//
//  Call while the conveyor runs + ~1 s off-delay.
//  ReSample_DX, Conveyor_Type, LowSpd_Dimension_mS: kept for interface
//  compatibility, not used.
//==========================================================================
VERSION : 0.7


VAR_INPUT
  Bit_0 : BOOL ;	//InFeed Sensor - Count UP (gated by caller)
  Bit_1 : BOOL ;	//Exit Sensor - Count DOWN (RAW sensor)
  Transfer_Start : BOOL ;	//Transfer Step Active - Count DOWN Enable
  Error_Reset : BOOL ;	//Fault Reset PB
  Space_DX_mS : INT ;	//Nominal Space Between Packets [mS] - Gap = 50%
  ReSample_DX : INT ;	//Not Used (Compatibility)
  Conveyor_Type : INT ;	//Info Only: 1 Collator, 2 Delivery, 3 Link
  Preset_MIN_mS : INT ;	//Min ON Time to Accept a Packet [mS]
  LowSpd_Dimension_mS : INT ;	//Not Used (Compatibility)
  HighSpd_Dimension_mS : INT ;	//Packet Dimension @ Transfer Speed [mS] - 0 = Off
  Plc_Scan_mS : INT ;	//PLC ScanTime [mS]
END_VAR
VAR_OUTPUT
  Q_Error : BOOL ;	//Bit_0 Stuck
END_VAR
VAR_IN_OUT
  Word_Count : WORD ;	//HMI Packet Count (Read + Write Back) - WORD as in "HMI_DB"
  IO_DB : "Debouncer Counter Struct";	
END_VAR
BEGIN
NETWORK
TITLE =Init on First Call - Take Over HMI Count

      AN    #IO_DB.FirstScan_Done; 
      JCN   INIT; 
      L     0; 
      T     #IO_DB.Bit0_Entry_mS; 
      T     #IO_DB.Bit0_OFF_mS; 
      T     #IO_DB.Bit0_Stuck_mS; 
      T     #IO_DB.Bit1_Exit_mS; 
      T     #IO_DB.Bit1_OFF_mS; 
      L     #Word_Count; 
      T     #IO_DB.Count_Result; 
      T     #IO_DB.HMI_Last; 
      SET   ; 
      R     #IO_DB.Bit0_ON_Latch; 
      R     #IO_DB.Bit1_ON_Latch; 
      R     #IO_DB.Count_Done_Latch_0; 
      R     #IO_DB.Error; 
      S     #IO_DB.FirstScan_Done; 
INIT: NOP   0; 
NETWORK
TITLE =HMI Count Changed Outside (Operator Edit / Reset) - Take Over

      L     #Word_Count; 
      L     #IO_DB.HMI_Last; 
      <>I   ; 
      JCN   H001; 
      L     #Word_Count; 
      T     #IO_DB.Count_Result; 
H001: NOP   0; 
NETWORK
TITLE =Windows

      L     #Space_DX_mS; 
      L     2; 
      /I    ; 
      T     #IO_DB.Space_Between; // Gap Confirm [mS]
      L     100; 
      <I    ; 
      JCN   P001; 
      L     100; 
      T     #IO_DB.Space_Between; // Min 100 mS
P001: L     #Preset_MIN_mS; 
      T     #IO_DB.InFeed_Window_mS; // Info
      L     #HighSpd_Dimension_mS; 
      L     #IO_DB.Space_Between; 
      +I    ; 
      T     #IO_DB.Exit_Window_mS; // Butted Packets Window
NETWORK
TITLE =Count UP - InFeed Sensor Timing

      A     #Bit_0; 
      JCN   U001; 
      SET   ; 
      S     #IO_DB.Bit0_ON_Latch; // Packet Seen
      L     0; 
      T     #IO_DB.Bit0_OFF_mS; 
      L     #IO_DB.Bit0_Entry_mS; 
      L     #Plc_Scan_mS; 
      +I    ; 
      T     #IO_DB.Bit0_Entry_mS; // ON Time - This Packet
      L     #IO_DB.Bit0_Stuck_mS; 
      L     #Plc_Scan_mS; 
      +I    ; 
      T     #IO_DB.Bit0_Stuck_mS; // Continuous ON Time
      JU    U002; 
U001: L     0; 
      T     #IO_DB.Bit0_Stuck_mS; 
      A     #IO_DB.Bit0_ON_Latch; 
      JCN   U002; 
      L     #IO_DB.Bit0_OFF_mS; 
      L     #Plc_Scan_mS; 
      +I    ; 
      T     #IO_DB.Bit0_OFF_mS; // Gap Time
U002: NOP   0; 
NETWORK
TITLE =Count UP - Packet Accepted +1

      A     #IO_DB.Bit0_ON_Latch; 
      AN    #IO_DB.Count_Done_Latch_0; // Not Counted Yet
      A(    ; 
      L     #IO_DB.Bit0_Entry_mS; 
      L     #Preset_MIN_mS; 
      >=I   ; 
      )     ; 
      JCN   U003; 
      L     #IO_DB.Count_Result; 
      L     1; 
      +I    ; 
      T     #IO_DB.Count_Result; 
      SET   ; 
      S     #IO_DB.Count_Done_Latch_0; 
U003: NOP   0; 
NETWORK
TITLE =Count UP - Gap Confirmed - Re-Arm

      A(    ; 
      L     #IO_DB.Bit0_OFF_mS; 
      L     #IO_DB.Space_Between; 
      >=I   ; 
      )     ; 
      JCN   U004; 
      SET   ; 
      R     #IO_DB.Bit0_ON_Latch; 
      R     #IO_DB.Count_Done_Latch_0; 
      L     0; 
      T     #IO_DB.Bit0_Entry_mS; 
      T     #IO_DB.Bit0_OFF_mS; 
U004: NOP   0; 
NETWORK
TITLE =Count DOWN - Exit Sensor Timing

      A     #Bit_1; 
      JCN   D001; 
      L     0; 
      T     #IO_DB.Bit1_OFF_mS; 
      A     #Transfer_Start; // ON Time only while Transfering
      JCN   D002; 
      SET   ; 
      S     #IO_DB.Bit1_ON_Latch; 
      L     #IO_DB.Bit1_Exit_mS; 
      L     #Plc_Scan_mS; 
      +I    ; 
      T     #IO_DB.Bit1_Exit_mS; // ON Time - This Packet
      JU    D002; 
D001: A     #IO_DB.Bit1_ON_Latch; 
      JCN   D002; 
      L     #IO_DB.Bit1_OFF_mS; 
      L     #Plc_Scan_mS; 
      +I    ; 
      T     #IO_DB.Bit1_OFF_mS; // Gap Time
D002: NOP   0; 
NETWORK
TITLE =Count DOWN - Butted Packets -1 (Exit Sensor Never Clears)

      A     #Bit_1; 
      A     #Transfer_Start; 
      A     #IO_DB.Bit1_ON_Latch; 
      A(    ; 
      L     #HighSpd_Dimension_mS; 
      L     #Preset_MIN_mS; 
      >I    ; 
      )     ; 
      A(    ; 
      L     #IO_DB.Bit1_Exit_mS; 
      L     #IO_DB.Exit_Window_mS; 
      >=I   ; 
      )     ; 
      JCN   D003; 
      L     #IO_DB.Count_Result; 
      L     1; 
      -I    ; 
      T     #IO_DB.Count_Result; 
      L     #IO_DB.Bit1_Exit_mS; 
      L     #HighSpd_Dimension_mS; 
      -I    ; 
      T     #IO_DB.Bit1_Exit_mS; // Keep the Rest for the Next Packet
D003: NOP   0; 
NETWORK
TITLE =Count DOWN - Packet Left -1

      A(    ; 
      L     #IO_DB.Bit1_OFF_mS; 
      L     #IO_DB.Space_Between; 
      >=I   ; 
      )     ; 
      JCN   D005; 
      A(    ; 
      L     #IO_DB.Bit1_Exit_mS; 
      L     #Preset_MIN_mS; 
      >=I   ; 
      )     ; 
      JCN   D004; // Too Short = Not a Packet
      L     #IO_DB.Count_Result; 
      L     1; 
      -I    ; 
      T     #IO_DB.Count_Result; 
D004: SET   ; 
      R     #IO_DB.Bit1_ON_Latch; 
      L     0; 
      T     #IO_DB.Bit1_Exit_mS; 
      T     #IO_DB.Bit1_OFF_mS; 
D005: NOP   0; 
NETWORK
TITLE =Timers Overflow Clamp 30s

      L     #IO_DB.Bit0_Entry_mS; 
      L     30000; 
      >I    ; 
      JCN   K001; 
      L     30000; 
      T     #IO_DB.Bit0_Entry_mS; 
K001: L     #IO_DB.Bit0_Stuck_mS; 
      L     30000; 
      >I    ; 
      JCN   K002; 
      L     30000; 
      T     #IO_DB.Bit0_Stuck_mS; 
K002: L     #IO_DB.Bit1_Exit_mS; 
      L     30000; 
      >I    ; 
      JCN   K003; 
      L     30000; 
      T     #IO_DB.Bit1_Exit_mS; 
K003: NOP   0; 
NETWORK
TITLE =Clamp Packet Qty  0...Maximum_Count  (Max 0 = No Limit)

      L     #IO_DB.Count_Result; 
      L     0; 
      <I    ; 
      JCN   C001; 
      L     0; 
      T     #IO_DB.Count_Result; 
C001: L     #IO_DB.Maximum_Count; 
      L     0; 
      >I    ; 
      JCN   C002; 
      L     #IO_DB.Count_Result; 
      L     #IO_DB.Maximum_Count; 
      >I    ; 
      JCN   C002; 
      L     #IO_DB.Maximum_Count; 
      T     #IO_DB.Count_Result; 
C002: NOP   0; 
NETWORK
TITLE =InFeed Sensor Stuck >= 5s - Error

      A(    ; 
      L     #IO_DB.Bit0_Stuck_mS; 
      L     5000; 
      >=I   ; 
      )     ; 
      S     #IO_DB.Error; 
      A     #Error_Reset; 
      R     #IO_DB.Error; 
      A     #IO_DB.Error; 
      =     #Q_Error; 
NETWORK
TITLE =Result to HMI

      L     #IO_DB.Count_Result; 
      T     #Word_Count; 
      T     #IO_DB.HMI_Last; 
END_FUNCTION

FUNCTION "SCALER" : REAL
TITLE =Linear interpolation between two points
AUTHOR : APC
FAMILY : CONV_LIB
NAME : LINEAR
VERSION : 1.0


VAR_INPUT
  X : REAL ;	//[-] Input value
  X1 : REAL ;	//[-] First interpolation point, x-value
  Y1 : REAL ;	//[-] First interpolation point, y-value
  X2 : REAL ;	//[-] Second interpolation point, x-value
  Y2 : REAL ;	//[-] Second interpolation point, y-value
END_VAR
VAR_TEMP
  X_CALC_1 : REAL ;	//[-] x1 for Calculation
  Y_CALC_1 : REAL ;	//[-] y1 for Calculation
  X_CALC_2 : REAL ;	//[-] x2 for Calculation
  Y_CALC_2 : REAL ;	//[-] y2 for Calculation
END_VAR
BEGIN
NETWORK
TITLE =SCL network
//compiled by SCL compiler version:  SCLCOMP K05.06.00.00_11.01.00.01 release
//      SET   
//     SAVE  
//     =     L     16.1
      L     0.000000e+00; 
      T     #RET_VAL; 
//;
      L     #X1; 
      L     #X2; 
      <>R   ; 
      JCN   A7d0; 
//;
      L     #X1; 
      L     #X2; 
      >R    ; 
      JCN   A7d1; 
//;
      L     #X2; 
      T     #X_CALC_1; 
//;
      L     #Y2; 
      T     #Y_CALC_1; 
//;
      L     #X1; 
      T     #X_CALC_2; 
//;
      L     #Y1; 
      T     #Y_CALC_2; 
      JU    A7d2; 

A7d1: L     #X1; 
      T     #X_CALC_1; 
//;
      L     #Y1; 
      T     #Y_CALC_1; 
//;
      L     #X2; 
      T     #X_CALC_2; 
//;
      L     #Y2; 
      T     #Y_CALC_2; 
A7d2: L     #X; 

      L     #X_CALC_1; 
      <=R   ; 
      JCN   A7d3; 
      L     #Y_CALC_1; 
      T     #RET_VAL; 
      JU    A7d0; 

A7d3: L     #X; 
      L     #X_CALC_2; 
      >=R   ; 
      JCN   A7d5; 
      L     #Y_CALC_2; 
      T     #RET_VAL; 
      JU    A7d0; 

A7d5: L     #X; 
      L     #X_CALC_1; 
      -R    ; 
      L     #X_CALC_2; 
      TAK   ; 
      T     LD    18; 
      TAK   ; 
      L     #X_CALC_1; 
      -R    ; 
      L     LD    18; 
      TAK   ; 
      /R    ; 
      L     #Y_CALC_2; 
      TAK   ; 
      T     LD    18; 
      TAK   ; 
      L     #Y_CALC_1; 
      -R    ; 
      L     LD    18; 
      *R    ; 
      L     #Y_CALC_1; 
      +R    ; 
      T     #RET_VAL; 

A7d0: CLR   ; 

//    A     L     16.1
//    SAVE  
//    BE    
END_FUNCTION

