TITLE =Feeder Lift Steps Chain Reset by Feeder Fingers (MW71)

      A     "M 76.0"; 
      AN    "M 76.1"; 
      A(    ; 
      ON    "M 71.2"; 
      O     "M 72.2"; 
      )     ; 
      A     "M 74.0"; 
      JC    M003; 
      JU    M004; 

M003: L     2#0; 
      T     "MW 75"; 

M004: NOP   0; 
NETWORK
TITLE =Step 16N10 - Feeder Hold Operation (Stop) 1

      A     "S 3.4"; 
      A     "M 71.5"; 
      AN    "M 71.7"; 
      A     "M 74.0"; 
      A     "M 76.0"; 
      S     "M 76.1"; 
NETWORK
TITLE =Step 16N11 - Feeder Hold Operation (Stop) 2

      AN    "P 11.5"; 
      A     "M 74.0"; 
      A     "M 76.1"; 
      S     "M 76.2"; 
NETWORK
TITLE =Step 16N12 - Feeder Hold Operation (Stop) 3

      AN    "S 3.4"; 
      A     "M 74.0"; 
      A     "M 76.2"; 
      S     "M 76.3"; 
NETWORK
TITLE =Step 16N13 - Feeder Hold Operation (Stop) 4

      A     "S 3.4"; 
      A     "M 74.0"; 
      A     "M 76.3"; 
      S     "M 76.4"; 
NETWORK
TITLE =Step 16N14 - Feeder Hold Operation (Stop) 4 - Fill MB76

      A     "M 76.4"; 
      A     "M 74.0"; 
      JC    M005; 
      JU    M006; 

M005: L     2#11111100000000; 
      T     "MW 75"; 

M006: NOP   0; 
NETWORK
TITLE =Packets Movements - UpDate

      A(    ; 
      A     "P 11.4"; 
      A     "M 73.6"; 
      O     ; 
      A     "P 13.2"; 
      A     "M 73.7"; 
      O     ; 
      AN    "M 73.6"; 
      AN    "M 73.7"; 
      A     "P 11.5"; 
      )     ; 
      A     "M 74.2"; 
      A     "M 75.2"; 
      AN    "M 75.4"; 
      O     ; 
      A     "M 76.1"; 
      AN    "M 76.2"; 
      A     "P 11.4"; 
      =     "M 9.0"; 
NETWORK
TITLE =Feeder Lift - Up Motion

      A(    ; 
      A     "M 9.0"; 
      AN    #FEEDER_SERVICE_SW; 
      O     ; 
      A     #FEEDER_SERVICE_SW; 
