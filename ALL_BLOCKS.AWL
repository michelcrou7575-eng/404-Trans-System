      A(    ; 
      A     "M 79.2"; 
      AN    "M 79.3"; 
      O     ; 
      A     "B 15.5"; 
      AN    "M 83.1"; 
      )     ; 
      O     #SERVICE_RUN; // Drive Test - Logic : DON'T CARE!
      A     "M 82.0"; 
      A     "M 83.0"; 
      S     "M 83.1"; 
NETWORK
TITLE =Step 23N3 - Conveyor 22 - Stop Filling

      A     "B 15.5"; 
      A     "M 82.0"; 
      A     "M 83.1"; 
      S     "M 83.2"; 
NETWORK
TITLE =Step 23N4 - Conveyor 22 - Transfering

      A     "M 87.1"; 
      AN    "M 87.2"; 
      A     "M 82.0"; 
      A     "M 83.2"; 
      S     "M 83.3"; 
NETWORK
TITLE =Step 23N5 - Conveyor 22 - Steps Register - Reset

      A(    ; 
      O     "B 15.7"; 
      O     "Timer 83"; 
      )     ; 
      A     "M 82.0"; 
      A     "M 83.3"; 
      S     "M 83.4"; 
NETWORK
TITLE =Conveyor  22 VFD - Release

      A(    ; 
      A     "M 83.1"; 
      AN    "M 83.2"; 
      O     ; 
      A     "M 83.3"; 
      AN    "M 83.4"; 
      )     ; 
      A     "M 82.0"; 
      AN    "M 11.1"; // VFD NOT All Ready !
      =     "A 53.6"; 
      =     "A 53.7"; 
END_FUNCTION

FUNCTION "CONVEYOR 23 - DELIV. HI" : VOID
TITLE =Conveyor 23 - Delivery Second Level
//
NAME : POS_15_H
VERSION : 0.0


VAR_TEMP
  MAIN_SERVICE_2_SW : BOOL ;	
  SERVICE_RUN : BOOL ;	
END_VAR
BEGIN
NETWORK
TITLE =Conveyor 23 - Service

      A     "HMI_DB".ALL_SERVICE_ENABLE_SW; 
      A     "HMI_DB".CONVEYOR_21_SERVICE_SW; 
      A     "HMI_DB".SERVICE_SW_2_STATUS; 
      =     #MAIN_SERVICE_2_SW; 
//;
      A     #MAIN_SERVICE_2_SW; 
      O     "M 86.1"; 
      JNB   CO23; 
//;    
      A     "HMI_DB".HMI_CONVEYOR_23_TEST_SSW; 
      =     #SERVICE_RUN; 
//;
      AN    #MAIN_SERVICE_2_SW; 
      R     "HMI_DB".HMI_CONVEYOR_23_TEST_SSW; 

CO23: R     #SERVICE_RUN; 
      FP    "FP 149.3"; 
      =     "M 86.1"; 
NETWORK
TITLE =Delivery Conveyor 23 - Running TimeOut  30s

      A     "M 87.1"; 
      AN    "M 87.3"; 
      A     "A 54.0"; 
      A     "M 86.0"; 
      L     S5T#30S; 
      SD    "Timer 86"; 
NETWORK
TITLE =FL Conveyor 23 - Next Delivery

      A     "B 15.7"; 
      A     "M 87.5"; 
      AN    "M 87.6"; 
      A     "M 0.3"; 
      S     "M 86.6"; 
//;
      A     "M 87.3"; 
      AN    "M 87.4"; 
      R     "M 86.6"; 
NETWORK
TITLE =Delivery Conveyor 23 - Empty TimeOut  3s

      A     "M 87.4"; 
      AN    "M 87.5"; 
      A     "B 15.7"; 
      A     "M 0.3"; 
      A     "A 54.0"; 
      L     S5T#3S; 
      SD    "Timer 87"; 
NETWORK
TITLE =Delivery Conveyor 23 - Ready

      A     "Timer 87"; 
      S     "M 86.7"; 
//;
      A     "S 2.7"; 
      AN    "B 15.7"; 
      A     "M 0.3"; 
      R     "M 86.7"; 
NETWORK
TITLE =FL Conveyor 23 - Power Enable

      A     "M 0.3"; 
      AN    "DB UTILITY".Conveyor_23_Disable; 
      =     "M 86.0"; 
NETWORK
TITLE =Step     24N1 - Conveyor 23 - Power On

      A     "M 86.0"; 
      S     "M 87.0"; 
NETWORK
TITLE =Step     24N2 - Conveyor 23 - Filling

      A(    ; 
      A     "M 83.2"; 
      AN    "M 83.3"; 
      O     ; 
      A(    ; 
      O     "B 15.6"; 
      O     "B 15.7"; 
      )     ; 
//      O     #SERVICE_RUN
      AN    "M 87.1"; 
      )     ; 
      A     "M 86.0"; 
      A     "M 87.0"; 
      S     "M 87.1"; 
NETWORK
TITLE =Step     24N3 - Conveyor 23 - Stop

      A(    ; 
      O     "B 15.6"; 
      O     "B 15.7"; 
      )     ; 
      A     "M 86.0"; 
      A     "M 87.1"; 
      S     "M 87.2"; 
NETWORK
TITLE =Step     24N4 - Conveyor 23 - No Vacancy

      A     "B 15.7"; 
      A     "M 86.0"; 
      A     "M 87.2"; 
      S     "M 87.3"; 
NETWORK
TITLE =Step     24N5 - Conveyor 23 - Delivery

      A(    ; 
      AN    "P 13.2"; 
      A     "M 71.2"; 
      AN    "M 71.3"; 
      A     "M 73.7"; 
      ON    "B 15.7"; 
      )     ; 
      AN    "M 86.7"; 
      A     "M 86.0"; 
      A     "M 87.3"; 
      S     "M 87.4"; 
NETWORK
TITLE =Write 1 to Steps 0-3 Byte Register MB87

      A(    ; 
      O     "M 86.6"; 
      O     "M 86.7"; 
      )     ; 
      A     "M 87.4"; 
      A     "M 86.0"; 
      JC    M001; 
      JU    M002; 

M001: L     2#1111; 
      T     "MB 87"; 

M002: NOP   0; 
NETWORK
TITLE =Step     24N6 - Conveyor 23 - Delivery Done

      AN    "B 15.7"; 
      A     "M 86.0"; 
      A     "M 87.4"; 
      S     "M 87.5"; 
NETWORK
TITLE =Delivery Conveyor 23 - Next Delivery - Delay

      A     "M 87.5"; 
      AN    "M 87.6"; 
      A     "A 54.0"; 
      A     "M 86.0"; 
      L     S5T#3S; 
      SD    "Timer 89"; 
NETWORK
TITLE =Step     24N7 - Conveyor 23 - Steps Reset

      A     "Timer 89"; 
      A     "M 86.0"; 
      A     "M 87.5"; 
      S     "M 87.6"; 
NETWORK
TITLE =Steps Register - Reset

      A(    ; 
      O     "M 87.6"; 
      O     "Timer 86"; 
      )     ; 
      A     "M 86.0"; 
      JC    M003; 
      JU    M004; 

M003: L     2#0; 
      T     "MW 87"; 

M004: NOP   0; 
NETWORK
TITLE =Conveyor  23 VFD - Release

      A(    ; 
      A     "M 87.1"; 
      AN    "M 87.3"; 
      O     ; 
      A     "M 87.4"; 
      AN    "M 87.5"; 
      A     "M 70.0"; 
      O     ; 
      A     "M 87.5"; 
      AN    "M 87.6"; 
      O     "M 86.4"; 
      )     ; 
      A     "M 86.0"; 
      =     "A 54.0"; 
NETWORK
TITLE =Conveyor Filling

      A     "M 87.1"; 
      AN    "M 87.2"; 
      A     "M 86.0"; 
      =     "A 54.1"; 
NETWORK
TITLE =Conveyor  23 VFD - Slow

      A(    ; 
      A     "M 87.2"; 
      AN    "M 87.3"; 
      O     ; 
      A     "M 87.4"; 
      AN    "M 87.6"; 
      O     "M 86.4"; 
      )     ; 
      A     "M 86.0"; 
      =     "A 54.2"; 
NETWORK
TITLE =Conveyor 23 - Delivering ON

      A     "M 87.2"; 
      AN    "M 87.3"; 
      S     "M 86.4"; 
      A(    ; 
      ON    "M 87.2"; 
      O     "M 87.3"; 
      )     ; 
      R     "M 86.4"; 
END_FUNCTION

FUNCTION "LIGHT BAR" : VOID
TITLE =Light Bar
VERSION : 0.1


VAR_TEMP
  BARRIER_BLINKER : BOOL ;	//Feeder Safety Light Barrier
  STATUS_BLANKER : BOOL ;	
  CLEARING_BLINKER : BOOL ;	
END_VAR
BEGIN
NETWORK
TITLE =Light Barrier - Blinker

      ON    "E 1.4"; 
      L     S5T#5M; 
      SD    "Timer 68"; // Blinker TimeOut Start
//;
      A(    ; 
      AN    "Timer 68"; // Blinker TimeOut Done
      A     "M 145.0"; 
      )     ; 
      AN    "E 1.4"; 
      A     "S 2.6"; 
      =     #BARRIER_BLINKER; 
NETWORK
TITLE =Clearing _Blinker

      A     "M 10.0"; 
      A     "M 6.7"; 
      =     #CLEARING_BLINKER; 
NETWORK
TITLE =Light Bar - Conveyor Status Blanker

      AN    "E 1.4"; 
      AN    "Timer 68"; 
      O     "M 10.0"; 
      =     #STATUS_BLANKER; 
NETWORK
TITLE =Lamp >7< -> Collator Conveyor 4 - Transfer > Blink, Full > Solid

      A(    ; 

      A(    ; // Solid
      A(    ; 
      L     "HMI_DB".CONV_4_COUNT; 
      L     1; 
      >=I   ; 
      )     ; 
      AN    "M 31.6"; 
      )     ; // Solid

      O     ; 

      A(    ; // Blink
      A     "M 31.6"; 
      A     "A 44.4"; 
      AN    "M 145.4"; 
      )     ; // Blink

      )     ; 
      A     "M 0.3"; 
      AN    #STATUS_BLANKER; 
      O     #BARRIER_BLINKER; 
      O     #CLEARING_BLINKER; 
      O     "Timer 0"; 
      =     "H 52.6"; 
NETWORK
TITLE =Lamp >6< -> Link Conveyor 5 - Fill/Xsfer > Blink, Full > Solid

      A(    ; 

      A(    ; // Solid
      A(    ; 
      A(    ; 
      L     "HMI_DB".CONV_5_COUNT; 
      L     1; 
      >=I   ; 
      )     ; 
      O     "B 7.1"; 
      )     ; 
      O     "M 35.2"; 
      AN    "M 35.1"; 
      AN    "M 35.3"; 
      AN    "A 45.1"; 
      )     ; // Solid

      O     ; 

      A(    ; // Blink
      A(    ; 
      A     "M 35.1"; 
      AN    "M 35.2"; 
      O     ; 
      A     "M 35.3"; 
      )     ; 
      A     "A 45.1"; 
      A     "M 145.4"; 
      )     ; // Blink

      )     ; 
      A(    ; 
      A     "E 1.4"; 
      O     "Timer 68"; // Blinker TimeOut Done
      )     ; 
      A     "M 0.3"; 
      O     #BARRIER_BLINKER; 
      O     "Timer 0"; 
      =     "H 52.5"; 
NETWORK
TITLE =Lamp >5< -> Delivery Conveyor 6 - Fill > Blink, Full > Solid

      A(    ; 

      A(    ; // Solid
      A(    ; 
      A(    ; 
      L     "HMI_DB".CONV_6_COUNT; 
      L     1; 
      >=I   ; 
      )     ; 
      O     "B 7.2"; 
      )     ; 
      O     "M 39.2"; 
      AN(   ; 
      A     "M 39.1"; 
      AN    "M 39.2"; 
      )     ; 
      AN    "A 45.4"; 
      )     ; // Solid

      O     ; 

      A(    ; // Blink
      A     "M 39.1"; 
      AN    "M 39.2"; 
      A     "A 45.4"; 
      AN    "M 145.4"; 
      )     ; // Blink

      )     ; 
      A(    ; 
      A     "E 1.4"; 
      O     "Timer 68"; // Blinker TimeOut Done
      )     ; 
      A     "M 0.3"; 
      O     #BARRIER_BLINKER; 
      O     "Timer 0"; 
      =     "H 52.4"; 
NETWORK
TITLE =Lamp >4< -> Pivot 10 -> 11L/21H - Fill > Blink, Full > Solid

      A(    ; 

      A(    ; // Solid
      A(    ; 
      L     "HMI_DB".CONV_10_COUNT; 
      L     1; 
      >=I   ; 
      )     ; 
      O     "M 55.4"; 
      AN    "M 55.5"; 
      AN    "A 48.1"; 
      )     ; // Solid

      O     ; 

      A(    ; // Blink
      A     "M 55.5"; 
      A     "A 48.1"; 
      A     "M 145.4"; 
      )     ; // Blink

      )     ; 
      A(    ; 
      A     "E 1.4"; 
      O     "Timer 68"; // Blinker TimeOut Done
      )     ; 
      A     "M 0.3"; 
      O     #BARRIER_BLINKER; 
      O     "Timer 0"; 
      =     "H 52.3"; 
NETWORK
TITLE =Lamp >3< -> Link Conveyors 11L/21H - Fill > Blink, Full > Solid

      A(    ; 

      A(    ; // Solid
      A(    ; 
      A(    ; 
      A(    ; 
      L     "HMI_DB".CONV_11_COUNT; 
      L     "HMI_DB".CONV_21_COUNT; 
      +I    ; 
      L     1; 
      >=I   ; 
      )     ; 
      O     "B 10.7"; 
      O     "B 15.4"; 
      )     ; 
      O     "M 59.2"; 
      O     "M 79.2"; 
      )     ; 
      AN(   ; 
      A     "M 59.1"; 
      AN    "M 59.2"; 
      )     ; 
      AN(   ; 
      A     "M 79.1"; 
      AN    "M 79.2"; 
      )     ; 
      AN    "M 59.3"; 
      AN    "M 79.3"; 
      AN    "A 48.3"; 
      AN    "A 53.4"; 
      )     ; // Solid

      O     ; 

      A(    ; // Blink
      A(    ; 
      A(    ; 
      A     "M 59.1"; 
      AN    "M 59.2"; 
      O     ; 
      A     "M 79.1"; 
      AN    "M 79.2"; 
      )     ; 
      O     ; 
      A(    ; 
      A     "M 59.3"; 
      O     "M 79.3"; 
      )     ; 
      )     ; 
      A(    ; 
      O     "A 48.3"; 
      O     "A 53.4"; 
      )     ; 
      AN    "M 145.4"; 
      )     ; // Blink    

      )     ; 
      A(    ; 
      A     "E 1.4"; 
      O     "Timer 68"; // Blinker TimeOut Done
      )     ; 
      A     "M 0.3"; 
      O     #BARRIER_BLINKER; 
      O     "Timer 0"; 
      =     "H 52.2"; 

NETWORK
TITLE =Lamp >2< -> Link Conveyors 12L/22H - Fill > Blink, Full > Solid

      A(    ; 

      A(    ; // Solid
      A(    ; 
      A(    ; 
      A(    ; 
      L     "HMI_DB".CONV_12_COUNT; 
      L     "HMI_DB".CONV_22_COUNT; 
      +I    ; 
      L     1; 
      >=I   ; 
      )     ; 
      O     "B 11.0"; 
      O     "B 15.5"; 
      )     ; 
      O     "M 63.2"; 
      O     "M 83.2"; 
      )     ; 
      AN(   ; 
      A     "M 63.1"; 
      AN    "M 63.2"; 
      )     ; 
      AN(   ; 
      A     "M 83.1"; 
      AN    "M 83.2"; 
      )     ; 
      AN    "M 63.3"; 
      AN    "M 83.3"; 
      AN    "A 48.6"; 
      AN    "A 53.6"; 
      )     ; // Solid

      O     ; 

      A(    ; // Blink
      A(    ; 
      A(    ; 
      A     "M 63.1"; 
      AN    "M 63.2"; 
      O     ; 
      A     "M 83.1"; 
      AN    "M 83.2"; 
      )     ; 
      O     ; 
      A(    ; 
      A     "M 63.3"; 
      O     "M 83.3"; 
      )     ; 
      )     ; 
      A(    ; 
      O     "A 48.6"; 
      O     "A 53.6"; 
      )     ; 
      A     "M 145.4"; 
      )     ; // Blink

      )     ; 
      A(    ; 
      A     "E 1.4"; 
      O     "Timer 68"; // Blinker TimeOut Done
      )     ; 
      A     "M 0.3"; 
      O     #BARRIER_BLINKER; 
      O     "Timer 0"; 
      =     "H 52.1"; 

NETWORK
TITLE =Lamp >1< -> Output Conveyors 13L/23H - Fill > Blink,Full > Solid

      A(    ; // Solid

      A(    ; 
      L     "HMI_DB".CONV_13_COUNT; 
      L     "HMI_DB".CONV_23_COUNT; 
      +I    ; 
      L     1; 
      >=I   ; 
      )     ; 
      O     "B 11.2"; 
      O     "B 15.7"; 
      )     ; // Solid

      A(    ; 
      A     "E 1.4"; 
      O     "Timer 68"; // Blinker TimeOut Done
      )     ; 
      A     "M 0.3"; 
      AN    #STATUS_BLANKER; 
      O     #BARRIER_BLINKER; 
      O     #CLEARING_BLINKER; 
      O     "Timer 0"; 
      =     "H 52.0"; 
END_FUNCTION

FUNCTION "HMI CONTROL" : VOID
TITLE =HMI Control - Screen 0 SSW Inputs
//Screen 0 - "RUN" Screen
NAME : HMI_CTRL
VERSION : 0.1


VAR_TEMP
  SERVICE_ON : BOOL ;	
  CLEARING_ON : BOOL ;	
  HAND_FEED : BOOL ;	
  UPDATE_PULSE : BOOL ;	
END_VAR
BEGIN
NETWORK
TITLE =New HMI Panel Switches

      A     "E 34.0"; 
      =     "M 146.0"; 
//;
      A     "E 34.1"; 
      =     "M 146.1"; 
//;
      A     "E 34.2"; 
      =     "M 146.2"; 
//;
      A     "E 28.7"; 
      =     "M 146.3"; 
//;
      A     "H 40.1"; 
      =     "H 57.1"; 
//;
      A(    ; 
      A     "M 6.5"; 
      A     "M 10.0"; 
      )     ; 
      O     "M 5.3"; // Alarm White
      O     "M 8.5"; 
      =     "H 57.0"; 
//;
      A     "H 40.2"; 
      O     "M 5.5"; // Alarm Red
      =     "H 57.2"; 
//;
      A     "M 146.3"; 
      =     "H 57.3"; 
NETWORK
TITLE =New HMI ON Temporary

      A     "HMI_DB".ON_SW; 
      A     "HMI_DB".SERVICE_SW_3_STATUS; 
      =     "M 140.3"; 
NETWORK
TITLE =Screen UpDate

      A     "M 6.7"; 
      FP    "FP 168.0"; 
      =     #UPDATE_PULSE; 
NETWORK
TITLE =Screen 0 Soft Switches

      A(    ; 
      L     "HMI_DB".ACTUAL_HMI_SCREEN_NO; 
      L     "HMI_UPDATE".HMI_MAIN_PAGE_GRAPHIC; 
      <>I   ; 
      )     ; 
      O     #UPDATE_PULSE; 
      JNB   MAIN; 
NETWORK
TITLE =Service Switch Status - Screen 0 SSW Inputs

      A     "HMI_DB".SERVICE_SSW_MAIN; 
      L     S5T#20M; 
      SD    "Timer 101"; 
      =     #SERVICE_ON; 
      =     "HMI_DB".SERVICE_SSW_STATUS; 
//;
      A     #SERVICE_ON; 
      A     "Timer 101"; 
      R     "HMI_DB".SERVICE_SSW_MAIN; 
NETWORK
TITLE =Hand Feed Switch Status - Screen 0 SSW Inputs

      A     "M 140.3"; 
      A     "HMI_DB".MAN_FEED_SSW_MAIN; 
      L     S5T#20M; 
      SD    "Timer 103"; 
      =     #HAND_FEED; 
      =     "M 110.0"; 
      =     "HMI_DB".MAN_FEED_SSW_STATUS; 
//;
      A     #HAND_FEED; 
      =     "HMI_DB".HAND_FEED_ARROW_STATUS; 
//;
      A     #HAND_FEED; 
      A     "Timer 103"; 
      R     "HMI_DB".MAN_FEED_SSW_MAIN; 
NETWORK
TITLE =Turn Table Switch Status - Screen 0 SSW Inputs

      A     "M 7.3"; 
      =     "HMI_DB".TURNTABLE_SSW_STATUS; 
NETWORK
TITLE =Flipper Switch Status - Screen 0 SSW Inputs

      A     "M 140.3"; 
      A     "HMI_DB".FLIPPER_SSW_MAIN; 
      =     "M 111.1"; 
      =     "HMI_DB".FLIPPER_SSW_STATUS; 
NETWORK
TITLE =Roller Switch Status - Screen 0 SSW Inputs

      A     "M 140.3"; 
      A     "HMI_DB".ROLLER_SSW_MAIN; 
      =     "M 111.0"; 
      =     "HMI_DB".ROLLER_SSW_STATUS; 
NETWORK
TITLE =HMI Service Switch Reset
//HMI Service Switch Reset when 2145 Exits Packets + 10s Delay
      A(    ; 
      L     "HMI_DB".ACTUAL_HMI_SCREEN_NO; 
      L     0; 
      ==I   ; 
      )     ; 
      L     S5T#10S; 
      SD    "Timer 6"; 
//;
      A     "Timer 6"; 
      A     "E 34.7"; 
      R     "HMI_DB".ALL_SERVICE_ENABLE_SW; 
      R     "HMI_DB".SERVICE_SW_1_STATUS; 
      R     "HMI_DB".SERVICE_SW_2_STATUS; 
      R     "HMI_DB".SERVICE_SW_3_STATUS; 
      R     "HMI_DB".SERVICE_SW_1_2_STATUS; 
NETWORK
TITLE =Main Screen Graphic


      L     "HMI_DB".ACTUAL_HMI_SCREEN_NO; 
      T     "HMI_UPDATE".HMI_MAIN_PAGE_GRAPHIC; 

MAIN: NOP   0; 
END_FUNCTION

FUNCTION "HMI COMMS" : VOID
TITLE =HMI Communications
//OMRON NS12  on DB12
NAME : HMI_COMM
VERSION : 0.1


VAR_TEMP
  UPDATE_PULSE_0 : BOOL ;	
  UPDATE_PULSE_1 : BOOL ;	
  UPDATE_PULSE_2 : BOOL ;	
  UPDATE_PULSE_3 : BOOL ;	
  UPDATE_PULSE_4 : BOOL ;	
  UPDATE_PULSE_5 : BOOL ;	
  UPDATE_PULSE_6 : BOOL ;	
  UPDATE_1 : BOOL ;	
  UPDATE_2 : BOOL ;	
  UPDATE_3 : BOOL ;	
  UPDATE_4 : BOOL ;	
  UPDATE_5 : BOOL ;	
  UPDATE_6 : BOOL ;	
  UPDATE_7 : BOOL ;	
  UPDATE_8 : BOOL ;	
  UPDATE_9 : BOOL ;	
  UPDATE_10 : BOOL ;	
  UPDATE_11 : BOOL ;	
  UPDATE_12 : BOOL ;	
  UPDATE_13 : BOOL ;	
  TEMP1 : BOOL ;	
  TEST : BOOL ;	
  CONVEYOR_0_COLOR : BYTE ;	
  ELEVATOR_COLOR : BYTE ;	
  CONVEYOR_1_COLOR : BYTE ;	
  CONVEYOR_2_COLOR : BYTE ;	
  CONVEYOR_3_COLOR : BYTE ;	
  CONVEYOR_4_COLOR : BYTE ;	
  CONVEYOR_5_COLOR : BYTE ;	
  CONVEYOR_6_COLOR : BYTE ;	
  CONVEYOR_7_COLOR : BYTE ;	
  CONVEYOR_8_COLOR : BYTE ;	
  CONVEYOR_9_COLOR : BYTE ;	
  PUSHER_2_COLOR : BOOL ;	
  CONVEYOR_11_COLOR : BYTE ;	
  CONVEYOR_12_COLOR : BYTE ;	
  CONVEYOR_13_COLOR : BYTE ;	
  CONVEYOR_21_COLOR : BYTE ;	
  CONVEYOR_22_COLOR : BYTE ;	
